+++ b/crates/ara-editor/src/shell/script_recovery_ui/tests.rs
@@ -0,0 +1,199 @@
+//! Controlled owned-channel completions; these tests neither start players nor emit diagnostics.
+#![allow(clippy::unwrap_used)]
+use super::*;
+use ara_play_host::ScriptRecoveryPlayerResult;
+
+fn request(world: &str) -> ScriptRecoveryRequest {
+    ScriptRecoveryRequest {
+        session: "editor-session".into(),
+        world: world.into(),
+        player: None,
+        why: Some("Editor: Reload Scripts".into()),
+    }
+}
+fn status(ticket: u64, world: &str, finished: bool) -> ScriptRecoveryStatus {
+    ScriptRecoveryStatus {
+        ticket: ScriptRecoveryTicket(ticket),
+        world: world.into(),
+        finished,
+        players: Vec::new(),
+        diagnostics: Vec::new(),
+    }
+}
+
+#[test]
+fn coalesces_only_same_world_and_keeps_previous_world_ticket_owned() {
+    let mut state = State::default();
+    assert!(state.start(request("play:one"), |_| Ok(ScriptRecoveryTicket(1))));
+    assert!(!state.start(request("play:one"), |_| panic!(
+        "same-world duplicate must not submit"
+    )));
+    assert!(state.start(request("play:two"), |_| Ok(ScriptRecoveryTicket(2))));
+    assert_eq!(state.pending.len(), 2);
+    assert!(state.note(Some("play:one")).unwrap().contains("play:one"));
+    assert!(state.note(None).unwrap().contains("previous world"));
+    let now = Instant::now();
+    assert!(state.poll(now, |ticket| {
+        (ticket.0 == 1).then(|| status(1, "play:one", true))
+    }));
+    assert!(!state.pending_world("play:one"));
+    assert!(state.pending_world("play:two"));
+    assert_eq!(state.terminal.front().unwrap().world, "play:one");
+}
+
+#[test]
+fn mismatch_and_missing_reply_cannot_release_or_retarget_a_request() {
+    let mut state = State::default();
+    state.start(request("play:one"), |_| Ok(ScriptRecoveryTicket(1)));
+    let now = Instant::now();
+    assert!(!state.poll(now, |_| None));
+    assert!(state.busy());
+    assert!(
+        state.poll(now + Duration::from_millis(250), |_| Some(status(
+            1,
+            "play:replacement",
+            true
+        )))
+    );
+    assert!(state.pending[&1].invalid_reply);
+    assert!(state.busy());
+    assert!(
+        !state.poll(now + Duration::from_millis(500), |_| Some(status(
+            99, "play:one", true
+        )))
+    );
+    assert!(state.busy());
+    assert!(
+        state.poll(now + Duration::from_millis(750), |_| Some(status(
+            1, "play:one", true
+        )))
+    );
+    assert!(!state.busy());
+    assert_eq!(state.terminal.front().unwrap().world, "play:one");
+}
+
+#[test]
+fn slow_recovery_polls_are_bounded_coalesced_and_round_robin_without_releasing_tickets() {
+    let mut state = State::default();
+    for ticket in 1..=12 {
+        state.start(request(&format!("play:{ticket}")), |_| {
+            Ok(ScriptRecoveryTicket(ticket))
+        });
+    }
+    let now = Instant::now();
+    let mut read = Vec::new();
+    assert!(!state.poll(now, |ticket| {
+        read.push(ticket.0);
+        None
+    }));
+    assert_eq!(read, (1..=8).collect::<Vec<_>>());
+    assert!(!state.poll(now + Duration::from_millis(249), |_| panic!(
+        "poll cadence must preserve event-pump budget"
+    )));
+    read.clear();
+    assert!(!state.poll(now + Duration::from_millis(250), |ticket| {
+        read.push(ticket.0);
+        None
+    }));
+    assert_eq!(read, [9, 10, 11, 12, 1, 2, 3, 4]);
+    assert_eq!(state.pending.len(), 12);
+    assert!(state.report()["busy"].as_bool().unwrap());
+}
+
+#[test]
+fn diagnostics_are_kept_for_display_and_terminal_result_keeps_exact_outcome_and_modules() {
+    let mut state = State::default();
+    state.start(request("play:one"), |_| Ok(ScriptRecoveryTicket(1)));
+    let diagnostic=ara_diag::Diagnostic::error(ara_diag::Code(912),"original rich command fault")
+        .data(json!({"module":"Gameplay","play":{"world":"play:one","player":0,"source":"incarnation","binding":1},
+            "exception":{"schema":1,"type":"Outer","message":"original","frames":[],"inners":[],"truncated":false}}));
+    let mut done = status(1, "play:one", true);
+    done.diagnostics.push(diagnostic.clone());
+    done.players.push(ScriptRecoveryPlayerResult {
+        player: 0,
+        source: "incarnation".into(),
+        binding: 1,
+        outcome: ScriptRecoveryOutcome::Reloaded,
+        modules: vec!["Gameplay".into()],
+        diagnostics: vec![diagnostic.clone()],
+    });
+    let mut reply = Some(done);
+    assert!(state.poll(Instant::now(), |_| reply.take()));
+    let retained = state.terminal.front().unwrap();
+    assert_eq!(retained.diagnostics, [diagnostic.clone()]);
+    assert_eq!(retained.players[0].diagnostics, [diagnostic]);
+    assert_eq!(retained.players[0].modules, ["Gameplay"]);
+    assert!(matches!(
+        retained.players[0].outcome,
+        ScriptRecoveryOutcome::Reloaded
+    ));
+    // State has no Host/bus handle. Presentation consumes the original diagnostic,
+    // and the integration poll must never call report_failure/Cx::log for Status.
+    assert!(state::summary(retained).contains("Reloaded"));
+}
+
+#[test]
+fn duplicate_backend_ticket_and_transport_refusal_do_not_replace_earlier_ownership() {
+    let mut state = State::default();
+    state.start(request("play:one"), |_| Ok(ScriptRecoveryTicket(1)));
+    state.start(request("play:two"), |_| Ok(ScriptRecoveryTicket(1)));
+    assert_eq!(state.pending[&1].world, "play:one");
+    assert_eq!(state.pending.len(), 1);
+    assert!(
+        state
+            .note(Some("play:two"))
+            .unwrap()
+            .contains("duplicate owned ticket")
+    );
+    let diagnostic =
+        ara_diag::Diagnostic::error(crate::codes::ACTION, "owned recovery channel closed");
+    state.start(request("play:three"), |_| Err(vec![diagnostic.clone()]));
+    assert_eq!(state.request_error.as_ref().unwrap().1, [diagnostic]);
+    assert_eq!(state.pending.len(), 1);
+}
+
+#[test]
+fn pending_and_terminal_storage_are_bounded_without_evicting_live_tickets() {
+    let mut state = State::default();
+    for ticket in 1..=64 {
+        assert!(state.start(request(&format!("play:{ticket}")), |_| Ok(
+            ScriptRecoveryTicket(ticket)
+        )));
+    }
+    assert!(state.full());
+    assert!(!state.start(request("play:overflow"), |_| panic!(
+        "do not submit beyond owned ticket capacity"
+    )));
+    let now = Instant::now();
+    for round in 0..8 {
+        assert!(
+            state.poll(now + Duration::from_millis(round * 250), |ticket| Some(
+                status(ticket.0, &format!("play:{}", ticket.0), true)
+            ))
+        );
+    }
+    assert!(!state.busy());
+    assert_eq!(state.terminal.len(), 8);
+    assert_eq!(state.report()["pending"], json!([]));
+}
+
+#[test]
+fn retained_status_view_escapes_messages_and_bounds_visible_diagnostic_rows() {
+    let mut status = status(1, "play:<&>", true);
+    for index in 0..40 {
+        status.diagnostics.push(ara_diag::Diagnostic::error(
+            crate::codes::ACTION,
+            format!("failure <&> '{index}'"),
+        ));
+    }
+    let mut markup = String::new();
+    view::status_markup(&status, &mut markup);
+    assert_eq!(
+        markup
+            .matches("id='script-recovery-result-1-diagnostic-")
+            .count(),
+        16
+    );
+    assert!(markup.contains("24 additional diagnostics"));
+    assert!(!markup.contains("failure <&>"));
+}
diff --git a/crates/ara-editor/src/shell/script_recovery_ui/view.rs b/crates/ara-editor/src/shell/script_recovery_ui/view.rs
new file mode 100644
index 0000000..2502dac
--- /dev/null
+++ b/crates/ara-editor/src/shell/script_recovery_ui/view.rs
@@ -0,0 +1,112 @@
+use super::*;
+
+impl Shell {
+    /// Compact optional content for the existing Play/Problems area; no new page or modal.
+    pub(crate) fn script_recovery_markup(&mut self, editor: &Editor, out: &mut String) {
+        self.bind_command(
+            "script-recovery-reload",
+            "tools.cs.reload",
+            commands::Target::None,
+        );
+        self.bind_command(
+            "script-recovery-console",
+            "window.console",
+            commands::Target::None,
+        );
+        let state = &self.script_recovery_ui;
+        let reason = self.script_recovery_blocker(editor);
+        out.push_str(&format!("<panel id='script-recovery' style='flex-direction:column;height:auto;min-height:0px;max-height:180px;flex-basis:auto;flex-shrink:1;gap:4px;padding:6px'><panel id='script-recovery-actions' class='row' style='height:auto;min-height:24px;flex-shrink:0;flex-wrap:wrap;gap:4px'><button id='script-recovery-reload' style='height:auto;min-height:24px;min-width:0px;white-space:normal' text='Reload scripts' description='{}' disabled='{}' action='Dispatch' /><button id='script-recovery-console' class='ghost' text='Console' description='View full diagnostic history, including managed exception stacks' action='Dispatch' /></panel>",escape(reason.unwrap_or("Reload C# in every player of the current running world; do not restart Play")),reason.is_some()));
+        if let Some(reason) = reason {
+            out.push_str(&format!(
+                "<text id='script-recovery-reason' class='caption wrap-text' text='{}' />",
+                escape(reason)
+            ));
+        }
+        out.push_str("<scroll id='script-recovery-scroll' style='height:auto;min-height:0px;max-height:120px;flex-basis:auto;flex-shrink:1'><panel id='script-recovery-body' style='height:auto;flex-direction:column;gap:4px'>");
+        for (ticket, pending) in state.pending.iter().take(8) {
+            out.push_str(&format!("<panel id='script-recovery-pending-{ticket}' style='height:auto;flex-direction:column;flex-shrink:0;gap:2px'><text id='script-recovery-pending-{ticket}-label' class='caption wrap-text' text='Reload #{ticket} · {} · pending{}' />",escape(&pending.world),if editor.play_world.as_deref()==Some(pending.world.as_str()){""}else{" (previous world; request remains owned)"}));
+            if pending.invalid_reply {
+                out.push_str(&format!("<text id='script-recovery-pending-{ticket}-invalid' class='caption wrap-text' text='Waiting for this Play session to report its result. An unrelated reply was ignored.' />"));
+            }
+            if let Some(status) = &pending.latest {
+                status_markup(status, out);
+            }
+            out.push_str("</panel>");
+        }
+        if state.pending.len() > 8 {
+            out.push_str(&format!("<text id='script-recovery-more-pending' class='caption wrap-text' text='{} additional reload requests remain owned and are polled in turn.' />",state.pending.len()-8));
+        }
+        if let Some((world, diagnostics)) = &state.request_error {
+            out.push_str(&format!("<text id='script-recovery-request-error' class='caption wrap-text' text='Reload was not queued for {}' />",escape(world)));
+            diagnostic_markup("script-recovery-request", diagnostics, &mut 16, out);
+        }
+        for status in &state.terminal {
+            status_markup(status, out);
+        }
+        if state.pending.is_empty() && state.terminal.is_empty() && state.request_error.is_none() {
+            out.push_str("<text id='script-recovery-empty' class='caption wrap-text' text='Source compilation remains automatic. Manual reload reports each player and module; Unchanged or Refused does not clear runtime faults.' />");
+        }
+        out.push_str("</panel></scroll></panel>");
+    }
+}
+
+pub(super) fn status_markup(status: &ScriptRecoveryStatus, out: &mut String) {
+    let id = format!("script-recovery-result-{}", status.ticket.0);
+    out.push_str(&format!("<panel id='{id}' style='height:auto;flex-direction:column;flex-shrink:0;gap:2px'><text id='{id}-summary' class='caption wrap-text' text='{}' />",escape(&state::summary(status))));
+    let mut budget = 16;
+    diagnostic_markup(&id, &status.diagnostics, &mut budget, out);
+    for (index, player) in status.players.iter().take(16).enumerate() {
+        let prefix = format!("{id}-player-{index}");
+        let modules = player
+            .modules
+            .iter()
+            .take(16)
+            .map(String::as_str)
+            .collect::<Vec<_>>()
+            .join(", ");
+        out.push_str(&format!("<text id='{prefix}-scope' class='caption wrap-text' text='Player {} · source {} · binding {} · {} · modules: {}{}' />",player.player,escape(&player.source),player.binding,state::outcome(&player.outcome),escape(&modules),if player.modules.len()>16 { " (additional modules retained in Console)" } else { "" }));
+        diagnostic_markup(&prefix, &player.diagnostics, &mut budget, out);
+    }
+    if status.players.len() > 16 {
+        out.push_str(&format!("<text id='{id}-more-players' class='caption wrap-text' text='{} additional player results are retained in Console.' />",status.players.len()-16));
+    }
+    out.push_str("</panel>");
+}
+
+fn diagnostic_markup(
+    id: &str,
+    diagnostics: &[ara_diag::Diagnostic],
+    budget: &mut usize,
+    out: &mut String,
+) {
+    // Bound mounted rows while preserving all severities and prioritizing actual
+    // errors. Full diagnostics are retained in Status and already in Console.
+    let ordered = diagnostics
+        .iter()
+        .enumerate()
+        .filter(|(_, d)| d.is_error())
+        .chain(
+            diagnostics
+                .iter()
+                .enumerate()
+                .filter(|(_, d)| d.severity == ara_diag::Severity::Warning),
+        )
+        .chain(
+            diagnostics
+                .iter()
+                .enumerate()
+                .filter(|(_, d)| d.severity == ara_diag::Severity::Info),
+        );
+    let shown = diagnostics.len().min(*budget);
+    *budget -= shown;
+    for (index, diagnostic) in ordered.take(shown) {
+        out.push_str(&format!(
+            "<text id='{id}-diagnostic-{index}' class='caption wrap-text' text='{}: {}' />",
+            diagnostic.code,
+            escape(&diagnostic.message)
+        ));
+    }
+    if diagnostics.len() > shown {
+        out.push_str(&format!("<text id='{id}-more' class='caption wrap-text' text='{} additional diagnostics are retained in Console.' />",diagnostics.len()-shown));
+    }
+}
