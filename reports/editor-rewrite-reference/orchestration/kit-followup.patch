diff --git a/crates/ara-editor/src/shell/editor.css b/crates/ara-editor/src/shell/editor.css
index 5e927196..7837a6d9 100644
--- a/crates/ara-editor/src/shell/editor.css
+++ b/crates/ara-editor/src/shell/editor.css
@@ -144,7 +144,7 @@ scroll { overflow:hidden; flex-basis:0px; min-height:0px; min-width:0px; }
 .overlay { position:absolute; left:0px; top:0px; width:100%; height:100%; background:var(--background); }
 
 .menu { padding:4px; gap:0px; background:var(--menu-surface); border-width:1px; border-color:var(--separator-strong); border-radius:var(--radius-md); }
-.menu-item { height:26px; flex-shrink:0; justify-content:start; gap:8px; padding-left:6px; padding-right:6px; background:transparent; border-width:0px; border-radius:4px; color:var(--foreground); font-size:13px; }
+.menu-item { height:auto; min-height:26px; flex-shrink:0; justify-content:start; gap:8px; padding-left:6px; padding-right:6px; background:transparent; border-width:0px; border-radius:4px; color:var(--foreground); font-size:13px; }
 .menu-item:hover { background:var(--hover-surface); }
 .menu-item:disabled { color:var(--muted-foreground); background:transparent; }
 .menu-active { background:var(--selection-surface); color:var(--selection-foreground); }
@@ -154,9 +154,9 @@ scroll { overflow:hidden; flex-basis:0px; min-height:0px; min-width:0px; }
 .menu-group { height:22px; flex-shrink:0; padding-left:8px; padding-top:4px; font-size:11px; color:var(--muted-foreground); }
 .menu-filter { height:26px; flex-shrink:0; padding-bottom:4px; }
 .menu-check { width:16px; height:16px; flex-shrink:0; }
-.menu-label { flex-grow:1; flex-shrink:1; flex-basis:0px; min-width:0px; overflow:hidden; }
+.menu-label { flex-grow:1; flex-shrink:1; flex-basis:auto; min-width:0px; white-space:normal; }
 
-.palette { display:flex; width:640px; height:440px; padding:6px; gap:4px; background:var(--menu-surface); border-color:var(--separator-strong); border-width:1px; border-radius:var(--radius-base); overflow:hidden; }
+.palette { display:flex; width:640px; max-width:640px; height:440px; padding:6px; gap:4px; background:var(--menu-surface); border-color:var(--separator-strong); border-width:1px; border-radius:var(--radius-base); overflow:hidden; }
 .palette-result { height:32px; flex-shrink:0; justify-content:start; gap:8px; padding-left:8px; padding-right:8px; background:transparent; border-width:0px; border-radius:var(--radius-sm); }
 .palette-result:hover { background:var(--hover-surface); }
 .palette-active { background:var(--selection-surface); color:var(--selection-foreground); }
@@ -170,7 +170,7 @@ scroll { overflow:hidden; flex-basis:0px; min-height:0px; min-width:0px; }
 .dialog-text { white-space:normal; font-size:12px; color:var(--muted-foreground); }
 .dialog-code { white-space:normal; font-size:12px; font-family:JetBrains Mono; padding:8px; background:var(--background); border-radius:var(--radius-sm); }
 .context { position:absolute; left:0px; top:0px; width:220px; padding:4px; gap:0px; background:var(--menu-surface); border-width:1px; border-color:var(--separator-strong); border-radius:var(--radius-md); }
-.tooltip { position:absolute; left:0px; top:0px; width:320px; padding:8px; background:var(--menu-surface); border-width:1px; border-color:var(--separator-strong); border-radius:var(--radius-sm); }
+.tooltip { position:absolute; left:0px; top:0px; min-width:24px; max-width:360px; padding:8px; background:var(--menu-surface); border-width:1px; border-color:var(--separator-strong); border-radius:var(--radius-sm); }
 .tooltip-copy { white-space:normal; font-size:12px; }
 
 .diff { flex-direction:row; gap:8px; align-items:center; min-height:22px; }
