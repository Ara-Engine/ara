diff --git a/crates/ara-ui/src/dialogs/choice.rs b/crates/ara-ui/src/dialogs/choice.rs
new file mode 100644
index 00000000..3cd41c54
--- /dev/null
+++ b/crates/ara-ui/src/dialogs/choice.rs
@@ -0,0 +1,78 @@
+//! Owned choice results for real conflicts, using the same modal stack and focus contract.
+use super::{DialogFuture, DialogOptions, Dialogs, Outcome, Reply, Response, escape, stable_id};
+
+pub(super) struct Choice {
+    labels: Vec<String>,
+    default: usize,
+    reply: Reply<Option<usize>>,
+}
+
+impl Choice {
+    pub(super) fn default_id(&self, id: &str) -> String {
+        format!("{id}-choice-{}", self.default)
+    }
+
+    pub(super) fn index(&self, id: &str, node: u64) -> Option<usize> {
+        (0..self.labels.len()).find(|index| stable_id(&format!("{id}-choice-{index}")) == node)
+    }
+
+    pub(super) fn finish(self, outcome: Outcome) {
+        let index = match outcome {
+            Outcome::Accept => Some(self.default),
+            Outcome::Choice(index) if index < self.labels.len() => Some(index),
+            _ => None,
+        };
+        self.reply.finish(index);
+    }
+
+    pub(super) fn markup(&self, id: &str, destructive: bool) -> String {
+        let mut out = format!("<scroll id='{id}-choices' class='kit-dialog-choice-list'>");
+        for (index, label) in self.labels.iter().enumerate() {
+            let primary = if index == self.default {
+                if destructive {
+                    "kit-dialog-destructive"
+                } else {
+                    "kit-dialog-accept"
+                }
+            } else {
+                ""
+            };
+            out.push_str(&format!("<button id='{id}-choice-{index}' class='kit-dialog-button kit-dialog-choice {primary}' action='ara.dialog.choose' text='{}' />",escape(label,b'\'')));
+        }
+        out.push_str("</scroll>");
+        out
+    }
+}
+
+impl Dialogs {
+    /// Ask the user to choose an owned label by index. Esc, Cancel and controller
+    /// drop resolve None. Empty choices resolve immediately without mounting UI;
+    /// an out-of-range default is clamped to the last choice. `accept_label` is unused.
+    pub fn choose(
+        &mut self,
+        options: DialogOptions,
+        choices: Vec<String>,
+        default: usize,
+    ) -> DialogFuture<Option<usize>> {
+        let (reply, future) = Reply::new();
+        if choices.is_empty() {
+            reply.finish(None);
+            return future;
+        }
+        let default = default.min(choices.len() - 1);
+        self.push(
+            options,
+            None,
+            Response::Choose(Choice {
+                labels: choices,
+                default,
+                reply,
+            }),
+        );
+        future
+    }
+}
+
+#[cfg(test)]
+#[path = "choice_tests.rs"]
+mod tests;
diff --git a/crates/ara-ui/src/dialogs/choice_tests.rs b/crates/ara-ui/src/dialogs/choice_tests.rs
new file mode 100644
index 00000000..993228c9
--- /dev/null
+++ b/crates/ara-ui/src/dialogs/choice_tests.rs
@@ -0,0 +1,197 @@
+use super::super::CSS;
+use super::*;
+use crate::{
+    Result, Ui,
+    input::{InputEvent, InputState},
+};
+use ara_ui_text::{Clipboard, TextSystem};
+
+struct Clip;
+impl Clipboard for Clip {
+    fn read(&mut self) -> ara_ui_text::Result<String> {
+        Ok(String::new())
+    }
+    fn write(&mut self, _: &str) -> ara_ui_text::Result<()> {
+        Ok(())
+    }
+}
+
+fn surface(size: [f32; 2], host: &str) -> Result<(Ui, TextSystem, InputState)> {
+    let mut text = TextSystem::bundled()?;
+    let mut ui = Ui::editor(
+        "<ui id='root'><button id='outside' text='Outside' /></ui>",
+        &format!("{}{host}{CSS}", crate::theme::EDITOR_CSS),
+        size,
+    )?;
+    ui.frame(&mut text)?;
+    let mut input = InputState::default();
+    input.push(
+        &mut ui,
+        stable_id("root"),
+        Some(stable_id("outside")),
+        false,
+    )?;
+    Ok((ui, text, input))
+}
+fn mount(
+    dialogs: &mut Dialogs,
+    ui: &mut Ui,
+    text: &mut TextSystem,
+    input: &mut InputState,
+) -> Result<()> {
+    ui.reconcile(&format!(
+        "<ui id='root'><button id='outside' text='Outside' />{}</ui>",
+        dialogs.markup(ui.size)
+    ))?;
+    ui.frame(text)?;
+    dialogs.sync(ui, input)?;
+    ui.frame(text)?;
+    Ok(())
+}
+
+#[test]
+fn empty_choices_complete_without_ui_and_out_of_range_default_is_safe() -> Result<()> {
+    let (mut ui, mut text, mut input) = surface([480., 320.], "")?;
+    let mut dialogs = Dialogs::default();
+    let mut empty = dialogs.choose(
+        DialogOptions::new("No conflicts", "Nothing needs a choice."),
+        Vec::new(),
+        usize::MAX,
+    );
+    assert_eq!(empty.try_take(), Some(None));
+    assert!(dialogs.is_empty());
+    let mut choice = dialogs.choose(
+        DialogOptions::new("Conflict", "Choose an action."),
+        vec!["Rename".into(), "Skip".into()],
+        usize::MAX,
+    );
+    mount(&mut dialogs, &mut ui, &mut text, &mut input)?;
+    assert_eq!(input.focused(), Some(stable_id("ara-dialog-1-choice-1")));
+    dialogs.event(&mut ui, &mut input, InputEvent::Activate, &mut Clip)?;
+    assert_eq!(choice.try_take(), Some(Some(1)));
+    assert_eq!(input.focused(), Some(stable_id("outside")));
+    let mut rename = dialogs.choose(
+        DialogOptions::new("Existing file", "Rename is the safe default."),
+        vec!["Rename".into(), "Replace".into(), "Skip".into()],
+        0,
+    );
+    mount(&mut dialogs, &mut ui, &mut text, &mut input)?;
+    assert_eq!(input.focused(), Some(stable_id("ara-dialog-2-choice-0")));
+    dialogs.event(&mut ui, &mut input, InputEvent::Activate, &mut Clip)?;
+    assert_eq!(rename.try_take(), Some(Some(0)));
+    let mut dropped = dialogs.choose(
+        DialogOptions::new("Close", "Dropping a controller cancels the request."),
+        vec!["Rename".into()],
+        0,
+    );
+    drop(dialogs);
+    assert_eq!(dropped.try_take(), Some(None));
+    Ok(())
+}
