+#[test]
+fn empty_select_search_hint_is_painted_but_never_value_and_native_preedit_hides_it()->Result<()> {
+    use crate::{native_input::{Router,TextSource},paint::Draw};
+    let(mut ui,mut input,mut text)=surface()?;
+    let mut select=Select::new("hint","Engine version",vec![SelectOption::new(0,"Preview 4"),SelectOption::new(1,"Nightly")],Some(0));
+    mount(&mut select,&mut ui,&mut input,&mut text)?;
+    let rect=ui.nodes[ui.find(select.control_id()).expect("control")].rect;
+    let point=[rect.x+rect.w*0.5,rect.y+rect.h*0.5];
+    for event in [InputEvent::PointerDown(point),InputEvent::PointerUp(point)] {route(&mut select,&mut ui,&mut input,&mut text,event)?;}
+    let id=stable_id("hint-search");let index=ui.find("hint-search").expect("search");
+    assert_eq!(input.focused(),Some(id));assert_eq!(select.query(),"");
+    assert_eq!(ui.nodes[index].placeholder.as_ref().expect("real hint").value,"Search…");
+    let muted=ui.sheet.color_token("--muted-foreground").expect("hint color");
+    let hint_glyphs=|ui:&Ui|ui.display.commands.iter().filter(|draw|matches!(draw,Draw::GlyphRun{node,color,..} if *node==id && *color==muted)).count();
+    assert!(hint_glyphs(&ui)>0);
+    assert!(ui.display.glyphs.iter().all(|glyph|glyph.id!=0),"bundled Search ellipsis has coverage");
+    let bounds=ui.nodes[index].rect;
+    assert_eq!(ui.hit_test(bounds.x+bounds.w*0.5,bounds.y+bounds.h*0.5),Some(index));
+    let value=|ui:&Ui|match &ui.widgets[&id] {crate::widgets::Widget::Input(input)=>input.value().to_owned(),_=>panic!("search input")};
+    assert_eq!(value(&ui),"");
+    let accessibility=crate::accessibility::accessibility(&ui,input.focused());
+    let accessible=accessibility.nodes.iter().find(|(node,_)|node.0==id).expect("accessible search");
+    assert_eq!(accessible.1.value(),Some(""),"hint is not accessibility data");
+    // Native preedit goes straight into Ui, without changing Select::query or
+    // requiring the host to regenerate markup.
+    let mut router=Router::default();
+    router.preedit(&mut ui,&mut input,TextSource::Sdl,"pré",0,3,&mut Clip)?;
+    ui.frame(&mut text)?;
+    assert_eq!(select.query(),"");assert_eq!(value(&ui),"");assert_eq!(hint_glyphs(&ui),0);
+    router.preedit(&mut ui,&mut input,TextSource::Sdl,"",0,0,&mut Clip)?;
+    ui.frame(&mut text)?;assert!(hint_glyphs(&ui)>0);
+    route(&mut select,&mut ui,&mut input,&mut text,InputEvent::Edit(EditEvent::Insert("not present".into())))?;
+    assert_eq!(value(&ui),"not present");assert_eq!(hint_glyphs(&ui),0);
+    assert!(ui.find("hint-popover-empty").is_some());assert_eq!(select.selected(),Some(&0));
+    select.key(&mut ui,&mut input,Key::Escape)?;
+    mount(&mut select,&mut ui,&mut input,&mut text)?;
+    select.key(&mut ui,&mut input,Key::Enter)?;
+    mount(&mut select,&mut ui,&mut input,&mut text)?;
+    assert_eq!(value(&ui),"");assert!(hint_glyphs(&ui)>0);
+    Ok(())
+}
