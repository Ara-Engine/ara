+#[test]
+fn placeholder_only_changes_repaint_without_layout_and_theme_switches_reuse_its_shaping()->Result<()> {
+    use crate::theme::EditorTheme;
+    let mut text=TextSystem::bundled()?;
+    let mut ui=Ui::editor("<ui id='root'><field id='field' placeholder='Search…' /></ui>",EDITOR_CSS,[300.,100.])?;
+    ui.frame(&mut text)?;
+    let index=ui.find("field").expect("empty field");let rect=ui.nodes[index].rect;
+    for theme in [EditorTheme::Light,EditorTheme::Dark] {
+        ui.switch_theme(theme)?;let work=ui.frame(&mut text)?;
+        assert_eq!((work.layout_passes,work.shaped),(0,0));assert_eq!(ui.nodes[index].rect,rect);
+        let idle=ui.frame(&mut text)?;assert_eq!((idle.layout_passes,idle.shaped,idle.paint_nodes),(0,0,0));
+    }
+    ui.reconcile("<ui id='root'><field id='field' placeholder='Filtrer les versions…' /></ui>")?;
+    let work=ui.frame(&mut text)?;assert_eq!(work.layout_passes,0);assert_eq!(work.shaped,1);
+    assert_eq!(ui.nodes[index].rect,rect);
+    let mut input=InputState::default();input.push(&mut ui,stable_id("root"),Some(stable_id("field")),false)?;
+    input.event(&mut ui,InputEvent::Edit(EditEvent::Insert("actual value".into())),&mut Clip)?;
+    ui.frame(&mut text)?;
+    assert!(matches!(&ui.widgets[&stable_id("field")],crate::widgets::Widget::Input(input) if input.value()=="actual value"));
+    Ok(())
+}
