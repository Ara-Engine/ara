+fn closed_select_has_native_chevron_reserved_caption_space_and_enabled_hover_focus_disabled_states()->Result<()> {
+    use crate::{cursor::Cursor,paint::Draw,theme::EditorTheme};
+    for theme in [EditorTheme::Dark,EditorTheme::Light] {
+        let(mut ui,mut input,mut text)=surface()?;ui.switch_theme(theme)?;
+        let mut select=Select::new("affordance","Engine version",vec![SelectOption::new(0,"Preview 4 — إصدار المعاينة")],Some(0));
+        mount(&mut select,&mut ui,&mut input,&mut text)?;
+        let index=ui.find(select.control_id()).expect("native select");
+        let rect=ui.nodes[index].rect;
+        let point=[rect.x+rect.w*0.5,rect.y+rect.h*0.5];
+        assert_eq!(ui.cursor(&input,point),Cursor::Pointer);
+        assert_eq!(ui.nodes[index].computed.color,ui.sheet.color_token("--foreground").expect("foreground"));
+        assert_eq!(ui.nodes[index].computed.background,ui.sheet.color_token("--background").expect("enabled field fill"));
+        let id=stable_id(select.control_id());
+        let lines:Vec<_>=ui.display.commands.iter().filter_map(|draw|if let Draw::Line{node,from,to,color,..}=draw {(*node==id).then_some((from,to,color))}else{None}).collect();
+        assert_eq!(lines.len(),2,"chevron does not depend on font glyph coverage");
+        assert!(lines[0].0[1]<lines[0].1[1],"closed chevron points down");
+        let layout=ui.tree.layout(ui.nodes[index].layout_id)?;
+        let caption=ui.nodes[index].text.as_ref().expect("selected caption");
+        let text_right=rect.x+layout.padding.left+layout.border.left+caption.layout.width();
+        assert!(text_right<=rect.x+rect.w-layout.padding.right-layout.border.right+0.5);
+        assert!(lines[0].0[0]>rect.x+rect.w-layout.padding.right,"arrow is outside the caption area");
+        route(&mut select,&mut ui,&mut input,&mut text,InputEvent::PointerMove(point))?;
+        assert_eq!(ui.nodes[index].computed.background,ui.sheet.color_token("--hover-surface").expect("hover"));
+        input.focus(&mut ui,id)?;ui.frame(&mut text)?;
+        assert_eq!(ui.nodes[index].computed.border_color,ui.sheet.color_token("--ring").expect("focus ring"));
+        let mut unavailable=SelectOption::new(0,"Engine not installed");unavailable.disabled=Some("Install the engine first".into());
+        select.set_options(vec![unavailable]);mount(&mut select,&mut ui,&mut input,&mut text)?;
+        assert!(ui.nodes[index].state.disabled);
+        assert_eq!(ui.nodes[index].computed.color,ui.sheet.color_token("--muted-foreground").expect("disabled text"));
+        let rect=ui.nodes[index].rect;let point=[rect.x+rect.w*0.5,rect.y+rect.h*0.5];
+        assert_eq!(ui.cursor(&input,point),Cursor::NotAllowed);
+        for event in [InputEvent::PointerDown(point),InputEvent::PointerUp(point)] {route(&mut select,&mut ui,&mut input,&mut text,event)?;}
+        assert!(!select.is_open());assert_eq!(select.take_changed(),None);
+        let idle=ui.frame(&mut text)?;assert_eq!((idle.layout_passes,idle.shaped,idle.paint_nodes),(0,0,0));
+    }
+    Ok(())
+}
