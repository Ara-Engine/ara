+    let report = typed.report();
+    assert_eq!(report["typedCommandCatalogReady"], true);
+    assert!(
+        !report["typedCommandCatalogErrors"]
+            .as_array()
+            .unwrap()
+            .is_empty()
+    );
+    assert_eq!(report["typedCommandCoverageComplete"], false);
+    assert_eq!(editor.host.store().revision(), revision);
+}
