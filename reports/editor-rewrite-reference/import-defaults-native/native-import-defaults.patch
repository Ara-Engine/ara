+//! Sources and typed sidecar ops are prepared before Host/file watching starts.
+use super::*;
+use crate::app::Options;
+
+pub(in crate::app) fn prepare(options: &Options) -> ara_ui::Result<()> {
+    let root = &options.project;
+    if !root.join(".ara-behaviour-fixture").is_file() {
+        return Err(
+            "Refusing import-defaults fixture writes outside the private behaviour project".into(),
+        );
+    }
+    let folder = root.join(ara_doc::AUTHORING_ROOT).join(FOLDER);
+    std::fs::create_dir(&folder)?;
+    let registry = ara_importers::registry()?;
+    let importer = registry.get("ara.texture")?;
+    let mut schema = ara_schema::SchemaDb::new();
+    ara_asset::register_schema(&mut schema);
+    importer.register_settings(&mut schema);
+    for (index, settings) in [
+        json!({"usage":"color","mipmaps":true,"maxDimension":512}),
+        json!({"usage":"normal","mipmaps":false,"maxDimension":2048}),
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let _: ara_asset::TextureSettings = serde_json::from_value(settings.clone())?;
+        let id: ara_doc::AssetId = DOCS[index].parse()?;
+        let sidecar = ara_asset::Sidecar::empty(id.clone());
+        let mut document = sidecar.into_document();
+        // The fixture uses the same typed Edit -> Op path as authoring; no JSON sidecar patching.
+        let edit = ara_asset::SidecarCommand::InitializeInherited(ara_asset::ImportSettings {
+            importer: "ara.texture".into(),
+            version: importer.version().into(),
+            settings,
+            ..Default::default()
+        })
+        .edit(id)?;
+        let _created = document.apply(edit, &schema)?;
+        let source = root.join(ara_doc::AUTHORING_ROOT).join(SOURCES[index]);
+        std::fs::write(
+            &source,
+            include_bytes!("../../../../../assets/brand/icons/engine/ara-engine-64.png"),
+        )?;
+        std::fs::write(
+            source.with_extension("png.import.json"),
+            ara_doc::write(&document, &schema),
+        )?;
+    }
+    let policy = ara_asset::ProjectImportSettings {
+        preset: ara_asset::CookPreset::Fast,
+        defaults: Default::default(),
+    };
+    let policy_path = root.join(ara_asset::PROJECT_IMPORT_SETTINGS_FILE);
+    std::fs::create_dir_all(
+        policy_path
+            .parent()
+            .ok_or("Import settings path has no parent")?,
+    )?;
+    std::fs::write(policy_path, policy.canonical_text()?)?;
+    Ok(())
+}
diff --git a/crates/ara-editor/src/app/import_defaults_verify/input.rs b/crates/ara-editor/src/app/import_defaults_verify/input.rs
