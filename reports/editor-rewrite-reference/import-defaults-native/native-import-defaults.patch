+++ b/crates/ara-editor/src/app/import_defaults_verify.rs
@@ -0,0 +1,186 @@
+//! Native SDL proof for mixed source edits and scoped project importer defaults.
+use super::input_verify::native;
+use crate::{Editor, gpu::NativeUi, shell::Shell};
+use ara_platform::{Event, Window};
+use serde_json::{Value, json};
+use std::{
+    path::{Path, PathBuf},
+    time::{Duration, Instant},
+};
+mod cleanup;
+mod fixture;
+mod input;
+mod proof;
+mod steps;
+pub(super) use fixture::prepare;
+const FOLDER: &str = "P4 Import Defaults";
+const SOURCES: [&str; 2] = ["P4 Import Defaults/A.png", "P4 Import Defaults/B.png"];
+const DOCS: [&str; 2] = ["as_nativeimporta", "as_nativeimportb"];
+const EXPECTED: usize = 5;
+
+#[derive(Default)]
+struct Clip(String);
+impl ara_ui_text::Clipboard for Clip {
+    fn read(&mut self) -> ara_ui_text::Result<String> {
+        Ok(self.0.clone())
+    }
+    fn write(&mut self, value: &str) -> ara_ui_text::Result<()> {
+        self.0 = value.into();
+        Ok(())
+    }
+}
+struct Initial {
+    folder: String,
+    query: String,
+    scope: bool,
+    grid: bool,
+    asset: Option<String>,
+    maximized: Option<String>,
+    focus: String,
+    camera: crate::state::Camera,
+    doc: String,
+    selection: Vec<String>,
+    source: Value,
+    policy: Value,
+}
+
+/// Drives only a private behaviour fixture; authoring cleanup remains typed.
+pub(super) struct ImportDefaultsCheck {
+    output: PathBuf,
+    phase: u32,
+    started: Option<Instant>,
+    finished: bool,
+    restored: bool,
+    initial: Option<Initial>,
+    base: u64,
+    edit_txn: Option<String>,
+    undo_txn: Option<String>,
+    checkpoint_policy: Value,
+    passed: Vec<&'static str>,
+    trace: Vec<Value>,
+    error: Option<String>,
+    pending_capture: Option<&'static str>,
+    native_events: usize,
+    pointer: Option<[f32; 2]>,
+    clipboard: Clip,
+}
+impl ImportDefaultsCheck {
+    pub fn new(editor: &Editor, output: &Path) -> ara_ui::Result<Self> {
+        if !editor.host.root().join(".ara-behaviour-fixture").is_file() {
+            return Err("Import-defaults proof requires the isolated behaviour fixture".into());
+        }
+        Ok(Self {
+            output: output.into(),
+            phase: 0,
+            started: None,
+            finished: false,
+            restored: false,
+            initial: None,
+            base: 0,
+            edit_txn: None,
+            undo_txn: None,
+            checkpoint_policy: Value::Null,
+            passed: Vec::new(),
+            trace: Vec::new(),
+            error: None,
+            pending_capture: None,
+            native_events: 0,
+            pointer: None,
+            clipboard: Clip::default(),
+        })
+    }
+    pub fn finished(&self) -> bool {
+        self.finished
+    }
+    pub fn clipboard(&mut self) -> &mut dyn ara_ui_text::Clipboard {
+        &mut self.clipboard
+    }
+    pub fn validate(&self) -> ara_ui::Result<()> {
+        if !self.finished || !self.restored || self.error.is_some() || self.passed.len() != EXPECTED
+        {
+            return Err(format!("Native import-defaults proof incomplete: phase={}, restored={}, passed={}/{EXPECTED}, error={:?}", self.phase,self.restored,self.passed.len(),self.error).into());
+        }
+        Ok(())
+    }
+    pub fn inject(
+        &mut self,
+        editor: &mut Editor,
+        shell: &mut Shell,
+        window: &Window,
+        scale: f32,
+        events: &mut Vec<(u32, Event)>,
+    ) -> ara_ui::Result<()> {
+        if self.finished {
+            return Ok(());
+        }
+        if let Some(pointer) = self.pointer {
+            shell.desktop_pointer = Some(pointer);
+        }
+        if self.pending_capture.is_some() {
+            return Ok(());
+        }
+        if self.error.is_some() || self.phase == 29 {
+            native::focus_lost(window, events)?;
+            if let Err(error) = self.restore(editor, shell) {
+                self.error = Some(format!(
+                    "{}; cleanup: {error}",
+                    self.error
+                        .as_deref()
+                        .unwrap_or("Import-defaults cleanup failed")
+                ));
+            }
+            self.finished = true;
+            return self.write();
+        }
+        let before = events.len();
+        let result = (|| {
+            if !scale.is_finite() || scale <= 0. {
+                return Err("Invalid native import-defaults scale".into());
+            }
+            if self
+                .started
+                .is_some_and(|start| start.elapsed() >= Duration::from_secs(120))
+            {
+                return Err(format!(
+                    "Native import-defaults proof timed out at phase {}",
+                    self.phase
+                )
+                .into());
+            }
+            self.step(editor, shell, window, scale, events)
+        })();
+        self.native_events += events.len().saturating_sub(before);
+        if let Err(error) = result {
+            events.truncate(before);
+            native::tap(window, 41, events)?;
+            self.error = Some(error.to_string());
+            self.mark("failure", editor, shell, json!({"error":self.error}));
+        }
+        Ok(())
+    }
+    pub fn end(
+        &mut self,
+        editor: &Editor,
+        shell: &mut Shell,
+        gpu: &mut NativeUi,
+    ) -> ara_ui::Result<()> {
+        if let Some(stage) = self.pending_capture.take() {
+            self.capture(stage, editor, shell, gpu)?;
+            self.write()?;
+        }
+        Ok(())
+    }
+    pub fn write(&self) -> ara_ui::Result<()> {
+        std::fs::create_dir_all(&self.output)?;
+        std::fs::write(
+            self.output.join("import-defaults.json"),
+            ara_json::to_canonical_string(&json!({
+                "completed":self.finished,"restored":self.restored,"expected":EXPECTED,"passed":self.passed.len(),
+                "journeys":self.passed,"phase":self.phase,"nativeEvents":self.native_events,"error":self.error,
+                "elapsedSeconds":self.started.map(|start|start.elapsed().as_secs_f64()),"trace":self.trace,
+                "scope":"Hidden window, real SDL pointer/key injection, mounted Assets selection and shared Inspector controls. Setup/cleanup navigation and cleanup authoring use typed commands; all measured authoring gestures use production UI. No post-open filesystem mutation. No timing acceptance claim."
+            })),
+        )?;
+        Ok(())
+    }
+}
