+    pub(crate) fn settle_content_feedback(
+        &mut self,
+        editor: &mut Editor,
+    ) -> ara_ui::Result<ara_ui::Work> {
+        match self.refresh_content_drag_feedback(editor) {
+            Ok(false) => Ok(ara_ui::Work::default()),
+            Ok(true) => self.frame(),
+            Err(error) => {
+                editor.report_failure(&*error);
+                self.frame()
+            }
+        }
+    }
