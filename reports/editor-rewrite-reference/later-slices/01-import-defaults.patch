+++ b/crates/ara-editor/src/shell/import_batch/defaults.rs
@@ -0,0 +1,113 @@
+//! Project scope uses the same reflected fields as per-source importers.
+use super::*;
+impl Shell {
+    pub(crate) fn import_defaults_open(&self) -> bool {
+        self.import_batch.defaults_open
+    }
+    pub(crate) fn import_defaults(&mut self, editor: &mut Editor) -> ara_ui::Result<()> {
+        self.commit_import_fields(editor)?;
+        self.import_batch.defaults_open = true;
+        if self.import_batch.default_type.is_empty() {
+            self.import_batch.default_type = "ara.texture".into();
+        }
+        self.menu = None;
+        editor.action("editor.palette", json!({"open":false}))?;
+        editor.action("editor.layout.show", json!({"panel":"inspector"}))?;
+        editor.action("editor.focus", json!({"panel":"inspector"}))?;
+        self.rebuild(editor)
+    }
+    pub(crate) fn close_import_defaults(&mut self, editor: &mut Editor) -> ara_ui::Result<()> {
+        self.commit_import_fields(editor)?;
+        self.import_batch.defaults_open = false;
+        self.rebuild(editor)
+    }
+    pub(crate) fn reset_import_defaults(
+        &mut self,
+        editor: &mut Editor,
+        target: &crate::shell::commands::Target,
+    ) -> ara_ui::Result<()> {
+        let importer = match target {
+            crate::shell::commands::Target::Text(value) => value.as_str(),
+            _ => self.import_batch.default_type.as_str(),
+        };
+        let importer = format!("ara.{}", commands::type_key(importer)?);
+        let prefix = format!("@import-batch|@default:{importer}|");
+        self.drafts.retain(|key, _| !key.starts_with(&prefix));
+        commands::apply(
+            editor,
+            vec![Change::Reset(importer)],
+            "Reset importer type defaults",
+        )?;
+        self.rebuild(editor)
+    }
+    pub(crate) fn import_defaults_panel(
+        &mut self,
+        editor: &Editor,
+        out: &mut String,
+    ) -> ara_ui::Result<()> {
+        let importer = self.import_batch.default_type.clone();
+        settings(&importer)?;
+        let policy = commands::policy(editor)?;
+        out.push_str("<scroll id='import-defaults-inspector' style='flex-grow:1;flex-basis:0px;min-height:0px;padding:8px;gap:8px'><text id='import-defaults-title' class='heading' text='Project import defaults' /><text id='import-defaults-scope' class='caption' style='white-space:normal' text='Explicit source fields take priority, then these typed defaults, then built-in importer values. Existing sources which inherit changed fields are reimported; each completed edit has one Undo.' />");
+        self.choice_button(
+            "import-defaults-type",
+            "Importer type",
+            choices::Select {
+                destination: choices::Destination::ImportGroup,
+                current: json!(importer),
+                options: ["ara.texture", "ara.gltf", "ara.fbx", "ara.audio"]
+                    .into_iter()
+                    .map(|value| (json!(value), view::label(value).into()))
+                    .collect(),
+            },
+            out,
+        );
+        self.choice_button(
+            "import-defaults-quality",
+            "Global texture quality",
+            choices::Select {
+                destination: choices::Destination::ImportBatch {
+                    group: "@project".into(),
+                    key: "$preset".into(),
+                },
+                current: json!(policy.preset),
+                options: vec![
+                    (json!("fast"), "Fast".into()),
+                    (json!("balanced"), "Balanced".into()),
+                    (json!("highQuality"), "High quality".into()),
+                ],
+            },
+            out,
+        );
+        self.import_fields(
+            editor,
+            &format!("@default:{importer}"),
+            &Group {
+                importer: importer.clone(),
+                sources: Vec::new(),
+                project: true,
+            },
+            out,
+        )?;
+        out.push_str(&self.bind_button(
+            "import-defaults-reset",
+            "Reset this type to built-in defaults",
+            Binding::Command(
+                "assets.import_defaults.reset",
+                crate::shell::commands::Target::Text(importer),
+            ),
+            "quiet",
+        ));
+        out.push_str(&self.bind_button(
+            "import-defaults-close",
+            "Back to selection",
+            Binding::Command(
+                "assets.import_defaults.close",
+                crate::shell::commands::Target::None,
+            ),
+            "quiet",
+        ));
+        out.push_str("</scroll>");
+        Ok(())
+    }
+}
diff --git a/crates/ara-editor/src/shell/import_batch/tests.rs b/crates/ara-editor/src/shell/import_batch/tests.rs
new file mode 100644
--- /dev/null
+++ b/crates/ara-editor/src/shell/import_batch/tests.rs
@@ -0,0 +1,294 @@
+//! Real authority tests: cross-document atomicity and latest independent overrides.
+#![allow(clippy::unwrap_used)]
+use super::*;
+use std::{
+    path::PathBuf,
+    sync::atomic::{AtomicU64, Ordering},
+};
+
+struct Project(PathBuf);
+impl Project {
+    fn new() -> Self {
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        let root = std::path::absolute(crate::test_target())
+            .unwrap()
+            .join("import-batch")
+            .join(format!(
+                "{}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed)
+            ));
+        std::fs::create_dir_all(root.join(ara_doc::AUTHORING_ROOT)).unwrap();
+        std::fs::write(root.join("ara.project.json"),ara_json::to_canonical_string(&json!({"layoutVersion":ara_doc::PROJECT_LAYOUT_VERSION,"name":"Import batch","main":"main.scene"}))).unwrap();
+        std::fs::write(
+            root.join(ara_doc::AUTHORING_ROOT).join("main.scene"),
+            ara_json::to_canonical_string(
+                &json!({"$schema":"ara://schema/scene/1","id":"sc_importbatch","records":{}}),
+            ),
+        )
+        .unwrap();
+        Self(root)
+    }
+    fn open(&self) -> Editor {
+        let mut editor =
+            Editor::open_with(&self.0, Some(self.0.join(".ara/test-user.json"))).unwrap();
+        editor.apply(vec![
+            json!({"cmd":"import.initialize","args":{"source":"a.png","id":"as_batcha","settings":{"maxDimension":512,"mipmaps":true}}}),
+            json!({"cmd":"import.initialize","args":{"source":"b.png","id":"as_batchb","settings":{"maxDimension":2048,"mipmaps":false}}}),
+            json!({"cmd":"import.initialize","args":{"source":"other.wav","id":"as_batchc","settings":{"opusBitrate":128000}}}),
+        ],"Create typed import batch fixture",None).unwrap();
+        editor
+    }
+}
+impl Drop for Project {
+    fn drop(&mut self) {
+        assert!(
+            self.0
+                .starts_with(std::path::absolute(crate::test_target()).unwrap())
+        );
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+fn records(editor: &Editor) -> Value {
+    let workspace = editor.host.store().workspace();
+    json!([
+        workspace.doc("as_batcha").unwrap().records(),
+        workspace.doc("as_batchb").unwrap().records(),
+        workspace.doc("as_batchc").unwrap().records()
+    ])
+}
+fn setting(doc: &str, field: &str, value: Value) -> Change {
+    Change::Setting {
+        doc: doc.into(),
+        field: field.into(),
+        value,
+    }
+}
+
+#[test]
+fn independent_mixed_sources_commit_one_transaction_and_one_undo_redo() {
+    let project = Project::new();
+    let mut editor = project.open();
+    let before = records(&editor);
+    let revision = editor.host.store().revision();
+    commands::apply(
+        &mut editor,
+        vec![
+            setting("as_batcha", "flipNormalY", json!(true)),
+            setting("as_batchb", "flipNormalY", json!(true)),
+        ],
+        "Batch flip normals",
+    )
+    .unwrap();
+    let after = records(&editor);
+    assert_eq!(editor.host.store().revision(), revision + 1);
+    assert_eq!(after[0]["i_settings"]["settings"]["maxDimension"], 512);
+    assert_eq!(after[1]["i_settings"]["settings"]["maxDimension"], 2048);
+    assert_eq!(after[0]["i_settings"]["settings"]["mipmaps"], true);
+    assert_eq!(after[1]["i_settings"]["settings"]["mipmaps"], false);
+    assert_eq!(after[2], before[2], "incompatible audio type untouched");
+    editor.action("history.undo", json!({})).unwrap();
+    assert_eq!(records(&editor), before);
+    editor.action("history.redo", json!({})).unwrap();
+    assert_eq!(records(&editor), after);
+}
+
+#[test]
+fn latest_other_field_change_is_preserved_and_invalid_member_rolls_back_every_source() {
+    let project = Project::new();
+    let mut editor = project.open();
+    editor.apply(vec![json!({"cmd":"import.configure","args":{"source":"b.png","settings":{"maxDimension":4096,"mipmaps":false}}})],
+        "Concurrent independent import setting",None).unwrap();
+    commands::apply(
+        &mut editor,
+        vec![
+            setting("as_batcha", "flipNormalY", json!(true)),
+            setting("as_batchb", "flipNormalY", json!(true)),
+        ],
+        "Batch after independent change",
+    )
+    .unwrap();
+    assert_eq!(
+        records(&editor)[1]["i_settings"]["settings"]["maxDimension"],
+        4096
+    );
+    let before = records(&editor);
+    let revision = editor.host.store().revision();
+    assert!(
+        commands::apply(
+            &mut editor,
+            vec![
+                setting("as_batcha", "mipmaps", json!(false)),
+                setting("as_batchb", "maxDimension", json!(0))
+            ],
+            "Reject complete batch"
+        )
+        .is_err()
+    );
+    assert_eq!(records(&editor), before);
+    assert_eq!(editor.host.store().revision(), revision);
+}
+
+#[test]
+fn deleted_sidecar_rejects_batch_and_preset_inheritance_is_one_atomic_edit() {
+    let project = Project::new();
+    let mut editor = project.open();
+    let before = records(&editor);
+    commands::apply(
+        &mut editor,
+        vec![
+            Change::Preset {
+                doc: "as_batcha".into(),
+                preset: Some(ara_asset::CookPreset::Fast),
+            },
+            Change::Preset {
+                doc: "as_batchb".into(),
+                preset: Some(ara_asset::CookPreset::Fast),
+            },
+        ],
+        "Batch quality",
+    )
+    .unwrap();
+    editor.action("history.undo", json!({})).unwrap();
+    assert_eq!(records(&editor), before);
+    let revision = editor.host.store().revision();
+    assert!(
+        commands::apply(
+            &mut editor,
+            vec![
+                setting("as_batcha", "mipmaps", json!(false)),
+                setting("as_missing", "mipmaps", json!(false))
+            ],
+            "Reject deleted reference"
+        )
+        .is_err()
+    );
+    assert_eq!(records(&editor), before);
+    assert_eq!(editor.host.store().revision(), revision);
+}
+
+struct Clip;
+impl ara_ui_text::Clipboard for Clip {
+    fn read(&mut self) -> ara_ui_text::Result<String> {
+        Ok(String::new())
+    }
+    fn write(&mut self, _: &str) -> ara_ui_text::Result<()> {
+        Ok(())
+    }
+}
+fn click(shell: &mut Shell, editor: &mut Editor, id: &str) {
+    let node = &shell.ui.nodes[shell.shown_node(id).unwrap()];
+    let rect = node.rect.intersection(node.clip);
+    assert!(
+        rect.w > 1. && rect.h >= node.rect.h * 0.75,
+        "{id}: {:?}, clip {:?}",
+        node.rect,
+        node.clip
+    );
+    let point = [rect.x + rect.w * 0.5, rect.y + rect.h * 0.5];
+    shell
+        .event(ara_ui::input::InputEvent::PointerDown(point), &mut Clip)
+        .unwrap();
+    shell
+        .event(ara_ui::input::InputEvent::PointerUp(point), &mut Clip)
+        .unwrap();
+    shell.dispatch(editor).unwrap();
+    shell.frame().unwrap();
+}
+#[test]
+fn mounted_multi_selection_type_select_and_mixed_toggle_use_the_real_input_path() {
+    let project = Project::new();
+    let mut editor = project.open();
+    let mut shell = Shell::new(&mut editor, [1200., 900.]).unwrap();
+    shell.offscreen = true;
+    let (browser, mut publication) = assets::scan_fixture::controlled(ara_doc::AUTHORING_ROOT);
+    shell.browser = browser;
+    let items = [("a.png", "png"), ("b.png", "png"), ("other.wav", "wav")]
+        .into_iter()
+        .map(|(logical, kind)| {
+            let mut asset = assets::Asset::unindexed(
+                format!("{}/{logical}", ara_doc::AUTHORING_ROOT),
+                kind.into(),
+            );
+            asset.authored_path = Some(logical.into());
+            asset
+        })
+        .collect::<Vec<_>>();
+    let keys = items
+        .iter()
+        .map(|asset| ara_ui::source::stable_id(&asset.path))
+        .collect::<Vec<_>>();
+    let primary = items[0].path.clone();
+    let generation = publication.start();
+    publication.publish(generation, items).unwrap();
+    assert!(shell.poll_assets());
+    editor
+        .action(
+            "editor.workspace",
+            json!({"asset":primary,"folder":ara_doc::AUTHORING_ROOT,"grid":false}),
+        )
+        .unwrap();
+    shell.asset_selection.set_selected(keys);
+    shell.asset_selection_path = editor.state.asset_path.clone();
+    shell.rebuild(&mut editor).unwrap();
+    shell.frame().unwrap();
+    click(&mut shell, &mut editor, "import-batch-type");
+    shell.key(&mut editor, 77, true, &mut Clip).unwrap();
+    shell.key(&mut editor, 40, true, &mut Clip).unwrap();
+    shell.frame().unwrap();
+    assert_eq!(shell.import_batch.filter.as_deref(), Some("ara.texture"));
+    assert!(shell.shown_node("import-batch-mipmaps-mixed").is_some());
+    let before = records(&editor);
+    let revision = editor.host.store().revision();
+    click(&mut shell, &mut editor, "import-batch-mipmaps");
+    let after = records(&editor);
+    assert_eq!(editor.host.store().revision(), revision + 1);
+    assert_eq!(after[0]["i_settings"]["settings"]["mipmaps"], true);
+    assert_eq!(after[1]["i_settings"]["settings"]["mipmaps"], true);
+    assert_eq!(after[0]["i_settings"]["settings"]["maxDimension"], 512);
+    assert_eq!(after[1]["i_settings"]["settings"]["maxDimension"], 2048);
+    assert_eq!(after[2], before[2]);
+    editor.action("history.undo", json!({})).unwrap();
+    assert_eq!(records(&editor), before);
+}
+
+#[test]
+fn schema_driven_project_fields_update_one_type_and_reset_is_one_undo() {
+    let project = Project::new();
+    let mut editor = project.open();
+    let mut shell = Shell::new(&mut editor, [1200., 900.]).unwrap();
+    shell.offscreen = true;
+    shell.import_defaults(&mut editor).unwrap();
+    shell.frame().unwrap();
+    assert!(shell.shown_node("import-defaults-inspector").is_some());
+    shell
+        .import_batch_value(
+            &mut editor,
+            "@default:ara.audio",
+            "opusBitrate",
+            json!(96000),
+        )
+        .unwrap();
+    let policy = commands::policy(&editor).unwrap();
+    assert_eq!(policy.defaults.audio.unwrap().opus_bitrate, 96000);
+    assert!(policy.defaults.texture.is_none());
+    let revision = editor.host.store().revision();
+    shell
+        .reset_import_defaults(
+            &mut editor,
+            &crate::shell::commands::Target::Text("audio".into()),
+        )
+        .unwrap();
+    assert_eq!(editor.host.store().revision(), revision + 1);
+    assert!(commands::policy(&editor).unwrap().defaults.audio.is_none());
+    editor.action("history.undo", json!({})).unwrap();
+    assert_eq!(
+        commands::policy(&editor)
+            .unwrap()
+            .defaults
+            .audio
+            .unwrap()
+            .opus_bitrate,
+        96000
+    );
+}
diff --git a/crates/ara-editor/src/shell/import_batch/view.rs b/crates/ara-editor/src/shell/import_batch/view.rs
new file mode 100644
--- /dev/null
+++ b/crates/ara-editor/src/shell/import_batch/view.rs
@@ -0,0 +1,317 @@
+//! Type-filtered multi-edit without taking values from a representative source.
+use super::*;
+
+impl Shell {
+    pub(super) fn multi_import_panel(
+        &mut self,
+        editor: &Editor,
+        out: &mut String,
+    ) -> ara_ui::Result<bool> {
+        let selected = self.asset_selection.selected();
+        let primary = editor.state.asset_path.as_deref();
+        if selected.len() < 2
+            || primary.is_none_or(|path| !selected.contains(&ara_ui::source::stable_id(path)))
+        {
+            return Ok(false);
+        }
+        let workspace = editor.host.store().workspace();
+        let mut groups = BTreeMap::<String, Group>::new();
+        let mut skipped = 0;
+        for asset in &self.browser.items {
+            if !selected.contains(&ara_ui::source::stable_id(&asset.path)) {
+                continue;
+            }
+            let Some(source) = asset.authored_path.as_deref() else {
+                skipped += 1;
+                continue;
+            };
+            let Some(doc) = crate::asset_tools::paths::import_document(workspace, source) else {
+                skipped += 1;
+                continue;
+            };
+            let Some(record) = doc.record("i_settings") else {
+                skipped += 1;
+                continue;
+            };
+            let importer = record
+                .get("importer")
+                .and_then(Value::as_str)
+                .ok_or("A selected import has no importer identity")?;
+            if settings(importer).is_err() {
+                skipped += 1;
+                continue;
+            }
+            groups
+                .entry(importer.into())
+                .or_insert_with(|| Group {
+                    importer: importer.into(),
+                    sources: Vec::new(),
+                    project: false,
+                })
+                .sources
+                .push(Source {
+                    doc: doc.id.to_string(),
+                    source: source.into(),
+                });
+        }
+        let mut captured = BTreeMap::new();
+        for (_, mut group) in groups {
+            group.sources.sort_by(|a, b| a.doc.cmp(&b.doc));
+            let signature = group
+                .sources
+                .iter()
+                .map(|source| format!("{}:{}", source.doc, source.source))
+                .collect::<Vec<_>>()
+                .join("|");
+            let token = format!(
+                "{}-{:x}",
+                group.importer,
+                ara_ui::source::stable_id(&signature)
+            );
+            captured.insert(token, group);
+        }
+        self.import_batch.groups = captured;
+        if self.import_batch.filter.as_ref().is_none_or(|filter| {
+            !self
+                .import_batch
+                .groups
+                .values()
+                .any(|group| &group.importer == filter)
+        }) {
+            self.import_batch.filter = self
+                .import_batch
+                .groups
+                .values()
+                .next()
+                .map(|group| group.importer.clone());
+        }
+        out.push_str("<scroll id='import-inspector' style='flex-grow:1;flex-basis:0px;min-height:0px;padding:8px;gap:8px'>");
+        out.push_str(&format!("<text id='import-batch-title' class='heading' text='{} selected sources' /><text id='import-batch-scope' class='caption' style='white-space:normal' text='Edit one compatible importer type at a time. Changes apply to every source in that type in one undoable transaction. {skipped} selected files have no editable import sidecar.' />",selected.len()));
+        if self.import_batch.groups.is_empty() {
+            out.push_str("<text id='import-batch-empty' class='caption' style='white-space:normal' text='Import the selected source files first, then edit their shared settings.' /></scroll>");
+            return Ok(true);
+        }
+        let options = self
+            .import_batch
+            .groups
+            .values()
+            .map(|group| {
+                (
+                    json!(group.importer),
+                    format!(
+                        "{} ({} sources)",
+                        label(&group.importer),
+                        group.sources.len()
+                    ),
+                )
+            })
+            .collect();
+        self.choice_button(
+            "import-batch-type",
+            "Compatible importer",
+            choices::Select {
+                destination: choices::Destination::ImportGroup,
+                current: json!(self.import_batch.filter),
+                options,
+            },
+            out,
+        );
+        let (token, group) = self
+            .import_batch
+            .groups
+            .iter()
+            .find(|(_, group)| Some(&group.importer) == self.import_batch.filter.as_ref())
+            .map(|(token, group)| (token.clone(), group.clone()))
+            .ok_or("Compatible import group disappeared")?;
+        out.push_str(&format!("<text id='import-batch-targets' class='caption' style='white-space:normal' text='Editing {} {} sources; other selected types remain unchanged.' />",group.sources.len(),escape(label(&group.importer))));
+        self.import_fields(editor, &token, &group, out)?;
+        let presets = group
+            .sources
+            .iter()
+            .map(|source| {
+                workspace
+                    .doc(&source.doc)
+                    .and_then(|doc| doc.record("i_settings"))
+                    .and_then(|r| r.get("preset"))
+                    .cloned()
+                    .unwrap_or(Value::Null)
+            })
+            .collect::<Vec<_>>();
+        let preset = presets
+            .first()
+            .filter(|first| presets.iter().all(|value| value == *first))
+            .cloned()
+            .unwrap_or(json!("mixed"));
+        self.choice_button(
+            "import-batch-preset",
+            if preset == "mixed" {
+                "Quality (mixed)"
+            } else {
+                "Cook quality"
+            },
+            choices::Select {
+                destination: choices::Destination::ImportBatch {
+                    group: token,
+                    key: "$preset".into(),
+                },
+                current: preset,
+                options: vec![
+                    (Value::Null, "Use project/default quality".into()),
+                    (json!("fast"), "Fast".into()),
+                    (json!("balanced"), "Balanced".into()),
+                    (json!("highQuality"), "High quality".into()),
+                ],
+            },
+            out,
+        );
+        out.push_str(&self.bind_button(
+            "import-batch-defaults",
+            "Project texture quality…",
+            Binding::Command(
+                "assets.import_defaults",
+                super::super::commands::Target::None,
+            ),
+            "quiet",
+        ));
+        out.push_str("</scroll>");
+        Ok(true)
+    }
+    pub(super) fn import_fields(
+        &mut self,
+        editor: &Editor,
+        token: &str,
+        group: &Group,
+        out: &mut String,
+    ) -> ara_ui::Result<()> {
+        let workspace = editor.host.store().workspace();
+        let (mut defaults, schema) = settings(&group.importer)?;
+        let policy = commands::policy(editor)?;
+        let inherited = policy.effective_settings(&group.importer, &json!({}))?;
+        if let Some(inherited) = inherited.as_object() {
+            for (key, value) in inherited {
+                defaults[key] = value.clone();
+            }
+        }
+        let db = editor.host.store().schema();
+        let fields = db
+            .get(schema)
+            .ok_or("Installed importer schema unavailable")?
+            .fields();
+        let defaults = defaults
+            .as_object()
+            .ok_or("Importer defaults are not an object")?;
+        for (key, default) in defaults {
+            if group.importer == "ara.fbx" && key == "opacityMaps" {
+                continue;
+            }
+            let metadata = fields
+                .iter()
+                .find(|field| field.name == *key)
+                .ok_or("Shared importer field is not reflected")?;
+            let mut common = group.project.then_some(default);
+            let mut mixed = false;
+            for source in &group.sources {
+                let current = workspace
+                    .doc(&source.doc)
+                    .and_then(|doc| doc.record("i_settings"))
+                    .and_then(|record| record.get("settings"))
+                    .and_then(|settings| settings.get(key))
+                    .unwrap_or(default);
+                match common {
+                    None => common = Some(current),
+                    Some(old) if old != current => mixed = true,
+                    _ => {}
+                }
+            }
+            let value = if mixed {
+                Value::Null
+            } else {
+                common.cloned().unwrap_or_else(|| default.clone())
+            };
+            let id = format!("import-batch-{key}");
+            let name = super::super::inspector_panel::sentence(key);
+            let help = if mixed {
+                format!(
+                    "{} Mixed values across {} sources; editing sets all compatible sources.",
+                    metadata.doc,
+                    group.sources.len()
+                )
+            } else {
+                metadata.doc.clone()
+            };
+            out.push_str(&format!("<panel id='{id}-row' class='prop-row'><panel id='{id}-label-cell' class='prop-label' style='width:42%'><text id='{id}-label' text='{}' description='{}' /></panel><panel id='{id}-value' class='prop-value'>",escape(&name),escape(&help)));
+            self.bindings.insert(
+                ara_ui::source::stable_id(&id),
+                Binding::ImportBatchField(token.to_owned(), key.clone()),
+            );
+            match crate::inspector::widget(db, metadata) {
+                crate::inspector::Widget::Bool => {
+                    out.push_str(&format!("<toggle id='{id}' checked='{}' label='{}' description='{}' action='Dispatch' />",value.as_bool().unwrap_or(false),escape(&name),escape(&help)));
+                }
+                crate::inspector::Widget::Enum { options } => self.choice_button(
+                    &format!("{id}-options"),
+                    &if mixed {
+                        "Mixed values".into()
+                    } else {
+                        name.clone()
+                    },
+                    choices::Select {
+                        destination: choices::Destination::ImportBatch {
+                            group: token.to_owned(),
+                            key: key.clone(),
+                        },
+                        options: enum_values(
+                            options,
+                            matches!(&metadata.ty, ara_schema::ValueType::Option(_)),
+                        ),
+                        current: value,
+                    },
+                    out,
+                ),
+                widget => {
+                    let bounds = match widget {
+                        crate::inspector::Widget::Number { min, max, step, .. } => {
+                            let mut bounds = format!("class='number' step='{step}'");
+                            if let Some(min) = min {
+                                bounds.push_str(&format!(" min='{min}'"));
+                            }
+                            if let Some(max) = max {
+                                bounds.push_str(&format!(" max='{max}'"));
+                            }
+                            bounds
+                        }
+                        _ => String::new(),
+                    };
+                    let text = self
+                        .drafts
+                        .get(&format!("@import-batch|{token}|{key}"))
+                        .cloned()
+                        .unwrap_or_else(|| {
+                            if mixed {
+                                String::new()
+                            } else {
+                                panels::display(&value)
+                            }
+                        });
+                    out.push_str(&format!("<field id='{id}' {bounds} style='flex-grow:1;flex-basis:0px' text='{}' placeholder='{}' label='{}' description='{}' action='Dispatch' />",escape(&text),if mixed{"Mixed values"}else{""},escape(&name),escape(&help)));
+                }
+            }
+            if mixed {
+                out.push_str(&format!(
+                    "<text id='{id}-mixed' class='caption' text='Mixed' />"
+                ));
+            }
+            out.push_str("</panel></panel>");
+        }
+        Ok(())
+    }
+}
+pub(super) fn label(importer: &str) -> &str {
+    match importer {
+        "ara.texture" => "Texture",
+        "ara.gltf" => "glTF model",
+        "ara.fbx" => "FBX model",
+        "ara.audio" => "Audio",
+        _ => importer,
+    }
+}
