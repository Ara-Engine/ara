diff --git a/crates/ara-editor/src/shell/profiler_targets.rs b/crates/ara-editor/src/shell/profiler_targets.rs
new file mode 100644
--- /dev/null
+++ b/crates/ara-editor/src/shell/profiler_targets.rs
@@ -0,0 +1,338 @@
+//! Target identity and immutable player captures over a small private asynchronous port.
+use super::*;
+pub(crate) mod backend;
+mod controls;
+#[cfg(test)]
+mod tests;
+mod view;
+use backend::{Action, Backend, Outcome, Request, Row, Scope, Status, Ticket};
+use std::{
+    sync::Arc,
+    time::{Duration, Instant},
+};
+const POLL: Duration = Duration::from_millis(250);
+const LIVE_SNAPSHOT: Duration = Duration::from_secs(1);
+pub(super) const CSS: &str = ".profiler-targets { flex-shrink:0;min-width:0px;gap:4px;padding:6px; }.profiler-target-row { flex-direction:row;flex-wrap:wrap;min-width:0px;gap:6px; }.profiler-target-caption { white-space:normal;min-width:0px;flex-shrink:0;font-size:11px;color:var(--muted-foreground); }.profiler-actions { flex-wrap:wrap;height:auto;min-height:28px;flex-shrink:0;min-width:0px; }";
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+enum Target {
+    #[default]
+    Editor,
+    Player(Scope),
+}
+impl Target {
+    fn value(&self) -> Value {
+        match self {
+            Self::Editor => Value::Null,
+            Self::Player(scope) => json!(scope),
+        }
+    }
+    fn label(&self) -> String {
+        match self {
+            Self::Editor => "Editor".into(),
+            Self::Player(scope) => scope.label(),
+        }
+    }
+}
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Purpose {
+    Record,
+    Snapshot,
+    Freeze,
+    Baseline,
+}
+struct Pending {
+    ticket: Ticket,
+    target: Scope,
+    purpose: Purpose,
+    session: String,
+}
+struct Capture {
+    target: Target,
+    name: String,
+    profile: Arc<ara_profile::Profile>,
+    serial: u64,
+    frozen: bool,
+}
+
+/// Local reading state; target changes never retarget a pending ticket or capture.
+pub(crate) struct State {
+    selected: Target,
+    rows: Vec<Row>,
+    error: Option<String>,
+    refresh_error: Option<String>,
+    diagnostics: Vec<ara_diag::Diagnostic>,
+    pending: Option<Pending>,
+    current: Option<Capture>,
+    baseline: Option<Capture>,
+    frame: Option<u64>,
+    compare: bool,
+    follow: bool,
+    serial: u64,
+    next_poll: Option<Instant>,
+    next_snapshot: Option<Instant>,
+    transport: bool,
+    editor_job: Option<String>,
+    next_editor_poll: Option<Instant>,
+}
+impl Default for State {
+    fn default() -> Self {
+        Self {
+            selected: Target::Editor,
+            rows: Vec::new(),
+            error: None,
+            refresh_error: None,
+            diagnostics: Vec::new(),
+            pending: None,
+            current: None,
+            baseline: None,
+            frame: None,
+            compare: false,
+            follow: true,
+            serial: 0,
+            next_poll: None,
+            next_snapshot: None,
+            transport: false,
+            editor_job: None,
+            next_editor_poll: None,
+        }
+    }
+}
+impl State {
+    fn row(&self) -> Option<&Row> {
+        let Target::Player(scope) = &self.selected else {
+            return None;
+        };
+        self.rows.iter().find(|row| &row.target == scope)
+    }
+    fn blocker(&self) -> Option<&str> {
+        if self.selected == Target::Editor {
+            return None;
+        }
+        if self.pending.is_some() {
+            return Some("Wait for the pending player profiling request to finish");
+        }
+        if !self.transport {
+            return Some("The player profiling transport is not attached");
+        }
+        if let Some(error) = self.refresh_error.as_deref() {
+            return Some(error);
+        }
+        if let Target::Player(scope) = &self.selected
+            && (scope.world.trim().is_empty() || scope.source.trim().is_empty())
+        {
+            return Some("The profiling target has no valid world/source incarnation identity");
+        }
+        match self.row() {
+            Some(row) if row.available => None,
+            Some(row) => row
+                .reason
+                .as_deref()
+                .or(Some("This target does not provide profiling")),
+            None => {
+                Some("This exact player incarnation is no longer live; select a current target")
+            }
+        }
+    }
+    fn capture(&self) -> Option<&Capture> {
+        self.current
+            .as_ref()
+            .filter(|capture| capture.target == self.selected)
+    }
+    fn recording(&self) -> bool {
+        self.row().is_some_and(|row| row.recording)
+    }
+    fn observe_rows(&mut self, rows: &[Row]) -> bool {
+        if self.rows == rows {
+            return false;
+        }
+        self.rows = rows.to_vec();
+        true
+    }
+    fn accept(&mut self, status: Status) -> bool {
+        let Some(pending) = self.pending.as_ref() else {
+            return false;
+        };
+        if status.ticket != pending.ticket {
+            self.error=Some("A profiling response had another request's ticket; the original request remains pending".into());
+            return true;
+        }
+        if !status.finished {
+            return false;
+        }
+        let pending = self
+            .pending
+            .take()
+            .expect("matching finished profiling ticket");
+        self.diagnostics = status.diagnostics.into_iter().take(16).collect();
+        if status.target != pending.target {
+            self.error=Some("A profiling response did not match its requested world/player incarnation; data was not adopted".into());
+            return true;
+        }
+        if let Some(row) = self.rows.iter_mut().find(|row| row.target == status.target) {
+            row.recording = status.recording;
+        }
+        if !matches!(
+            status.outcome,
+            Some(Outcome::Completed | Outcome::Unchanged)
+        ) {
+            self.follow = false;
+            self.error = Some(
+                match status.outcome {
+                    Some(Outcome::Refused) => "The player refused this profiling request",
+                    Some(Outcome::Failed) => "The player profiling request failed",
+                    _ => "The profiling request finished without an outcome",
+                }
+                .into(),
+            );
+            return true;
+        }
+        self.error = None;
+        if let Some(mut profile) = status.profile {
+            profile.frames.retain(|frame| frame.duration_ns > 0);
+            let Some(serial) = self.serial.checked_add(1) else {
+                self.error =
+                    Some("Profiler capture identity exhausted; restart the editor session".into());
+                return true;
+            };
+            self.serial = serial;
+            let name = self
+                .rows
+                .iter()
+                .find(|row| row.target == pending.target)
+                .map_or_else(|| pending.target.label(), |row| row.name.clone());
+            let capture = Capture {
+                target: Target::Player(pending.target),
+                name,
+                profile: Arc::new(profile),
+                serial,
+                frozen: matches!(pending.purpose, Purpose::Freeze | Purpose::Baseline),
+            };
+            if pending.purpose == Purpose::Baseline {
+                self.baseline = Some(capture);
+            } else {
+                self.current = Some(capture);
+                self.frame = None;
+            }
+            self.compare = false;
+        } else if matches!(
+            pending.purpose,
+            Purpose::Freeze | Purpose::Baseline | Purpose::Snapshot
+        ) {
+            let target = Target::Player(pending.target);
+            let existing = self
+                .current
+                .as_mut()
+                .filter(|capture| capture.target == target);
+            if let (Some(Outcome::Unchanged), Some(existing)) = (status.outcome, existing) {
+                if pending.purpose == Purpose::Baseline {
+                    self.baseline = Some(Capture {
+                        target: existing.target.clone(),
+                        name: existing.name.clone(),
+                        profile: Arc::clone(&existing.profile),
+                        serial: existing.serial,
+                        frozen: true,
+                    });
+                } else if pending.purpose == Purpose::Freeze {
+                    existing.frozen = true;
+                }
+            } else {
+                self.follow = false;
+                self.error = Some(
+                    "The profiling response contained no completed-frame capture for this target"
+                        .into(),
+                );
+            }
+        }
+        true
+    }
+}
+
+impl Shell {
+    /// Poll the private port, not the network. Backend work remains single-flight.
+    /// Root takes/restores its Editor handle around this call to keep borrows disjoint.
+    pub(crate) fn poll_profiler_targets(
+        &mut self,
+        session: &str,
+        backend: Option<&mut dyn Backend>,
+    ) -> ara_ui::Result<bool> {
+        let state = &mut self.profiler_targets;
+        let Some(backend) = backend else {
+            let changed = state.transport;
+            state.transport = false;
+            return Ok(changed);
+        };
+        let mut changed = !state.transport;
+        state.transport = true;
+        let now = Instant::now();
+        if state.next_poll.is_some_and(|next| now < next) {
+            return Ok(changed);
+        }
+        state.next_poll = Some(now + POLL);
+        match backend.refresh_targets() {
+            Ok(()) => {
+                changed |= state.refresh_error.is_some();
+                state.refresh_error = None;
+                changed |= state.observe_rows(backend.targets());
+            }
+            Err(diagnostics) => {
+                let message = diagnostics
+                    .first()
+                    .map_or("Player profiling targets could not be refreshed", |d| {
+                        d.message.as_str()
+                    })
+                    .to_owned();
+                changed |= state.refresh_error.as_ref() != Some(&message);
+                state.refresh_error = Some(message);
+                state.diagnostics = diagnostics.into_iter().take(16).collect();
+            }
+        }
+        if let Some(pending) = &state.pending
+            && let Some(status) = backend.poll(pending.ticket)
+        {
+            changed |= state.accept(status);
+        }
+        if state.pending.is_none()
+            && state.follow
+            && (state.recording() || state.capture().is_none())
+            && state.blocker().is_none()
+            && state.next_snapshot.is_none_or(|next| now >= next)
+        {
+            let Target::Player(target) = &state.selected else {
+                return Ok(changed);
+            };
+            let target = target.clone();
+            match backend.request(Request {
+                session: session.into(),
+                target: target.clone(),
+                action: Action::Snapshot,
+                why: Some("Read selected player's closed profiler frames".into()),
+            }) {
+                Ok(ticket) => {
+                    state.pending = Some(Pending {
+                        ticket,
+                        target,
+                        purpose: Purpose::Snapshot,
+                        session: session.into(),
+                    });
+                    state.next_snapshot = Some(now + LIVE_SNAPSHOT);
+                    changed = true;
+                }
+                Err(diagnostics) => {
+                    state.follow = false;
+                    state.error = Some(
+                        diagnostics
+                            .first()
+                            .map_or("Player profiling snapshot was refused", |d| {
+                                d.message.as_str()
+                            })
+                            .into(),
+                    );
+                    state.diagnostics = diagnostics.into_iter().take(16).collect();
+                    changed = true;
+                }
+            }
+        }
+        Ok(changed)
+    }
+}
diff --git a/crates/ara-editor/src/shell/profiler_targets/backend.rs b/crates/ara-editor/src/shell/profiler_targets/backend.rs
new file mode 100644
--- /dev/null
+++ b/crates/ara-editor/src/shell/profiler_targets/backend.rs
@@ -0,0 +1,73 @@
+//! Private UI port. The real PlayProfilingHandle adapter is required before player closure.
+use ara_diag::Diagnostic;
+use serde::{Deserialize, Serialize};
+
+/// Exact live-world/player incarnation. Player number alone is never an identity.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct Scope {
+    /// Live Play world ID.
+    pub world: String,
+    /// Rendering player index in that world.
+    pub player: u32,
+    /// Opaque process/world producer incarnation.
+    pub source: String,
+    /// Monotonic binding within that producer slot.
+    pub binding: u64,
+}
+impl Scope {
+    pub(super) fn label(&self) -> String {
+        format!(
+            "{} · player {} · source {} · binding {}",
+            self.world, self.player, self.source, self.binding
+        )
+    }
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Row {
+    pub target: Scope,
+    pub name: String,
+    pub process_id: Option<u32>,
+    pub recording: bool,
+    pub available: bool,
+    pub reason: Option<String>,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Action {
+    Start,
+    Stop,
+    Snapshot,
+    Freeze,
+}
+pub(crate) struct Request {
+    pub session: String,
+    pub target: Scope,
+    pub action: Action,
+    pub why: Option<String>,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Ticket(pub u64);
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Outcome {
+    Completed,
+    Unchanged,
+    Failed,
+    Refused,
+}
+pub(crate) struct Status {
+    pub ticket: Ticket,
+    pub target: Scope,
+    pub finished: bool,
+    pub outcome: Option<Outcome>,
+    pub recording: bool,
+    pub profile: Option<ara_profile::Profile>,
+    pub diagnostics: Vec<Diagnostic>,
+}
+/// All methods are bounded handle operations; implementations own any asynchronous transport.
+/// No default/fake implementation is provided. None means unavailable player profiling.
+pub(crate) trait Backend: Send {
+    fn refresh_targets(&mut self) -> Result<(), Vec<Diagnostic>>;
+    fn targets(&self) -> &[Row];
+    fn request(&mut self, request: Request) -> Result<Ticket, Vec<Diagnostic>>;
+    fn poll(&mut self, ticket: Ticket) -> Option<Status>;
+}
diff --git a/crates/ara-editor/src/shell/profiler_targets/controls.rs b/crates/ara-editor/src/shell/profiler_targets/controls.rs
new file mode 100644
--- /dev/null
+++ b/crates/ara-editor/src/shell/profiler_targets/controls.rs
@@ -0,0 +1,343 @@
+use super::*;
+impl Shell {
+    /// The Editor owns the real adapter. Taking/restoring its box never clones a capture.
+    pub(crate) fn poll_profiler_target_state(
+        &mut self,
+        editor: &mut Editor,
+    ) -> ara_ui::Result<bool> {
+        let mut backend = editor.play_profiling.take();
+        let result = match backend.as_mut() {
+            Some(handle) => self.poll_profiler_targets(&editor.session, Some(handle.as_mut())),
+            None => self.poll_profiler_targets(&editor.session, None),
+        };
+        editor.play_profiling = backend;
+        let mut changed = result?;
+        let now = Instant::now();
+        if self.profiler_targets.editor_job.is_some()
+            && self
+                .profiler_targets
+                .next_editor_poll
+                .is_none_or(|next| now >= next)
+        {
+            self.profiler_targets.next_editor_poll = Some(now + POLL);
+            let id = self
+                .profiler_targets
+                .editor_job
+                .as_ref()
+                .expect("pending editor capture");
+            match editor.action("jobs.status", json!({"job":id})) {
+                Ok(status) if status["status"] != "running" => {
+                    self.profiler_targets.editor_job = None;
+                    changed = true;
+                    if status["status"] != "done" {
+                        self.profiler_targets.error=Some("The editor capture save did not complete successfully; inspect its job diagnostic".into());
+                    }
+                }
+                Err(error) => {
+                    let message = format!("Editor capture job state unavailable: {error}");
+                    changed |= self.profiler_targets.error.as_ref() != Some(&message);
+                    self.profiler_targets.error = Some(message);
+                }
+                _ => {}
+            }
+        }
+        Ok(changed)
+    }
+
+    pub(crate) fn choose_profiler_target(
+        &mut self,
+        editor: &mut Editor,
+        value: Value,
+    ) -> ara_ui::Result<()> {
+        let selected = if value.is_null() {
+            Target::Editor
+        } else {
+            Target::Player(serde_json::from_value::<Scope>(value)?)
+        };
+        if let Target::Player(scope) = &selected {
+            if !self
+                .profiler_targets
+                .rows
+                .iter()
+                .any(|row| &row.target == scope)
+                && selected != self.profiler_targets.selected
+            {
+                return Err("That player incarnation is no longer in the live profiler target list; refresh it".into());
+            }
+        }
+        if selected != self.profiler_targets.selected {
+            self.input.cancel_interaction(&mut self.ui);
+            self.profiler_targets.selected = selected;
+            self.profiler_targets.frame = None;
+            self.profiler_targets.compare = false;
+            self.profiler_targets.follow = true;
+            self.profiler_targets.next_poll = None;
+            self.profiler_targets.next_snapshot = None;
+            self.profile_scope = None;
+            if editor.state.profiler_compare {
+                editor.action("editor.workspace", json!({"compare":false}))?;
+            }
+        }
+        self.poll_profiler_target_state(editor)?;
+        self.rebuild(editor)
+    }
+
+    fn request_player_profile(
+        &mut self,
+        editor: &mut Editor,
+        action: Action,
+        purpose: Purpose,
+    ) -> ara_ui::Result<()> {
+        if let Some(reason) = self.profiler_targets.blocker() {
+            return Err(reason.to_owned().into());
+        }
+        let Target::Player(target) = &self.profiler_targets.selected else {
+            return Err("Choose a live player target".into());
+        };
+        let target = target.clone();
+        let backend = editor
+            .play_profiling
+            .as_mut()
+            .ok_or("The player profiling transport is not attached")?;
+        let ticket = match backend.request(Request {
+            session: editor.session.clone(),
+            target: target.clone(),
+            action,
+            why: Some("Native Profiler target action".into()),
+        }) {
+            Ok(ticket) => ticket,
+            Err(diagnostics) => {
+                self.profiler_targets.error = Some(
+                    diagnostics
+                        .first()
+                        .map_or("Player profiling request was refused", |diagnostic| {
+                            diagnostic.message.as_str()
+                        })
+                        .into(),
+                );
+                self.profiler_targets.diagnostics = diagnostics.into_iter().take(16).collect();
+                return self.rebuild(editor);
+            }
+        };
+        self.profiler_targets.error = None;
+        self.profiler_targets.pending = Some(Pending {
+            ticket,
+            target,
+            purpose,
+            session: editor.session.clone(),
+        });
+        self.profiler_targets.next_poll = None;
+        if purpose == Purpose::Freeze {
+            self.profiler_targets.follow = false;
+        }
+        self.rebuild(editor)
+    }
+
+    pub(crate) fn profiler_record_target(&mut self, editor: &mut Editor) -> ara_ui::Result<()> {
+        if self.profiler_targets.selected == Target::Editor {
+            if !editor.host.profiler().is_recording() {
+                editor.profile_current = None;
+            }
+            self.profiler_record(editor)?;
+            return self.rebuild(editor);
+        }
+        let action = if self.profiler_targets.recording() {
+            Action::Stop
+        } else {
+            Action::Start
+        };
+        self.profiler_targets.follow = true;
+        self.request_player_profile(editor, action, Purpose::Record)
+    }
+    pub(crate) fn profiler_snapshot_target(&mut self, editor: &mut Editor) -> ara_ui::Result<()> {
+        if self.profiler_targets.selected == Target::Editor {
+            return self.profiler_freeze_target(editor, false);
+        }
+        self.profiler_targets.follow = true;
+        self.profiler_targets.next_snapshot = Some(Instant::now() + LIVE_SNAPSHOT);
+        self.request_player_profile(editor, Action::Snapshot, Purpose::Snapshot)
+    }
+    pub(crate) fn profiler_freeze_target(
+        &mut self,
+        editor: &mut Editor,
+        baseline: bool,
+    ) -> ara_ui::Result<()> {
+        if self.profiler_targets.selected == Target::Editor {
+            if self.profiler_targets.editor_job.is_some() {
+                return Err(
+                    "An editor capture save is already pending; wait for its receipt".into(),
+                );
+            }
+            let response = editor.action("editor.profile.freeze", json!({"baseline":baseline}))?;
+            self.profiler_targets.editor_job = response["job"].as_str().map(str::to_owned);
+            if baseline {
+                self.profiler_targets.baseline = None;
+            }
+            self.profiler_targets.compare = false;
+            return self.rebuild(editor);
+        }
+        self.request_player_profile(
+            editor,
+            Action::Freeze,
+            if baseline {
+                Purpose::Baseline
+            } else {
+                Purpose::Freeze
+            },
+        )
+    }
+    pub(crate) fn refresh_profiler_targets(&mut self, editor: &mut Editor) -> ara_ui::Result<()> {
+        self.profiler_targets.next_poll = None;
+        self.poll_profiler_target_state(editor)?;
+        self.rebuild(editor)
+    }
+
+    pub(crate) fn profiler_target_blocker(&self) -> Option<&str> {
+        self.profiler_targets.blocker()
+    }
+    pub(crate) fn profiler_freeze_blocker(&self) -> Option<&str> {
+        if self.profiler_targets.selected == Target::Editor
+            && self.profiler_targets.editor_job.is_some()
+        {
+            Some("An editor capture save is already pending")
+        } else {
+            self.profiler_targets.blocker()
+        }
+    }
+    pub(crate) fn profiler_compare_blocker(&self, editor: &Editor) -> Option<&str> {
+        let current = if self.profiler_targets.selected == Target::Editor {
+            editor.profile_current.is_some()
+        } else {
+            self.profiler_targets.capture().is_some()
+        };
+        if !current {
+            return Some("Freeze or snapshot the selected target before comparing");
+        }
+        if self.profiler_targets.baseline.is_none() && editor.profile_baseline.is_none() {
+            return Some("Set an explicitly scoped baseline first");
+        }
+        if self.profiler_targets.follow && self.profiler_targets.recording() {
+            return Some("Freeze the selected player snapshot before comparing");
+        }
+        None
+    }
+    pub(crate) fn profiler_compare_active(&self, editor: &Editor) -> bool {
+        if self.profiler_targets.selected == Target::Editor
+            && self.profiler_targets.baseline.is_none()
+        {
+            editor.state.profiler_compare
+        } else {
+            self.profiler_targets.compare
+        }
+    }
+    pub(crate) fn compare_profiler_targets(&mut self, editor: &mut Editor) -> ara_ui::Result<()> {
+        if let Some(reason) = self.profiler_compare_blocker(editor) {
+            return Err(reason.to_owned().into());
+        }
+        if self.profiler_targets.selected == Target::Editor
+            && self.profiler_targets.baseline.is_none()
+        {
+            editor.action(
+                "editor.workspace",
+                json!({"compare":!editor.state.profiler_compare}),
+            )?;
+        } else {
+            self.profiler_targets.compare = !self.profiler_targets.compare;
+        }
+        self.rebuild(editor)
+    }
+
+    pub(in crate::shell) fn bind_profiler_frame(&mut self, id: &str, frame: u64) {
+        let serial = self
+            .profiler_targets
+            .capture()
+            .map_or(0, |capture| capture.serial);
+        self.bind_command(id,"profiler.frame",commands::Target::Text(ara_json::to_canonical_string(&json!({"target":self.profiler_targets.selected.value(),"capture":serial,"frame":frame}))));
+    }
+    pub(in crate::shell) fn profiler_frame_id(&self, frame: u64) -> String {
+        if self.profiler_targets.selected == Target::Editor {
+            return format!("profile-frame-{frame}");
+        }
+        let context = ara_json::to_canonical_string(&self.profiler_targets.selected.value());
+        format!(
+            "profile-frame-{:016x}-{}-{frame}",
+            ara_ui::source::stable_id(&context),
+            self.profiler_targets
+                .capture()
+                .map_or(0, |capture| capture.serial)
+        )
+    }
+    pub(crate) fn choose_profiler_frame(
+        &mut self,
+        editor: &mut Editor,
+        target: &commands::Target,
+    ) -> ara_ui::Result<()> {
+        let commands::Target::Text(text) = target else {
+            return Err("Choose a profiler frame".into());
+        };
+        let value: Value = serde_json::from_str(text)?;
+        let scope = if value["target"].is_null() {
+            Target::Editor
+        } else {
+            Target::Player(serde_json::from_value(value["target"].clone())?)
+        };
+        let frame = value["frame"]
+            .as_u64()
+            .ok_or("Profiler frame identity is missing")?;
+        if scope != self.profiler_targets.selected {
+            return Err("That frame belongs to a different profiling target; the current selection was preserved".into());
+        }
+        if scope == Target::Editor {
+            let exists = if let Some(profile) = &editor.profile_current {
+                profile
+                    .frames
+                    .iter()
+                    .any(|candidate| candidate.id == frame && candidate.duration_ns > 0)
+            } else {
+                editor
+                    .host
+                    .profiler()
+                    .profile()
+                    .frames
+                    .iter()
+                    .any(|candidate| candidate.id == frame && candidate.duration_ns > 0)
+            };
+            if !exists {
+                return Err(
+                    "That editor profiler frame is no longer in the current capture".into(),
+                );
+            }
+            editor.action("editor.workspace", json!({"frame":frame}))?;
+        } else {
+            let capture = self
+                .profiler_targets
+                .capture()
+                .ok_or("No completed frame snapshot exists for this exact player incarnation")?;
+            if value["capture"].as_u64() != Some(capture.serial)
+                || !capture
+                    .profile
+                    .frames
+                    .iter()
+                    .any(|candidate| candidate.id == frame)
+            {
+                return Err(
+                    "That profiler frame was superseded; select a frame in the current snapshot"
+                        .into(),
+                );
+            }
+            self.profiler_targets.frame = Some(frame);
+            self.profiler_targets.follow = false;
+        }
+        self.rebuild(editor)
+    }
+    pub(crate) fn profiler_targets_busy(&self) -> bool {
+        self.profiler_targets.pending.is_some() || self.profiler_targets.editor_job.is_some()
+    }
+    pub(crate) fn profiler_targets_report(&self) -> Value {
+        let capture = |capture: &Capture| json!({"target":capture.target.value(),"name":capture.name,"serial":capture.serial,"frames":capture.profile.frames.len(),"frozen":capture.frozen});
+        json!({"selected":self.profiler_targets.selected.value(),"transport":self.profiler_targets.transport,
+            "pending":self.profiler_targets.pending.as_ref().map(|pending|json!({"ticket":pending.ticket.0,"target":pending.target,"session":pending.session})),
+            "editorCaptureJob":self.profiler_targets.editor_job,"current":self.profiler_targets.current.as_ref().map(capture),
+            "baseline":self.profiler_targets.baseline.as_ref().map(capture),"error":self.profiler_targets.error,"refreshError":self.profiler_targets.refresh_error})
+    }
+}
diff --git a/crates/ara-editor/src/shell/profiler_targets/tests.rs b/crates/ara-editor/src/shell/profiler_targets/tests.rs
