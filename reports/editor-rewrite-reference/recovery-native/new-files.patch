new file mode 100644
--- /dev/null
+++ b/crates/ara-editor/src/app/recovery_verify/observe.rs
@@ -0,0 +1,324 @@
+//! Bounded authoritative Store and mounted-row observations; no diagnostic emission.
+use super::*;
+
+#[derive(Clone, Debug, PartialEq)]
+pub(super) struct Identity {
+    pub first: u64,
+    pub seq: u64,
+    pub count: u64,
+    pub module: String,
+    pub scope: Value,
+}
+impl Identity {
+    fn parse(row: &Value) -> ara_ui::Result<Self> {
+        let data = &row["diagnostic"]["data"];
+        let scope = &data["play"];
+        if scope["world"].as_str().is_none_or(str::is_empty)
+            || scope["source"].as_str().is_none_or(str::is_empty)
+            || scope["player"].as_u64().is_none()
+            || scope["binding"].as_u64().is_none_or(|binding| binding == 0)
+        {
+            return Err("Actual C# fault omitted its trusted Play incarnation".into());
+        }
+        Ok(Self {
+            first: number(&row["first"])?,
+            seq: number(&row["seq"])?,
+            count: number(&row["count"])?,
+            module: data["module"]
+                .as_str()
+                .filter(|module| !module.is_empty())
+                .ok_or("Actual C# fault omitted its loaded ModuleSlot name")?
+                .into(),
+            scope: scope.clone(),
+        })
+    }
+    pub fn report(&self) -> Value {
+        json!({"first":self.first,"seq":self.seq,"count":self.count,"module":self.module,"scope":self.scope})
+    }
+}
+
+pub(super) struct Bus {
+    pub cursor: u64,
+    rows: BTreeMap<u64, Value>,
+    next_poll: Option<Instant>,
+}
+impl Bus {
+    pub fn new(cursor: u64) -> Self {
+        Self {
+            cursor,
+            rows: BTreeMap::new(),
+            next_poll: None,
+        }
+    }
+    pub fn force(&mut self, editor: &mut Editor) -> ara_ui::Result<()> {
+        self.next_poll = None;
+        self.poll(editor)
+    }
+    pub fn poll(&mut self, editor: &mut Editor) -> ara_ui::Result<()> {
+        let now = Instant::now();
+        if self.next_poll.is_some_and(|next| now < next) {
+            return Ok(());
+        }
+        self.next_poll = Some(now + Duration::from_millis(50));
+        let page = editor.action(
+            "logs",
+            json!({"group":false,"severity":"info","since":self.cursor,"limit":500}),
+        )?;
+        let cursor = number(&page["cursor"])?;
+        let raw = page["entries"]
+            .as_array()
+            .ok_or("Recovery logs omitted entries")?;
+        if cursor < self.cursor
+            || page["total"]
+                .as_u64()
+                .is_none_or(|total| total > raw.len() as u64)
+        {
+            return Err(
+                "Recovery evidence lost a diagnostic page; refusing partial retirement/count proof"
+                    .into(),
+            );
+        }
+        for row in raw {
+            let diagnostic = &row["diagnostic"];
+            let code = diagnostic["code"].as_str().unwrap_or("");
+            let message = diagnostic["message"].as_str().unwrap_or("");
+            if (matches!(code, "ARA0910" | "ARA0912") && message.contains(PREFIX))
+                || code == "ARA0935"
+                || message.starts_with("Script recovery refused:")
+            {
+                let first = number(&row["first"])?;
+                if !self.rows.contains_key(&first) && self.rows.len() >= 64 {
+                    return Err("Recovery native diagnostic inventory exceeded64 rows; no rows were silently dropped".into());
+                }
+                self.rows.insert(first, row.clone());
+            }
+        }
+        self.cursor = cursor;
+        Ok(())
+    }
+    pub fn faults(&self, world: &str) -> Vec<&Value> {
+        self.rows
+            .values()
+            .filter(|row| {
+                matches!(
+                    row["diagnostic"]["code"].as_str(),
+                    Some("ARA0910" | "ARA0912")
+                ) && row["diagnostic"]["data"]["play"]["world"] == world
+            })
+            .collect()
+    }
+    pub fn fault(&self, world: &str, code: &str) -> ara_ui::Result<&Value> {
+        self.faults(world)
+            .into_iter()
+            .find(|row| row["diagnostic"]["code"] == code)
+            .ok_or_else(|| {
+                format!("Real {code} for {world} has not reached normal Host ingress").into()
+            })
+    }
+    pub fn row(&self, first: u64) -> ara_ui::Result<&Value> {
+        self.rows
+            .get(&first)
+            .ok_or("Captured diagnostic identity disappeared".into())
+    }
+    pub fn identities(&self) -> ara_ui::Result<BTreeMap<u64, Identity>> {
+        self.rows
+            .values()
+            .filter(|row| {
+                matches!(
+                    row["diagnostic"]["code"].as_str(),
+                    Some("ARA0910" | "ARA0912")
+                )
+            })
+            .map(|row| Identity::parse(row).map(|identity| (identity.first, identity)))
+            .collect()
+    }
+    pub fn unchanged(&self, before: &BTreeMap<u64, Identity>) -> ara_ui::Result<bool> {
+        for (first, identity) in before {
+            if &Identity::parse(self.row(*first)?)? != identity {
+                return Ok(false);
+            }
+        }
+        Ok(true)
+    }
+    pub fn marker(&self, after: u64, world: &str) -> ara_ui::Result<Option<Value>> {
+        let mut matching = self
+            .rows
+            .values()
+            .filter(|row| {
+                row["diagnostic"]["code"] == "ARA0935"
+                    && row["seq"].as_u64().is_some_and(|seq| seq > after)
+                    && row["diagnostic"]["data"]["play"]["world"] == world
+            })
+            .collect::<Vec<_>>();
+        matching.sort_by_key(|row| row["seq"].as_u64());
+        let Some(row) = matching.last() else {
+            return Ok(None);
+        };
+        let recovery = &row["diagnostic"]["data"]["recovery"];
+        if recovery["schema"] != 1
+            || recovery["outcome"] != "reloaded"
+            || recovery["ticket"].as_u64().is_none()
+        {
+            return Err(format!("Actual recovery did not complete as Reloaded: {recovery}").into());
+        }
+        let fault = Identity::parse(self.fault(world, "ARA0912")?)?;
+        if row["diagnostic"]["data"]["play"] != fault.scope
+            || !recovery["modules"].as_array().is_some_and(|modules| {
+                modules
+                    .iter()
+                    .any(|module| module.as_str() == Some(fault.module.as_str()))
+            })
+        {
+            return Err("ARA0935 does not own the fault's actual module/player incarnation".into());
+        }
+        Ok(Some((**row).clone()))
+    }
+    pub fn refusals(&self, after: u64) -> Vec<&Value> {
+        self.rows
+            .values()
+            .filter(|row| {
+                row["seq"].as_u64().is_some_and(|seq| seq > after)
+                    && row["diagnostic"]["message"]
+                        .as_str()
+                        .is_some_and(|message| message.starts_with("Script recovery refused:"))
+            })
+            .collect()
+    }
+    pub fn fault_report(&self) -> Value {
+        json!(self.rows.values().filter(|row|matches!(row["diagnostic"]["code"].as_str(),Some("ARA0910"|"ARA0912")))
+            .map(|row|json!({"first":row["first"],"seq":row["seq"],"count":row["count"],"code":row["diagnostic"]["code"],
+                "module":row["diagnostic"]["data"]["module"],"scope":row["diagnostic"]["data"]["play"]})).collect::<Vec<_>>())
+    }
+}
+pub(super) fn number(value: &Value) -> ara_ui::Result<u64> {
+    value
+        .as_u64()
+        .ok_or("Expected diagnostic sequence/count integer".into())
+}
+
+pub(super) fn text<'a>(shell: &'a Shell, id: &str) -> Option<&'a str> {
+    shell
+        .shown_node(id)
+        .and_then(|index| shell.ui.nodes[index].element.attrs.get("text"))
+        .map(String::as_str)
+}
+pub(super) fn rows(shell: &Shell, prefix: &str) -> Vec<u64> {
+    shell
+        .ui
+        .paint_order
+        .iter()
+        .filter_map(|index| {
+            let node = &shell.ui.nodes[*index];
+            let seq = node.element.id.strip_prefix(prefix)?.parse::<u64>().ok()?;
+            (shell.ui.shown(*index) && node.rect.intersection(node.clip).h > 1.).then_some(seq)
+        })
+        .collect()
+}
+pub(super) fn active(shell: &Shell, seq: u64) -> bool {
+    shell.compile_problem_state()["protectedRuntimeFaultSeqs"]
+        .as_array()
+        .is_some_and(|rows| rows.iter().any(|row| row.as_u64() == Some(seq)))
+}
+
+pub(super) struct SourceFrame {
+    pub index: usize,
+    pub file: String,
+    pub line: u32,
+    pub column: Option<u32>,
+}
+impl SourceFrame {
+    pub fn report(&self) -> Value {
+        json!({"index":self.index,"file":self.file,"line":self.line,"pdbColumn":self.column,"requestedColumn":self.column.unwrap_or(1)})
+    }
+}
+/// Assert that the original bounded exception tree, not a reformatted message,
+/// is mounted. Return a real PDB frame in the authored source for a native click.
+pub(super) fn stack(
+    shell: &Shell,
+    row: &Value,
+    expected_source: &Path,
+) -> ara_ui::Result<SourceFrame> {
+    let seq = number(&row["seq"])?;
+    let exception = &row["diagnostic"]["data"]["exception"];
+    if exception["schema"] != 1
+        || exception["type"] != "System.InvalidOperationException"
+        || exception["message"] != "P4 Recovery command fault"
+        || exception["inners"][0]["type"] != "System.ArgumentException"
+        || exception["inners"][0]["message"] != "P4 Recovery inner cause"
+    {
+        return Err("Real command fault lost its original outer/inner exception metadata".into());
+    }
+    let mut flattened = Vec::new();
+    flatten(exception, &mut flattened, 0)?;
+    if flattened.len() > 16 {
+        return Err("Runtime exception exceeded the agreed16-node bound".into());
+    }
+    let mut frame_index = 0;
+    let mut located = None;
+    for (index, node) in flattened.into_iter().enumerate() {
+        let kind = node["type"].as_str().ok_or("Exception type missing")?;
+        let expected = if index == 0 {
+            kind.to_owned()
+        } else {
+            format!("Caused by: {kind}")
+        };
+        if text(shell, &format!("log-{seq}-stack-type-{index}")) != Some(expected.as_str())
+            || text(shell, &format!("log-{seq}-stack-message-{index}")) != node["message"].as_str()
+        {
+            return Err(
+                "Console did not mount the original full managed exception/inner order".into(),
+            );
+        }
+        for frame in node["frames"]
+            .as_array()
+            .ok_or("Exception frames missing")?
+        {
+            if frame_index >= 64 {
+                return Err("Runtime exception exceeded64 total frames".into());
+            }
+            if text(
+                shell,
+                &format!("log-{seq}-stack-frame-{frame_index}-method"),
+            ) != frame["method"].as_str()
+            {
+                return Err("Console omitted/reordered a managed stack frame".into());
+            }
+            if let (Some(file), Some(line)) = (frame["file"].as_str(), frame["line"].as_u64())
+                && line > 0
+                && Path::new(file).canonicalize().ok().as_deref() == Some(expected_source)
+            {
+                let column = frame["column"]
+                    .as_u64()
+                    .map(u32::try_from)
+                    .transpose()?
+                    .filter(|column| *column > 0);
+                located.get_or_insert(SourceFrame {
+                    index: frame_index,
+                    file: file.into(),
+                    line: u32::try_from(line)?,
+                    column,
+                });
+            }
+            frame_index += 1;
+        }
+    }
+    if text(shell, &format!("log-{seq}-stack-malformed")).is_some()
+        || text(shell, &format!("log-{seq}-stack-truncated")).is_some()
+    {
+        return Err("The small original fixture stack was unexpectedly malformed/truncated".into());
+    }
+    located.ok_or("Real managed exception has no authored PDB source frame to click".into())
+}
+fn flatten<'a>(node: &'a Value, out: &mut Vec<&'a Value>, depth: usize) -> ara_ui::Result<()> {
+    if depth >= 8 || out.len() >= 16 || node["schema"] != 1 || node["truncated"] != false {
+        return Err("Native exception fixture has incomplete or out-of-bound metadata".into());
+    }
+    out.push(node);
+    for inner in node["inners"]
+        .as_array()
+        .ok_or("Exception inners missing")?
+    {
+        flatten(inner, out, depth + 1)?;
+    }
+    Ok(())
+}
