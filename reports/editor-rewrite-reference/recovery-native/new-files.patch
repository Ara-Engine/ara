@@ -0,0 +1,67 @@
+//! Measured Reload/Stop, palette, text, expansion and PDB actions use only SDL.
+use super::super::input_verify::native;
+use super::*;
+mod exception;
+mod refusal;
+mod reload;
+mod widgets;
+use widgets::{checked, show, visible};
+
+impl RecoveryCheck {
+    pub(super) fn input(
+        &mut self,
+        editor: &mut Editor,
+        shell: &mut Shell,
+        window: &Window,
+        scale: f32,
+        events: &mut Vec<(u32, Event)>,
+    ) -> ara_ui::Result<()> {
+        match self.index {
+            0 => {
+                if self.fixture.poll(editor, shell, &self.bus)? {
+                    for world in [self.fixture.a()?, self.fixture.b()?] {
+                        for code in ["ARA0910", "ARA0912"] {
+                            let seq = observe::number(&self.bus.fault(world, code)?["seq"])?;
+                            if !observe::active(shell, seq) {
+                                return Ok(());
+                            }
+                        }
+                    }
+                    self.done(json!({"realFixture":self.fixture.report(),"faults":self.bus.fault_report(),
+                        "ingress":"Typed C# create/rename/compile, real paused Play worlds, one real query tick and nested command fault; no synthetic diagnostic rows"}));
+                }
+            }
+            1 => self.exception(editor, shell, window, scale, events)?,
+            2 => self.reload_button(editor, shell, window, scale, events)?,
+            3 => self.history(editor, shell, window, scale, events)?,
+            4 => self.repeated_fault(editor, shell, window, scale, events)?,
+            5 => self.palette_reload(editor, shell, window, scale, events)?,
+            6 => self.refusal(editor, shell, window, scale, events)?,
+            7 => {
+                if self.fixture.cleanup(editor)? {
+                    editor.action(
+                        "editor.search",
+                        json!({"panel":"console","query":self.saved_searches[0]}),
+                    )?;
+                    editor.action(
+                        "editor.search",
+                        json!({"panel":"problems","query":self.saved_searches[1]}),
+                    )?;
+                    editor.action(
+                        "editor.view",
+                        json!({"maximized":self.saved_maximized.as_deref().unwrap_or("")}),
+                    )?;
+                    editor.action("editor.focus", json!({"panel":self.saved_focus}))?;
+                    shell.open_ide = self.saved_ide;
+                    self.pointer = None;
+                    shell.desktop_pointer = None;
+                    shell.rebuild(editor)?;
+                    self.done(json!({"worldsRetired":[self.fixture.a()?,self.fixture.b()?],"cleanup":self.fixture.report(),
+                        "nativeRefusedCoverage":"Reload then Stop batch exercised the ordinary native queue order; no private status injection"}));
+                }
+            }
+            _ => return Err("Recovery journey index outside bounded cases".into()),
+        }
+        Ok(())
+    }
+}
