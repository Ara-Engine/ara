@@ -0,0 +1,107 @@
+//! Native SDL actions for the real recovery proof.
+use super::*;
+
+impl RecoveryCheck {
+    pub(super) fn refusal(
+        &mut self,
+        editor: &mut Editor,
+        shell: &mut Shell,
+        window: &Window,
+        scale: f32,
+        events: &mut Vec<(u32, Event)>,
+    ) -> ara_ui::Result<()> {
+        match self.phase {
+            0 => {
+                fixture::command_fault(editor, self.fixture.a()?)?;
+                self.next();
+            }
+            1 => {
+                let row = self.bus.fault(self.fixture.a()?, "ARA0912")?;
+                let seq = observe::number(&row["seq"])?;
+                if seq
+                    <= self
+                        .marker
+                        .as_ref()
+                        .and_then(|row| row["seq"].as_u64())
+                        .ok_or("Prior marker missing")?
+                    || !observe::active(shell, seq)
+                {
+                    return Ok(());
+                }
+                self.baseline = self.bus.identities()?;
+                self.request_cursor = self.bus.cursor;
+                self.assert_command(shell, "script-recovery-reload", "tools.cs.reload")?;
+                // Both releases dispatch normally before the frame's service tick.
+                // Stop removes this world before the queued recovery is processed.
+                self.click(shell, window, scale, "script-recovery-reload", events)?;
+                self.click(shell, window, scale, "stop", events)?;
+                self.marker_began = None;
+                self.next();
+            }
+            _ => {
+                if editor.play_world.is_some()
+                    || shell.script_recovery_busy()
+                    || !fixture::retired(editor, self.fixture.a()?)?
+                {
+                    return Ok(());
+                }
+                let resource = shell.script_recovery_resource_report();
+                let terminal = resource["terminalHistory"].as_array().and_then(|rows| {
+                    rows.iter()
+                        .find(|row| row["world"] == self.fixture.a().unwrap_or(""))
+                });
+                let Some(ticket) = terminal.and_then(|row| row["ticket"].as_u64()) else {
+                    return Ok(());
+                };
+                self.refusal_ticket = Some(ticket);
+                let prefix = format!("script-recovery-result-{ticket}-player-");
+                let refused = shell.ui.nodes.iter().any(|node| {
+                    node.element.id.starts_with(&prefix)
+                        && node
+                            .element
+                            .attrs
+                            .get("text")
+                            .is_some_and(|text| text.contains("Refused"))
+                });
+                let rows = self.bus.refusals(self.request_cursor);
+                if !refused || rows.is_empty() {
+                    return Ok(());
+                }
+                if self.marker_began.is_none() {
+                    self.marker_began = Some(Instant::now());
+                    return Ok(());
+                }
+                if self
+                    .marker_began
+                    .is_some_and(|start| start.elapsed() < Duration::from_millis(600))
+                {
+                    return Ok(());
+                }
+                self.bus.force(editor)?;
+                if !self.bus.unchanged(&self.baseline)? {
+                    return Err(
+                        "Refused Status replayed or cleared an original fault identity".into(),
+                    );
+                }
+                let mounted = observe::rows(shell, "problem-");
+                if self.baseline.values().any(|identity| {
+                    observe::active(shell, identity.seq) && !mounted.contains(&identity.seq)
+                }) {
+                    return Ok(());
+                }
+                let current = self.bus.fault(self.fixture.a()?, "ARA0912")?;
+                if !observe::active(shell, observe::number(&current["seq"])?) {
+                    return Err("Refused recovery retired the current repeated fault".into());
+                }
+                let refusals = self.bus.refusals(self.request_cursor);
+                if refusals.iter().any(|row| row["count"] != 1) {
+                    return Err("UI re-logged an already-published local refusal diagnostic".into());
+                }
+                self.done(json!({"ticket":ticket,"renderedOutcome":"Refused","refusalBusRows":refusals,
+                    "faultStoreUnchanged":true,"problemsRows":mounted,"currentFault":current,
+                    "ingress":"same native SDL batch: Reload Scripts button then Stop toolbar; ordinary Host tick processed the invalidated incarnation"}));
+            }
+        }
+        Ok(())
+    }
+}
