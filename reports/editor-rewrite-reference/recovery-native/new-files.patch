@@ -0,0 +1,175 @@
+//! Native SDL actions for the real recovery proof.
+use super::*;
+
+impl RecoveryCheck {
+    pub(super) fn reload_button(
+        &mut self,
+        editor: &mut Editor,
+        shell: &mut Shell,
+        window: &Window,
+        scale: f32,
+        events: &mut Vec<(u32, Event)>,
+    ) -> ara_ui::Result<()> {
+        match self.phase {
+            0 => {
+                show(editor, shell, "problems")?;
+                if !checked(shell, "problems-errors") {
+                    self.click(shell, window, scale, "problems-errors", events)?;
+                }
+                self.arm()?;
+                self.next();
+            }
+            1 => {
+                self.assert_command(shell, "script-recovery-reload", "tools.cs.reload")?;
+                self.click(shell, window, scale, "script-recovery-reload", events)?;
+                self.requested_capture = Some("pending");
+                self.next();
+            }
+            2 => {
+                self.bus.force(editor)?;
+                self.ui_pending_at_typing = shell.script_recovery_busy();
+                self.pending_at_typing = self.ui_pending_at_typing
+                    && self
+                        .bus
+                        .marker(self.request_cursor, self.fixture.a()?)?
+                        .is_none();
+                self.search(shell, window, scale, "problems", PREFIX, events)?;
+                self.typing_frame = Some(self.frame);
+                self.next();
+            }
+            _ => {
+                if editor.state.searches.get("problems").map(String::as_str) != Some(PREFIX) {
+                    return Ok(());
+                }
+                if self.typing_frame.is_none_or(|frame| self.frame <= frame) {
+                    return Ok(());
+                }
+                if !self.retirement_ready(editor, shell)? {
+                    return Ok(());
+                }
+                self.done(json!({"authority":self.retired_evidence(shell),"typingAccepted":true,"nativeFrameAdvanced":true,
+                    "uiPendingAtTyping":self.ui_pending_at_typing,"noCompletionObservedAtTyping":self.pending_at_typing,
+                    "pendingCoverage":if self.pending_at_typing {"observed on real request"}else{"not established natively; controlled pending tests remain explicit coverage"}}));
+            }
+        }
+        Ok(())
+    }
+    pub(super) fn history(
+        &mut self,
+        editor: &mut Editor,
+        shell: &mut Shell,
+        window: &Window,
+        scale: f32,
+        events: &mut Vec<(u32, Event)>,
+    ) -> ara_ui::Result<()> {
+        match self.phase {
+            0 => {
+                if !self.retirement_ready(editor, shell)? {
+                    return Ok(());
+                }
+                self.runtime_job=Some(editor.action("play.read",json!({"world":self.fixture.a()?,"background":true,
+                    "paths":[format!("{ENTITY}.RecoveryProbe.count"),format!("{ENTITY}.RecoveryProbe.fault")]}))?["job"].as_str().ok_or("Runtime verification read omitted job")?.into());
+                self.next();
+            }
+            1 => {
+                let Some(runtime) = fixture::poll_job(editor, &mut self.runtime_job)? else {
+                    return Ok(());
+                };
+                let before = self
+                    .fixture
+                    .runtime_before
+                    .as_ref()
+                    .ok_or("Runtime baseline missing")?;
+                if runtime["tick"] != before["tick"] || runtime["values"] != before["values"] {
+                    return Err(format!("Recovery reset or advanced the paused real ECS state: before {before}, after {runtime}").into());
+                }
+                self.runtime_after = Some(runtime);
+                show(editor, shell, "console")?;
+                self.next();
+            }
+            2 => {
+                self.search(shell, window, scale, "console", PREFIX, events)?;
+                self.next();
+            }
+            3 => {
+                let first = self
+                    .command_first
+                    .ok_or("Original command identity missing")?;
+                let seq = observe::number(&self.bus.row(first)?["seq"])?;
+                if shell.shown_node(&format!("log-{seq}-details")).is_some() {
+                    let id = format!("log-{seq}-row");
+                    if !self.reveal(shell, window, scale, &id, events)? {
+                        return Ok(());
+                    }
+                    self.click(shell, window, scale, &id, events)?;
+                }
+                self.next();
+            }
+            _ => {
+                let mounted = observe::rows(shell, "log-");
+                if self
+                    .baseline
+                    .values()
+                    .any(|identity| !mounted.contains(&identity.seq))
+                {
+                    return Ok(());
+                }
+                if !self.bus.unchanged(&self.baseline)? {
+                    return Err("Console/Status viewing replayed an original runtime fault".into());
+                }
+                self.done(json!({"originalIdentities":self.baseline.values().map(observe::Identity::report).collect::<Vec<_>>(),
+                    "consoleMounted":mounted,"storeUnchanged":true,"runtimeStatePreserved":self.runtime_after,
+                    "ingress":"native Console search; raw Store sequences/counts compared after multiple UI polling cadences"}));
+            }
+        }
+        Ok(())
+    }
+    pub(super) fn palette_reload(
+        &mut self,
+        editor: &mut Editor,
+        shell: &mut Shell,
+        window: &Window,
+        scale: f32,
+        events: &mut Vec<(u32, Event)>,
+    ) -> ara_ui::Result<()> {
+        match self.phase {
+            0 => {
+                self.arm()?;
+                native::shortcut(window, 14, events)?;
+                self.next();
+            }
+            1 => {
+                if !visible(shell, "palette-search") {
+                    return Ok(());
+                }
+                native::shortcut(window, 4, events)?;
+                native::text(window, "Reload Scripts", events)?;
+                self.next();
+            }
+            2 => {
+                let control = shell
+                    .command_bindings()
+                    .into_iter()
+                    .find(|(id, command)| {
+                        id.starts_with("command-")
+                            && command == "tools.cs.reload"
+                            && visible(shell, id)
+                    })
+                    .map(|(id, _)| id);
+                let Some(control) = control else {
+                    return Ok(());
+                };
+                self.assert_command(shell, &control, "tools.cs.reload")?;
+                self.click(shell, window, scale, &control, events)?;
+                self.next();
+            }
+            _ => {
+                if !self.retirement_ready(editor, shell)? {
+                    return Ok(());
+                }
+                self.done(json!({"authority":self.retired_evidence(shell),"ingress":"SDL Ctrl+K, palette text and pointer selection of real Reload Scripts result"}));
+            }
+        }
+        Ok(())
+    }
+}
diff --git a/crates/ara-editor/src/app/recovery_verify/input/widgets.rs b/crates/ara-editor/src/app/recovery_verify/input/widgets.rs
new file mode 100644
--- /dev/null
+++ b/crates/ara-editor/src/app/recovery_verify/input/widgets.rs
@@ -0,0 +1,130 @@
+//! Native SDL actions for the real recovery proof.
+use super::*;
+
+impl RecoveryCheck {
+    pub(super) fn assert_command(
+        &self,
+        shell: &Shell,
+        id: &str,
+        expected: &str,
+    ) -> ara_ui::Result<()> {
+        if !shell
+            .command_bindings()
+            .iter()
+            .any(|(node, command)| node == id && command == expected)
+        {
+            return Err(format!("Measured control {id} is not bound to {expected}").into());
+        }
+        let node = shell
+            .shown_node(id)
+            .ok_or("Measured recovery command is not mounted")?;
+        if shell.ui.nodes[node].state.disabled {
+            return Err(format!("Measured recovery control is disabled: {id}").into());
+        }
+        Ok(())
+    }
+    pub(super) fn search(
+        &mut self,
+        shell: &mut Shell,
+        window: &Window,
+        scale: f32,
+        panel: &str,
+        value: &str,
+        events: &mut Vec<(u32, Event)>,
+    ) -> ara_ui::Result<()> {
+        self.click(shell, window, scale, &format!("search-{panel}"), events)?;
+        native::shortcut(window, 4, events)?;
+        native::text(window, value, events)
+    }
+    pub(super) fn click(
+        &mut self,
+        shell: &mut Shell,
+        window: &Window,
+        scale: f32,
+        id: &str,
+        events: &mut Vec<(u32, Event)>,
+    ) -> ara_ui::Result<()> {
+        if !scale.is_finite() || scale <= 0. {
+            return Err("Native recovery scale must be finite and positive".into());
+        }
+        if self.trace.len() >= 128 {
+            return Err("Native recovery input trace exceeded128 bounded actions".into());
+        }
+        let index = shell
+            .shown_node(id)
+            .ok_or_else(|| format!("Native recovery control missing: {id}"))?;
+        let rect = shell.ui.nodes[index]
+            .rect
+            .intersection(shell.ui.nodes[index].clip);
+        if rect.w < 2. || rect.h < 8. {
+            return Err(format!("Native recovery control is clipped: {id}").into());
+        }
+        let point = [rect.x + rect.w * 0.5, rect.y + rect.h * 0.5];
+        let desktop = window.rect()?;
+        self.pointer = Some([
+            desktop[0] as f32 + point[0] / scale,
+            desktop[1] as f32 + point[1] / scale,
+        ]);
+        shell.desktop_pointer = self.pointer;
+        self.trace.push(json!({"journey":CASES[self.index],"phase":self.phase,"frame":self.frame,"control":id,
+            "pointer":point,"desktop":self.pointer,"scale":scale,"rect":[rect.x,rect.y,rect.w,rect.h],"ingress":"raw SDL pointer"}));
+        native::motion(window, point, scale, events)?;
+        native::button(window, true, events)?;
+        native::button(window, false, events)
+    }
+    pub(super) fn reveal(
+        &mut self,
+        shell: &mut Shell,
+        window: &Window,
+        scale: f32,
+        id: &str,
+        events: &mut Vec<(u32, Event)>,
+    ) -> ara_ui::Result<bool> {
+        if visible(shell, id) {
+            return Ok(true);
+        }
+        let Some(index) = shell.ui.find(id) else {
+            return Ok(false);
+        };
+        let node = &shell.ui.nodes[index];
+        let clip = node.clip;
+        if clip.w > 1. && clip.h > 1. {
+            let delta = if node.rect.y < clip.y { 3. } else { -3. };
+            let point = [clip.x + clip.w * 0.5, clip.y + clip.h * 0.5];
+            let desktop = window.rect()?;
+            self.pointer = Some([
+                desktop[0] as f32 + point[0] / scale,
+                desktop[1] as f32 + point[1] / scale,
+            ]);
+            shell.desktop_pointer = self.pointer;
+            native::motion(window, point, scale, events)?;
+            native::wheel(window, delta, events)?;
+        }
+        Ok(false)
+    }
+}
+
+pub(super) fn show(editor: &mut Editor, shell: &mut Shell, panel: &str) -> ara_ui::Result<()> {
+    shell.leave();
+    editor.action("editor.layout.show", json!({"panel":panel}))?;
+    editor.action("editor.focus", json!({"panel":panel}))?;
+    editor.action("editor.view", json!({"maximized":panel}))?;
+    shell.rebuild(editor)
+}
+pub(super) fn visible(shell: &Shell, id: &str) -> bool {
+    shell.shown_node(id).is_some_and(|index| {
+        let node = &shell.ui.nodes[index];
+        let rect = node.rect.intersection(node.clip);
+        rect.w > 1. && rect.h >= node.rect.h * 0.75
+    })
+}
+pub(super) fn checked(shell: &Shell, id: &str) -> bool {
+    shell
+        .shown_node(id)
+        .and_then(|index| shell.ui.nodes[index].element.attrs.get("class"))
+        .is_some_and(|classes| {
+            classes
+                .split_whitespace()
+                .any(|class| matches!(class, "selected" | "segment-on"))
+        })
+}
