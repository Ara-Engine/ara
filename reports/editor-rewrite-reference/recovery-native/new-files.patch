--- /dev/null
+++ b/crates/ara-editor/src/app/recovery_verify.rs
@@ -0,0 +1,354 @@
+//! Real C# fault/recovery proof; measured controls enter through the native SDL router.
+mod fixture;
+pub(super) use fixture::prepare;
+mod input;
+mod observe;
+mod proof;
+use crate::{Editor, gpu::NativeUi, shell::Shell};
+use ara_platform::{Event, Window};
+use ara_ui_text::Clipboard;
+use serde_json::{Value, json};
+use std::{
+    collections::BTreeMap,
+    path::{Path, PathBuf},
+    time::{Duration, Instant},
+};
+
+const PREFIX: &str = "P4 Recovery";
+const ENTITY: &str = "e_recovery_native";
+const STEP_LIMIT: Duration = Duration::from_secs(120);
+const TOTAL_LIMIT: Duration = Duration::from_secs(300);
+const CASES: &[&str] = &[
+    "real-system-command-faults-two-scopes",
+    "console-managed-stack-pdb-source-native",
+    "reload-button-native-and-observed-pending-input",
+    "trusted-retirement-and-console-identity-retention",
+    "later-command-fault-reactivates-problems",
+    "reload-command-palette-native",
+    "reload-then-stop-native-refusal-retains-faults",
+    "retire-owned-worlds-and-restore-editor",
+];
+
+#[derive(Default)]
+struct MemoryClipboard(String);
+impl Clipboard for MemoryClipboard {
+    fn read(&mut self) -> ara_ui_text::Result<String> {
+        Ok(self.0.clone())
+    }
+    fn write(&mut self, value: &str) -> ara_ui_text::Result<()> {
+        self.0 = value.into();
+        Ok(())
+    }
+}
+
+/// One bounded proof, owned by an offscreen loop with a fresh scratch project/profile.
+pub(super) struct RecoveryCheck {
+    output: PathBuf,
+    index: usize,
+    phase: u32,
+    began: Instant,
+    phase_began: Instant,
+    frame: u64,
+    events: usize,
+    case_events: usize,
+    fixture: fixture::Fixture,
+    bus: observe::Bus,
+    baseline: BTreeMap<u64, observe::Identity>,
+    marker: Option<Value>,
+    marker_began: Option<Instant>,
+    request_cursor: u64,
+    refusal_ticket: Option<u64>,
+    command_first: Option<u64>,
+    source_frame: Option<observe::SourceFrame>,
+    source_intent: Option<Value>,
+    pointer: Option<[f32; 2]>,
+    pending_observed: bool,
+    pending_at_typing: bool,
+    ui_pending_at_typing: bool,
+    pending_frames: u64,
+    typing_frame: Option<u64>,
+    pending_max_ms: f64,
+    runtime_job: Option<String>,
+    runtime_after: Option<Value>,
+    requested_capture: Option<&'static str>,
+    complete: Option<Value>,
+    error: Option<String>,
+    results: Vec<Value>,
+    trace: Vec<Value>,
+    clipboard: MemoryClipboard,
+    saved_focus: String,
+    saved_maximized: Option<String>,
+    saved_searches: [String; 2],
+    saved_ide: bool,
+}
+impl RecoveryCheck {
+    pub fn new(editor: &mut Editor, shell: &mut Shell, output: &Path) -> ara_ui::Result<Self> {
+        if !shell.offscreen || !editor.host.root().join(".ara-recovery-fixture").is_file() {
+            return Err("Recovery proof requires the isolated offscreen recovery fixture".into());
+        }
+        if editor.play_world.is_some() || shell.modal_active() || editor.gesture.is_some() {
+            return Err(
+                "Recovery proof requires no preceding Play, modal or authoring gesture".into(),
+            );
+        }
+        let profile =
+            std::env::var_os("ARA_CONFIG_DIR").ok_or("Recovery proof needs an isolated profile")?;
+        if !std::path::absolute(Path::new(&profile))?
+            .starts_with(std::path::absolute(output)?.join(".ara-profile"))
+        {
+            return Err(
+                "Recovery proof refused a profile outside its fresh output directory".into(),
+            );
+        }
+        std::fs::create_dir_all(output)?;
+        shell.leave();
+        let saved_ide = shell.open_ide;
+        shell.open_ide = false;
+        let cursor = editor.action("logs", json!({"limit":1}))?["cursor"]
+            .as_u64()
+            .ok_or("logs cursor missing")?;
+        Ok(Self {
+            output: output.into(),
+            index: 0,
+            phase: 0,
+            began: Instant::now(),
+            phase_began: Instant::now(),
+            frame: 0,
+            events: 0,
+            case_events: 0,
+            fixture: Default::default(),
+            bus: observe::Bus::new(cursor),
+            baseline: BTreeMap::new(),
+            marker: None,
+            marker_began: None,
+            request_cursor: cursor,
+            refusal_ticket: None,
+            command_first: None,
+            source_frame: None,
+            source_intent: None,
+            pointer: None,
+            pending_observed: false,
+            pending_at_typing: false,
+            ui_pending_at_typing: false,
+            pending_frames: 0,
+            typing_frame: None,
+            pending_max_ms: 0.,
+            requested_capture: Some("before"),
+            complete: None,
+            runtime_job: None,
+            runtime_after: None,
+            error: None,
+            results: Vec::new(),
+            trace: Vec::new(),
+            clipboard: Default::default(),
+            saved_focus: editor.state.focus.clone(),
+            saved_maximized: editor.state.maximized.clone(),
+            saved_searches: [
+                editor
+                    .state
+                    .searches
+                    .get("console")
+                    .cloned()
+                    .unwrap_or_default(),
+                editor
+                    .state
+                    .searches
+                    .get("problems")
+                    .cloned()
+                    .unwrap_or_default(),
+            ],
+            saved_ide,
+        })
+    }
+    pub fn finished(&self) -> bool {
+        self.index == CASES.len() || self.error.is_some()
+    }
+    /// Request a fresh target0 draw only for captures or a completed case.
+    pub fn wants_frame(&self) -> bool {
+        !self.finished() && (self.requested_capture.is_some() || self.complete.is_some())
+    }
+    pub fn failures(&self) -> Vec<String> {
+        self.results
+            .iter()
+            .filter(|row| row["ok"] != true)
+            .filter_map(|row| row["journey"].as_str().map(str::to_owned))
+            .collect()
+    }
+    pub fn clipboard(&mut self) -> &mut dyn Clipboard {
+        &mut self.clipboard
+    }
+    fn next(&mut self) {
+        self.phase += 1;
+        self.phase_began = Instant::now();
+    }
+    fn done(&mut self, evidence: Value) {
+        self.complete = Some(evidence);
+    }
+    fn fail(&mut self, error: &str, shell: &Shell) -> ara_ui::Result<()> {
+        self.error = Some(error.into());
+        self.results.push(
+            json!({"journey":CASES.get(self.index),"ok":false,"phase":self.phase,"error":error,
+            "observed":self.snapshot(shell)}),
+        );
+        self.write()
+    }
+    pub fn inject(
+        &mut self,
+        editor: &mut Editor,
+        shell: &mut Shell,
+        window: &Window,
+        scale: f32,
+        events: &mut Vec<(u32, Event)>,
+    ) -> ara_ui::Result<()> {
+        if self.finished() {
+            return Ok(());
+        }
+        self.frame += 1;
+        if self.began.elapsed() >= TOTAL_LIMIT || self.phase_began.elapsed() >= STEP_LIMIT {
+            let message = format!(
+                "Native recovery exceeded its wall-clock bound at {} phase{} (total {:.1}s, phase {:.1}s)",
+                CASES[self.index],
+                self.phase,
+                self.began.elapsed().as_secs_f64(),
+                self.phase_began.elapsed().as_secs_f64()
+            );
+            self.fail(&message, shell)?;
+            return Err(message.into());
+        }
+        if let Some(point) = self.pointer {
+            shell.desktop_pointer = Some(point);
+        }
+        if self.complete.is_some() {
+            return Ok(());
+        }
+        let before = events.len();
+        let result = self
+            .bus
+            .poll(editor)
+            .and_then(|()| self.input(editor, shell, window, scale, events));
+        self.events += events.len() - before;
+        self.case_events += events.len() - before;
+        if let Err(error) = &result {
+            self.fail(&error.to_string(), shell)?;
+        }
+        result
+    }
+    pub fn end(
+        &mut self,
+        editor: &mut Editor,
+        shell: &mut Shell,
+        gpu: &mut NativeUi,
+        main_ui_submitted: bool,
+        frame_ms: f64,
+    ) -> ara_ui::Result<()> {
+        let result = self.end_frame(editor, shell, gpu, main_ui_submitted, frame_ms);
+        if let Err(error) = &result {
+            self.fail(&error.to_string(), shell)?;
+        }
+        result
+    }
+    fn end_frame(
+        &mut self,
+        editor: &mut Editor,
+        shell: &mut Shell,
+        gpu: &mut NativeUi,
+        main_ui_submitted: bool,
+        frame_ms: f64,
+    ) -> ara_ui::Result<()> {
+        if self.finished() {
+            return Ok(());
+        }
+        self.bus.poll(editor)?;
+        if shell.script_recovery_busy() {
+            self.pending_observed = true;
+            self.pending_frames += 1;
+            if frame_ms.is_finite() {
+                self.pending_max_ms = self.pending_max_ms.max(frame_ms);
+            }
+        }
+        if !main_ui_submitted {
+            return Ok(());
+        }
+        if let Some(stage) = self.requested_capture.take() {
+            let stage = if stage == "pending" {
+                self.bus.force(editor)?;
+                if !shell.script_recovery_busy()
+                    || self
+                        .bus
+                        .marker(self.request_cursor, self.fixture.a()?)?
+                        .is_some()
+                {
+                    "after-click-completion-already-observed"
+                } else {
+                    stage
+                }
+            } else {
+                stage
+            };
+            self.capture(shell, gpu, stage)?;
+        }
+        if let Some(complete) = self.complete.take() {
+            self.capture(shell, gpu, "after")?;
+            self.results.push(json!({"journey":CASES[self.index],"ok":true,"nativeEvents":self.case_events,"observed":complete,"after":self.snapshot(shell)}));
+            self.index += 1;
+            self.phase = 0;
+            self.case_events = 0;
+            self.phase_began = Instant::now();
+            self.requested_capture = (!self.finished()).then_some("before");
+            self.write()?;
+        }
+        Ok(())
+    }
+    fn capture(&self, shell: &Shell, gpu: &mut NativeUi, stage: &str) -> ara_ui::Result<()> {
+        gpu.select_target(0);
+        let stem = format!(
+            "recovery-{:02}-{}-{stage}",
+            self.index + 1,
+            CASES[self.index]
+        );
+        gpu.pixels()?
+            .save(self.output.join(format!("{stem}.png")))?;
+        std::fs::write(
+            self.output.join(format!("{stem}.layout.json")),
+            ara_json::to_canonical_string(&shell.layout_report()),
+        )?;
+        Ok(())
+    }
+    pub fn validate(&self) -> ara_ui::Result<()> {
+        if self.index != CASES.len() || self.error.is_some() || !self.failures().is_empty() {
+            return Err(format!(
+                "Native recovery incomplete: {:?}; {:?}",
+                self.failures(),
+                self.error
+            )
+            .into());
+        }
+        Ok(())
+    }
+    fn snapshot(&self, shell: &Shell) -> Value {
+        json!({"frame":self.frame,"phase":self.phase,"compileProjection":shell.compile_problem_state(),
+            "recoveryUI":shell.script_recovery_resource_report(),"problemRows":observe::rows(shell,"problem-"),
+            "consoleRows":observe::rows(shell,"log-"),"faults":self.bus.fault_report(),"marker":self.marker,
+            "ideIntent":self.source_intent,"refusalTicket":self.refusal_ticket,"pendingObserved":self.pending_observed,"pendingAtTyping":self.pending_at_typing,"uiPendingAtTyping":self.ui_pending_at_typing,
+            "pendingFrames":self.pending_frames,"typingFrame":self.typing_frame,"pendingMaxFrameMs":self.pending_max_ms})
+    }
+    pub fn write(&self) -> ara_ui::Result<()> {
+        std::fs::write(
+            self.output.join("script-recovery.json"),
+            ara_json::to_canonical_string(&json!({
+                "schema":1,"completed":self.index==CASES.len(),"failed":self.failures().len(),"passed":self.results.iter().filter(|row|row["ok"]==true).count(),
+                "error":self.error,"nativeEvents":self.events,"journeys":self.results,"trace":self.trace,
+                "fixture":self.fixture.report(),"runtimeAfter":self.runtime_after,"pending":{"nativeUiObserved":self.pending_observed,"uiPendingAtTypingInjection":self.ui_pending_at_typing,"noAuthoritativeCompletionObservedAtTypingInjection":self.pending_at_typing,
+                    "frames":self.pending_frames,"maxFrameMs":self.pending_max_ms,"timing":"informal (shared GPU); no frame-time gate",
+                    "coverage":if self.pending_at_typing {"Owned request was pending and no authoritative completion had been observed at native typing injection"} else {"Native backend-pending typing was not established; the controlled seven UI/channel tests cover pending behavior"}},
+                "limits":["Only captured actual C# system/command fault scopes and actual ARA0935 reloaded module batches are assessed; global Problems cleanliness is not claimed.",
+                    "Unchanged requires an empty real module graph; negative-module and Unchanged behavior are covered by the controlled projection suite, not manufactured as native results.",
+                    "Source clicks retain the exact suppressed IDE invocation; no external IDE or desktop window launches.",
+                    "Only a target0 frame submitted in the same loop iteration may be captured."],
+                "bounds":{"stepSeconds":120,"totalSeconds":300,"maxBusRecords":64,"maxTrace":128},
+                "current":{"journey":CASES.get(self.index),"phase":self.phase,"elapsedSeconds":self.began.elapsed().as_secs_f64()}
+            })),
+        )?;
+        Ok(())
+    }
+}
diff --git a/crates/ara-editor/src/app/recovery_verify/fixture.rs b/crates/ara-editor/src/app/recovery_verify/fixture.rs
new file mode 100644
--- /dev/null
+++ b/crates/ara-editor/src/app/recovery_verify/fixture.rs
@@ -0,0 +1,335 @@
+//! Same real ECS/system/nested-command paths as ara-player/tests/csharp.rs.
+use super::*;
+pub(super) const SOURCE: &str = "P4Recovery/RecoveryDraft.cs";
+pub(super) const FINAL_SOURCE: &str = "P4Recovery/RecoveryNative.cs";
+pub(super) const COMMAND: &str = "probe.recovery_native_fail";
+const CODE: &str = r#"using Ara;
+/// <summary>Native recovery proof state, held only in ECS.</summary>
+[Component] public partial struct RecoveryProbe {
+    /// <summary>Preserved update count.</summary>
+    public int Count;
+    /// <summary>Explicit system fault trigger.</summary>
+    public int Fault;
+}
+/// <summary>Real query fault and recovery path.</summary>
+public static partial class RecoveryDraft {
+    [Query] static void Run(ref RecoveryProbe p) {
+        if (p.Fault != 0) throw new System.InvalidOperationException("P4 Recovery system fault");
+        p.Count += 1;
+    }
+}
+/// <summary>Real nested command exception path.</summary>
+[Command("probe.recovery_native_fail")]
+public static partial class RecoveryFail {
+    /// <summary>Reports the original managed exception and inner cause.</summary>
+    /// <param name="ctx">The world command context.</param>
+    public static CommandResult Execute(ref CommandContext ctx) =>
+        throw new System.InvalidOperationException("P4 Recovery command fault", new System.ArgumentException("P4 Recovery inner cause"));
+}
+"#;
+
+/// Make a fresh minimal project before Host exists; no supplied project is touched.
+pub(in crate::app) fn prepare(options: &mut super::super::Options) -> ara_ui::Result<()> {
+    if options.verify_behaviours
+        || options.verify_profiler
+        || options.verify_monkey
+        || options.verify_journey
+        || options.verify_assets
+        || options.verify
+        || options.verify_panels
+        || options.verify_ux
+        || options.verify_docking
+        || options.verify_first_hour
+        || options.verify_responsiveness
+        || options.verify_unpresentable
+        || options.verify_scene_quality
+        || options.verify_loading
+        || options.headless
+        || options.play
+        || options.sample
+        || options.scene.is_some()
+        || options.select.is_some()
+        || options.panel.is_some()
+    {
+        return Err("Run --verify-script-recovery independently with its fresh fixture".into());
+    }
+    let output = std::path::absolute(&options.output)?;
+    std::fs::create_dir_all(&output)?;
+    let root = output.join(format!("recovery-project-{}", std::process::id()));
+    // No stale fixture may accidentally satisfy the source/schema/fault assertions.
+    std::fs::create_dir(&root)?;
+    let levels = root.join(ara_doc::AUTHORING_ROOT).join("levels");
+    std::fs::create_dir_all(&levels)?;
+    std::fs::write(
+        root.join("ara.project.json"),
+        ara_json::to_canonical_string(&json!({
+            "name":"Native C# recovery proof","layoutVersion":ara_doc::PROJECT_LAYOUT_VERSION,"main":"levels/main.scene"
+        })),
+    )?;
+    std::fs::write(
+        levels.join("main.scene"),
+        ara_json::to_canonical_string(&json!({
+            "$schema":"ara://schema/scene/1","id":"sc_recoverynative","records":{}
+        })),
+    )?;
+    std::fs::write(
+        root.join(".ara-recovery-fixture"),
+        "Ara isolated native C# recovery fixture\n",
+    )?;
+    options.project = root;
+    options.output = output;
+    Ok(())
+}
+#[derive(Default)]
+pub(super) struct Fixture {
+    phase: u32,
+    pending: Option<String>,
+    pub world_a: Option<String>,
+    pub world_b: Option<String>,
+    pub runtime_before: Option<Value>,
+    authored: Option<Value>,
+    writes: Vec<Value>,
+    cleanup_phase: u32,
+}
+impl Fixture {
+    pub fn a(&self) -> ara_ui::Result<&str> {
+        self.world_a
+            .as_deref()
+            .ok_or("Current recovery world missing".into())
+    }
+    pub fn b(&self) -> ara_ui::Result<&str> {
+        self.world_b
+            .as_deref()
+            .ok_or("Preserved recovery world missing".into())
+    }
+    pub fn poll(
+        &mut self,
+        editor: &mut Editor,
+        shell: &mut Shell,
+        bus: &observe::Bus,
+    ) -> ara_ui::Result<bool> {
+        match self.phase {
+            0 => {
+                let path = format!("{}/{SOURCE}", ara_doc::AUTHORING_ROOT);
+                self.queue(editor.action("cmd.apply",json!({"doc":editor.state.doc,"why":"Native recovery fixture: typed C# creation", "commands":[
+                    {"cmd":"source.replace","args":{"path":path,"baseHash":Value::Null,"text":CODE}}
+                ]}))?)?;
+                self.writes.push(json!({"operation":"source.replace","path":path,"baseHash":Value::Null,"ingress":"typed fixture authoring, not measured native input"}));
+            }
+            1 => {
+                if poll_job(editor, &mut self.pending)?.is_none() {
+                    return Ok(false);
+                }
+                self.queue(editor.action(
+                    "script.rename",
+                    json!({"path":SOURCE,"to":FINAL_SOURCE,"attachTo":[],"doc":editor.state.doc}),
+                )?)?;
+                self.writes.push(json!({"operation":"script.rename","from":SOURCE,"to":FINAL_SOURCE,"compile":true,
+                    "reason":"Normal source authoring job publishes the actual RecoveryProbe schema before creating its entity"}));
+            }
+            2 => {
+                if poll_job(editor, &mut self.pending)?.is_none() {
+                    return Ok(false);
+                }
+                if editor.host.store().schema().get("RecoveryProbe").is_none() {
+                    return Err("Real compiler job did not publish RecoveryProbe".into());
+                }
+                editor.apply(vec![json!({"cmd":"entity.create","args":{"id":ENTITY,"name":"Native recovery probe",
+                    "components":{"RecoveryProbe":{"count":41,"fault":1}}}})],"Native recovery fixture: real ECS probe",None)?;
+                self.authored = Some(authored(editor)?);
+                self.world_b = Some(start(editor)?);
+            }
+            3 => {
+                let world = self.b()?;
+                if !running(editor, world)? {
+                    return Ok(false);
+                }
+                fault(editor, world)?;
+            }
+            4 => {
+                if bus.faults(self.b()?).len() < 2 {
+                    return Ok(false);
+                }
+                self.world_a = Some(start(editor)?);
+            }
+            5 => {
+                let world = self.a()?;
+                if !running(editor, world)? {
+                    return Ok(false);
+                }
+                fault(editor, world)?;
+            }
+            6 => {
+                if bus.faults(self.a()?).len() < 2 {
+                    return Ok(false);
+                }
+                self.queue(editor.action(
+                    "play.patch",
+                    json!({"world":self.a()?,"background":true,
+                    "sets":[{"entity":ENTITY,"path":"RecoveryProbe.fault","value":0}]}),
+                )?)?;
+            }
+            7 => {
+                if poll_job(editor, &mut self.pending)?.is_none() {
+                    return Ok(false);
+                }
+                self.queue(editor.action("play.read",json!({"world":self.a()?,"background":true,
+                    "paths":[format!("{ENTITY}.RecoveryProbe.count"),format!("{ENTITY}.RecoveryProbe.fault")]}))?)?;
+            }
+            8 => {
+                let Some(runtime) = poll_job(editor, &mut self.pending)? else {
+                    return Ok(false);
+                };
+                if runtime["values"][format!("{ENTITY}.RecoveryProbe.count")] != 41
+                    || runtime["values"][format!("{ENTITY}.RecoveryProbe.fault")] != 0
+                {
+                    return Err(format!(
+                        "Real recovery fixture has unexpected ECS values: {runtime}"
+                    )
+                    .into());
+                }
+                self.runtime_before = Some(runtime);
+                // Navigation setup mirrors the actual running, paused world. It
+                // does not simulate a backend success or a measured gesture.
+                editor.action("editor.view", json!({"play":"paused"}))?;
+                shell.read_play_status(editor);
+                shell.rebuild(editor)?;
+            }
+            _ => return Ok(true),
+        }
+        self.phase += 1;
+        Ok(false)
+    }
+    fn queue(&mut self, result: Value) -> ara_ui::Result<()> {
+        self.pending = Some(
+            result["job"]
+                .as_str()
+                .ok_or("Fixture operation did not return its normal background job")?
+                .into(),
+        );
+        Ok(())
+    }
+    pub fn authored_unchanged(&self, editor: &Editor) -> ara_ui::Result<bool> {
+        Ok(self.authored.as_ref() == Some(&authored(editor)?))
+    }
+    pub fn cleanup(&mut self, editor: &mut Editor) -> ara_ui::Result<bool> {
+        match self.cleanup_phase {
+            0 => {
+                editor.action("play.stop", json!({"world":self.b()?}))?;
+            }
+            1 => {
+                if !retired(editor, self.b()?)? {
+                    return Ok(false);
+                }
+                editor.apply(
+                    vec![json!({"cmd":"entity.delete","args":{"entities":[ENTITY]}})],
+                    "Remove native recovery fixture actor",
+                    None,
+                )?;
+                self.queue(editor.action(
+                    "cmd.apply",
+                    json!({"doc":"ara.project.json","why":"Remove native recovery fixture source",
+                    "commands":[{"cmd":"asset.delete","args":{"source":FINAL_SOURCE}}]}),
+                )?)?;
+            }
+            2 => {
+                if poll_job(editor, &mut self.pending)?.is_none() {
+                    return Ok(false);
+                }
+                if editor
+                    .host
+                    .root()
+                    .join(ara_doc::AUTHORING_ROOT)
+                    .join(FINAL_SOURCE)
+                    .exists()
+                {
+                    return Err(
+                        "Typed cleanup completed before the fixture source was removed".into(),
+                    );
+                }
+            }
+            _ => return Ok(true),
+        }
+        self.cleanup_phase += 1;
+        Ok(false)
+    }
+    pub fn report(&self) -> Value {
+        json!({"source":FINAL_SOURCE,"writes":self.writes,"worldA":self.world_a,"worldB":self.world_b,
+        "runtimeBefore":self.runtime_before,"cleanupPhase":self.cleanup_phase,"setup":"Real compiler/schema publication, actual C# query and nested command faults; no diag.report fixture rows"})
+    }
+}
+fn authored(editor: &Editor) -> ara_ui::Result<Value> {
+    let record = editor
+        .host
+        .store()
+        .workspace()
+        .doc(&editor.state.doc)
+        .and_then(|doc| doc.record(ENTITY))
+        .ok_or("Authored recovery fixture actor missing")?;
+    Ok(json!(record))
+}
+fn start(editor: &mut Editor) -> ara_ui::Result<String> {
+    let result=editor.action("play.start",json!({"scene":editor.state.doc,"background":true,"window":false,"startPaused":true,"hotReload":false,"seed":77123,"tickHz":60}))?;
+    result["world"]
+        .as_str()
+        .map(str::to_owned)
+        .ok_or("Background Play omitted its owned world".into())
+}
+fn running(editor: &mut Editor, world: &str) -> ara_ui::Result<bool> {
+    let status = editor.action("play.status", json!({}))?;
+    let row = status["worlds"]
+        .as_array()
+        .and_then(|rows| rows.iter().find(|row| row["world"] == world))
+        .ok_or("Owned recovery world disappeared while starting")?;
+    if row["status"] == "failed" || !row["fault"].is_null() {
+        return Err(format!("Recovery world failed: {row}").into());
+    }
+    Ok(row["status"] == "running")
+}
+pub(super) fn retired(editor: &mut Editor, world: &str) -> ara_ui::Result<bool> {
+    let status = editor.action("play.status", json!({}))?;
+    Ok(!status["worlds"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .chain(status["stopping"].as_array().into_iter().flatten())
+        .any(|row| row["world"] == world))
+}
+fn fault(editor: &mut Editor, world: &str) -> ara_ui::Result<()> {
+    editor.action("play.step", json!({"world":world,"ticks":1}))?;
+    command_fault(editor, world)
+}
+pub(super) fn command_fault(editor: &mut Editor, world: &str) -> ara_ui::Result<()> {
+    // Expected runtime errors have already crossed normal Host ingress. Never
+    // report_failure/re-log their returned diagnostics from this verifier.
+    match editor.action(
+        "play.command",
+        json!({"world":world,"name":COMMAND,"params":{}}),
+    ) {
+        Err(_) => Ok(()),
+        Ok(result) if result["ok"] == false || result["isError"] == true => Ok(()),
+        Ok(result) => Err(format!("Real nested command unexpectedly succeeded: {result}").into()),
+    }
+}
+pub(super) fn poll_job(
+    editor: &mut Editor,
+    job: &mut Option<String>,
+) -> ara_ui::Result<Option<Value>> {
+    let id = job
+        .as_deref()
+        .ok_or("Recovery fixture lost its owned job")?;
+    let status = editor.action("jobs.status", json!({"job":id}))?;
+    match status["status"].as_str() {
+        Some("running" | "queued") => Ok(None),
+        Some("done") => {
+            job.take();
+            Ok(Some(
+                status
+                    .get("result")
+                    .ok_or("Completed fixture job omitted its result")?
+                    .clone(),
+            ))
+        }
+        _ => Err(format!("Recovery fixture job failed: {status}").into()),
+    }
+}
