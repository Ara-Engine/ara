+++ b/crates/ara-editor/src/app/recovery_verify/proof.rs
@@ -0,0 +1,128 @@
+//! Compare original Store identities, actual ARA0935 authority, and mounted Problems.
+use super::*;
+impl RecoveryCheck {
+    pub(super) fn arm(&mut self) -> ara_ui::Result<()> {
+        self.baseline = self.bus.identities()?;
+        self.request_cursor = self.bus.cursor;
+        self.marker = None;
+        self.marker_began = None;
+        Ok(())
+    }
+    pub(super) fn retirement_ready(
+        &mut self,
+        editor: &Editor,
+        shell: &Shell,
+    ) -> ara_ui::Result<bool> {
+        let world = self.fixture.a()?;
+        if self.marker.is_none() {
+            let Some(marker) = self.bus.marker(self.request_cursor, world)? else {
+                return Ok(false);
+            };
+            self.marker = Some(marker);
+            self.marker_began = Some(Instant::now());
+        }
+        let marker = self.marker.as_ref().ok_or("Recovery marker lost")?;
+        let seq = observe::number(&marker["seq"])?;
+        let data = &marker["diagnostic"]["data"];
+        let modules = data["recovery"]["modules"]
+            .as_array()
+            .ok_or("Recovery module batch missing")?;
+        let mut removed = 0;
+        let projection = shell.compile_problem_state();
+        let recovery = &projection["recovery"];
+        if recovery["invalidMarkers"] != 0
+            || recovery["omittedRecords"] != 0
+            || recovery["gapMarkers"] != 0
+        {
+            return Err(format!(
+                "Recovery projection cannot establish complete captured scope: {recovery}"
+            )
+            .into());
+        }
+        if recovery["lastMarker"]["seq"]
+            .as_u64()
+            .is_none_or(|seen| seen < seq)
+        {
+            return Ok(false);
+        }
+        let mounted = observe::rows(shell, "problem-");
+        for identity in self.baseline.values() {
+            let belongs = identity.scope == data["play"]
+                && modules
+                    .iter()
+                    .any(|module| module.as_str() == Some(identity.module.as_str()))
+                && identity.seq < seq;
+            let active = observe::active(shell, identity.seq);
+            if belongs {
+                removed += 1;
+                if active || mounted.contains(&identity.seq) {
+                    return Ok(false);
+                }
+            } else if !active || !mounted.contains(&identity.seq) {
+                return Err(format!(
+                    "An unrelated module/incarnation fault disappeared from actual Problems: {}",
+                    identity.report()
+                )
+                .into());
+            }
+        }
+        if removed < 1 {
+            return Err(
+                "The actual successful batch did not own any captured earlier runtime fault".into(),
+            );
+        }
+        if shell.script_recovery_busy()
+            || self
+                .marker_began
+                .is_none_or(|start| start.elapsed() < Duration::from_millis(600))
+        {
+            return Ok(false);
+        }
+        if !self.bus.unchanged(&self.baseline)? {
+            return Err("Returned Status diagnostics were replayed or another occurrence changed the paused fixture fault identities/counts".into());
+        }
+        if !self.fixture.authored_unchanged(editor)? {
+            return Err("C# reload changed the authored RecoveryProbe record".into());
+        }
+        Ok(true)
+    }
+    pub(super) fn retired_evidence(&self, shell: &Shell) -> Value {
+        json!({"marker":self.marker,"before":self.baseline.values().map(observe::Identity::report).collect::<Vec<_>>(),
+            "afterStore":self.bus.fault_report(),"problemsMounted":observe::rows(shell,"problem-"),
+            "projection":shell.compile_problem_state(),"statusDisplay":shell.script_recovery_resource_report(),
+            "authority":"original normal-ingress ARA0935 exact module batch + trusted world/player/source/binding; no Status-driven retirement"})
+    }
+    pub(super) fn source_intent(&self, shell: &Shell) -> ara_ui::Result<Value> {
+        let source = self
+            .source_frame
+            .as_ref()
+            .ok_or("Authored PDB frame missing")?;
+        let expected = Path::new(&source.file).canonicalize()?;
+        let expected = expected.to_str().ok_or("PDB source path is not UTF-8")?;
+        let column = source.column.unwrap_or(1);
+        let request = shell.script_ide_request();
+        if request["targetFile"] != expected
+            || request["line"] != source.line
+            || request["column"] != column
+            || request["launchSuppressed"] != true
+            || request["attempted"] != false
+            || request["outcome"] != "suppressed"
+            || !request["error"].is_null()
+        {
+            return Err(format!("Native PDB source click did not retain the exact suppressed file/line/column: {request}").into());
+        }
+        if let Some(fallback) = request.get("fallback").filter(|value| !value.is_null())
+            && (fallback["launchSuppressed"] != true
+                || fallback["attempted"] != false
+                || fallback["outcome"] != "suppressed")
+        {
+            return Err(
+                "PDB source click attempted its external fallback in a hidden verification run"
+                    .into(),
+            );
+        }
+        Ok(
+            json!({"pdb":source.report(),"intent":request,"sink":"existing retained literal IDE request under offscreen suppression; no process launch"}),
+        )
+    }
+}
