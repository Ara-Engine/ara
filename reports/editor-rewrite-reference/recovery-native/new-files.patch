@@ -0,0 +1,133 @@
+//! Native SDL actions for the real recovery proof.
+use super::*;
+
+impl RecoveryCheck {
+    pub(super) fn exception(
+        &mut self,
+        editor: &mut Editor,
+        shell: &mut Shell,
+        window: &Window,
+        scale: f32,
+        events: &mut Vec<(u32, Event)>,
+    ) -> ara_ui::Result<()> {
+        let row = self.bus.fault(self.fixture.a()?, "ARA0912")?;
+        let seq = observe::number(&row["seq"])?;
+        match self.phase {
+            0 => {
+                show(editor, shell, "console")?;
+                if !checked(shell, "console-errors") {
+                    self.click(shell, window, scale, "console-errors", events)?;
+                }
+                if checked(shell, "console-collapse") {
+                    self.click(shell, window, scale, "console-collapse", events)?;
+                }
+                self.next();
+            }
+            1 => {
+                self.search(
+                    shell,
+                    window,
+                    scale,
+                    "console",
+                    "P4 Recovery command fault",
+                    events,
+                )?;
+                self.next();
+            }
+            2 => {
+                if !observe::rows(shell, "log-").contains(&seq) {
+                    return Ok(());
+                }
+                let id = format!("log-{seq}-row");
+                if self.reveal(shell, window, scale, &id, events)? {
+                    self.click(shell, window, scale, &id, events)?;
+                    self.next();
+                }
+            }
+            3 => {
+                let source = editor
+                    .host
+                    .root()
+                    .join(ara_doc::AUTHORING_ROOT)
+                    .join(fixture::FINAL_SOURCE)
+                    .canonicalize()?;
+                self.source_frame = Some(observe::stack(shell, row, &source)?);
+                self.command_first = Some(observe::number(&row["first"])?);
+                self.requested_capture = Some("full-managed-stack");
+                self.next();
+            }
+            4 => {
+                let id = format!("log-{seq}-stack-type-1");
+                if self.reveal(shell, window, scale, &id, events)? {
+                    self.requested_capture = Some("inner-cause-visible");
+                    self.next();
+                }
+            }
+            5 => {
+                let frame = self
+                    .source_frame
+                    .as_ref()
+                    .ok_or("Original source frame missing")?;
+                let id = format!("log-{seq}-stack-frame-{}-source", frame.index);
+                if self.reveal(shell, window, scale, &id, events)? {
+                    self.click(shell, window, scale, &id, events)?;
+                    self.next();
+                }
+            }
+            _ => {
+                self.source_intent = Some(self.source_intent(shell)?);
+                self.done(json!({"originalDiagnostic":row,"fullStackMounted":true,"pdbSourceIntent":self.source_intent,
+                    "ingress":"native Console search, row expansion, stack scrolling and PDB source click; IDE launch suppressed"}));
+            }
+        }
+        Ok(())
+    }
+    pub(super) fn repeated_fault(
+        &mut self,
+        editor: &mut Editor,
+        shell: &mut Shell,
+        window: &Window,
+        scale: f32,
+        events: &mut Vec<(u32, Event)>,
+    ) -> ara_ui::Result<()> {
+        match self.phase {
+            0 => {
+                fixture::command_fault(editor, self.fixture.a()?)?;
+                show(editor, shell, "problems")?;
+                self.next();
+            }
+            1 => {
+                self.search(shell, window, scale, "problems", PREFIX, events)?;
+                self.next();
+            }
+            _ => {
+                let first = self
+                    .command_first
+                    .ok_or("Original command identity missing")?;
+                let row = self.bus.row(first)?;
+                let before = self
+                    .baseline
+                    .get(&first)
+                    .ok_or("Original command baseline missing")?;
+                let marker = self
+                    .marker
+                    .as_ref()
+                    .ok_or("Prior actual recovery marker missing")?;
+                let seq = observe::number(&row["seq"])?;
+                if seq <= observe::number(&marker["seq"])?
+                    || observe::number(&row["count"])? <= before.count
+                {
+                    return Ok(());
+                }
+                if !observe::active(shell, seq) || !observe::rows(shell, "problem-").contains(&seq)
+                {
+                    return Ok(());
+                }
+                self.done(json!({"first":first,"newSeq":seq,"newCount":row["count"],"oldSeq":before.seq,"oldCount":before.count,
+                    "afterMarker":marker["seq"],"activeProblemsRow":seq,"fault":row,
+                    "ingress":"real C# command executed again after actual activation, not diagnostic reinjection"}));
+            }
+        }
+        Ok(())
+    }
+}
