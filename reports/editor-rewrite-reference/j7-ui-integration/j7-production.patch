+        assert_eq!(super::super::view_mode("gi_diffuse"), ara_render::capture::ViewMode::GiDiffuse);
+        assert_eq!(super::super::view_mode("overdraw"), ara_render::capture::ViewMode::Overdraw);
+    }
 }
