<Project Sdk="Microsoft.NET.Sdk">
  <!-- Machine-applicable fixes for the Ara analyzers (kept apart from them, since code
       fixes need Roslyn Workspaces and analyzers must not). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <ProjectReference Include="../Ara.Analyzers/Ara.Analyzers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Ara.Generators/Polyfills.cs" Link="Polyfills.cs" />
  </ItemGroup>
</Project>
