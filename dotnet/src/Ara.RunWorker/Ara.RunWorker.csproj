<Project Sdk="Microsoft.NET.Sdk">
  <!-- The ara_run worker: a warm out-of-process runner for agent C# scripts. Compiles a
       script against Ara.Agent only, checks its IL against a whitelist, runs it in a
       collectible ALC, and talks to its supervisor over stdin/stdout JSON lines. The
       supervisor enforces wall-clock and memory limits and kills the worker on violation. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ara.RunWorker</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.3.0" />
    <ProjectReference Include="../Ara.Agent/Ara.Agent.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ara.RunWorker.Tests" />
  </ItemGroup>
</Project>
