<Project Sdk="Microsoft.NET.Sdk">
  <!-- The warm, out-of-process compile server (decision A13): retained Roslyn compilations per
       module, the Ara generator and analyzers, the L1/L3 edit classifier and EnC baselines.
       It ships PE/PDB images and EnC deltas to the game process over a named pipe, so
       Roslyn's CPU and GC never stall ticks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ara.CompileServer</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Workstation, non-concurrent GC: the footprint stays small next to the editor, and the GC budgets gen0 by cache size
         instead of the much smaller concurrent budget. A compile allocates 100-160 MB in ~100 ms; with background GC an L3 ran
         ~10 gen0 and 3 gen1 collections (44 ms of GC pause in a 122 ms compile, 135 ms in the initial compile). Without it the
         same compile has 1-2 collections (benchmarks/iteration/SERVER_GC.md). Blocking gen2 collections happen in the compile
         server, never in the game process. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- ReadyToRun (below) makes Roslyn start without JIT, so the server tiers normally. Without it
         (-p:AraReadyToRun=false) every Roslyn method would run at tier 0 for many edits, so keep
         the older no-tiering setting: every method is JIT-optimized on first use. -->
    <TieredCompilation Condition="'$(AraReadyToRun)' == 'false'">false</TieredCompilation>
    <TieredPGO Condition="'$(AraReadyToRun)' != 'false'">false</TieredPGO>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AraReadyToRun)' != 'false'">
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Keep outputs at artifacts/bin/<Project>/release; the host looks there. -->
    <ArtifactsPivots>$(Configuration.ToLowerInvariant())</ArtifactsPivots>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="5.3.0" />
    <!-- Only for the shared ABI constants (reload kinds, escalation codes). -->
    <ProjectReference Include="../Ara.Runtime/Ara.Runtime.csproj" />
    <ProjectReference Include="../Ara.Editor/Ara.Editor.csproj" />
    <ProjectReference Include="../Ara.Generators/Ara.Generators.csproj" />
    <ProjectReference Include="../Ara.Analyzers/Ara.Analyzers.csproj" />
    <ProjectReference Include="../Ara.Analyzers.CodeFixes/Ara.Analyzers.CodeFixes.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(AraReadyToRun)' != 'false'">
    <!-- Start promoting hot Roslyn methods to tier 1 at once instead of after a 100 ms quiet period:
         without it the first ~30 edits ran 5-10% slower than the old no-tiering server. -->
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ara.CompileServer.Tests" />
  </ItemGroup>
  <!-- After every build, publish-with-ReadyToRun into obj/ and copy the precompiled assemblies over the
       build output. Roslyn ships IL only, so a cold server spent ~1.2 s of a 2.4 s start JIT-compiling it
       (docs/dev/script-host-benchmarks.md). The inner publish sets AraInnerPublish to stop recursion. -->
  <Target Name="AraReadyToRun" AfterTargets="Build" Condition="'$(AraReadyToRun)' != 'false' and '$(AraInnerPublish)' != 'true'">
    <PropertyGroup>
      <!-- IntermediateOutputPath is already absolute under ArtifactsPath; NormalizeDirectory resolves either form. -->
      <_AraR2RDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'r2r'))</_AraR2RDir>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="NoBuild=true;AraInnerPublish=true;PublishDir=$(_AraR2RDir)" />
    <ItemGroup>
      <_AraR2RFile Include="$(_AraR2RDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_AraR2RFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
