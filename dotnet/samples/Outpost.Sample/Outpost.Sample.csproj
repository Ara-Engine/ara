<Project Sdk="Microsoft.NET.Sdk">
  <!-- The R10 sample module (Door behaviour, UseMedkit command, Gravity system). In dev the
       compile server compiles this folder from ara.module.toml; this project gives IDEs the
       same view (generator + analyzers) and feeds the NativeAOT sample. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Outpost.Sample</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same global usings the compile server adds. -->
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
    <Using Include="System.Numerics" />
    <Using Include="Ara" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Ara.Runtime/Ara.Runtime.csproj" />
    <ProjectReference Include="../../src/Ara.Generators/Ara.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Ara.Analyzers/Ara.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Ara.Analyzers.CodeFixes/Ara.Analyzers.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
