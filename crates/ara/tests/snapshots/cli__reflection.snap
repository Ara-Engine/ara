        }
      ]
    },
    "entity.reparent": {
      "kind": "command",
      "summary": "Move an entity under a new parent (or to the root) at a position among its siblings.",
      "params": "EntityReparentParams",
      "hints": {
        "idempotent": true,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
