      "doc": "Authored raw-geometry navigation surface; its derived mesh is content-addressed.",
      "module": "navigation",
      "fields": {
        "profiles": {
          "type": "list<u32>",
          "doc": "Shared bake profiles to generate from this surface.",
          "default": []
        },
        "geometry": {
          "type": "option<asset>",
          "doc": "Source collision geometry asset, resolved by the asset/physics integration.",
          "default": null
        },
        "min": {
          "type": "vec3",
          "doc": "World-space lower bake bound.",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "max": {
          "type": "vec3",
          "doc": "World-space upper bake bound.",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "cellSize": {
          "type": "f32",
          "doc": "Horizontal voxel size in metres.",
          "default": 0.2,
          "unit": "m",
          "range": [0.01, 10]
        },
        "tileSize": {
          "type": "u16",
          "doc": "Interior tile width in voxels.",
          "default": 64,
          "range": [8, 256]
        }
      }
    },
    "OverrideRevertParams": {
      "kind": "params",
      "doc": "Parameters of `prefab.override.revert`.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "A prefab instance, or an entity inside one.",
          "required": true
        },
        "path": {
          "type": "option<string>",
          "doc": "The overridden path to revert, with everything under it; absent reverts every override and removal on this entity.",
          "default": null
        }
      }
    },
    "OverrideSetParams": {
      "kind": "params",
      "doc": "Parameters of `prefab.override.set`.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "A prefab instance, or an entity inside one (`e_4f9a/e_m4tz`).",
          "required": true
        },
        "path": {
          "type": "string",
          "doc": "Field path: `name`, a component (`Light`) or a component field (`Light.color`).",
          "required": true
        },
        "value": {
          "type": "json",
          "doc": "The overriding value.",
          "required": true
        }
      }
    },
    "PhysicsId": {
      "kind": "component",
      "doc": "Stable simulation identity; nonzero and unique within a physics world.",
      "module": "physics",
      "fields": {
        "value": {
          "type": "u64",
          "doc": "Stable scene/network identity, used to sort creation and inputs across peers.",
          "default": 1,
          "range": [1, null]
        }
      }
    },
    "PhysicsPose": {
      "kind": "component",
      "doc": "Resolved world-space pose in meters. Hierarchy/scale resolution runs before physics.",
      "module": "physics",
      "fields": {
        "position": {
          "type": "vec3",
          "doc": "Body origin or character feet, in world space.",
          "default": [0, 0, 0],
          "unit": "m",
          "replicate": {
            "audience": "relevant",
            "interpolate": "linear",
            "rollback": true
          }
        },
        "rotation": {
          "type": "quat",
          "doc": "Unit quaternion in XYZW order; use baked rotations for cross-platform replay.",
          "default": [0, 0, 0, 1],
          "replicate": {
            "audience": "relevant",
            "interpolate": "slerp",
            "rollback": true
          }
        }
      }
    },
    "PlayerControl": {
      "kind": "component",
      "doc": "Drives this entity's CharacterController from `Move`, `Sprint` and `Jump`, relative to its camera rig's yaw.",
      "module": "gameplay",
      "fields": {
        "player": {
          "type": "u64",
          "doc": "Input owner (`PlayerId`).",
          "default": 1
        },
        "walkSpeed": {
          "type": "f32",
          "doc": "Walking speed.",
          "default": 1.6,
          "unit": "m/s",
          "range": [0, null]
        },
        "runSpeed": {
          "type": "f32",
          "doc": "Sprinting speed.",
          "default": 4.5,
          "unit": "m/s",
          "range": [0, null]
        },
        "jumpSpeed": {
          "type": "f32",
          "doc": "Jump launch speed.",
          "default": 4.5,
          "unit": "m/s",
          "range": [0, null]
        },
        "turnRate": {
          "type": "f32",
          "doc": "Maximum turn rate toward the movement direction.",
          "default": 540,
          "unit": "deg/s",
          "range": [0, null]
        },
        "yaw": {
          "type": "f32",
          "doc": "Facing yaw; 0 faces +Z. Simulation state.",
          "default": 0,
          "unit": "deg"
        },
        "camera": {
          "type": "option<entity>",
          "doc": "Camera rig whose yaw orients `Move`; world axes when empty.",
          "default": null
        }
      }
    },
    "PrefabInstantiateParams": {
      "kind": "params",
      "doc": "Parameters of `prefab.instantiate`.",
      "fields": {
        "prefab": {
          "type": "asset<prefab>",
          "doc": "The prefab, as `@path#id`, `@path` or `@#id`.",
          "required": true
        },
        "id": {
          "type": "option<string>",
          "doc": "ID of the instance: a symbol (`$door`) or a concrete unused record ID. Minted when absent.",
          "default": null
        },
        "name": {
          "type": "option<string>",
          "doc": "Display name; absent keeps the prefab root's name.",
          "default": null
        },
        "parent": {
          "type": "option<entity>",
          "doc": "Parent entity; absent creates a root.",
          "default": null
        },
        "index": {
          "type": "option<u32>",
          "doc": "Position among the parent's children; absent appends.",
          "default": null
        },
        "position": {
          "type": "option<vec3>",
          "doc": "Local position of the instance.",
          "default": null,
          "unit": "m"
        }
      }
    },
    "PropertySetParams": {
      "kind": "params",
      "doc": "Parameters of `property.set`.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Target entity; inside a prefab instance this writes an override.",
          "required": true
        },
        "path": {
          "type": "string",
          "doc": "Field path: `name`, or a component field such as `Light.intensity` or `Transform.position.y`.",
          "required": true
        },
        "value": {
          "type": "json",
          "doc": "New value, in the field's schema type and unit.",
          "required": true
        }
      }
    },
    "RigidBody": {
      "kind": "component",
      "doc": "Rigid-body authoring settings; simulation state is written to pose and velocity.",
      "module": "physics",
      "fields": {
        "motion": {
          "type": "MotionType",
          "doc": "Static, kinematic, or dynamic motion.",
          "default": "static",
          "options": [
            "static",
            "kinematic",
            "dynamic"
          ]
        },
        "mass": {
          "type": "f32",
          "doc": "Mass in kilograms; zero computes mass from the collider's 1000 kg/m3 density.",
          "default": 0,
          "unit": "kg",
          "range": [0, null]
        },
        "allowSleep": {
          "type": "bool",
          "doc": "Permit inactive bodies to sleep.",
          "default": true
        },
        "continuous": {
          "type": "bool",
          "doc": "Use swept collision detection for fast bodies.",
          "default": false
        }
      }
    },
    "Transform": {
      "kind": "component",
      "doc": "Position, rotation and scale of an entity relative to its parent.",
      "module": "core",
      "fields": {
        "position": {
          "type": "vec3",
          "doc": "Position relative to the parent.",
          "default": [0, 0, 0],
          "unit": "m",
          "examples": [
            [0, 1, 0]
          ],
          "replicate": {
            "audience": "relevant",
            "quantize": 0.001,
            "interpolate": "linear",
            "rollback": true
          }
        },
        "rotation": {
          "type": "vec3",
          "doc": "Rotation relative to the parent, as XYZ Euler angles.",
          "default": [0, 0, 0],
          "unit": "deg",
          "examples": [
            [0, 90, 0]
          ],
          "replicate": {
            "audience": "relevant",
            "quantize": 0.01,
            "interpolate": "slerp",
            "rollback": true
          }
        },
        "scale": {
          "type": "vec3",
          "doc": "Scale relative to the parent; `[1, 1, 1]` is unscaled.",
          "default": [1, 1, 1],
          "examples": [
            [2, 2, 2]
          ]
        }
      }
    },
    "TransformSetParams": {
      "kind": "params",
      "doc": "Parameters of `transform.set`.",
      "fields": {
        "entities": {
          "type": "list<entity>",
          "doc": "Entities to change; each gets a `Transform` if it has none.",
          "required": true
        },
        "position": {
          "type": "option<vec3>",
          "doc": "Position relative to the parent.",
          "default": null,
          "unit": "m"
        },
        "rotation": {
          "type": "option<vec3>",
          "doc": "Rotation relative to the parent, as XYZ Euler angles.",
          "default": null,
          "unit": "deg"
        },
        "scale": {
          "type": "option<vec3>",
          "doc": "Scale relative to the parent.",
          "default": null
        }
      }
    },
    "Vehicle": {
      "kind": "component",
      "doc": "Four-wheel engine/automatic-gearbox vehicle, using S6's stable defaults.",
      "module": "physics",
      "fields": {
        "halfExtents": {
          "type": "vec3",
          "doc": "Chassis half extents.",
          "default": [0.9, 0.2, 2],
          "unit": "m",
          "range": [0.001, null]
        },
        "mass": {
          "type": "f32",
          "doc": "Chassis mass.",
          "default": 1500,
          "unit": "kg",
          "range": [0.001, null]
        },
        "wheelRadius": {
          "type": "f32",
          "doc": "All four wheel radii.",
          "default": 0.35,
          "unit": "m",
          "range": [0.001, null]
        },
        "wheelWidth": {
          "type": "f32",
          "doc": "All four wheel widths.",
          "default": 0.2,
          "unit": "m",
          "range": [0.001, null]
        },
        "suspensionMin": {
          "type": "f32",
          "doc": "Minimum suspension length.",
          "default": 0.2,
          "unit": "m",
          "range": [0, null]
        },
        "suspensionMax": {
          "type": "f32",
          "doc": "Maximum suspension length.",
          "default": 0.5,
          "unit": "m",
          "range": [0.001, null]
        },
        "suspensionFrequency": {
          "type": "f32",
          "doc": "Suspension spring frequency.",
          "default": 1.5,
          "unit": "Hz",
          "range": [0.001, null]
        },
        "suspensionDamping": {
          "type": "f32",
          "doc": "Suspension damping ratio.",
          "default": 0.5,
          "range": [0, null]
        },
        "maxSteerDeg": {
          "type": "f32",
          "doc": "Front wheel steering lock.",
          "default": 30,
          "unit": "deg",
          "range": [0, 89]
        },
        "engineMaxTorque": {
          "type": "f32",
          "doc": "Engine peak torque; Jolt's gearbox/engine curves supply the remaining defaults.",
          "default": 500,
          "unit": "N*m",
          "range": [0.001, null]
        },
        "rearWheelDrive": {
          "type": "bool",
          "doc": "Rear-wheel drive; false selects front-wheel drive.",
          "default": true
        },
        "layer": {
          "type": "u32",
          "doc": "Chassis collision layer.",
          "default": 1,
          "range": [1, 15]
        }
      }
    },
    "VehicleInput": {
      "kind": "component",
      "doc": "Replayable driver intent consumed every fixed tick.",
      "module": "physics",
      "fields": {
        "throttle": {
          "type": "f32",
          "doc": "Signed accelerator, with negative input selecting reverse.",
          "default": 0,
          "range": [-1, 1],
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        },
        "steer": {
          "type": "f32",
          "doc": "Signed steering, positive turns right.",
          "default": 0,
          "range": [-1, 1],
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        },
        "brake": {
          "type": "f32",
          "doc": "Service brake.",
          "default": 0,
          "range": [0, 1],
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        },
        "handBrake": {
          "type": "f32",
          "doc": "Rear-wheel handbrake.",
          "default": 0,
          "range": [0, 1],
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        }
      }
    },
    "VehicleTelemetry": {
      "kind": "component",
      "doc": "Vehicle drivetrain and suspension state mirrored into ECS after each tick.",
      "module": "physics",
      "fields": {
        "wheelsInContact": {
          "type": "u32",
          "doc": "Grounded wheel count.",
          "default": 0,
          "range": [0, 4],
          "replicate": {
            "audience": "relevant",
            "rollback": true
          }
        },
        "engineRpm": {
          "type": "f32",
          "doc": "Current engine speed in revolutions per minute.",
          "default": 0,
          "range": [0, null],
          "replicate": {
            "audience": "relevant",
            "rollback": true
          }
        },
        "gear": {
          "type": "i32",
          "doc": "Gear index (negative is reverse).",
          "default": 0,
          "replicate": {
            "audience": "relevant",
            "rollback": true
          }
        }
      }
    },
    "Velocity": {
      "kind": "component",
      "doc": "Authoritative velocity, synchronized at tick boundaries.",
      "module": "physics",
      "fields": {
        "linear": {
          "type": "vec3",
          "doc": "World-space linear velocity.",
          "default": [0, 0, 0],
          "unit": "m/s",
          "replicate": {
            "audience": "relevant",
            "rollback": true
          }
        },
        "angular": {
          "type": "vec3",
          "doc": "World-space angular velocity.",
          "default": [0, 0, 0],
          "unit": "rad/s",
          "replicate": {
            "audience": "relevant",
            "rollback": true
          }
        }
      }
    },
    "Wanderer": {
      "kind": "component",
      "doc": "Server-side AI: walks the navmesh to random points inside a box, pausing between.",
      "module": "gameplay",
      "fields": {
        "min": {
          "type": "vec3",
          "doc": "Minimum corner of the roaming box (world space).",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "max": {
          "type": "vec3",
          "doc": "Maximum corner of the roaming box (world space).",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "pauseTicks": {
          "type": "u32",
          "doc": "Ticks to wait after arriving before choosing the next goal.",
          "default": 45
        },
        "resumeTick": {
          "type": "u64",
          "doc": "Tick at which the next goal is chosen. Simulation state.",
          "default": 0
        },
        "goals": {
          "type": "u32",
          "doc": "Goals chosen so far. Simulation state.",
          "default": 0
        }
      }
    }
  },
  "documents": {
    "prefab": {
      "doc": "A reusable entity subtree with exactly one root, instantiated by reference.",
      "schema": "ara://schema/prefab/1",
      "idPrefix": "pf",
      "extension": "prefab",
      "records": [
        "Entity"
      ],
      "singleRoot": true
    },
    "scene": {
      "doc": "A level or sub-level: a flat map of entities.",
      "schema": "ara://schema/scene/1",
      "idPrefix": "sc",
      "extension": "scene",
      "records": [
        "Entity"
      ]
    }
  },
  "commands": {
    "component.add": {
      "kind": "command",
      "summary": "Add a component to an entity, with optional initial values.",
      "params": "ComponentAddParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "entity": "e_8b21",
          "component": "Transform",
          "value": {
            "position": [0, 1, 0]
          }
        }
      ]
    },
    "component.remove": {
      "kind": "command",
      "summary": "Remove a component from an entity (for prefab entities, from this instance only).",
      "params": "ComponentRemoveParams",
      "hints": {
        "idempotent": false,
        "destructive": true
      },
      "scope": "edit:scene",
      "examples": [
        {
          "entity": "e_8b21",
          "component": "Transform"
        }
      ]
    },
    "entity.create": {
      "kind": "command",
      "summary": "Create an entity, optionally with a parent, a position among its siblings and components.",
      "params": "EntityCreateParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "id": "$crate",
          "name": "Crate",
          "components": {
            "Transform": {
              "position": [2, 0, 3]
            }
          }
        },
        {
          "name": "Lid",
          "parent": "$crate",
          "index": 0
        }
      ]
    },
    "entity.delete": {
      "kind": "command",
      "summary": "Delete entities and their descendants (prefab entities are removed from their instance).",
      "params": "EntityDeleteParams",
      "hints": {
        "idempotent": false,
        "destructive": true
      },
      "scope": "edit:scene",
      "examples": [
        {
          "entities": [
            "e_8b21"
          ]
        }
      ]
    },
    "entity.inspect": {
      "kind": "query",
      "summary": "Show an entity's name, parent and components with prefab overrides applied.",
      "params": "EntityInspectParams",
      "hints": {
        "idempotent": true,
        "destructive": false
      },
      "scope": "read",
      "examples": [
        {
          "entity": "e_4f9a/e_m4tz"
        }
      ]
    },
    "entity.reparent": {
      "kind": "command",
      "summary": "Move an entity under a new parent (or to the root) at a position among its siblings.",
      "params": "EntityReparentParams",
      "hints": {
        "idempotent": true,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "entity": "e_8b21",
          "parent": "e_1c0d",
          "index": 0
        },
        {
          "entity": "e_8b21"
        }
      ]
    },
    "prefab.instantiate": {
      "kind": "command",
      "summary": "Place an instance of a prefab; its content stays linked to the prefab.",
      "params": "PrefabInstantiateParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "prefab": "@prefabs/crate.prefab",
          "id": "$crate",
          "position": [0, 0, 4]
        }
      ]
    },
    "prefab.override.revert": {
      "kind": "command",
      "summary": "Revert overrides of a prefab instance back to the prefab's values.",
      "params": "OverrideRevertParams",
      "hints": {
        "idempotent": true,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "entity": "e_4f9a/e_m4tz",
          "path": "MeshRenderer.tint"
        },
        {
          "entity": "e_4f9a"
        }
      ]
    },
    "prefab.override.set": {
      "kind": "command",
      "summary": "Override a value of a prefab instance (or of an entity inside it).",
      "params": "OverrideSetParams",
      "hints": {
        "idempotent": true,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "entity": "e_4f9a/e_m4tz",
          "path": "MeshRenderer.tint",
          "value": [1, 0, 0, 1]
        }
      ]
    },
    "property.set": {
      "kind": "command",
      "summary": "Set one field of an entity (its name or a component field).",
      "params": "PropertySetParams",
      "hints": {
        "idempotent": true,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "entity": "e_8b21",
          "path": "Transform.position.y",
          "value": 2
        },
        {
          "entity": "e_8b21",
          "path": "name",
          "value": "Crate"
        }
      ]
    },
    "transform.set": {
      "kind": "command",
      "summary": "Set the local position, rotation and/or scale of entities.",
      "params": "TransformSetParams",
      "hints": {
        "idempotent": true,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "entities": [
            "e_8b21"
          ],
          "position": [2, 0, 3],
          "rotation": [0, 45, 0]
        }
      ]
    }
  }
}
