---
source: crates/ara/tests/cli.rs
expression: out
---
{
  "$schema": "ara://schema/reflection/1",
  "types": {
    "AcousticMaterial": {
      "kind": "struct",
      "doc": "Surface acoustics for reflection, scattering and transmission.",
      "module": "audio",
      "fields": {
        "absorption": {
          "type": "vec3",
          "doc": "Fraction of energy absorbed on reflection: low/mid/high bands.",
          "default": [0.1, 0.2, 0.3],
          "range": [0, 1]
        },
        "scattering": {
          "type": "f32",
          "doc": "Fraction of reflected energy scattered diffusely (0 specular, 1 diffuse).",
          "default": 0.05,
          "range": [0, 1]
        },
        "transmission": {
          "type": "vec3",
          "doc": "Fraction of energy transmitted through the surface: low/mid/high bands.",
          "default": [0.1, 0.05, 0.03],
          "range": [0, 1]
        }
      }
    },
    "AcousticPath": {
      "kind": "struct",
      "doc": "Acoustic simulation result. Physics/Steam workers publish this at a frame boundary.",
      "module": "audio",
      "fields": {
        "visibility": {
          "type": "f32",
          "doc": "Direct path visibility: zero is fully occluded, one is clear.",
          "default": 1,
          "range": [0, 1]
        },
        "transmission": {
          "type": "vec3",
          "doc": "Low/mid/high band transmission through occluders.",
          "default": [0, 0, 0],
          "range": [0, 1]
        },
        "reverbSend": {
          "type": "f32",
          "doc": "Per-voice room reverb send amplitude into the bus's routed aux return. Values above one compensate distance attenuation so the diffuse reverberant level stays physical.",
          "default": 0,
          "range": [0, 16]
        },
        "air": {
          "type": "vec3",
          "doc": "Low/mid/high air absorption gain over the propagation distance; one is none.",
          "default": [1, 1, 1],
          "range": [0, 1]
        }
      }
    },
    "AcousticPortal": {
      "kind": "component",
      "doc": "An opening (door, window, archway) connecting two zones. An empty zone name is outdoors.",
      "module": "audio",
      "fields": {
        "a": {
          "type": "string",
          "doc": "First zone's name; empty means outdoors.",
          "default": ""
        },
        "b": {
          "type": "string",
          "doc": "Second zone's name; empty means outdoors.",
          "default": ""
        },
        "position": {
          "type": "vec3",
          "doc": "World-space center of the opening, supplied by the bridge.",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "width": {
          "type": "f32",
          "doc": "Opening width.",
          "default": 1,
          "unit": "m",
          "range": [0.01, 1000]
        },
        "height": {
          "type": "f32",
          "doc": "Opening height.",
          "default": 2,
          "unit": "m",
          "range": [0.01, 1000]
        },
        "open": {
          "type": "f32",
          "doc": "How open it is: 0 closed (blocks), 1 fully open. Drive from door state.",
          "default": 1,
          "range": [0, 1]
        }
      }
    },
    "AcousticSource": {
      "kind": "component",
      "doc": "Per-source acoustic behaviour, alongside `AudioSource`. Optional: sources without it use `AcousticSource::default()`.",
      "module": "audio",
      "fields": {
        "occlusion": {
          "type": "bool",
          "doc": "Trace geometry between source and listener for occlusion and transmission.",
          "default": true
        },
        "occlusionRadius": {
          "type": "f32",
          "doc": "Radius sampled for partial (volumetric) occlusion; 0 traces only the center ray.",
          "default": 0.5,
          "unit": "m",
          "range": [0, 50]
        },
        "airAbsorption": {
          "type": "bool",
          "doc": "Apply frequency-dependent air absorption over the propagation distance.",
          "default": true
        },
        "doppler": {
          "type": "f32",
          "doc": "Doppler strength: 0 disables pitch shift, 1 is physical, larger exaggerates.",
          "default": 1,
          "range": [0, 4]
        },
        "reverbSend": {
          "type": "f32",
          "doc": "Room reverb send before zone and portal attenuation.",
          "default": 1,
          "range": [0, 1]
        },
        "distanceCurve": {
          "type": "list<vec2>",
          "doc": "Custom distance curve: `[meters, linear gain]` points with increasing distance. Empty uses `AudioSource.attenuation`; cones still apply.",
          "default": []
        }
      }
    },
    "AcousticSurface": {
      "kind": "component",
      "doc": "Acoustic surface of static geometry or a collider. The physics ray adapter maps hit bodies to this component; absent components read as `generic`.",
      "module": "audio",
      "fields": {
        "preset": {
          "type": "MaterialPreset",
          "doc": "Named material; ignored when `custom` is set.",
          "default": "generic",
          "options": [
            "generic",
            "brick",
            "concrete",
            "ceramic",
            "gravel",
            "carpet",
            "glass",
            "plaster",
            "wood",
            "metal",
            "rock"
          ]
        },
        "custom": {
          "type": "option<AcousticMaterial>",
          "doc": "Explicit material values overriding the preset.",
          "default": null
        }
      }
    },
    "AcousticsSettings": {
      "kind": "struct",
      "doc": "World-wide propagation constants, stored in project/world settings.",
      "module": "audio",
      "fields": {
        "speedOfSound": {
          "type": "f32",
          "doc": "Speed of sound, for Doppler and reflection delays.",
          "default": 343,
          "unit": "m/s",
          "range": [1, 2000]
        },
        "airCoefficients": {
          "type": "vec3",
          "doc": "Air absorption per meter for low/mid/high bands: gain = exp(-coefficient × distance).",
          "default": [0.0002, 0.0017, 0.0182],
          "range": [0, 1]
        },
        "occlusionRays": {
          "type": "u32",
          "doc": "Rays per source for volumetric occlusion, including the center ray.",
          "default": 9,
          "range": [1, 64]
        },
        "maxPortalDepth": {
          "type": "u32",
          "doc": "Maximum portals sound may pass through between zones.",
          "default": 3,
          "range": [0, 8]
        }
      }
    },
    "AnimAsset": {
      "kind": "record",
      "doc": "A stable authoring record holding imported data or a controller source graph.",
      "module": "animation",
      "prefix": "an",
      "fields": {
        "name": {
          "type": "string",
          "doc": "Human-readable authoring name.",
          "default": ""
        },
        "skeleton": {
          "type": "option<SkeletonData>",
          "doc": "Skeleton source data, when this record defines a rig.",
          "default": null
        },
        "skeletonRef": {
          "type": "option<asset<animation>>",
          "doc": "Canonical skeleton reference for clip/controller records.",
          "default": null
        },
        "clip": {
          "type": "option<ClipData>",
          "doc": "Source clip keys; the derived cooked blob lives in the asset cache.",
          "default": null
        },
        "controller": {
          "type": "option<AnimController>",
          "doc": "State-machine and pose-graph source, independent of editor layout.",
          "default": null
        },
        "rig": {
          "type": "option<RigMap>",
          "doc": "Humanoid role bindings for import-time or runtime retargeting.",
          "default": null
        },
        "ik": {
          "type": "option<IkSetup>",
          "doc": "Procedural contact chains and ground-probe settings.",
          "default": null
        },
        "motionDatabase": {
          "type": "option<MatchConfig>",
          "doc": "Offline pose/trajectory feature database configuration.",
          "default": null
        },
        "ragdoll": {
          "type": "option<RagdollProfile>",
          "doc": "Powered bodies, constraints and spring gains for physical animation.",
          "default": null
        }
      }
    },
    "AnimBlendSample": {
      "kind": "struct",
      "doc": "A blend sample with a stable child-node identity.",
      "module": "animation",
      "fields": {
        "node": {
          "type": "string",
          "doc": "Stable child-node ID in the same controller.",
          "default": ""
        },
        "x": {
          "type": "f32",
          "doc": "Scalar coordinate, or horizontal directional coordinate.",
          "default": 0
        },
        "y": {
          "type": "f32",
          "doc": "Vertical directional coordinate; zero for a scalar blend.",
          "default": 0
        }
      }
    },
    "AnimComparison": {
      "kind": "enum",
      "doc": "A typed parameter comparison.",
      "module": "animation",
      "variants": {
        "equal": {
          "doc": "Exact equality in the parameter's storage type."
        },
        "notEqual": {
          "doc": "Exact inequality in the parameter's storage type."
        },
        "greater": {
          "doc": "Strict numeric greater-than."
        },
        "less": {
          "doc": "Strict numeric less-than."
        },
        "trigger": {
          "doc": "A latched trigger is set."
        }
      }
    },
    "AnimCondition": {
      "kind": "struct",
      "doc": "One transition predicate; all conditions on a transition must match.",
      "module": "animation",
      "fields": {
        "parameter": {
          "type": "string",
          "doc": "Stable parameter name.",
          "default": ""
        },
        "comparison": {
          "type": "AnimComparison",
          "doc": "Comparison valid for that parameter's type.",
          "default": "equal",
          "options": [
            "equal",
            "notEqual",
            "greater",
            "less",
            "trigger"
          ]
        },
        "floatValue": {
          "type": "f32",
          "doc": "Right-hand side for a float comparison.",
          "default": 0
        },
        "intValue": {
          "type": "i32",
          "doc": "Right-hand side for an integer comparison.",
          "default": 0
        },
        "boolValue": {
          "type": "bool",
          "doc": "Right-hand side for a boolean comparison.",
          "default": false
        }
      }
    },
    "AnimController": {
      "kind": "struct",
      "doc": "Canonical controller source, lowered to an immutable program by Controller.",
      "module": "animation",
      "fields": {
        "parameters": {
          "type": "map<AnimParameter>",
          "doc": "Stable typed parameter declarations.",
          "default": {}
        },
        "nodes": {
          "type": "map<AnimNode>",
          "doc": "Stable graph nodes; child references must form a DAG.",
          "default": {}
        },
        "states": {
          "type": "map<AnimState>",
          "doc": "Stable named states.",
          "default": {}
        },
        "transitions": {
          "type": "list<AnimTransition>",
          "doc": "Transition list, in descending priority.",
          "default": []
        },
        "initial": {
          "type": "string",
          "doc": "Initial state ID.",
          "default": ""
        },
        "fixedStep": {
          "type": "u32",
          "doc": "Fixed tick duration in the clips' common timebase.",
          "default": 800
        },
        "extractRootMotion": {
          "type": "bool",
          "doc": "Remove the root's animated rigid transform after extraction.",
          "default": true
        }
      }
    },
    "AnimJoint": {
      "kind": "struct",
      "doc": "A joint in parent-before-child order, with stable importer identity. Reflected as `AnimJoint` (the physics `Joint` component owns the bare name); documents never name it, so the rename needs no document migration.",
      "module": "animation",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Stable joint identifier, preserved when its display name changes.",
          "default": ""
        },
        "name": {
          "type": "string",
          "doc": "Human-readable joint name.",
          "default": ""
        },
        "parent": {
          "type": "option<u32>",
          "doc": "Index of the parent joint; absent for a root.",
          "default": null
        },
        "bind": {
          "type": "AnimTransform",
          "doc": "Local bind transform relative to the parent.",
          "default": {}
        },
        "retarget": {
          "type": "Retarget",
          "doc": "Retargeting metadata preserved by the cooked skeleton.",
          "default": {}
        }
      }
    },
    "AnimMatrix": {
      "kind": "struct",
      "doc": "An explicitly imported inverse-bind matrix, in column-major order.",
      "module": "animation",
      "fields": {
        "x": {
          "type": "vec4",
          "doc": "First matrix column.",
          "default": [0, 0, 0, 0]
        },
        "y": {
          "type": "vec4",
          "doc": "Second matrix column.",
          "default": [0, 0, 0, 0]
        },
        "z": {
          "type": "vec4",
          "doc": "Third matrix column.",
          "default": [0, 0, 0, 0]
        },
        "w": {
          "type": "vec4",
          "doc": "Fourth matrix column, including translation.",
          "default": [0, 0, 0, 0]
        }
      }
    },
    "AnimNode": {
      "kind": "struct",
      "doc": "A typed animation graph node. The compiler validates fields for each kind.",
      "module": "animation",
      "fields": {
        "kind": {
          "type": "AnimNodeKind",
          "doc": "Pose operation.",
          "default": "clip",
          "options": [
            "clip",
            "blend1d",
            "directional2d",
            "additive",
            "layer",
            "motionMatching"
          ]
        },
        "clip": {
          "type": "option<asset<animation>>",
          "doc": "Clip reference in canonical @path#id form, resolved by ara-asset.",
          "default": null
        },
        "parameterX": {
          "type": "string",
          "doc": "Float parameter for a scalar axis, horizontal axis or optional layer weight.",
          "default": ""
        },
        "parameterY": {
          "type": "string",
          "doc": "Float parameter for a directional vertical axis.",
          "default": ""
        },
        "samples": {
          "type": "list<AnimBlendSample>",
          "doc": "Samples; additive/layer nodes use exactly two in base, overlay order.",
          "default": []
        },
        "weight": {
          "type": "f32",
          "doc": "Constant additive/layer weight when parameterX is empty.",
          "default": 1
        },
        "boneMask": {
          "type": "list<f32>",
          "doc": "Per-joint [0,1] weights for layer/additive nodes; empty means every joint.",
          "default": []
        },
        "matching": {
          "type": "option<MatchNode>",
          "doc": "Search/query/inertialization settings for a motion-matching node.",
          "default": null
        }
      }
    },
    "AnimNodeKind": {
      "kind": "enum",
      "doc": "Runtime pose operation represented by an authoring graph node.",
      "module": "animation",
      "variants": {
        "clip": {
          "doc": "A referenced cooked clip."
        },
        "blend1d": {
          "doc": "Interpolate adjacent samples on an ordered scalar axis."
        },
        "directional2d": {
          "doc": "Interpolate a center and an angular ring with radial barycentric weights."
        },
        "additive": {
          "doc": "Add the second input's difference from the skeleton bind pose to the first."
        },
        "layer": {
          "doc": "Blend the second input onto the first through a per-joint mask."
        },
        "motionMatching": {
          "doc": "Bounded search in a normalized pose/trajectory feature database."
        }
      }
    },
    "AnimParameter": {
      "kind": "struct",
      "doc": "A typed parameter declaration, addressed by its stable map key.",
      "module": "animation",
      "fields": {
        "kind": {
          "type": "AnimParameterKind",
          "doc": "Parameter's storage and comparison type.",
          "default": "float",
          "options": [
            "float",
            "int",
            "bool",
            "trigger"
          ]
        },
        "floatValue": {
          "type": "f32",
          "doc": "Initial value for a float parameter.",
          "default": 0
        },
        "intValue": {
          "type": "i32",
          "doc": "Initial value for an integer parameter.",
          "default": 0
        },
        "boolValue": {
          "type": "bool",
          "doc": "Initial value for a boolean parameter; triggers always start unset.",
          "default": false
        }
      }
    },
    "AnimParameterKind": {
      "kind": "enum",
      "doc": "A schema-registered gameplay parameter type.",
      "module": "animation",
      "variants": {
        "float": {
          "doc": "Finite floating-point value."
        },
        "int": {
          "doc": "Signed 32-bit integer."
        },
        "bool": {
          "doc": "Boolean state."
        },
        "trigger": {
          "doc": "Latched trigger, consumed only by a selected transition that tests it."
        }
      }
    },
    "AnimState": {
      "kind": "struct",
      "doc": "A state selecting a pose graph and its normalized phase clock.",
      "module": "animation",
      "fields": {
        "node": {
          "type": "string",
          "doc": "Stable pose graph node ID.",
          "default": ""
        },
        "duration": {
          "type": "u32",
          "doc": "Duration in clip ticks; zero infers the longest descendant clip.",
          "default": 0
        },
        "looping": {
          "type": "bool",
          "doc": "Whether to wrap the phase clock and repeat notifies.",
          "default": true
        },
        "syncGroup": {
          "type": "string",
          "doc": "Nonempty group preserves normalized phase on entry and throughout cross-fades.",
          "default": ""
        }
      }
    },
    "AnimTransform": {
      "kind": "struct",
      "doc": "A local affine transform; rotations use XYZW quaternions.",
      "module": "animation",
      "fields": {
        "translation": {
          "type": "vec3",
          "doc": "Translation in meters relative to the parent.",
          "default": [0, 0, 0]
        },
        "rotation": {
          "type": "vec4",
          "doc": "Unit rotation quaternion in XYZW order.",
          "default": [0, 0, 0, 1]
        },
        "scale": {
          "type": "vec3",
          "doc": "Positive scale relative to the parent.",
          "default": [1, 1, 1]
        }
      }
    },
    "AnimTransition": {
      "kind": "struct",
      "doc": "A state transition. Serialized list order defines deterministic priority.",
      "module": "animation",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Stable transition ID for tools and graph mapping.",
          "default": ""
        },
        "from": {
          "type": "string",
          "doc": "Source state ID.",
          "default": ""
        },
        "to": {
          "type": "string",
          "doc": "Target state ID.",
          "default": ""
        },
        "duration": {
          "type": "u32",
          "doc": "Fixed cross-fade duration; zero switches before advancing this tick.",
          "default": 0
        },
        "exitTick": {
          "type": "option<u32>",
          "doc": "Optional earliest elapsed state tick; duration waits for one complete cycle.",
          "default": null
        },
        "conditions": {
          "type": "list<AnimCondition>",
          "doc": "Typed AND predicates; empty means unconditional.",
          "default": []
        }
      }
    },
    "AnimationClipSetParams": {
      "kind": "params",
      "doc": "Replace animation clip keys.",
      "module": "animation",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Existing animation record ID or a symbol created earlier in the batch.",
          "required": true
        },
        "value": {
          "type": "ClipData",
          "doc": "Replacement typed source data.",
          "required": true
        }
      }
    },
    "AnimationControllerSetParams": {
      "kind": "params",
      "doc": "Replace an animation controller graph.",
      "module": "animation",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Existing animation record ID or a symbol created earlier in the batch.",
          "required": true
        },
        "value": {
          "type": "AnimController",
          "doc": "Replacement typed source data.",
          "required": true
        }
      }
    },
    "AnimationCreateParams": {
      "kind": "params",
      "doc": "Create one animation asset (skeleton, clip, controller or procedural setup).",
      "module": "animation",
      "fields": {
        "id": {
          "type": "option<string>",
          "doc": "Stable record ID or batch symbol; generated when omitted.",
          "default": null
        },
        "asset": {
          "type": "AnimAsset",
          "doc": "Typed animation source asset.",
          "required": true
        }
      }
    },
    "AnimationIkSetParams": {
      "kind": "params",
      "doc": "Replace procedural animation contact chains.",
      "module": "animation",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Existing animation record ID or a symbol created earlier in the batch.",
          "required": true
        },
        "value": {
          "type": "IkSetup",
          "doc": "Replacement typed source data.",
          "required": true
        }
      }
    },
    "AnimationMotionDatabaseSetParams": {
      "kind": "params",
      "doc": "Replace pose-search database configuration.",
      "module": "animation",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Existing animation record ID or a symbol created earlier in the batch.",
          "required": true
        },
        "value": {
          "type": "MatchConfig",
          "doc": "Replacement typed source data.",
          "required": true
        }
      }
    },
    "AnimationPropertySetParams": {
      "kind": "params",
      "doc": "Edit one schema-addressed field of an animation record.",
      "module": "animation",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Animation record ID.",
          "required": true
        },
        "path": {
          "type": "string",
          "doc": "Reflected field path, including nested graph and curve fields.",
          "required": true
        },
        "value": {
          "type": "json",
          "doc": "Typed JSON replacement; null removes the stored value to its default.",
          "required": true
        }
      }
    },
    "AnimationRagdollSetParams": {
      "kind": "params",
      "doc": "Replace a physical animation ragdoll profile.",
      "module": "animation",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Existing animation record ID or a symbol created earlier in the batch.",
          "required": true
        },
        "value": {
          "type": "RagdollProfile",
          "doc": "Replacement typed source data.",
          "required": true
        }
      }
    },
    "AnimationRigSetParams": {
      "kind": "params",
      "doc": "Replace semantic humanoid bone bindings.",
      "module": "animation",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Existing animation record ID or a symbol created earlier in the batch.",
          "required": true
        },
        "value": {
          "type": "RigMap",
          "doc": "Replacement typed source data.",
          "required": true
        }
      }
    },
    "AnimationSkeletonSetParams": {
      "kind": "params",
      "doc": "Replace animation skeleton source.",
      "module": "animation",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Existing animation record ID or a symbol created earlier in the batch.",
          "required": true
        },
        "value": {
          "type": "SkeletonData",
          "doc": "Replacement typed source data.",
          "required": true
        }
      }
    },
    "Animator": {
      "kind": "component",
      "doc": "Skeletal animation for this entity's `MeshRenderer.model`, compiled to an ara-anim program: the `controller` document when set, else an `idle` state and a `move` state whose 1D blend tree is driven by the entity's ground speed, cross-faded at `moveThreshold`.",
      "module": "animation",
      "fields": {
        "controller": {
          "type": "option<asset<animation>>",
          "doc": "Controller authored in an `.animation` document (`@anim/fox.animation#an_fox`): its state machine, blend trees and motion matching replace the built-in idle/locomotion graph below. A float `speed` parameter follows ground speed.",
          "default": null
        },
        "idle": {
          "type": "string",
          "doc": "Idle clip name.",
          "default": ""
        },
        "locomotion": {
          "type": "list<LocomotionClip>",
          "doc": "Moving blend samples in increasing speed order.",
          "default": []
        },
        "moveThreshold": {
          "type": "f32",
          "doc": "Ground speed separating idle from moving.",
          "default": 0.15,
          "unit": "m/s",
          "range": [0, null]
        },
        "fade": {
          "type": "f32",
          "doc": "Cross-fade duration between idle and moving.",
          "default": 0.2,
          "unit": "s",
          "range": [0, null]
        },
        "rootMotion": {
          "type": "bool",
          "doc": "Moves the entity by the extracted root motion (only without a character controller or navigation agent, which own movement).",
          "default": false
        }
      }
    },
    "AssetDeleteParams": {
      "kind": "params",
      "doc": "Parameters of `asset.delete`.",
      "module": "core",
      "fields": {
        "source": {
          "type": "string",
          "doc": "Authored-root-relative path; document references and local source URIs block deletion.",
          "required": true
        }
      }
    },
    "AssetDestinationParams": {
      "kind": "params",
      "doc": "Parameters of `asset.move` and `asset.duplicate`.",
      "module": "core",
      "fields": {
        "source": {
          "type": "string",
          "doc": "Existing authored-root-relative file or folder; source media includes its sidecar.",
          "required": true
        },
        "destination": {
          "type": "string",
          "doc": "Complete authored-root-relative destination, including the filename.",
          "required": true
        }
      }
    },
    "AssetImportParams": {
      "kind": "params",
      "doc": "Parameters of the asynchronous `asset.import` typed job.",
      "module": "core",
      "fields": {
        "sources": {
          "type": "list<string>",
          "doc": "Explicit absolute OS files or folder roots authorizing external reads.",
          "required": true
        },
        "destination": {
          "type": "string",
          "doc": "Authored-relative destination folder; empty means the authored root.",
          "required": true
        },
        "conflict": {
          "type": "ImportConflict",
          "doc": "Rename by default; Replace and Skip are explicit conflict policies.",
          "default": "rename",
          "options": [
            "rename",
            "replace",
            "skip"
          ]
        },
        "dryRun": {
          "type": "bool",
          "doc": "Read-only conflict/source preflight; no staging, cooking or file changes.",
          "default": false
        }
      }
    },
    "AssetRenameParams": {
      "kind": "params",
      "doc": "Parameters of `asset.rename`.",
      "module": "core",
      "fields": {
        "source": {
          "type": "string",
          "doc": "Existing authored-root-relative file or folder.",
          "required": true
        },
        "name": {
          "type": "string",
          "doc": "New basename, including the file extension; never a path.",
          "required": true
        }
      }
    },
    "Atlas": {
      "kind": "struct",
      "doc": "Canonical atlas metadata; the immutable pixel payload lives in the asset cache.",
      "fields": {
        "width": {
          "type": "u32",
          "doc": "Atlas pixel width.",
          "default": 0
        },
        "height": {
          "type": "u32",
          "doc": "Atlas pixel height.",
          "default": 0
        },
        "regions": {
          "type": "map<SpriteRegion>",
          "doc": "Stable source/subasset names to regions, never heap slots.",
          "default": {}
        }
      }
    },
    "Attenuation": {
      "kind": "enum",
      "doc": "Distance rolloff model, evaluated in meters.",
      "variants": {
        "inverse": {
          "doc": "Inverse distance, clamped at the reference distance and silent at the maximum."
        },
        "linear": {
          "doc": "Linear fade between reference and maximum distance."
        },
        "inverseSquare": {
          "doc": "Inverse-square energy falloff with a finite range fade."
        }
      }
    },
    "AudioBus": {
      "kind": "record",
      "doc": "One bus (category) in the mixer tree. `AudioSource.bus` names it.",
      "module": "audio",
      "prefix": "b",
      "fields": {
        "name": {
          "type": "string",
          "doc": "Unique bus name; `master` configures the root bus.",
          "default": ""
        },
        "output": {
          "type": "string",
          "doc": "Bus this one mixes into; empty means `master`. (`parent` is reserved by the kernel.)",
          "default": ""
        },
        "gainDb": {
          "type": "f32",
          "doc": "Base gain.",
          "default": 0,
          "unit": "dB",
          "range": [-96, 24]
        },
        "mute": {
          "type": "bool",
          "doc": "Silences the bus and its reverb sends.",
          "default": false
        },
        "voiceLimit": {
          "type": "u32",
          "doc": "Real-voice cap for this category and its children; 0 is unlimited.",
          "default": 0
        },
        "loudness": {
          "type": "option<f32>",
          "doc": "Integrated loudness target for sources on this bus (music and dialogue: -16 LUFS).",
          "default": null,
          "unit": "dB"
        },
        "reverb": {
          "type": "bool",
          "doc": "Route spatial voices on this bus to the listener's room reverb.",
          "default": false
        },
        "duck": {
          "type": "option<AudioDuck>",
          "doc": "Sidechain ducking driven by another bus.",
          "default": null
        }
      }
    },
    "AudioDuck": {
      "kind": "struct",
      "doc": "Sidechain ducking: another bus's level pulls this bus down (dialogue over music).",
      "module": "audio",
      "fields": {
        "by": {
          "type": "string",
          "doc": "Name of the bus whose level triggers the duck.",
          "default": ""
        },
        "thresholdDb": {
          "type": "f32",
          "doc": "Trigger level of that bus's block peak.",
          "default": -30,
          "unit": "dB",
          "range": [-96, 0]
        },
        "amountDb": {
          "type": "f32",
          "doc": "Attenuation while ducked.",
          "default": -9,
          "unit": "dB",
          "range": [-60, 0]
        },
        "attack": {
          "type": "f32",
          "doc": "Seconds to reach the ducked level.",
          "default": 0.05,
          "unit": "s",
          "range": [0.001, 10]
        },
        "release": {
          "type": "f32",
          "doc": "Seconds to recover.",
          "default": 0.4,
          "unit": "s",
          "range": [0.001, 10]
        }
      }
    },
    "AudioEffectCodec": {
      "kind": "enum",
      "doc": "Codec for resident sound effects; streamed audio always uses Opus.",
      "module": "asset",
      "variants": {
        "pcm": {
          "doc": "Signed 16-bit PCM."
        },
        "adpcm": {
          "doc": "IMA ADPCM."
        }
      }
    },
    "AudioGraphAddParams": {
      "kind": "params",
      "doc": "Adds an operation node.",
      "module": "audio",
      "fields": {
        "name": {
          "type": "string",
          "doc": "New unique node name.",
          "required": true
        },
        "op": {
          "type": "string",
          "doc": "Operation (`lowpass`, `random.pick`).",
          "required": true
        },
        "args": {
          "type": "map<json>",
          "doc": "Arguments by input name: numbers, `@clip` references or `name`/`name.port` references.",
          "required": true
        }
      }
    },
    "AudioGraphParamParams": {
      "kind": "params",
      "doc": "Edits a parameter's default, range or documentation.",
      "module": "audio",
      "fields": {
        "name": {
          "type": "string",
          "doc": "Parameter name.",
          "required": true
        },
        "default": {
          "type": "option<json>",
          "doc": "New default: a number, or an `@clip` reference for clip parameters.",
          "default": null
        },
        "range": {
          "type": "option<vec2>",
          "doc": "New `[lo, hi]` range for value parameters.",
          "default": null
        },
        "doc": {
          "type": "option<string>",
          "doc": "New documentation.",
          "default": null
        }
      }
    },
    "AudioGraphRemoveParams": {
      "kind": "params",
      "doc": "Removes a node or parameter and every reference to it.",
      "module": "audio",
      "fields": {
        "name": {
          "type": "string",
          "doc": "Name to remove.",
          "required": true
        }
      }
    },
    "AudioGraphRenameParams": {
      "kind": "params",
      "doc": "Renames a parameter or node, keeping its identity, wiring and canvas position.",
      "module": "audio",
      "fields": {
        "from": {
          "type": "string",
          "doc": "Current name.",
          "required": true
        },
        "to": {
          "type": "string",
          "doc": "New unique name.",
          "required": true
        }
      }
    },
    "AudioGraphSetInputParams": {
      "kind": "params",
      "doc": "Sets one input of a node, or a graph output, to a literal or a reference.",
      "module": "audio",
      "fields": {
        "node": {
          "type": "string",
          "doc": "Node name, or `output` for graph outputs.",
          "required": true
        },
        "input": {
          "type": "string",
          "doc": "Input name (`cutoff`, `in0`) or output field (`out`, `left`, `right`, `done`).",
          "required": true
        },
        "value": {
          "type": "json",
          "doc": "A number, an `@clip` reference or a `name`/`name.port` reference.",
          "required": true
        }
      }
    },
    "AudioGraphSource": {
      "kind": "component",
      "doc": "Plays a procedural audio graph (an ara-audio-graph `graph` document, domain `audio`) from this entity, spatialized and attenuated by its `AudioSource` (whose clip stays empty). Gameplay writes `parameters` and bumps `triggers`; the audio presenter forwards changes sample-accurately at the next control frame.",
      "module": "audio",
      "fields": {
        "graph": {
          "type": "option<asset<graph>>",
          "doc": "The audio graph document.",
          "default": null
        },
        "parameters": {
          "type": "map<f32>",
          "doc": "Parameter values by name (clamped to the graph's declared ranges).",
          "default": {}
        },
        "triggers": {
          "type": "map<u32>",
          "doc": "Trigger counters by name: each increment fires the trigger once.",
          "default": {}
        }
      }
    },
    "AudioGraphTextParams": {
      "kind": "params",
      "doc": "Replaces the graph with edited `.audiograph` text; surviving names keep their IDs.",
      "module": "audio",
      "fields": {
        "text": {
          "type": "string",
          "doc": "Complete `.audiograph` source.",
          "required": true
        }
      }
    },
    "AudioImportSettings": {
      "kind": "struct",
      "doc": "Audio sidecar settings, validated identically by authoring commands and workers.",
      "module": "asset",
      "fields": {
        "usage": {
          "type": "AudioImportUse",
          "doc": "Resident effect, streamed music or streamed dialogue.",
          "default": "shortEffect",
          "options": [
            "shortEffect",
            "music",
            "dialogue"
          ]
        },
        "codec": {
          "type": "AudioEffectCodec",
          "doc": "Codec for resident effects.",
          "default": "pcm",
          "options": [
            "pcm",
            "adpcm"
          ]
        },
        "opusBitrate": {
          "type": "i32",
          "doc": "Stereo Opus bitrate for music/dialogue, in bits per second.",
          "default": 128000,
          "range": [6000, 512000]
        },
        "decodedBudget": {
          "type": "u64",
          "doc": "Resident decoded PCM budget in bytes; streamed cooking uses bounded blocks.",
          "default": 67108864,
          "range": [65536, null]
        }
      }
    },
    "AudioImportUse": {
      "kind": "enum",
      "doc": "Audio use selects resident effects or streamed music/dialogue.",
      "module": "asset",
      "variants": {
        "shortEffect": {
          "doc": "Resident sound effect."
        },
        "music": {
          "doc": "Streamed music encoded as Opus."
        },
        "dialogue": {
          "doc": "Streamed dialogue encoded as Opus."
        }
      }
    },
    "AudioListener": {
      "kind": "component",
      "doc": "Presentation listener, usually copied from the local player's camera component.",
      "module": "audio",
      "fields": {
        "position": {
          "type": "vec3",
          "doc": "Listener world position.",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "velocity": {
          "type": "vec3",
          "doc": "Listener world velocity in meters per second.",
          "default": [0, 0, 0]
        },
        "forward": {
          "type": "vec3",
          "doc": "Forward direction; the default engine basis looks down negative Z.",
          "default": [0, 0, -1]
        },
        "up": {
          "type": "vec3",
          "doc": "Up direction; must not be parallel to forward.",
          "default": [0, 1, 0]
        },
        "coneInner": {
          "type": "f32",
          "doc": "Listener sensitivity cone inner full angle.",
          "default": 360,
          "unit": "deg",
          "range": [0, 360]
        },
        "coneOuter": {
          "type": "f32",
          "doc": "Listener sensitivity cone outer full angle.",
          "default": 360,
          "unit": "deg",
          "range": [0, 360]
        },
        "coneOuterGain": {
          "type": "f32",
          "doc": "Linear sensitivity outside the listener cone.",
          "default": 1,
          "range": [0, 1]
        }
      }
    },
    "AudioMixState": {
      "kind": "record",
      "doc": "A named mix (combat, explore, menu): per-bus gain offsets reached over `fade` seconds.",
      "module": "audio",
      "prefix": "s",
      "fields": {
        "name": {
          "type": "string",
          "doc": "Unique state name.",
          "default": ""
        },
        "buses": {
          "type": "map<f32>",
          "doc": "Gain offsets in dB added to each named bus's base gain; -96 or below mutes.",
          "default": {}
        },
        "fade": {
          "type": "f32",
          "doc": "Transition time into this state.",
          "default": 1,
          "unit": "s",
          "range": [0, 60]
        }
      }
    },
    "AudioMixerSettings": {
      "kind": "record",
      "doc": "Mixer-wide settings (one record per mixer document).",
      "module": "audio",
      "prefix": "m",
      "fields": {
        "initialState": {
          "type": "string",
          "doc": "State applied at startup; empty is the base mix.",
          "default": ""
        }
      }
    },
    "AudioSource": {
      "kind": "component",
      "doc": "Declarative sound intent. Playback cursors and decoder state are presentation only.",
      "module": "audio",
      "fields": {
        "clip": {
          "type": "option<asset<audio>>",
          "doc": "Cooked clip reference in `@path#id` form; absent means no clip.",
          "default": null
        },
        "bus": {
          "type": "string",
          "doc": "Mixer bus name resolved by the presentation bridge.",
          "default": "master"
        },
        "gain": {
          "type": "f32",
          "doc": "Linear source amplitude.",
          "default": 1,
          "range": [0, 16]
        },
        "pitch": {
          "type": "f32",
          "doc": "Playback pitch multiplier before Doppler.",
          "default": 1,
          "range": [0.125, 8]
        },
        "looping": {
          "type": "bool",
          "doc": "Whether the clip repeats.",
          "default": false
        },
        "spatial": {
          "type": "bool",
          "doc": "Whether position affects the sound.",
          "default": true
        },
        "priority": {
          "type": "u8",
          "doc": "Voice budget priority; larger values are retained first.",
          "default": 128
        },
        "referenceDistance": {
          "type": "f32",
          "doc": "Full-volume radius.",
          "default": 1,
          "unit": "m",
          "range": [0.01, 100000]
        },
        "maxDistance": {
          "type": "f32",
          "doc": "Silent beyond this distance; must exceed referenceDistance.",
          "default": 100,
          "unit": "m",
          "range": [0.02, 1000000]
        },
        "attenuation": {
          "type": "Attenuation",
          "doc": "Shape of the distance attenuation curve.",
          "default": "inverse",
          "options": [
            "inverse",
            "linear",
            "inverseSquare"
          ]
        },
        "position": {
          "type": "vec3",
          "doc": "Source position, supplied from the ECS world transform by the bridge.",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "velocity": {
          "type": "vec3",
          "doc": "Source velocity in meters per second for Doppler.",
          "default": [0, 0, 0]
        },
        "forward": {
          "type": "vec3",
          "doc": "Source forward axis; normalized during spatial evaluation.",
          "default": [0, 0, -1]
        },
        "coneInner": {
          "type": "f32",
          "doc": "Full angle of the unattenuated source cone.",
          "default": 360,
          "unit": "deg",
          "range": [0, 360]
        },
        "coneOuter": {
          "type": "f32",
          "doc": "Full angle at which the source reaches coneOuterGain.",
          "default": 360,
          "unit": "deg",
          "range": [0, 360]
        },
        "coneOuterGain": {
          "type": "f32",
          "doc": "Linear amplitude outside the source cone.",
          "default": 1,
          "range": [0, 1]
        }
      }
    },
    "BehaviorRenameParams": {
      "kind": "params",
      "doc": "Renames a state, variable or query, rewriting every reference.",
      "module": "ai",
      "fields": {
        "from": {
          "type": "string",
          "doc": "Existing name.",
          "required": true
        },
        "to": {
          "type": "string",
          "doc": "New unique name.",
          "required": true
        },
        "restoreId": {
          "type": "option<string>",
          "doc": "After a plain-text rename (delete + create): the deleted node's ID, to restore.",
          "default": null
        }
      }
    },
    "BehaviorStateAddParams": {
      "kind": "params",
      "doc": "Adds an empty state.",
      "module": "ai",
      "fields": {
        "name": {
          "type": "string",
          "doc": "New unique state name.",
          "required": true
        },
        "parent": {
          "type": "option<string>",
          "doc": "Parent state name; top level when absent.",
          "default": null
        },
        "when": {
          "type": "option<string>",
          "doc": "Entry condition expression.",
          "default": null
        }
      }
    },
    "BehaviorStateRemoveParams": {
      "kind": "params",
      "doc": "Removes a state, its children and transitions that target them.",
      "module": "ai",
      "fields": {
        "name": {
          "type": "string",
          "doc": "State name.",
          "required": true
        }
      }
    },
    "BehaviorTextParams": {
      "kind": "params",
      "doc": "Replaces the behaviour with DSL text, keeping IDs of surviving names.",
      "module": "ai",
      "fields": {
        "text": {
          "type": "string",
          "doc": "Complete behaviour text.",
          "required": true
        }
      }
    },
    "BehaviorTransitionParams": {
      "kind": "params",
      "doc": "Adds a transition.",
      "module": "ai",
      "fields": {
        "from": {
          "type": "string",
          "doc": "Source state name.",
          "required": true
        },
        "to": {
          "type": "string",
          "doc": "Target state name.",
          "required": true
        },
        "when": {
          "type": "string",
          "doc": "`done`, `failed` or a condition expression.",
          "required": true
        }
      }
    },
    "BehaviorVarParams": {
      "kind": "params",
      "doc": "Sets (or clears) a variable's default.",
      "module": "ai",
      "fields": {
        "name": {
          "type": "string",
          "doc": "Variable name.",
          "required": true
        },
        "default": {
          "type": "option<string>",
          "doc": "Default expression; absent clears it.",
          "default": null
        }
      }
    },
    "BoneRole": {
      "kind": "enum",
      "doc": "Anatomical roles shared by Mixamo, UE Mannequin and Unity Humanoid rigs.",
      "module": "animation",
      "variants": {
        "root": {
          "doc": "Locomotion root, possibly separate from the pelvis."
        },
        "hips": {
          "doc": "Pelvis."
        },
        "spine": {
          "doc": "Lower spine."
        },
        "chest": {
          "doc": "Upper spine/chest."
        },
        "upperChest": {
          "doc": "Optional upper chest, above the main chest role."
        },
        "neck": {
          "doc": "Neck."
        },
        "head": {
          "doc": "Head/look joint."
        },
        "leftShoulder": {
          "doc": "Left clavicle."
        },
        "leftUpperArm": {
          "doc": "Left upper arm."
        },
        "leftLowerArm": {
          "doc": "Left forearm."
        },
        "leftHand": {
          "doc": "Left wrist/hand effector."
        },
        "rightShoulder": {
          "doc": "Right clavicle."
        },
        "rightUpperArm": {
          "doc": "Right upper arm."
        },
        "rightLowerArm": {
          "doc": "Right forearm."
        },
        "rightHand": {
          "doc": "Right wrist/hand effector."
        },
        "leftUpperLeg": {
          "doc": "Left thigh."
        },
        "leftLowerLeg": {
          "doc": "Left shin."
        },
        "leftFoot": {
          "doc": "Left ankle/foot effector."
        },
        "leftToes": {
          "doc": "Left ball/toes."
        },
        "rightUpperLeg": {
          "doc": "Right thigh."
        },
        "rightLowerLeg": {
          "doc": "Right shin."
        },
        "rightFoot": {
          "doc": "Right ankle/foot effector."
        },
        "rightToes": {
          "doc": "Right ball/toes."
        }
      }
    },
    "Brain": {
      "kind": "component",
      "doc": "Runs a behaviour on this entity (authoring).",
      "module": "ai",
      "fields": {
        "behavior": {
          "type": "option<asset>",
          "doc": "Behaviour graph asset (`@ai/guard.behavior#gr_...`).",
          "default": null
        },
        "overrides": {
          "type": "list<string>",
          "doc": "Blackboard overrides as `name = expression` (no IDs), e.g. `route = [vec3(0, 0, 4), vec3(8, 0, 4)]`.",
          "default": []
        },
        "enabled": {
          "type": "bool",
          "doc": "Whether the brain thinks.",
          "default": true
        }
      }
    },
    "BuildProfileCreateParams": {
      "kind": "params",
      "doc": "Parameters of build_profile.create.",
      "fields": {
        "name": {
          "type": "string",
          "doc": "Portable profile name; its filename is normalized to lowercase.",
          "required": true
        },
        "preset": {
          "type": "json",
          "doc": "Complete export preset, written with the canonical JSON writer.",
          "required": true
        }
      }
    },
    "Camera": {
      "kind": "component",
      "doc": "A viewpoint looking along the entity's local -Z axis. The lowest `priority` wins.",
      "module": "render",
      "fields": {
        "fov": {
          "type": "f32",
          "doc": "Vertical field of view.",
          "default": 55,
          "unit": "deg",
          "range": [1, 170]
        },
        "priority": {
          "type": "i32",
          "doc": "Selection order when several cameras exist; lower is preferred.",
          "default": 0
        }
      }
    },
    "Camera2d": {
      "kind": "component",
      "doc": "Orthographic view. Pixel mode uses integer zoom and nearest texel sampling.",
      "module": "twoD",
      "fields": {
        "centre": {
          "type": "vec2",
          "doc": "View centre in world metres.",
          "default": [0, 0]
        },
        "pixelsPerMetre": {
          "type": "f32",
          "doc": "Art pixels per world metre.",
          "default": 16,
          "range": [0.001, null]
        },
        "zoom": {
          "type": "f32",
          "doc": "Screen pixels per art pixel, rounded to an integer in pixel mode.",
          "default": 2,
          "range": [0.001, null]
        },
        "pixelPerfect": {
          "type": "bool",
          "doc": "Snap view and sprite geometry to art pixels and sample nearest texels.",
          "default": true
        },
        "ambient": {
          "type": "vec3",
          "doc": "Linear scene ambient illumination.",
          "default": [0.2, 0.2, 0.25]
        },
        "background": {
          "type": "vec3",
          "doc": "Linear clear color behind every layer.",
          "default": [0.012, 0.018, 0.032]
        }
      }
    },
    "Camera2dSetParams": {
      "kind": "params",
      "doc": "Complete typed component authoring update.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Target entity, including prefab addresses.",
          "required": true
        },
        "value": {
          "type": "Camera2d",
          "doc": "Complete typed component; omitted fields use schema defaults.",
          "required": true
        }
      }
    },
    "CaptureAudioParams": {
      "kind": "params",
      "doc": "Parameters for the offline `capture_audio` job, run outside the human's audio engine.",
      "module": "audio",
      "fields": {
        "seconds": {
          "type": "f64",
          "doc": "Capture duration; bounded so an agent cannot allocate an unbounded buffer.",
          "default": 1,
          "unit": "s",
          "range": [0.001, 60]
        }
      }
    },
    "Cell": {
      "kind": "record",
      "doc": "One grid/layer partition, with a scene plus optional per-entity scene files.",
      "module": "world",
      "prefix": "c",
      "fields": {
        "x": {
          "type": "i32",
          "doc": "Grid X coordinate.",
          "default": 0
        },
        "z": {
          "type": "i32",
          "doc": "Grid Z coordinate.",
          "default": 0
        },
        "layer": {
          "type": "string",
          "doc": "Stable layer record ID in this manifest.",
          "default": ""
        },
        "slot": {
          "type": "u32",
          "doc": "Unique slot differentiating partitions at the same coordinates.",
          "default": 0
        },
        "documents": {
          "type": "list<string>",
          "doc": "Cell scene `@path#documentId` references; every file has one owner.",
          "default": []
        },
        "actors": {
          "type": "list<string>",
          "doc": "Optional standalone actor scene files, kept at readable stable paths.",
          "default": []
        },
        "acoustics": {
          "type": "option<asset>",
          "doc": "Baked acoustic probes for this cell (an imported `AcousticCell` blob); play loads and unloads them with the cell.",
          "default": null
        }
      }
    },
    "ChainData": {
      "kind": "struct",
      "doc": "Canonical chain setup, addressed by stable skeleton joint IDs.",
      "module": "animation",
      "fields": {
        "joints": {
          "type": "list<string>",
          "doc": "Consecutive parent-to-child joints, including the end effector.",
          "default": []
        },
        "limits": {
          "type": "list<JointLimit>",
          "doc": "One limit per rotating joint; empty uses unrestricted limits.",
          "default": []
        }
      }
    },
    "CharacterController": {
      "kind": "component",
      "doc": "Predicted capsule movement: slopes, stairs, moving platforms, crouching and pushing.",
      "module": "physics",
      "fields": {
        "radius": {
          "type": "f32",
          "doc": "Standing capsule radius.",
          "default": 0.3,
          "unit": "m",
          "range": [0.001, null]
        },
        "height": {
          "type": "f32",
          "doc": "Complete standing height; must exceed twice the radius.",
          "default": 1.8,
          "unit": "m",
          "range": [0.001, null]
        },
        "crouchHeight": {
          "type": "f32",
          "doc": "Complete crouched height, between diameter and standing height.",
          "default": 1,
          "unit": "m",
          "range": [0.001, null]
        },
        "maxSlopeDeg": {
          "type": "f32",
          "doc": "Maximum walkable slope angle.",
          "default": 45,
          "unit": "deg",
          "range": [0.1, 89.9]
        },
        "stepHeight": {
          "type": "f32",
          "doc": "Maximum stair step height.",
          "default": 0.35,
          "unit": "m",
          "range": [0, null]
        },
        "stickDown": {
          "type": "f32",
          "doc": "Distance searched below feet to stay on a descending surface.",
          "default": 0.5,
          "unit": "m",
          "range": [0, null]
        },
        "padding": {
          "type": "f32",
          "doc": "Capsule collision padding.",
          "default": 0.02,
          "unit": "m",
          "range": [0, null]
        },
        "maxStrength": {
          "type": "f32",
          "doc": "Maximum force used to push rigid bodies.",
          "default": 1000,
          "unit": "N",
          "range": [0, null]
        },
        "mass": {
          "type": "f32",
          "doc": "Character mass used for dynamic body interaction.",
          "default": 70,
          "unit": "kg",
          "range": [0.001, null]
        },
        "layer": {
          "type": "u32",
          "doc": "Collision group used for movement queries.",
          "default": 1,
          "range": [1, 15]
        }
      }
    },
    "CharacterController2d": {
      "kind": "component",
      "doc": "Kinematic capsule character: slopes, steps, ground snapping and pushing. The entity needs no RigidBody2d/Collider2d; the controller owns its capsule.",
      "module": "physics2d",
      "fields": {
        "radius": {
          "type": "f32",
          "doc": "Capsule radius.",
          "default": 0.3,
          "unit": "m",
          "range": [0.001, null]
        },
        "height": {
          "type": "f32",
          "doc": "Complete capsule height; must exceed twice the radius.",
          "default": 1.8,
          "unit": "m",
          "range": [0.001, null]
        },
        "maxSlopeDeg": {
          "type": "f32",
          "doc": "Maximum walkable slope angle.",
          "default": 45,
          "unit": "deg",
          "range": [0.1, 89.9]
        },
        "stepHeight": {
          "type": "f32",
          "doc": "Maximum step height climbed automatically; zero disables stepping.",
          "default": 0.25,
          "unit": "m",
          "range": [0, null]
        },
        "stickDown": {
          "type": "f32",
          "doc": "Distance searched below the feet to stay on descending ground; zero disables it.",
          "default": 0.2,
          "unit": "m",
          "range": [0, null]
        },
        "padding": {
          "type": "f32",
          "doc": "Collision padding kept between the capsule and the world.",
          "default": 0.01,
          "unit": "m",
          "range": [0.0001, null]
        },
        "layer": {
          "type": "u32",
          "doc": "Collision group used for movement queries.",
          "default": 1,
          "range": [1, 15]
        }
      }
    },
    "CharacterInput": {
      "kind": "component",
      "doc": "Per-tick character intent: replay this input exactly once before the rigid-body step.",
      "module": "physics",
      "fields": {
        "desiredVelocity": {
          "type": "vec3",
          "doc": "Desired world-space horizontal velocity; Y must be zero.",
          "default": [0, 0, 0],
          "unit": "m/s",
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        },
        "jumpSpeed": {
          "type": "f32",
          "doc": "Jump launch speed; zero means no jump this tick.",
          "default": 0,
          "unit": "m/s",
          "range": [0, null],
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        },
        "crouch": {
          "type": "bool",
          "doc": "Requested crouch; standing may be blocked by clearance.",
          "default": false,
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        }
      }
    },
    "CharacterInput2d": {
      "kind": "component",
      "doc": "Per-tick character intent, read exactly once by each boundary. Gameplay writes it before the physics system; it is not cleared, so held input repeats.",
      "module": "physics2d",
      "fields": {
        "desiredVelocity": {
          "type": "vec2",
          "doc": "Desired world-space velocity. With gravity it must be perpendicular to gravity (vertical motion comes from gravity and jumps); zero-gravity worlds use both axes.",
          "default": [0, 0],
          "unit": "m/s",
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        },
        "jumpSpeed": {
          "type": "f32",
          "doc": "Jump launch speed, applied only while grounded; zero means no jump this tick.",
          "default": 0,
          "unit": "m/s",
          "range": [0, null],
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        }
      }
    },
    "CharacterMotion": {
      "kind": "component",
      "doc": "Character support and stance mirrored at every fixed boundary.",
      "module": "physics",
      "fields": {
        "grounded": {
          "type": "bool",
          "doc": "Walkable ground support.",
          "default": false,
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        },
        "crouched": {
          "type": "bool",
          "doc": "Actual stance; a ceiling can prevent standing.",
          "default": false,
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        },
        "groundVelocity": {
          "type": "vec3",
          "doc": "Platform contact velocity.",
          "default": [0, 0, 0],
          "unit": "m/s",
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        },
        "groundNormal": {
          "type": "vec3",
          "doc": "Supporting surface normal.",
          "default": [0, 0, 0],
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        }
      }
    },
    "CharacterMotion2d": {
      "kind": "component",
      "doc": "Character support mirrored at every fixed boundary.",
      "module": "physics2d",
      "fields": {
        "grounded": {
          "type": "bool",
          "doc": "Walkable ground support after the last move.",
          "default": false,
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        },
        "groundNormal": {
          "type": "vec2",
          "doc": "Supporting surface normal; zero while airborne.",
          "default": [0, 0],
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        }
      }
    },
    "ClipData": {
      "kind": "struct",
      "doc": "An editable clip. Cook this once in the asset worker, never on a frame thread.",
      "module": "animation",
      "fields": {
        "duration": {
          "type": "u32",
          "doc": "Nonzero duration in integer ticks.",
          "default": 0
        },
        "ticksPerSecond": {
          "type": "u32",
          "doc": "Clip tick frequency. Controllers require all clips to share this frequency.",
          "default": 48000
        },
        "tracks": {
          "type": "list<JointTrack>",
          "doc": "Exactly one sparse track per skeleton joint, in skeleton order.",
          "default": []
        },
        "curves": {
          "type": "list<Curve>",
          "doc": "Animated scalar properties, independent of joint channels.",
          "default": []
        },
        "notifies": {
          "type": "list<Notify>",
          "doc": "Notifies in increasing time order; equal-time order is preserved.",
          "default": []
        }
      }
    },
    "Collider": {
      "kind": "component",
      "doc": "Collision geometry, material, layer and trigger settings.",
      "module": "physics",
      "fields": {
        "kind": {
          "type": "ColliderKind",
          "doc": "Primitive type or externally cooked shape.",
          "default": "box",
          "options": [
            "box",
            "sphere",
            "capsule",
            "cylinder",
            "cooked",
            "modelConvex",
            "modelMesh"
          ]
        },
        "center": {
          "type": "vec3",
          "doc": "Shape center in body-local metres, after visual scale is baked. The body origin remains at Transform/PhysicsPose; rotation also rotates this offset.",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "halfExtents": {
          "type": "vec3",
          "doc": "Box half extents; scale must be baked before physics extraction.",
          "default": [0.5, 0.5, 0.5],
          "unit": "m",
          "range": [0.0001, null],
          "editor": {
            "showIf": {
              "field": "kind",
              "when": {
                "oneOf": [
                  "box",
                  "modelConvex",
                  "modelMesh"
                ]
              }
            }
          }
        },
        "radius": {
          "type": "f32",
          "doc": "Sphere, capsule or cylinder radius.",
          "default": 0.5,
          "unit": "m",
          "range": [0.0001, null],
          "editor": {
            "showIf": {
              "field": "kind",
              "when": {
                "oneOf": [
                  "sphere",
                  "capsule",
                  "cylinder"
                ]
              }
            }
          }
        },
        "halfHeight": {
          "type": "f32",
          "doc": "Cylinder half height, excluding the capsule hemispheres.",
          "default": 0.5,
          "unit": "m",
          "range": [0, null],
          "editor": {
            "showIf": {
              "field": "kind",
              "when": {
                "oneOf": [
                  "capsule",
                  "cylinder"
                ]
              }
            }
          }
        },
        "asset": {
          "type": "option<asset>",
          "doc": "Cooked collision asset (`@path#id`); resolve into `CookedCollider` before ticking.",
          "default": null,
          "editor": {
            "showIf": {
              "field": "kind",
              "when": {
                "oneOf": [
                  "cooked",
                  "modelConvex",
                  "modelMesh"
                ]
              }
            }
          }
        },
        "node": {
          "type": "option<string>",
          "doc": "Source model node name/index for model-derived geometry; absent uses its default scene.",
          "default": null,
          "editor": {
            "showIf": {
              "field": "kind",
              "when": {
                "oneOf": [
                  "modelConvex",
                  "modelMesh"
                ]
              }
            }
          }
        },
        "primitive": {
          "type": "option<u32>",
          "doc": "Subtree-local primitive for model-derived geometry; absent uses the complete subtree.",
          "default": null,
          "editor": {
            "showIf": {
              "field": "kind",
              "when": {
                "oneOf": [
                  "modelConvex",
                  "modelMesh"
                ]
              }
            }
          }
        },
        "layer": {
          "type": "u32",
          "doc": "Zero selects static/moving defaults from the body; 1..15 select an explicit group.",
          "default": 0,
          "range": [0, 15]
        },
        "sensor": {
          "type": "bool",
          "doc": "Report trigger events without a collision response.",
          "default": false
        },
        "friction": {
          "type": "f32",
          "doc": "Coulomb friction coefficient.",
          "default": 0.6,
          "range": [0, null]
        },
        "restitution": {
          "type": "f32",
          "doc": "Elasticity: zero is inelastic, one is perfectly elastic.",
          "default": 0,
          "range": [0, 1]
        }
      }
    },
    "Collider2d": {
      "kind": "component",
      "doc": "Collision geometry, material, layer and trigger settings for a `RigidBody2d`.",
      "module": "physics2d",
      "fields": {
        "kind": {
          "type": "ColliderKind2d",
          "doc": "Primitive type or convex polygon.",
          "default": "box",
          "options": [
            "box",
            "circle",
            "capsule",
            "polygon"
          ]
        },
        "halfExtents": {
          "type": "vec2",
          "doc": "Box half extents; scale must be baked before physics extraction.",
          "default": [0.5, 0.5],
          "unit": "m",
          "range": [0.0001, null]
        },
        "radius": {
          "type": "f32",
          "doc": "Circle or capsule radius.",
          "default": 0.5,
          "unit": "m",
          "range": [0.0001, null]
        },
        "halfHeight": {
          "type": "f32",
          "doc": "Capsule segment half height, excluding the end caps.",
          "default": 0.5,
          "unit": "m",
          "range": [0, null]
        },
        "points": {
          "type": "list<vec2>",
          "doc": "Local convex hull input for polygons, in metres.",
          "default": []
        },
        "layer": {
          "type": "u32",
          "doc": "Zero selects static/moving defaults from the body; 1..15 select an explicit group.",
          "default": 0,
          "range": [0, 15]
        },
        "sensor": {
          "type": "bool",
          "doc": "Report overlaps without a collision response.",
          "default": false
        },
        "friction": {
          "type": "f32",
          "doc": "Coulomb friction coefficient.",
          "default": 0.6,
          "range": [0, null]
        },
        "restitution": {
          "type": "f32",
          "doc": "Elasticity: zero is inelastic, one is perfectly elastic.",
          "default": 0,
          "range": [0, 1]
        }
      }
    },
    "ColliderFromModelParams": {
      "kind": "params",
      "doc": "Derive a collider from an imported model or the entity's MeshRenderer selection.",
      "module": "physics",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Target entity, including prefab addresses.",
          "required": true
        },
        "model": {
          "type": "option<asset>",
          "doc": "Source import; omitted uses MeshRenderer.model.",
          "default": null
        },
        "node": {
          "type": "option<string>",
          "doc": "Source node name/index; omitted inherits MeshRenderer.node when model is omitted.",
          "default": null
        },
        "primitive": {
          "type": "option<u32>",
          "doc": "Subtree-local primitive; omitted inherits MeshRenderer.primitive when model is omitted.",
          "default": null
        },
        "mode": {
          "type": "ModelColliderMode",
          "doc": "Convex hull by default, or a static triangle surface.",
          "default": "convex",
          "options": [
            "convex",
            "mesh"
          ]
        },
        "center": {
          "type": "option<vec3>",
          "doc": "Optional center in body-local metres, after visual scale is baked.",
          "default": null
        }
      }
    },
    "ColliderKind": {
      "kind": "enum",
      "doc": "Primitive or cooked geometry selection. Cooked geometry is resolved by the asset worker.",
      "module": "physics",
      "variants": {
        "box": {
          "doc": "Box using half extents."
        },
        "sphere": {
          "doc": "Sphere using radius."
        },
        "capsule": {
          "doc": "Y-axis capsule using cylinder half height and radius."
        },
        "cylinder": {
          "doc": "Y-axis cylinder using half height and radius."
        },
        "cooked": {
          "doc": "Immutable cooked hull, mesh, terrain or compound, attached as `CookedCollider`."
        },
        "modelConvex": {
          "doc": "Convex hull from the selected cooked model geometry; supports moving bodies."
        },
        "modelMesh": {
          "doc": "Triangle surface from the selected cooked model geometry; static bodies only."
        }
      }
    },
    "ColliderKind2d": {
      "kind": "enum",
      "doc": "Convex 2D geometry selection; 2D never reuses the 3D shape vocabulary.",
      "module": "physics2d",
      "variants": {
        "box": {
          "doc": "Box using half extents."
        },
        "circle": {
          "doc": "Circle using radius."
        },
        "capsule": {
          "doc": "Y-axis capsule using segment half height and radius."
        },
        "polygon": {
          "doc": "Convex hull of `points` (3 to 64 local-space points)."
        }
      }
    },
    "ComponentAddParams": {
      "kind": "params",
      "doc": "Parameters of `component.add`.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Target entity; may be inside a prefab instance (stored as an override).",
          "required": true
        },
        "component": {
          "type": "string",
          "doc": "Component type name (`Light`).",
          "required": true
        },
        "value": {
          "type": "option<json>",
          "doc": "Initial field values; absent uses every default.",
          "default": null
        }
      }
    },
    "ComponentRemoveParams": {
      "kind": "params",
      "doc": "Parameters of `component.remove`.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Target entity; may be inside a prefab instance.",
          "required": true
        },
        "component": {
          "type": "string",
          "doc": "Component type name.",
          "required": true
        }
      }
    },
    "ControlAudioParams": {
      "kind": "params",
      "doc": "Schema-discoverable `audio.control` parameters for an existing presentation voice.",
      "module": "audio",
      "fields": {
        "voice": {
          "type": "u64",
          "doc": "Session-local runtime voice handle returned by audio.play, never a network entity ID.",
          "required": true
        },
        "atFrame": {
          "type": "u64",
          "doc": "Absolute presentation sample frame at which gain/rate automation begins.",
          "required": true
        },
        "parameters": {
          "type": "VoiceParameters",
          "doc": "Validated source gain/rate and listener-local acoustic parameters.",
          "required": true
        },
        "rampFrames": {
          "type": "u32",
          "doc": "Linear transition length in output frames; zero requests an explicit hard change.",
          "default": 64
        }
      }
    },
    "CookPreset": {
      "kind": "enum",
      "doc": "Encoding quality is an explicit cook input, independent of the execution budget. New imports default to Balanced; projects and individual textures can select HQ.",
      "module": "asset",
      "variants": {
        "balanced": {
          "doc": "Balanced compression search, the default for interactive project imports."
        },
        "highQuality": {
          "doc": "Deeper compression search for higher-quality assets and background recooks."
        },
        "fast": {
          "doc": "Reduced compression search for the first interactive generation."
        }
      }
    },
    "Curve": {
      "kind": "struct",
      "doc": "An animation curve addressing the same property path as the inspector.",
      "module": "animation",
      "fields": {
        "property": {
          "type": "string",
          "doc": "Stable target property path, such as MorphWeights.smile.",
          "default": ""
        },
        "keys": {
          "type": "list<ScalarKey>",
          "doc": "Strictly increasing keys; at least one is required.",
          "default": []
        },
        "interpolation": {
          "type": "Interpolation",
          "doc": "Scalar interpolation mode.",
          "default": "linear",
          "options": [
            "linear",
            "step"
          ]
        }
      }
    },
    "DocCreateParams": {
      "kind": "params",
      "doc": "Parameters of `doc.create`.",
      "fields": {
        "path": {
          "type": "string",
          "doc": "Output path relative to the authored root, with the document kind's extension.",
          "required": true
        },
        "kind": {
          "type": "option<string>",
          "doc": "Registered kind, or the material template (.graph); inferred from the path when omitted.",
          "default": null
        },
        "id": {
          "type": "option<string>",
          "doc": "Stable asset ID or batch symbol; generated when omitted.",
          "default": null
        }
      }
    },
    "DocDeleteParams": {
      "kind": "params",
      "doc": "Parameters of `doc.delete`.",
      "module": "core",
      "fields": {
        "document": {
          "type": "asset",
          "doc": "Loaded document path or asset reference to remove. Run from a different batch document, such as ara.project.json; project settings cannot be deleted.",
          "required": true
        }
      }
    },
    "Entity": {
      "kind": "record",
      "doc": "An entity in a scene or prefab. Components are stored inline under their type names; a prefab instance stores `prefab` plus overrides instead.",
      "module": "core",
      "prefix": "e",
      "components": true,
      "fields": {
        "name": {
          "type": "string",
          "doc": "Display name in the hierarchy.",
          "default": ""
        },
        "parent": {
          "type": "option<entity>",
          "doc": "Parent entity, or none for a root. May point inside a prefab instance (`e_4f9a/m4tz`).",
          "default": null
        },
        "order": {
          "type": "option<string>",
          "doc": "Fractional-index key ordering the entity among its siblings.",
          "default": null
        },
        "prefab": {
          "type": "option<asset<prefab>>",
          "doc": "The prefab this entity instantiates. Instances carry overrides, not components.",
          "default": null
        },
        "overrides": {
          "type": "map<json>",
          "doc": "Prefab overrides keyed by `[<id path>/]<field path>`, such as `m4tz/MeshRenderer.mesh` or `Transform.position`.",
          "default": {}
        },
        "removed": {
          "type": "list<string>",
          "doc": "Prefab entities (`m4tz`) or components (`m4tz/Light`) removed from this instance.",
          "default": []
        }
      }
    },
    "EntityCreateParams": {
      "kind": "params",
      "doc": "Parameters of `entity.create`.",
      "fields": {
        "id": {
          "type": "option<string>",
          "doc": "ID of the new entity: a symbol (`$crate`) that later calls in the batch can use, or a concrete unused record ID. Minted when absent.",
          "default": null
        },
        "name": {
          "type": "option<string>",
          "doc": "Display name.",
          "default": null
        },
        "parent": {
          "type": "option<entity>",
          "doc": "Parent entity; absent creates a root. May be inside a prefab instance.",
          "default": null
        },
        "index": {
          "type": "option<u32>",
          "doc": "Position among the parent's children; absent appends.",
          "default": null
        },
        "components": {
          "type": "option<map<json>>",
          "doc": "Components to add, by type name; `{}` uses every default.",
          "default": null
        }
      }
    },
    "EntityDeleteParams": {
      "kind": "params",
      "doc": "Parameters of `entity.delete`.",
      "fields": {
        "entities": {
          "type": "list<entity>",
          "doc": "Entities to delete, with everything below them. Entities inside a prefab instance are removed from that instance instead.",
          "required": true
        }
      }
    },
    "EntityInspectParams": {
      "kind": "params",
      "doc": "Parameters of `entity.inspect`.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "The entity to inspect; may be inside a prefab instance.",
          "required": true
        }
      }
    },
    "EntityReparentParams": {
      "kind": "params",
      "doc": "Parameters of `entity.reparent`.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "The entity to move. Must be a record of the document (not inside a prefab).",
          "required": true
        },
        "parent": {
          "type": "option<entity>",
          "doc": "New parent; absent makes the entity a root.",
          "default": null
        },
        "index": {
          "type": "option<u32>",
          "doc": "Position among the new siblings; absent appends.",
          "default": null
        }
      }
    },
    "Environment": {
      "kind": "component",
      "doc": "Procedural sky radiance and camera exposure. The first in stable-ID order wins.",
      "module": "render",
      "fields": {
        "sky": {
          "type": "color",
          "doc": "Zenith sky color (linear).",
          "default": [0.22, 0.32, 0.6, 1]
        },
        "horizon": {
          "type": "color",
          "doc": "Horizon sky color (linear).",
          "default": [0.95, 0.62, 0.4, 1]
        },
        "ground": {
          "type": "color",
          "doc": "Ground color seen below the horizon (linear).",
          "default": [0.18, 0.16, 0.14, 1]
        },
        "intensity": {
          "type": "f32",
          "doc": "Sky radiance scale in candela per square metre.",
          "default": 900,
          "unit": "cd",
          "range": [0, null]
        },
        "exposure": {
          "type": "f32",
          "doc": "Linear camera exposure multiplier, applied before tone mapping.",
          "default": 0.0015,
          "range": [1e-7, null]
        }
      }
    },
    "ExposureMode": {
      "kind": "enum",
      "doc": "How the camera exposes the scene (a post-process volume's exposure override).",
      "module": "render",
      "variants": {
        "auto": {
          "doc": "Meter the frame's luminance and adapt within `minEv100`..`maxEv100`."
        },
        "manual": {
          "doc": "Fixed photographic exposure `ev100`."
        }
      }
    },
    "Flipbook": {
      "kind": "component",
      "doc": "Tick-driven flipbook state, wholly contained in an ECS component.",
      "module": "twoD",
      "fields": {
        "frames": {
          "type": "list<FlipbookFrame>",
          "doc": "Ordered clip frames.",
          "default": []
        },
        "startTick": {
          "type": "u64",
          "doc": "Clip's start tick, preserved through snapshots.",
          "default": 0
        },
        "looping": {
          "type": "bool",
          "doc": "Repeat rather than hold the final frame.",
          "default": false
        }
      }
    },
    "FlipbookFrame": {
      "kind": "struct",
      "doc": "One deterministic flipbook frame.",
      "fields": {
        "region": {
          "type": "string",
          "doc": "Atlas region name.",
          "default": ""
        },
        "ticks": {
          "type": "u32",
          "doc": "Frame duration in fixed simulation ticks; must be positive.",
          "default": 0
        }
      }
    },
    "FlipbookSetParams": {
      "kind": "params",
      "doc": "Complete typed component authoring update.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Target entity, including prefab addresses.",
          "required": true
        },
        "value": {
          "type": "Flipbook",
          "doc": "Complete typed component; omitted fields use schema defaults.",
          "required": true
        }
      }
    },
    "FolderCreateParams": {
      "kind": "params",
      "doc": "Parameters of `folder.create`.",
      "module": "core",
      "fields": {
        "path": {
          "type": "string",
          "doc": "New folder path relative to the authored root.",
          "required": true
        },
        "parents": {
          "type": "bool",
          "doc": "Also create missing intermediate empty directories; false requires an existing parent.",
          "default": false
        }
      }
    },
    "FoliageCreateParams": {
      "kind": "params",
      "doc": "Foliage source terrain.",
      "module": "foliage",
      "fields": {
        "header": {
          "type": "FoliageHeader",
          "doc": "Source terrain dependency.",
          "required": true
        }
      }
    },
    "FoliageEraseParams": {
      "kind": "params",
      "doc": "Stable record deletion for erasing manual strokes/rules/zones.",
      "module": "foliage",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Existing paint, exclusion or unused rule record ID.",
          "required": true
        }
      }
    },
    "FoliageExcludeParams": {
      "kind": "params",
      "doc": "Exclusion insertion parameters.",
      "module": "foliage",
      "fields": {
        "id": {
          "type": "option<string>",
          "doc": "Optional concrete or symbolic exclusion ID for reproducible authoring.",
          "default": null
        },
        "zone": {
          "type": "FoliageExclusion",
          "doc": "Circular exclusion zone.",
          "required": true
        }
      }
    },
    "FoliageExclusion": {
      "kind": "record",
      "doc": "Circular exclusion zone, applied identically to procedural and manual foliage.",
      "module": "foliage",
      "prefix": "x",
      "fields": {
        "center": {
          "type": "vec2",
          "doc": "World X/Z centre in metres.",
          "default": [0, 0]
        },
        "radius": {
          "type": "f32",
          "doc": "Radius in metres.",
          "default": 0
        }
      }
    },
    "FoliageHeader": {
      "kind": "record",
      "doc": "Terrain dependency for a foliage document.",
      "module": "foliage",
      "prefix": "f",
      "fields": {
        "terrain": {
          "type": "asset",
          "doc": "Canonical terrain asset reference.",
          "default": null
        }
      }
    },
    "FoliagePaint": {
      "kind": "record",
      "doc": "One manual brush gesture, retained for deterministic regeneration and undo.",
      "module": "foliage",
      "prefix": "p",
      "fields": {
        "rule": {
          "type": "string",
          "doc": "Existing rule ID whose asset and filters supply instance properties.",
          "default": ""
        },
        "seed": {
          "type": "u64",
          "doc": "Explicit seed for per-point scale/yaw/wind phase.",
          "default": 0
        },
        "points": {
          "type": "list<vec2>",
          "doc": "Manual world X/Z points, ordered within a single gesture.",
          "default": []
        }
      }
    },
    "FoliagePaintParams": {
      "kind": "params",
      "doc": "One manual brush stroke.",
      "module": "foliage",
      "fields": {
        "stroke": {
          "type": "FoliagePaint",
          "doc": "Whole gesture, with all points in order.",
          "required": true
        }
      }
    },
    "FoliageRule": {
      "kind": "record",
      "doc": "Seeded procedural placement rule, evaluated on workers in global cell space.",
      "module": "foliage",
      "prefix": "r",
      "fields": {
        "name": {
          "type": "string",
          "doc": "Display name for editor/agent tools.",
          "default": ""
        },
        "species": {
          "type": "FoliageSpecies",
          "doc": "Species/geometry family.",
          "default": "grass",
          "options": [
            "grass",
            "tree",
            "rock"
          ]
        },
        "asset": {
          "type": "asset",
          "doc": "Source model or foliage asset; resolves to cooked mesh/impostor LODs.",
          "default": null
        },
        "seed": {
          "type": "u64",
          "doc": "Explicit deterministic seed, independent of request/iteration order.",
          "default": 0
        },
        "cellSize": {
          "type": "f32",
          "doc": "Global candidate-cell width in metres, strictly positive.",
          "default": 0
        },
        "density": {
          "type": "f32",
          "doc": "Expected accepted instances per square metre before surface masks.",
          "default": 0
        },
        "height": {
          "type": "vec2",
          "doc": "Inclusive elevation range in world metres.",
          "default": [0, 0]
        },
        "slope": {
          "type": "vec2",
          "doc": "Inclusive slope range in degrees.",
          "default": [0, 0]
        },
        "channel": {
          "type": "u32",
          "doc": "Splat channel controlling density, zero to three.",
          "default": 0
        },
        "minWeight": {
          "type": "f32",
          "doc": "Minimum terrain weight required before multiplying density by that weight.",
          "default": 0
        },
        "noise": {
          "type": "f32",
          "doc": "Low-frequency deterministic noise modulation (zero disables it).",
          "default": 0
        },
        "scale": {
          "type": "vec2",
          "doc": "Inclusive uniform scale range.",
          "default": [0, 0]
        },
        "enabled": {
          "type": "bool",
          "doc": "Whether this rule participates in regeneration.",
          "default": false
        }
      }
    },
    "FoliageRuleParams": {
      "kind": "params",
      "doc": "Rule insertion/replacement parameters.",
      "module": "foliage",
      "fields": {
        "id": {
          "type": "option<string>",
          "doc": "Optional existing ID or new symbolic ID.",
          "default": null
        },
        "rule": {
          "type": "FoliageRule",
          "doc": "Seeded rule and placement filters.",
          "required": true
        }
      }
    },
    "FoliageSpecies": {
      "kind": "enum",
      "doc": "Vegetation/prop family used by render extraction and impostor selection.",
      "module": "foliage",
      "variants": {
        "grass": {
          "doc": "Alpha-tested ground cover with vertex wind."
        },
        "tree": {
          "doc": "Trunk/canopy instances with distance impostors."
        },
        "rock": {
          "doc": "Static opaque scattered rocks."
        }
      }
    },
    "FollowCamera": {
      "kind": "component",
      "doc": "Third-person orbit rig: places this entity behind `target`, steered by `Look`.",
      "module": "gameplay",
      "fields": {
        "target": {
          "type": "option<entity>",
          "doc": "Followed entity.",
          "default": null
        },
        "distance": {
          "type": "f32",
          "doc": "Orbit distance from the aim point; the boom stops in front of static box colliders.",
          "default": 5,
          "unit": "m",
          "range": [0.1, null]
        },
        "height": {
          "type": "f32",
          "doc": "Aim point height above the target's origin.",
          "default": 0.8,
          "unit": "m"
        },
        "yaw": {
          "type": "f32",
          "doc": "Orbit yaw; 0 looks along +Z. Simulation state driven by `Look`.",
          "default": 0,
          "unit": "deg"
        },
        "pitch": {
          "type": "f32",
          "doc": "Orbit pitch above the horizon; simulation state driven by `Look`.",
          "default": 20,
          "unit": "deg",
          "range": [-80, 80]
        },
        "sensitivity": {
          "type": "f32",
          "doc": "Look sensitivity: degrees per tick at full axis deflection.",
          "default": 2.5,
          "unit": "deg",
          "range": [0, null]
        },
        "player": {
          "type": "u64",
          "doc": "Input owner whose `Look` action steers the rig.",
          "default": 1
        }
      }
    },
    "Foot": {
      "kind": "struct",
      "doc": "A foot chain and its anatomical sole-up direction.",
      "module": "animation",
      "fields": {
        "chain": {
          "type": "ChainData",
          "doc": "Hip-to-ankle chain.",
          "default": {}
        },
        "up": {
          "type": "vec3",
          "doc": "Unit foot-local sole normal.",
          "default": [0, 1, 0]
        }
      }
    },
    "FootSettings": {
      "kind": "struct",
      "doc": "Ground-contact setup, serialized in the same animation asset as its chains.",
      "module": "animation",
      "fields": {
        "probeUp": {
          "type": "f32",
          "doc": "Probe start above the animated sole in meters.",
          "default": 0.3
        },
        "probeDown": {
          "type": "f32",
          "doc": "Probe reach below the animated sole in meters.",
          "default": 0.6
        },
        "soleHeight": {
          "type": "f32",
          "doc": "Foot-joint height above the ground in meters.",
          "default": 0
        },
        "pelvisLimit": {
          "type": "f32",
          "doc": "Maximum pelvis displacement in either vertical direction.",
          "default": 0.3
        },
        "minNormalY": {
          "type": "f32",
          "doc": "Minimum world-up dot ground normal accepted as walkable.",
          "default": 0.5
        }
      }
    },
    "GraphComment": {
      "kind": "struct",
      "doc": "A graph comment, stored only in the editor section.",
      "module": "graph",
      "fields": {
        "text": {
          "type": "string",
          "doc": "Human-readable annotation.",
          "default": ""
        },
        "position": {
          "type": "vec2",
          "doc": "Canvas position.",
          "default": [0, 0]
        }
      }
    },
    "GraphDirection": {
      "kind": "enum",
      "doc": "Direction relative to the owning node.",
      "module": "graph",
      "variants": {
        "input": {
          "doc": "Receives at most one connection."
        },
        "output": {
          "doc": "Can feed any number of inputs."
        }
      }
    },
    "GraphEdge": {
      "kind": "record",
      "doc": "A directed connection with its own stable document record ID.",
      "module": "graph",
      "prefix": "w",
      "fields": {
        "from": {
          "type": "GraphEndpoint",
          "doc": "Output socket.",
          "default": {}
        },
        "to": {
          "type": "GraphEndpoint",
          "doc": "Input socket.",
          "default": {}
        }
      }
    },
    "GraphEditor": {
      "kind": "record",
      "doc": "Nonsemantic editor state, excluded entirely from `semantic_hash`.",
      "module": "graph",
      "prefix": "l",
      "fields": {
        "positions": {
          "type": "map<vec2>",
          "doc": "Node coordinates keyed by stable semantic ID.",
          "default": {}
        },
        "comments": {
          "type": "map<GraphComment>",
          "doc": "Comments keyed by stable comment ID.",
          "default": {}
        },
        "groups": {
          "type": "map<GraphGroup>",
          "doc": "Groups keyed by stable group ID.",
          "default": {}
        },
        "reroutes": {
          "type": "map<list<vec2>>",
          "doc": "Edge routing points keyed by stable edge ID; not evaluation nodes.",
          "default": {}
        }
      }
    },
    "GraphEndpoint": {
      "kind": "struct",
      "doc": "An addressed socket; port identity is scoped to the node.",
      "module": "graph",
      "fields": {
        "node": {
          "type": "string",
          "doc": "Stable node record ID.",
          "default": ""
        },
        "port": {
          "type": "string",
          "doc": "Persistent socket key.",
          "default": ""
        }
      }
    },
    "GraphGroup": {
      "kind": "struct",
      "doc": "A visual group; membership never changes execution.",
      "module": "graph",
      "fields": {
        "label": {
          "type": "string",
          "doc": "Canvas title.",
          "default": ""
        },
        "nodes": {
          "type": "list<string>",
          "doc": "Stable node IDs in the group.",
          "default": []
        }
      }
    },
    "GraphHeader": {
      "kind": "record",
      "doc": "Domain metadata, kept apart from editor state.",
      "module": "graph",
      "prefix": "g",
      "fields": {
        "domain": {
          "type": "string",
          "doc": "Adapter identity (`material`, `animation`, ...).",
          "default": ""
        },
        "payload": {
          "type": "json",
          "doc": "Domain-specific semantic metadata.",
          "default": null
        }
      }
    },
    "GraphNode": {
      "kind": "record",
      "doc": "A versioned node; opaque payloads survive unavailable plugins unchanged.",
      "module": "graph",
      "prefix": "n",
      "fields": {
        "kind": {
          "type": "string",
          "doc": "Registry key, such as `material.add`.",
          "default": ""
        },
        "version": {
          "type": "u32",
          "doc": "Exact registry version used by this node.",
          "default": 1
        },
        "ports": {
          "type": "map<GraphPort>",
          "doc": "Ports keyed by persistent socket identity, not display order.",
          "default": {}
        },
        "params": {
          "type": "map<json>",
          "doc": "Literal input defaults and authorable parameters.",
          "default": {}
        },
        "payload": {
          "type": "json",
          "doc": "Domain-owned data, preserved for unknown node kinds.",
          "default": null
        },
        "subgraph": {
          "type": "option<asset>",
          "doc": "Optional full `@path#id` subgraph reference.",
          "default": null
        }
      }
    },
    "GraphPort": {
      "kind": "struct",
      "doc": "A stable named, nominally typed socket. Domains interpret `ty`.",
      "module": "graph",
      "fields": {
        "ty": {
          "type": "string",
          "doc": "Domain type name, including semantic distinctions such as sRGB.",
          "default": ""
        },
        "direction": {
          "type": "GraphDirection",
          "doc": "Input or output socket.",
          "default": "input",
          "options": [
            "input",
            "output"
          ]
        },
        "doc": {
          "type": "string",
          "doc": "Tooltip and agent-facing documentation.",
          "default": ""
        },
        "required": {
          "type": "bool",
          "doc": "Whether compilation requires an incoming edge or a parameter of this name.",
          "default": false
        }
      }
    },
    "GridLayout": {
      "kind": "enum",
      "doc": "Tile coordinate layout; hex is axial and pointy-topped.",
      "variants": {
        "grid": {
          "doc": "Axis-aligned rectangular cells."
        },
        "hex": {
          "doc": "Axial q/r hexagons with cell size equal to their bounding box."
        },
        "isometric": {
          "doc": "Diamond grid, cell size equal to a diamond's bounding box."
        }
      }
    },
    "HeightFog": {
      "kind": "component",
      "doc": "Exponential height fog lit by the sun, the sky and local lights (volumetric shafts where shadows cut the beams). Density halves every `falloff × ln 2` metres above `baseHeight`. The first entity in ID order wins.",
      "module": "render",
      "fields": {
        "density": {
          "type": "f32",
          "doc": "Extinction at `baseHeight`, per metre. 0.002 is a light haze (visibility ≈ 1.5 km), 0.02 a thick fog (≈ 150 m).",
          "default": 0.002,
          "range": [0, 0.1],
          "examples": [0.004]
        },
        "baseHeight": {
          "type": "f32",
          "doc": "World altitude where the fog has its full density.",
          "default": 0,
          "unit": "m"
        },
        "falloff": {
          "type": "f32",
          "doc": "Scale height: density falls by a factor of e over this many metres of altitude.",
          "default": 60,
          "unit": "m",
          "range": [1, 10000]
        },
        "albedo": {
          "type": "color",
          "doc": "Scattering colour (single-scattering albedo, linear). Grey-white for water fog, warm for dust.",
          "default": [0.9, 0.9, 0.9, 1]
        },
        "anisotropy": {
          "type": "f32",
          "doc": "Forward-scattering bias: 0 is uniform, toward 1 the fog glows around the sun and lamps.",
          "default": 0.3,
          "range": [0, 0.9]
        }
      }
    },
    "IkSetup": {
      "kind": "struct",
      "doc": "Canonical procedural rig setup; goal values are fixed-tick gameplay inputs.",
      "module": "animation",
      "fields": {
        "pelvis": {
          "type": "string",
          "doc": "Stable pelvis joint ID for full-body and foot-placement solvers.",
          "default": ""
        },
        "chains": {
          "type": "list<ChainData>",
          "doc": "Ordered chains used by body and hand goals.",
          "default": []
        },
        "feet": {
          "type": "list<Foot>",
          "doc": "Foot chains and anatomical sole-up vectors.",
          "default": []
        },
        "ground": {
          "type": "FootSettings",
          "doc": "Ground probe, slope and pelvis bounds.",
          "default": {}
        }
      }
    },
    "ImportConfigureParams": {
      "kind": "params",
      "doc": "Parameters of `import.configure`.",
      "module": "asset",
      "fields": {
        "source": {
          "type": "string",
          "doc": "Source media path whose existing sidecar should change.",
          "required": true
        },
        "settings": {
          "type": "option<json>",
          "doc": "Replacement importer-specific settings; omitted retains them.",
          "default": null
        },
        "preset": {
          "type": "option<CookPreset>",
          "doc": "Replacement shipping preset; omitted retains it.",
          "default": null,
          "options": [
            "balanced",
            "highQuality",
            "fast"
          ]
        },
        "useProjectPreset": {
          "type": "bool",
          "doc": "Remove the source quality override and follow the project import policy.",
          "default": false
        },
        "dependencies": {
          "type": "option<list<asset>>",
          "doc": "Replacement authoring dependencies; omitted retains them.",
          "default": null
        }
      }
    },
    "ImportConflict": {
      "kind": "enum",
      "doc": "Conflict resolution chosen before the background import preparation begins.",
      "variants": {
        "rename": {
          "doc": "Keep existing data and allocate deterministic, compound-extension-safe names."
        },
        "replace": {
          "doc": "Replace matching files while preserving existing asset IDs/sidecar settings; merge directories additively without deleting unmentioned children."
        },
        "skip": {
          "doc": "Keep colliding destination entries; a directory collision skips its subtree."
        }
      }
    },
    "ImportInitializeParams": {
      "kind": "params",
      "doc": "Parameters of `import.initialize`.",
      "module": "asset",
      "fields": {
        "source": {
          "type": "string",
          "doc": "Existing source media path, relative to the project.",
          "required": true
        },
        "id": {
          "type": "option<string>",
          "doc": "Stable asset ID or batch symbol; generated when omitted.",
          "default": null
        },
        "settings": {
          "type": "option<json>",
          "doc": "Importer-specific settings; defaults when omitted.",
          "default": null
        },
        "preset": {
          "type": "option<CookPreset>",
          "doc": "Source texture quality override; omitted inherits the project preset.",
          "default": null,
          "options": [
            "balanced",
            "highQuality",
            "fast"
          ]
        },
        "dependencies": {
          "type": "option<list<asset>>",
          "doc": "Referenced authoring assets used by the cook.",
          "default": null
        }
      }
    },
    "ImportProjectConfigureParams": {
      "kind": "params",
      "doc": "Parameters of `import.project.configure`; reflected in the inspector and MCP.",
      "module": "asset",
      "fields": {
        "preset": {
          "type": "CookPreset",
          "doc": "Default texture quality for sources and model textures without an override.",
          "required": true,
          "options": [
            "balanced",
            "highQuality",
            "fast"
          ]
        }
      }
    },
    "ImportSettings": {
      "kind": "record",
      "doc": "Declarative importer configuration, stored as the single `i_settings` record.",
      "module": "asset",
      "prefix": "i",
      "fields": {
        "preset": {
          "type": "option<CookPreset>",
          "doc": "Texture encoding quality override. Omit this field to inherit the project preset in ara.imports; Balanced is the default for new projects.",
          "default": null,
          "options": [
            "balanced",
            "highQuality",
            "fast"
          ]
        },
        "importer": {
          "type": "string",
          "doc": "Stable worker importer ID.",
          "default": ""
        },
        "version": {
          "type": "string",
          "doc": "Exact importer version, including encoder implementation versions.",
          "default": ""
        },
        "settings": {
          "type": "json",
          "doc": "Importer-specific typed settings, canonicalized recursively.",
          "default": null
        },
        "dependencies": {
          "type": "list<asset>",
          "doc": "Referenced authoring assets, using project-relative `@path#id` syntax.",
          "default": []
        }
      }
    },
    "Interpolation": {
      "kind": "enum",
      "doc": "Interpolation between consecutive keys.",
      "module": "animation",
      "variants": {
        "linear": {
          "doc": "Linear vectors and shortest-path normalized linear quaternions."
        },
        "step": {
          "doc": "Hold the preceding key until the next key's exact timestamp."
        }
      }
    },
    "Joint": {
      "kind": "component",
      "doc": "Joint on a body; connection zero anchors to the world. Anchors/axes are world-space.",
      "module": "physics",
      "fields": {
        "kind": {
          "type": "JointKind",
          "doc": "Constraint primitive.",
          "default": "fixed",
          "options": [
            "fixed",
            "hinge",
            "slider",
            "distance",
            "point",
            "sixDof"
          ]
        },
        "connectedBody": {
          "type": "u64",
          "doc": "PhysicsId of the connected body; zero is the world.",
          "default": 0
        },
        "anchorA": {
          "type": "vec3",
          "doc": "Anchor on the connected body, or the world anchor.",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "anchorB": {
          "type": "vec3",
          "doc": "Anchor on this entity's body.",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "axis": {
          "type": "vec3",
          "doc": "Unit primary axis (hinge direction, slider direction, or frame X).",
          "default": [1, 0, 0]
        },
        "normal": {
          "type": "vec3",
          "doc": "Unit perpendicular normal (frame Y).",
          "default": [0, 1, 0]
        },
        "translationMin": {
          "type": "vec3",
          "doc": "Minimum XYZ translation; X is the slider/distance lower bound.",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "translationMax": {
          "type": "vec3",
          "doc": "Maximum XYZ translation; X is the slider/distance upper bound.",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "rotationMin": {
          "type": "vec3",
          "doc": "Minimum XYZ angular limits; X is the hinge lower bound.",
          "default": [0, 0, 0],
          "unit": "rad",
          "range": [-3.1415928, 3.1415928]
        },
        "rotationMax": {
          "type": "vec3",
          "doc": "Maximum XYZ angular limits; X is the hinge upper bound.",
          "default": [0, 0, 0],
          "unit": "rad",
          "range": [-3.1415928, 3.1415928]
        }
      }
    },
    "JointKind": {
      "kind": "enum",
      "doc": "Joint primitive implemented by the backend.",
      "module": "physics",
      "variants": {
        "fixed": {
          "doc": "Locks all relative motion."
        },
        "hinge": {
          "doc": "Rotation around one axis."
        },
        "slider": {
          "doc": "Translation along one axis."
        },
        "distance": {
          "doc": "Separation constrained to a distance interval."
        },
        "point": {
          "doc": "Coincident anchors with free rotation."
        },
        "sixDof": {
          "doc": "Independent translation and angular limits on three axes each."
        }
      }
    },
    "JointLimit": {
      "kind": "struct",
      "doc": "Anatomical angular bounds, in radians around a unit bind-local axis.",
      "module": "animation",
      "fields": {
        "kind": {
          "type": "LimitKind",
          "doc": "Constraint primitive.",
          "default": "free",
          "options": [
            "free",
            "cone",
            "hinge"
          ]
        },
        "axis": {
          "type": "vec3",
          "doc": "Unit hinge or twist axis in the joint's bind-local frame.",
          "default": [1, 0, 0]
        },
        "swing": {
          "type": "f32",
          "doc": "Maximum swing angle for a cone.",
          "default": 3.1415927
        },
        "min": {
          "type": "f32",
          "doc": "Minimum signed twist or hinge angle.",
          "default": -3.1415927
        },
        "max": {
          "type": "f32",
          "doc": "Maximum signed twist or hinge angle.",
          "default": 3.1415927
        }
      }
    },
    "JointTrack": {
      "kind": "struct",
      "doc": "Sparse local transform channels for one joint; empty channels use bind pose.",
      "module": "animation",
      "fields": {
        "translations": {
          "type": "list<VectorKey>",
          "doc": "Translation channel.",
          "default": []
        },
        "rotations": {
          "type": "list<RotationKey>",
          "doc": "Rotation channel.",
          "default": []
        },
        "scales": {
          "type": "list<VectorKey>",
          "doc": "Scale channel.",
          "default": []
        },
        "translationInterpolation": {
          "type": "Interpolation",
          "doc": "Translation interpolation, independent of rotation and scale.",
          "default": "linear",
          "options": [
            "linear",
            "step"
          ]
        },
        "rotationInterpolation": {
          "type": "Interpolation",
          "doc": "Quaternion interpolation, independent of translation and scale.",
          "default": "linear",
          "options": [
            "linear",
            "step"
          ]
        },
        "scaleInterpolation": {
          "type": "Interpolation",
          "doc": "Scale interpolation, independent of translation and rotation.",
          "default": "linear",
          "options": [
            "linear",
            "step"
          ]
        }
      }
    },
    "L10nExtractParams": {
      "kind": "params",
      "doc": "Source-scan request. Sources are supplied by the host; no arbitrary filesystem IO.",
      "module": "l10n",
      "fields": {
        "kind": {
          "type": "L10nSourceKind",
          "doc": "UI markup or C#.",
          "required": true,
          "options": [
            "markup",
            "csharp"
          ]
        },
        "source": {
          "type": "string",
          "doc": "Complete UTF-8 source text.",
          "required": true
        },
        "prefix": {
          "type": "string",
          "doc": "Dotted prefix for generated stable keys, for example `pause`.",
          "required": true
        }
      }
    },
    "L10nFindMissingParams": {
      "kind": "params",
      "doc": "Source locale for parity checks against the current batch document.",
      "module": "l10n",
      "fields": {
        "sourceLocale": {
          "type": "string",
          "doc": "Source locale loaded in the document workspace, normally `en`.",
          "required": true
        }
      }
    },
    "L10nFontFace": {
      "kind": "struct",
      "doc": "Explicit font resource; never depends on installed OS fonts.",
      "module": "l10n",
      "fields": {
        "family": {
          "type": "string",
          "doc": "Family name passed to `ara_ui_text::TextSystem` in fallback order.",
          "default": ""
        },
        "asset": {
          "type": "option<asset>",
          "doc": "Font asset, using the standard `@path#id` reference syntax.",
          "default": null
        }
      }
    },
    "L10nLocaleConfig": {
      "kind": "record",
      "doc": "One locale's configuration, stored as `l_config` in its localization document.",
      "module": "l10n",
      "prefix": "l",
      "fields": {
        "locale": {
          "type": "string",
          "doc": "Canonical BCP-47 locale identifier such as `ar-EG`.",
          "default": ""
        },
        "fallback": {
          "type": "list<string>",
          "doc": "Additional fallback locales, followed after the locale's structural parents.",
          "default": []
        },
        "rtl": {
          "type": "bool",
          "doc": "Mirror layout boxes; glyph shaping and logical reading order remain intact.",
          "default": false
        },
        "fonts": {
          "type": "list<L10nFontFace>",
          "doc": "Ordered family/resources for this locale, inherited through fallback.",
          "default": []
        }
      }
    },
    "L10nParamKind": {
      "kind": "enum",
      "doc": "Parameter types shared by messages, generated bindings and translation jobs.",
      "module": "l10n",
      "variants": {
        "text": {
          "doc": "User or application text, inserted with bidi isolation."
        },
        "number": {
          "doc": "Exact decimal, also usable as a plural selector."
        },
        "date": {
          "doc": "ISO calendar date, formatted in the requested locale's calendar."
        },
        "currency": {
          "doc": "Exact decimal and ISO 4217 currency code."
        }
      }
    },
    "L10nProvenance": {
      "kind": "struct",
      "doc": "Reproducible origin of a generated translation; no secrets belong here.",
      "module": "l10n",
      "fields": {
        "provider": {
          "type": "string",
          "doc": "Provider identifier chosen by the host.",
          "default": ""
        },
        "model": {
          "type": "string",
          "doc": "Provider model/version identifier.",
          "default": ""
        },
        "job": {
          "type": "string",
          "doc": "Host-assigned generation job identifier.",
          "default": ""
        },
        "sourceHash": {
          "type": "string",
          "doc": "BLAKE3 of source text and typed parameter signature.",
          "default": ""
        }
      }
    },
    "L10nPutParams": {
      "kind": "params",
      "doc": "Validated insertion/replacement params used by machine-applicable fixes.",
      "module": "l10n",
      "fields": {
        "id": {
          "type": "option<string>",
          "doc": "Existing record ID, or omit to reuse the key's record or a stable hashed ID.",
          "default": null
        },
        "entry": {
          "type": "L10nStringEntry",
          "doc": "Whole message with typed parameters and review metadata.",
          "required": true
        }
      }
    },
    "L10nRemoveParams": {
      "kind": "params",
      "doc": "Record addressed removal of an obsolete localization message.",
      "module": "l10n",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Stable message record ID, starting with `m_`.",
          "required": true
        }
      }
    },
    "L10nSourceKind": {
      "kind": "enum",
      "doc": "Source language scanned for localization candidates.",
      "module": "l10n",
      "variants": {
        "markup": {
          "doc": "UI text nodes and human-visible text/label/placeholder/title attributes."
        },
        "csharp": {
          "doc": "C# normal and verbatim string literals, excluding comments and char literals."
        }
      }
    },
    "L10nStatus": {
      "kind": "enum",
      "doc": "Human review state, independent of whether the text can be displayed.",
      "module": "l10n",
      "variants": {
        "reviewed": {
          "doc": "A human has approved this translation."
        },
        "machineTranslated": {
          "doc": "A translation provider generated this text."
        },
        "needsReview": {
          "doc": "Text requires a translator's attention."
        }
      }
    },
    "L10nStringEntry": {
      "kind": "record",
      "doc": "A mergeable message record; its stable record ID survives translation changes.",
      "module": "l10n",
      "prefix": "m",
      "fields": {
        "key": {
          "type": "string",
          "doc": "Stable dotted lookup key, for example `inventory.items`.",
          "default": ""
        },
        "text": {
          "type": "string",
          "doc": "ICU MessageFormat pattern, including nested plural/select expressions.",
          "default": ""
        },
        "params": {
          "type": "map<L10nParamKind>",
          "doc": "Exact parameter names and types; every locale must share this signature.",
          "default": {}
        },
        "status": {
          "type": "L10nStatus",
          "doc": "Review state visible to agents and translators.",
          "default": "reviewed",
          "options": [
            "reviewed",
            "machineTranslated",
            "needsReview"
          ]
        },
        "provenance": {
          "type": "option<L10nProvenance>",
          "doc": "Generation origin, or none for human-authored source text.",
          "default": null
        },
        "note": {
          "type": "string",
          "doc": "Translator context, never displayed in game.",
          "default": ""
        }
      }
    },
    "Layer": {
      "kind": "record",
      "doc": "Independently loaded and visible data layer, such as art, night or quest state.",
      "module": "world",
      "prefix": "l",
      "fields": {
        "name": {
          "type": "string",
          "doc": "Human-readable label.",
          "default": ""
        },
        "loaded": {
          "type": "bool",
          "doc": "Load cells in this layer when a source is within range.",
          "default": false
        },
        "visible": {
          "type": "bool",
          "doc": "Presentation visibility; hiding preserves simulation residency.",
          "default": false
        },
        "range": {
          "type": "f32",
          "doc": "Distance outside a cell's bounds at which it becomes wanted.",
          "default": 0,
          "unit": "m"
        },
        "graceTicks": {
          "type": "u32",
          "doc": "Fixed host ticks a cell remains resident after leaving the wanted set.",
          "default": 0
        }
      }
    },
    "Light": {
      "kind": "component",
      "doc": "A light at the entity's world position. Edits apply live in play.",
      "module": "render",
      "fields": {
        "kind": {
          "type": "LightKind",
          "doc": "Point, spot or directional.",
          "default": "point",
          "options": [
            "point",
            "spot",
            "directional"
          ]
        },
        "color": {
          "type": "color",
          "doc": "Linear RGB tint (alpha is ignored).",
          "default": [1, 1, 1, 1],
          "editor": {
            "temperature": true
          }
        },
        "intensity": {
          "type": "f32",
          "doc": "Luminous flux in lumens (point/spot) or illuminance in lux (directional).",
          "default": 800,
          "range": [0, null]
        },
        "range": {
          "type": "f32",
          "doc": "Influence radius of point and spot lights.",
          "default": 10,
          "unit": "m",
          "range": [0.01, null],
          "editor": {
            "showIf": {
              "field": "kind",
              "when": {
                "oneOf": [
                  "point",
                  "spot"
                ]
              }
            }
          }
        },
        "innerAngle": {
          "type": "f32",
          "doc": "Spot inner cone half-angle.",
          "default": 20,
          "unit": "deg",
          "range": [0, 89],
          "editor": {
            "showIf": {
              "field": "kind",
              "when": {
                "oneOf": [
                  "spot"
                ]
              }
            }
          }
        },
        "outerAngle": {
          "type": "f32",
          "doc": "Spot outer cone half-angle.",
          "default": 30,
          "unit": "deg",
          "range": [0.1, 89],
          "editor": {
            "showIf": {
              "field": "kind",
              "when": {
                "oneOf": [
                  "spot"
                ]
              }
            }
          }
        }
      }
    },
    "Light2d": {
      "kind": "component",
      "doc": "Point light for an explicitly lit sprite; Z provides normal-map elevation.",
      "module": "twoD",
      "fields": {
        "position": {
          "type": "vec3",
          "doc": "Position in world metres.",
          "default": [0, 0, 0]
        },
        "color": {
          "type": "vec3",
          "doc": "Linear RGB intensity.",
          "default": [1, 1, 1]
        },
        "radius": {
          "type": "f32",
          "doc": "Finite influence radius in metres.",
          "default": 5,
          "range": [0.001, null]
        },
        "shadows": {
          "type": "bool",
          "doc": "Test tile/sprite occluder segments between light and fragment.",
          "default": false
        }
      }
    },
    "Light2dSetParams": {
      "kind": "params",
      "doc": "Complete typed component authoring update.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Target entity, including prefab addresses.",
          "required": true
        },
        "value": {
          "type": "Light2d",
          "doc": "Complete typed component; omitted fields use schema defaults.",
          "required": true
        }
      }
    },
    "LightKind": {
      "kind": "enum",
      "doc": "How a light emits.",
      "module": "render",
      "variants": {
        "point": {
          "doc": "Omnidirectional point light."
        },
        "spot": {
          "doc": "Cone light aimed along the entity's local -Z axis."
        },
        "directional": {
          "doc": "Sun-like light shining along the entity's local -Z axis; casts cascaded shadows."
        }
      }
    },
    "LimitKind": {
      "kind": "enum",
      "doc": "Angular constraint relative to the local bind rotation.",
      "module": "animation",
      "variants": {
        "free": {
          "doc": "Unrestricted rotation."
        },
        "cone": {
          "doc": "Circular swing cone plus signed twist interval."
        },
        "hinge": {
          "doc": "Only rotation about the hinge axis is permitted."
        }
      }
    },
    "LinkKind": {
      "kind": "enum",
      "doc": "How agents traverse an off-mesh link. Animation reads it from `NavAgentState.traversal` (an intent), never through a call.",
      "module": "navigation",
      "variants": {
        "walk": {
          "doc": "Straight walk at agent speed (narrow passages, scripted moves)."
        },
        "jump": {
          "doc": "Ballistic arc with `arc_height`; plays a jump animation."
        },
        "ladder": {
          "doc": "Vertical climb at reduced speed; plays a ladder animation."
        },
        "door": {
          "doc": "Passable only while open; agents wait at the start and request opening."
        },
        "elevator": {
          "doc": "Passable only while the cabin is present; riders wait, then ride."
        },
        "teleport": {
          "doc": "Instant relocation (portals, spawn tubes)."
        }
      }
    },
    "LocomotionClip": {
      "kind": "struct",
      "doc": "One clip of a locomotion blend and the ground speed it represents.",
      "module": "animation",
      "fields": {
        "clip": {
          "type": "string",
          "doc": "Animation name inside the model (the glTF animation name).",
          "default": ""
        },
        "speed": {
          "type": "f32",
          "doc": "Ground speed at which this clip has full weight.",
          "default": 0,
          "unit": "m/s",
          "range": [0, null]
        }
      }
    },
    "MatchConfig": {
      "kind": "struct",
      "doc": "Cook-time feature schema. Feature order is six floats per bone (position/velocity), three root-velocity floats, then six floats per horizon (position/facing).",
      "module": "animation",
      "fields": {
        "clips": {
          "type": "list<asset<animation>>",
          "doc": "Ordered canonical source clip references; empty accepts importer-supplied bindings.",
          "default": []
        },
        "bones": {
          "type": "list<string>",
          "doc": "Ordered stable joint IDs used for pose position and velocity features.",
          "default": []
        },
        "horizons": {
          "type": "list<u32>",
          "doc": "Increasing future root sample times in source clip ticks.",
          "default": []
        },
        "step": {
          "type": "u32",
          "doc": "Cook-time sampling interval in source ticks.",
          "default": 800
        },
        "positionWeight": {
          "type": "f32",
          "doc": "Normalized position-feature cost weight.",
          "default": 1
        },
        "velocityWeight": {
          "type": "f32",
          "doc": "Normalized bone-velocity cost weight.",
          "default": 1
        },
        "trajectoryWeight": {
          "type": "f32",
          "doc": "Normalized root-velocity and future-trajectory cost weight.",
          "default": 2
        }
      }
    },
    "MatchNode": {
      "kind": "struct",
      "doc": "Graph-node search settings. The clip field references a cooked motion database.",
      "module": "animation",
      "fields": {
        "query": {
          "type": "list<string>",
          "doc": "Float parameter names in the database's raw feature order.",
          "default": []
        },
        "budget": {
          "type": "u32",
          "doc": "Maximum candidate rows examined per search; zero requests an exact full scan.",
          "default": 0
        },
        "halfLife": {
          "type": "f32",
          "doc": "Offset decay half-life in seconds.",
          "default": 0.08
        },
        "continuation": {
          "type": "u32",
          "doc": "Keep playback when the selected frame is this many ticks from its continuation.",
          "default": 1600
        }
      }
    },
    "MaterialBudgetParams": {
      "kind": "params",
      "doc": "Sets an explicit material specialization budget.",
      "module": "material",
      "fields": {
        "budget": {
          "type": "u32",
          "doc": "Maximum static combinations.",
          "required": true
        }
      }
    },
    "MaterialConnectParams": {
      "kind": "params",
      "doc": "Rewires an AST argument or output, preserving the destination edge's identity.",
      "module": "material",
      "fields": {
        "source": {
          "type": "string",
          "doc": "Source semantic node ID.",
          "required": true
        },
        "node": {
          "type": "string",
          "doc": "Consumer node ID, or n_output for a domain field.",
          "required": true
        },
        "port": {
          "type": "string",
          "doc": "in0/in1/... for function arguments; domain field for n_output.",
          "required": true
        }
      }
    },
    "MaterialGraphParams": {
      "kind": "params",
      "doc": "Applies an edited graph projection as the same material AST.",
      "module": "material",
      "fields": {
        "json": {
          "type": "string",
          "doc": "Canonical graph JSON produced by ara-json.",
          "required": true
        }
      }
    },
    "MaterialInstance": {
      "kind": "record",
      "doc": "A saved material instance; all authoritative overrides are document fields.",
      "module": "material",
      "prefix": "i",
      "fields": {
        "definition": {
          "type": "asset<graph>",
          "doc": "Definition graph as a full project-relative `@path#gr_id` reference.",
          "default": null
        },
        "overrides": {
          "type": "map<json>",
          "doc": "Typed numeric, boolean and symbolic texture overrides; defaults stay in the graph.",
          "default": {}
        }
      }
    },
    "MaterialInstanceClearParams": {
      "kind": "params",
      "doc": "Removes a saved override, restoring the definition default.",
      "module": "material",
      "fields": {
        "node": {
          "type": "string",
          "doc": "Stable definition parameter ID.",
          "required": true
        }
      }
    },
    "MaterialInstanceSetParams": {
      "kind": "params",
      "doc": "Edits one saved material instance override.",
      "module": "material",
      "fields": {
        "node": {
          "type": "string",
          "doc": "Stable definition parameter ID.",
          "required": true
        },
        "values": {
          "type": "json",
          "doc": "Numeric, boolean or symbolic texture value; static switches require booleans.",
          "required": true
        }
      }
    },
    "MaterialLiteralParams": {
      "kind": "params",
      "doc": "Replaces an expression with a typed constant.",
      "module": "material",
      "fields": {
        "node": {
          "type": "string",
          "doc": "Stable expression ID.",
          "required": true
        },
        "values": {
          "type": "list<f64>",
          "doc": "New literal lanes.",
          "required": true
        }
      }
    },
    "MaterialOutputParams": {
      "kind": "params",
      "doc": "Identifies a domain output field.",
      "module": "material",
      "fields": {
        "field": {
          "type": "string",
          "doc": "Domain field name.",
          "required": true
        }
      }
    },
    "MaterialParameterParams": {
      "kind": "params",
      "doc": "Identifies a material parameter.",
      "module": "material",
      "fields": {
        "node": {
          "type": "string",
          "doc": "Stable parameter ID.",
          "required": true
        }
      }
    },
    "MaterialPreset": {
      "kind": "enum",
      "doc": "Named surface materials with Steam Audio's published values.",
      "module": "audio",
      "variants": {
        "generic": {
          "doc": "Average interior surface."
        },
        "brick": {
          "doc": "Brick wall."
        },
        "concrete": {
          "doc": "Poured concrete."
        },
        "ceramic": {
          "doc": "Ceramic tile."
        },
        "gravel": {
          "doc": "Loose gravel."
        },
        "carpet": {
          "doc": "Carpet on concrete."
        },
        "glass": {
          "doc": "Window glass."
        },
        "plaster": {
          "doc": "Plaster on brick."
        },
        "wood": {
          "doc": "Wooden panels."
        },
        "metal": {
          "doc": "Sheet metal."
        },
        "rock": {
          "doc": "Natural rock."
        }
      }
    },
    "MaterialRenameParams": {
      "kind": "params",
      "doc": "Renames an authored value while retaining its graph identity and layout.",
      "module": "material",
      "fields": {
        "from": {
          "type": "string",
          "doc": "Existing authored name.",
          "required": true
        },
        "to": {
          "type": "string",
          "doc": "New unique authored name.",
          "required": true
        },
        "restoreId": {
          "type": "option<string>",
          "doc": "Diagnostic-only recovery identity after a plain-text delete/create rename.",
          "default": null
        }
      }
    },
    "MaterialTextParams": {
      "kind": "params",
      "doc": "Replaces the text view, retaining layout for surviving semantic IDs.",
      "module": "material",
      "fields": {
        "text": {
          "type": "string",
          "doc": "Complete bounded material DSL.",
          "required": true
        }
      }
    },
    "MaterialTypeParams": {
      "kind": "params",
      "doc": "Changes a node's declared type (also used by type annotation fixes).",
      "module": "material",
      "fields": {
        "node": {
          "type": "string",
          "doc": "Stable expression/parameter ID.",
          "required": true
        },
        "ty": {
          "type": "string",
          "doc": "Exact material type name.",
          "required": true
        }
      }
    },
    "MeshRenderer": {
      "kind": "component",
      "doc": "Draws geometry at the entity's interpolated world transform.",
      "module": "render",
      "fields": {
        "shape": {
          "type": "MeshShape",
          "doc": "Procedural shape, drawn when `model` is empty.",
          "default": "box",
          "options": [
            "box",
            "sphere",
            "capsule",
            "plane"
          ],
          "editor": {
            "showIf": {
              "field": "model",
              "when": "empty"
            }
          }
        },
        "size": {
          "type": "vec3",
          "doc": "Shape size: box extents, sphere/capsule diameter in x and capsule height in y, plane extents in x and z.",
          "default": [1, 1, 1],
          "unit": "m",
          "range": [0.0001, null],
          "editor": {
            "showIf": {
              "field": "model",
              "when": "empty"
            }
          }
        },
        "model": {
          "type": "option<asset>",
          "doc": "Imported model (`@path#id` of a glTF/FBX source). Its meshes are drawn instead of the shape; skinned meshes follow this entity's Animator.",
          "default": null,
          "aliases": [
            "mesh"
          ]
        },
        "node": {
          "type": "option<string>",
          "doc": "Source node name or numeric glTF index. `name:3` selects a numeric name. The drawable subtree retains source rotation/scale and restores its pivot to the entity origin. Absent selects the complete default scene.",
          "default": null,
          "editor": {
            "showIf": {
              "field": "model",
              "when": "set"
            }
          }
        },
        "primitive": {
          "type": "option<u32>",
          "doc": "Zero-based primitive within the selected subtree (or whole model).",
          "default": null,
          "editor": {
            "showIf": {
              "field": "model",
              "when": "set"
            }
          }
        },
        "materialOverrides": {
          "type": "list<PrimitiveMaterialOverride>",
          "doc": "Native material assets by subtree-local primitive slot; omitted slots use the model.",
          "default": []
        },
        "color": {
          "type": "color",
          "doc": "Linear base color multiplier and opacity.",
          "default": [1, 1, 1, 1],
          "aliases": [
            "tint"
          ]
        },
        "roughness": {
          "type": "f32",
          "doc": "Perceptual roughness.",
          "default": 0.6,
          "range": [0, 1]
        },
        "metallic": {
          "type": "f32",
          "doc": "Metalness.",
          "default": 0,
          "range": [0, 1]
        },
        "emissive": {
          "type": "vec3",
          "doc": "Default procedural radiance, or an RGB emission multiplier with a model/material asset. Models treat zero RGB as neutral; use `emissiveEnabled` to switch them off.",
          "default": [0, 0, 0],
          "editor": {
            "color": true,
            "hdr": true
          }
        },
        "emissiveEnabled": {
          "type": "bool",
          "doc": "Enables emission without modifying the source model or its materials.",
          "default": true
        },
        "emissiveStrength": {
          "type": "f32",
          "doc": "Emission multiplier, applied once after the source or overridden factor.",
          "default": 1,
          "range": [0, null]
        },
        "emissiveFactor": {
          "type": "option<vec3>",
          "doc": "Optional linear RGB replacement for the source emissive factor, useful for lamps.",
          "default": null,
          "range": [0, null],
          "editor": {
            "color": true,
            "hdr": true
          }
        },
        "emissiveMaterials": {
          "type": "list<string>",
          "doc": "Source material names or numeric indices affected by `emissiveFactor`. Empty targets all; `name:3` disambiguates a numeric material name.",
          "default": []
        }
      }
    },
    "MeshSettings": {
      "kind": "struct",
      "doc": "Deterministic geometry cook policy.",
      "module": "asset",
      "fields": {
        "texturePresets": {
          "type": "map<CookPreset>",
          "doc": "Texture quality overrides by image URI or #image-index (FBX: #texture-id). Other images inherit the model/project preset and retain their cached work.",
          "default": {}
        },
        "lodCount": {
          "type": "u32",
          "doc": "Maximum LODs including the original (1–8). Skin/morph meshes retain at most four.",
          "default": 8,
          "range": [1, 8]
        },
        "lodError": {
          "type": "f32",
          "doc": "Relative simplification error ceiling; skin/morph meshes clamp this to 1%.",
          "default": 0.1,
          "range": [0, null]
        },
        "virtualGeometry": {
          "type": "bool",
          "doc": "Cook a versioned virtual-geometry DAG for each static material primitive. Skinned and morph-deformed meshes retain the classic path.",
          "default": true
        },
        "opacityMaps": {
          "type": "map<string>",
          "doc": "glTF base-color image URI (or #image-index) to companion opacity image URI. The mask's red channel multiplies existing alpha; paths are relative to the model.",
          "default": {}
        }
      }
    },
    "MeshShape": {
      "kind": "enum",
      "doc": "Built-in procedural geometry for gray-box levels.",
      "module": "render",
      "variants": {
        "box": {
          "doc": "Axis-aligned box with `size` extents."
        },
        "sphere": {
          "doc": "Sphere with diameter `size.x`."
        },
        "capsule": {
          "doc": "Upright capsule with diameter `size.x` and total height `size.y`."
        },
        "plane": {
          "doc": "Upward-facing quad spanning `size.x` by `size.z`."
        }
      }
    },
    "MixerBusSetParams": {
      "kind": "params",
      "doc": "Creates or replaces a complete mixer category.",
      "module": "audio",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Stable bus record ID or a new batch symbol.",
          "required": true
        },
        "bus": {
          "type": "AudioBus",
          "doc": "Typed bus data, with reflected defaults for omitted fields.",
          "required": true
        }
      }
    },
    "ModelColliderMode": {
      "kind": "enum",
      "doc": "Geometry used by a model-derived collider.",
      "module": "physics",
      "variants": {
        "convex": {
          "doc": "Convex hull, usable by static, kinematic and dynamic bodies."
        },
        "mesh": {
          "doc": "Exact triangle surface, usable only by static bodies."
        }
      }
    },
    "MotionType": {
      "kind": "enum",
      "doc": "How a rigid body moves; kinematic targets are runtime intents.",
      "module": "physics",
      "variants": {
        "static": {
          "doc": "Infinite mass, fixed scenery."
        },
        "kinematic": {
          "doc": "Infinite mass, moves to an explicit target each tick."
        },
        "dynamic": {
          "doc": "Finite mass, simulated by the solver."
        }
      }
    },
    "MotionType2d": {
      "kind": "enum",
      "doc": "How a rigid body moves; kinematic bodies follow their written pose.",
      "module": "physics2d",
      "variants": {
        "static": {
          "doc": "Infinite mass, fixed scenery."
        },
        "kinematic": {
          "doc": "Infinite mass; moves to its `PhysicsPose2d` each tick and pushes dynamic bodies."
        },
        "dynamic": {
          "doc": "Finite mass, simulated by the solver."
        }
      }
    },
    "MotorGains": {
      "kind": "struct",
      "doc": "Position and orientation spring gains in SI units.",
      "module": "animation",
      "fields": {
        "position": {
          "type": "f32",
          "doc": "Linear spring stiffness in N/m.",
          "default": 300
        },
        "linearDamping": {
          "type": "f32",
          "doc": "Linear damping in N*s/m.",
          "default": 35
        },
        "rotation": {
          "type": "f32",
          "doc": "Angular spring stiffness in N*m/rad.",
          "default": 80
        },
        "angularDamping": {
          "type": "f32",
          "doc": "Angular damping in N*m*s/rad.",
          "default": 12
        },
        "maxForce": {
          "type": "f32",
          "doc": "Maximum applied linear force in N.",
          "default": 1000
        },
        "maxTorque": {
          "type": "f32",
          "doc": "Maximum applied torque in N*m.",
          "default": 250
        }
      }
    },
    "MusicNext": {
      "kind": "struct",
      "doc": "A weighted follow-up for horizontal resequencing.",
      "module": "audio",
      "fields": {
        "segment": {
          "type": "string",
          "doc": "Segment to continue with.",
          "default": ""
        },
        "weight": {
          "type": "f32",
          "doc": "Relative probability.",
          "default": 1,
          "range": [0, 1000]
        }
      }
    },
    "MusicSegment": {
      "kind": "record",
      "doc": "A playable section with synchronized stems on one tempo map.",
      "module": "audio",
      "prefix": "sg",
      "fields": {
        "name": {
          "type": "string",
          "doc": "Unique segment name.",
          "default": ""
        },
        "bars": {
          "type": "u32",
          "doc": "Length in bars; the follow-up starts on the last bar line.",
          "default": 4,
          "range": [1, 4096]
        },
        "tempo": {
          "type": "list<MusicTempo>",
          "doc": "Tempo map; empty is 120 BPM in 4/4. The first change must be at bar 0.",
          "default": []
        },
        "stems": {
          "type": "list<MusicStem>",
          "doc": "Layers played together.",
          "default": []
        },
        "next": {
          "type": "list<MusicNext>",
          "doc": "Weighted follow-ups; empty repeats this segment.",
          "default": []
        },
        "loudness": {
          "type": "option<f32>",
          "doc": "Cooked integrated loudness of the full mix (all stems), so a loudness-targeted bus trims every stem equally. Measure with `measure_mix_loudness`.",
          "default": null,
          "unit": "dB"
        }
      }
    },
    "MusicSegmentSetParams": {
      "kind": "params",
      "doc": "Create or replace a music segment with stems and tempo map.",
      "module": "audio",
      "fields": {
        "id": {
          "type": "option<string>",
          "doc": "Existing record ID, stable new ID or batch symbol; generated when omitted.",
          "default": null
        },
        "segment": {
          "type": "MusicSegment",
          "doc": "Complete typed music record; omitted fields take their reflected defaults.",
          "required": true
        }
      }
    },
    "MusicSettings": {
      "kind": "record",
      "doc": "Music-wide settings (one record).",
      "module": "audio",
      "prefix": "ms",
      "fields": {
        "initial": {
          "type": "string",
          "doc": "Segment to start with.",
          "default": ""
        },
        "intensity": {
          "type": "f32",
          "doc": "Starting intensity 0..1.",
          "default": 0.5,
          "range": [0, 1]
        },
        "layerFade": {
          "type": "f32",
          "doc": "Seconds for layers to follow an intensity change.",
          "default": 1,
          "unit": "s",
          "range": [0, 30]
        },
        "seed": {
          "type": "u32",
          "doc": "Seed for weighted follow-ups (deterministic resequencing).",
          "default": 0
        }
      }
    },
    "MusicSettingsSetParams": {
      "kind": "params",
      "doc": "Music-wide starting segment, intensity, layer fade and deterministic seed.",
      "module": "audio",
      "fields": {
        "settings": {
          "type": "MusicSettings",
          "doc": "Complete music settings, stored in the unique ms_settings record.",
          "required": true
        }
      }
    },
    "MusicSource": {
      "kind": "component",
      "doc": "Plays a `.music` document's interactive score (segments, transitions, intensity layers) from this entity, non-spatial. Presentation intent: gameplay writes `intensity` and `segment`; the audio presenter follows them.",
      "module": "audio",
      "fields": {
        "music": {
          "type": "option<asset<music>>",
          "doc": "The score (`.music` document).",
          "default": null
        },
        "bus": {
          "type": "string",
          "doc": "Mixer bus the stems play on.",
          "default": "music"
        },
        "intensity": {
          "type": "f32",
          "doc": "Intensity from 0 to 1: stems whose range contains it are audible.",
          "default": 0,
          "range": [0, 1]
        },
        "segment": {
          "type": "string",
          "doc": "Segment to transition to (on the score's sync rule); empty follows the score.",
          "default": ""
        }
      }
    },
    "MusicStem": {
      "kind": "struct",
      "doc": "A synchronized layer (stem) of a segment, faded in by intensity.",
      "module": "audio",
      "fields": {
        "name": {
          "type": "string",
          "doc": "Stem name (`drums`, `strings`).",
          "default": ""
        },
        "clip": {
          "type": "option<asset<audio>>",
          "doc": "The stem's audio clip.",
          "default": null
        },
        "intensity": {
          "type": "vec2",
          "doc": "Intensity window: silent at or below `[0]`, full at or above `[1]`; equal values make a hard switch, `[0, 0]` is always on.",
          "default": [0, 0]
        },
        "gainDb": {
          "type": "f32",
          "doc": "Stem gain.",
          "default": 0,
          "unit": "dB",
          "range": [-96, 24]
        },
        "looping": {
          "type": "bool",
          "doc": "Repeat a short ambience/tension loop until its segment ends.",
          "default": false
        }
      }
    },
    "MusicStinger": {
      "kind": "record",
      "doc": "A one-shot played on top of the music, aligned to the grid.",
      "module": "audio",
      "prefix": "st",
      "fields": {
        "name": {
          "type": "string",
          "doc": "Unique stinger name.",
          "default": ""
        },
        "clip": {
          "type": "option<asset<audio>>",
          "doc": "The stinger's clip.",
          "default": null
        },
        "sync": {
          "type": "MusicSync",
          "doc": "Grid alignment.",
          "default": "bar",
          "options": [
            "bar",
            "beat",
            "end",
            "immediate"
          ]
        },
        "gainDb": {
          "type": "f32",
          "doc": "Stinger gain.",
          "default": 0,
          "unit": "dB",
          "range": [-96, 24]
        }
      }
    },
    "MusicStingerSetParams": {
      "kind": "params",
      "doc": "Create or replace a grid-aligned music stinger.",
      "module": "audio",
      "fields": {
        "id": {
          "type": "option<string>",
          "doc": "Existing record ID, stable new ID or batch symbol; generated when omitted.",
          "default": null
        },
        "stinger": {
          "type": "MusicStinger",
          "doc": "Complete typed music record; omitted fields take their reflected defaults.",
          "required": true
        }
      }
    },
    "MusicSync": {
      "kind": "enum",
      "doc": "Where a transition or stinger may land.",
      "module": "audio",
      "variants": {
        "bar": {
          "doc": "On the next bar line."
        },
        "beat": {
          "doc": "On the next beat."
        },
        "end": {
          "doc": "When the current segment ends."
        },
        "immediate": {
          "doc": "At the next control update."
        }
      }
    },
    "MusicTempo": {
      "kind": "struct",
      "doc": "A tempo and meter that applies from `bar` until the next change.",
      "module": "audio",
      "fields": {
        "bar": {
          "type": "u32",
          "doc": "First bar (0-based) at this tempo.",
          "default": 0
        },
        "bpm": {
          "type": "f32",
          "doc": "Beats per minute.",
          "default": 120,
          "range": [20, 400]
        },
        "beatsPerBar": {
          "type": "u32",
          "doc": "Beats in each bar.",
          "default": 4,
          "range": [1, 32]
        }
      }
    },
    "MusicTransition": {
      "kind": "record",
      "doc": "How a requested change of segment lands. An empty `from` matches any segment.",
      "module": "audio",
      "prefix": "tn",
      "fields": {
        "from": {
          "type": "string",
          "doc": "Segment being left; empty matches any.",
          "default": ""
        },
        "to": {
          "type": "string",
          "doc": "Segment requested.",
          "default": ""
        },
        "sync": {
          "type": "MusicSync",
          "doc": "Musical boundary to land on.",
          "default": "bar",
          "options": [
            "bar",
            "beat",
            "end",
            "immediate"
          ]
        },
        "fade": {
          "type": "f32",
          "doc": "Crossfade length in seconds; zero cuts.",
          "default": 0.5,
          "unit": "s",
          "range": [0, 30]
        },
        "bridge": {
          "type": "string",
          "doc": "Optional bridge segment played between them.",
          "default": ""
        }
      }
    },
    "MusicTransitionSetParams": {
      "kind": "params",
      "doc": "Create or replace a synchronized music transition.",
      "module": "audio",
      "fields": {
        "id": {
          "type": "option<string>",
          "doc": "Existing record ID, stable new ID or batch symbol; generated when omitted.",
          "default": null
        },
        "transition": {
          "type": "MusicTransition",
          "doc": "Complete typed music record; omitted fields take their reflected defaults.",
          "required": true
        }
      }
    },
    "NavAgent": {
      "kind": "component",
      "doc": "Dimensions, speed and permitted areas of one navigation agent.",
      "module": "navigation",
      "fields": {
        "profile": {
          "type": "u32",
          "doc": "Mesh profile ID; radius and height must fit that profile.",
          "default": 0
        },
        "radius": {
          "type": "f32",
          "doc": "Collision radius in metres.",
          "default": 0.3,
          "unit": "m",
          "range": [0.001, 10]
        },
        "height": {
          "type": "f32",
          "doc": "Required clearance in metres.",
          "default": 1.8,
          "unit": "m",
          "range": [0.01, 100]
        },
        "maxSpeed": {
          "type": "f32",
          "doc": "Maximum movement speed in metres per second.",
          "default": 3,
          "range": [0, 1000]
        },
        "acceleration": {
          "type": "f32",
          "doc": "Maximum change in velocity per second.",
          "default": 8,
          "range": [0, 10000]
        },
        "areaMask": {
          "type": "u16",
          "doc": "Areas this agent can use (one bit per area).",
          "default": 65535
        },
        "stoppingDistance": {
          "type": "f32",
          "doc": "Arrival tolerance in metres.",
          "default": 0.1,
          "unit": "m",
          "range": [0.001, 10]
        }
      }
    },
    "NavAgentType": {
      "kind": "component",
      "doc": "A named agent type: its own baked mesh (dimensions) and traversal costs. Agents select it through `NavAgent.profile == profile`.",
      "module": "navigation",
      "fields": {
        "profile": {
          "type": "u32",
          "doc": "Mesh profile ID shared by the type's agents and its bake.",
          "default": 0
        },
        "name": {
          "type": "string",
          "doc": "Inspector name (Humanoid, Brute, Drone).",
          "default": ""
        },
        "radius": {
          "type": "f32",
          "doc": "Bake radius in metres.",
          "default": 0.3,
          "unit": "m",
          "range": [0.01, 10]
        },
        "height": {
          "type": "f32",
          "doc": "Bake clearance height in metres.",
          "default": 1.8,
          "unit": "m",
          "range": [0.1, 100]
        },
        "climb": {
          "type": "f32",
          "doc": "Maximum step height in metres.",
          "default": 0.4,
          "unit": "m",
          "range": [0, 10]
        },
        "slope": {
          "type": "f32",
          "doc": "Steepest walkable slope in degrees.",
          "default": 45,
          "unit": "deg",
          "range": [0, 89]
        },
        "areaCosts": {
          "type": "list<f32>",
          "doc": "Cost multiplier per area ID (index 0..15); missing entries are 1.",
          "default": []
        },
        "areaMask": {
          "type": "u16",
          "doc": "Areas this type may enter (one bit per area).",
          "default": 65535
        }
      }
    },
    "NavArea": {
      "kind": "component",
      "doc": "Area label and cost policy for the collision-geometry producer and query filters.",
      "module": "navigation",
      "fields": {
        "area": {
          "type": "u8",
          "doc": "Semantic area ID, from 0 through 15.",
          "default": 0,
          "range": [0, 15]
        },
        "name": {
          "type": "string",
          "doc": "Inspector name (for example Ground, Water or Hazard).",
          "default": ""
        },
        "cost": {
          "type": "f32",
          "doc": "Default query traversal cost; agents can override it in their state filter.",
          "default": 1,
          "range": [1, 1000000]
        }
      }
    },
    "NavLink": {
      "kind": "component",
      "doc": "Authored off-mesh connection in world space (jump, ladder or scripted passage).",
      "module": "navigation",
      "fields": {
        "id": {
          "type": "u32",
          "doc": "Stable nonzero connection ID.",
          "default": 0
        },
        "start": {
          "type": "vec3",
          "doc": "Start endpoint in world space.",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "end": {
          "type": "vec3",
          "doc": "End endpoint in world space.",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "radius": {
          "type": "f32",
          "doc": "Maximum horizontal attachment distance.",
          "default": 0.5,
          "unit": "m",
          "range": [0.001, 100]
        },
        "area": {
          "type": "u8",
          "doc": "Traversal area index, from 0 through 15.",
          "default": 0,
          "range": [0, 15]
        },
        "bidirectional": {
          "type": "bool",
          "doc": "Whether traversal is allowed in both directions.",
          "default": true
        },
        "enabled": {
          "type": "bool",
          "doc": "Whether the connection is available to the baker.",
          "default": true
        },
        "kind": {
          "type": "LinkKind",
          "doc": "How agents traverse it: drives traversal motion, gating and animation hooks.",
          "default": "walk",
          "options": [
            "walk",
            "jump",
            "ladder",
            "door",
            "elevator",
            "teleport"
          ]
        },
        "duration": {
          "type": "f32",
          "doc": "Traversal time in seconds; 0 derives it from length and agent speed.",
          "default": 0,
          "unit": "s",
          "range": [0, 600]
        },
        "arcHeight": {
          "type": "f32",
          "doc": "Jump apex above the straight start-end line, in metres (jumps only).",
          "default": 0.5,
          "unit": "m",
          "range": [0, 100]
        }
      }
    },
    "NavMeshSurface": {
      "kind": "component",
      "doc": "Authored raw-geometry navigation surface; its derived mesh is content-addressed.",
      "module": "navigation",
      "fields": {
        "profiles": {
          "type": "list<u32>",
          "doc": "Shared bake profiles to generate from this surface.",
          "default": []
        },
        "geometry": {
          "type": "option<asset>",
          "doc": "Source collision geometry asset, resolved by the asset/physics integration.",
          "default": null
        },
        "min": {
          "type": "vec3",
          "doc": "World-space lower bake bound.",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "max": {
          "type": "vec3",
          "doc": "World-space upper bake bound.",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "cellSize": {
          "type": "f32",
          "doc": "Horizontal voxel size in metres.",
          "default": 0.2,
          "unit": "m",
          "range": [0.01, 10]
        },
        "tileSize": {
          "type": "u16",
          "doc": "Interior tile width in voxels.",
          "default": 64,
          "range": [8, 256]
        }
      }
    },
    "NavObstacle": {
      "kind": "component",
      "doc": "Dynamic obstacle: an axis-aligned box centred on the entity's `NavPosition`. Carve/Area changes publish after `NavConfig::rebake_latency_ticks`; until then (and always for `Avoid`) agents avoid it locally.",
      "module": "navigation",
      "fields": {
        "id": {
          "type": "u32",
          "doc": "Stable nonzero ID; changes are canonically ordered by it.",
          "default": 0
        },
        "halfExtents": {
          "type": "vec3",
          "doc": "Box half extents in metres.",
          "default": [0.5, 0.5, 0.5],
          "unit": "m"
        },
        "mode": {
          "type": "ObstacleMode",
          "doc": "Carve, relabel or avoid only.",
          "default": "carve",
          "options": [
            "carve",
            "area",
            "avoid"
          ]
        },
        "area": {
          "type": "u8",
          "doc": "Area applied in `Area` mode, from 0 through 15.",
          "default": 0,
          "range": [0, 15]
        }
      }
    },
    "Notify": {
      "kind": "struct",
      "doc": "A discrete animation notify, identified independently of its display name.",
      "module": "animation",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Stable notify ID for prediction event deduplication.",
          "default": ""
        },
        "name": {
          "type": "string",
          "doc": "Event name delivered to gameplay.",
          "default": ""
        },
        "tick": {
          "type": "u32",
          "doc": "Clip time in ticks, in the half-open range [0, duration).",
          "default": 0
        },
        "payload": {
          "type": "string",
          "doc": "Schema-addressable event payload encoded as a string.",
          "default": ""
        }
      }
    },
    "ObstacleMode": {
      "kind": "enum",
      "doc": "How the navigation reacts to a dynamic obstacle.",
      "module": "navigation",
      "variants": {
        "carve": {
          "doc": "Cut the box out of the navmesh (background tile rebake). Paths go around."
        },
        "area": {
          "doc": "Relabel the box with `area`, whose per-type cost decides avoidance."
        },
        "avoid": {
          "doc": "No rebake: local avoidance only (moving carts, temporary crowds)."
        }
      }
    },
    "OverrideRevertParams": {
      "kind": "params",
      "doc": "Parameters of `prefab.override.revert`.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "A prefab instance, or an entity inside one.",
          "required": true
        },
        "path": {
          "type": "option<string>",
          "doc": "The overridden path to revert, with everything under it; absent reverts every override and removal on this entity.",
          "default": null
        }
      }
    },
    "OverrideSetParams": {
      "kind": "params",
      "doc": "Parameters of `prefab.override.set`.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "A prefab instance, or an entity inside one (`e_4f9a/e_m4tz`).",
          "required": true
        },
        "path": {
          "type": "string",
          "doc": "Field path: `name`, a component (`Light`) or a component field (`Light.color`).",
          "required": true
        },
        "value": {
          "type": "json",
          "doc": "The overriding value.",
          "required": true
        }
      }
    },
    "PaintCell": {
      "kind": "struct",
      "doc": "A tile-paint sample in a stroke transaction.",
      "fields": {
        "x": {
          "type": "i32",
          "doc": "Signed column / axial q.",
          "default": 0
        },
        "y": {
          "type": "i32",
          "doc": "Signed row / axial r.",
          "default": 0
        },
        "tile": {
          "type": "u32",
          "doc": "Tile definition number; zero erases the cell.",
          "default": 0
        }
      }
    },
    "Perceiver": {
      "kind": "component",
      "doc": "An AI's senses: a sight cone with peripheral vision, hearing and memory.",
      "module": "ai",
      "fields": {
        "sightRange": {
          "type": "f32",
          "doc": "Sight range in metres inside the cone.",
          "default": 25,
          "unit": "m",
          "range": [0, 10000]
        },
        "fov": {
          "type": "f32",
          "doc": "Full field of view in degrees.",
          "default": 120,
          "unit": "deg",
          "range": [0, 360]
        },
        "peripheralRange": {
          "type": "f32",
          "doc": "Range in metres outside the cone (peripheral awareness); 0 disables.",
          "default": 2,
          "unit": "m",
          "range": [0, 1000]
        },
        "eyeHeight": {
          "type": "f32",
          "doc": "Eye height above the feet in metres.",
          "default": 1.7,
          "unit": "m",
          "range": [0, 100]
        },
        "hearing": {
          "type": "f32",
          "doc": "Hearing multiplier applied to every noise radius.",
          "default": 1,
          "range": [0, 100]
        },
        "occlusion": {
          "type": "f32",
          "doc": "Noise radius multiplier when the sound path is occluded.",
          "default": 0.5,
          "range": [0, 1]
        },
        "memory": {
          "type": "f32",
          "doc": "Seconds a memory survives after the last stimulus.",
          "default": 8,
          "unit": "s",
          "range": [0, 3600]
        }
      }
    },
    "PhysicalMode": {
      "kind": "enum",
      "doc": "Fixed-tick physical-animation mode.",
      "module": "animation",
      "variants": {
        "animated": {
          "doc": "Animation target with powered bodies."
        },
        "hitReaction": {
          "doc": "Temporary partial ragdoll, preserving active drives."
        },
        "ragdoll": {
          "doc": "Freely simulated ragdoll."
        },
        "gettingUp": {
          "doc": "Powered recovery and blend toward a caller-selected get-up animation."
        },
        "dead": {
          "doc": "Freely simulated terminal pose; recovery requires an explicit new request."
        }
      }
    },
    "PhysicalState": {
      "kind": "struct",
      "doc": "Complete future-affecting blend state. Store this in the character's ECS component.",
      "module": "animation",
      "fields": {
        "mode": {
          "type": "PhysicalMode",
          "doc": "Requested mode.",
          "default": "animated",
          "options": [
            "animated",
            "hitReaction",
            "ragdoll",
            "gettingUp",
            "dead"
          ]
        },
        "weight": {
          "type": "f32",
          "doc": "Current physical pose contribution in [0,1].",
          "default": 0
        },
        "start": {
          "type": "f32",
          "doc": "Start contribution for this transition.",
          "default": 0
        },
        "target": {
          "type": "f32",
          "doc": "Target contribution.",
          "default": 0
        },
        "elapsed": {
          "type": "u32",
          "doc": "Completed transition ticks.",
          "default": 0
        },
        "duration": {
          "type": "u32",
          "doc": "Fixed transition duration in ticks.",
          "default": 0
        }
      }
    },
    "Physics2dSetParams": {
      "kind": "params",
      "doc": "A complete rigid body or character, validated as one unit.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Target entity, including prefab addresses.",
          "required": true
        },
        "pose": {
          "type": "PhysicsPose2d",
          "doc": "World-space starting pose.",
          "required": true
        },
        "body": {
          "type": "option<RigidBody2d>",
          "doc": "Rigid body settings; requires `collider` and excludes `character`.",
          "default": null
        },
        "collider": {
          "type": "option<Collider2d>",
          "doc": "Collision geometry and material for `body`.",
          "default": null
        },
        "character": {
          "type": "option<CharacterController2d>",
          "doc": "Capsule character controller; excludes `body` and `collider`.",
          "default": null
        }
      }
    },
    "PhysicsId": {
      "kind": "component",
      "doc": "Stable simulation identity; nonzero and unique within a physics world.",
      "module": "physics",
      "fields": {
        "value": {
          "type": "u64",
          "doc": "Stable scene/network identity. Zero asks Play to assign a unique value from the entity identity; positive values explicitly reserve an identity.",
          "default": 0,
          "range": [0, null]
        }
      }
    },
    "PhysicsPose": {
      "kind": "component",
      "doc": "Resolved world-space pose in meters. Hierarchy/scale resolution runs before physics.",
      "module": "physics",
      "fields": {
        "position": {
          "type": "vec3",
          "doc": "Body origin or character feet, in world space.",
          "default": [0, 0, 0],
          "unit": "m",
          "replicate": {
            "audience": "relevant",
            "interpolate": "linear",
            "rollback": true
          }
        },
        "rotation": {
          "type": "quat",
          "doc": "Unit quaternion in XYZW order; use baked rotations for cross-platform replay.",
          "default": [0, 0, 0, 1],
          "replicate": {
            "audience": "relevant",
            "interpolate": "slerp",
            "rollback": true
          }
        }
      }
    },
    "PhysicsPose2d": {
      "kind": "component",
      "doc": "World-space 2D pose, written back by the solver at every completed boundary.",
      "module": "physics2d",
      "fields": {
        "position": {
          "type": "vec2",
          "doc": "Body origin or character capsule centre, in world space.",
          "default": [0, 0],
          "unit": "m",
          "replicate": {
            "audience": "relevant",
            "interpolate": "linear",
            "rollback": true
          }
        },
        "rotation": {
          "type": "f32",
          "doc": "Counter-clockwise rotation about +Z.",
          "default": 0,
          "unit": "rad",
          "replicate": {
            "audience": "relevant",
            "interpolate": "linear",
            "rollback": true
          }
        }
      }
    },
    "PlayAudioParams": {
      "kind": "params",
      "doc": "Schema-discoverable `audio.play` parameters; protocol resolves asset and entity handles.",
      "module": "audio",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Source entity address in the current presentation world.",
          "required": true
        },
        "atFrame": {
          "type": "u64",
          "doc": "Absolute output frame on the presentation sample clock.",
          "required": true
        }
      }
    },
    "PlayerControl": {
      "kind": "component",
      "doc": "Drives this entity's CharacterController from `Move`, `Sprint` and `Jump`, relative to its camera rig's yaw.",
      "module": "gameplay",
      "fields": {
        "player": {
          "type": "u64",
          "doc": "Input owner (`PlayerId`).",
          "default": 1
        },
        "walkSpeed": {
          "type": "f32",
          "doc": "Walking speed.",
          "default": 1.6,
          "unit": "m/s",
          "range": [0, null]
        },
        "runSpeed": {
          "type": "f32",
          "doc": "Sprinting speed.",
          "default": 4.5,
          "unit": "m/s",
          "range": [0, null]
        },
        "jumpSpeed": {
          "type": "f32",
          "doc": "Jump launch speed.",
          "default": 4.5,
          "unit": "m/s",
          "range": [0, null]
        },
        "turnRate": {
          "type": "f32",
          "doc": "Maximum turn rate toward the movement direction.",
          "default": 540,
          "unit": "deg/s",
          "range": [0, null]
        },
        "yaw": {
          "type": "f32",
          "doc": "Facing yaw; 0 faces +Z. Simulation state.",
          "default": 0,
          "unit": "deg"
        },
        "camera": {
          "type": "option<entity>",
          "doc": "Camera rig whose yaw orients `Move`; world axes when empty.",
          "default": null
        }
      }
    },
    "PostModule": {
      "kind": "enum",
      "doc": "The group of settings one `PostOverride` entry changes.",
      "module": "render",
      "variants": {
        "exposure": {
          "doc": "Automatic metering or a fixed exposure, compensation and adaptation."
        },
        "toneMapping": {
          "doc": "The display transform."
        },
        "bloom": {
          "doc": "The glow around bright pixels."
        },
        "colorGrading": {
          "doc": "White balance, saturation, contrast, lift/gamma/gain and a lookup table."
        },
        "vignette": {
          "doc": "Darkening toward the frame corners."
        },
        "depthOfField": {
          "doc": "Lens focus blur."
        },
        "motionBlur": {
          "doc": "Blur along screen motion while the shutter is open."
        },
        "chromaticAberration": {
          "doc": "Colour fringes toward the frame edges."
        },
        "ambientOcclusion": {
          "doc": "Screen-space ambient occlusion strength and radius (presets that run it)."
        },
        "reflections": {
          "doc": "Screen-space reflection strength and reach (presets that run them)."
        }
      }
    },
    "PostOverride": {
      "kind": "struct",
      "doc": "One group of settings a post-process volume overrides: pick the group in `module`, then tick the properties to change. Unticked properties are left to lower-priority volumes and the defaults.",
      "module": "render",
      "fields": {
        "module": {
          "type": "PostModule",
          "doc": "The settings group this entry changes.",
          "default": "exposure",
          "options": [
            "exposure",
            "toneMapping",
            "bloom",
            "colorGrading",
            "vignette",
            "depthOfField",
            "motionBlur",
            "chromaticAberration",
            "ambientOcclusion",
            "reflections"
          ]
        },
        "exposure": {
          "type": "option<ExposureMode>",
          "doc": "Automatic metering or a fixed exposure.",
          "default": null,
          "options": [
            "auto",
            "manual"
          ],
          "examples": [
            "auto"
          ],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "exposure"
                ]
              }
            }
          }
        },
        "ev100": {
          "type": "option<f32>",
          "doc": "Manual exposure value at ISO 100 (manual mode). Sunny day ≈ 15, overcast ≈ 12, sunset ≈ 10, lit interior ≈ 7, night street ≈ 3.",
          "default": null,
          "range": [-10, 24],
          "examples": [10],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "exposure"
                ]
              }
            }
          }
        },
        "compensation": {
          "type": "option<f32>",
          "doc": "Exposure compensation in stops, applied in both modes; +1 doubles the brightness.",
          "default": null,
          "range": [-8, 8],
          "examples": [0],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "exposure"
                ]
              }
            }
          }
        },
        "minEv100": {
          "type": "option<f32>",
          "doc": "Darkest exposure automatic metering may pick (lower = brighter in dark scenes).",
          "default": null,
          "range": [-10, 24],
          "examples": [-2],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "exposure"
                ]
              }
            }
          }
        },
        "maxEv100": {
          "type": "option<f32>",
          "doc": "Brightest exposure automatic metering may pick.",
          "default": null,
          "range": [-10, 24],
          "examples": [16],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "exposure"
                ]
              }
            }
          }
        },
        "adaptationSpeed": {
          "type": "option<f32>",
          "doc": "How fast automatic exposure adapts, per second; higher reacts faster.",
          "default": null,
          "range": [0.1, 20],
          "examples": [2],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "exposure"
                ]
              }
            }
          }
        },
        "toneMapping": {
          "type": "option<ToneMapping>",
          "doc": "Display transform that compresses scene radiance into the screen's range.",
          "default": null,
          "options": [
            "filmic",
            "neutral",
            "acesFit"
          ],
          "examples": [
            "filmic"
          ],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "toneMapping"
                ]
              }
            }
          }
        },
        "bloom": {
          "type": "option<f32>",
          "doc": "Fraction of light spread into the bloom glow around bright pixels.",
          "default": null,
          "range": [0, 0.25],
          "examples": [0.04],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "bloom"
                ]
              }
            }
          }
        },
        "whiteBalance": {
          "type": "option<f32>",
          "doc": "White balance: the colour temperature that renders as neutral white. Lower warms the image's whites to neutral (tungsten ≈ 3200), higher cools them.",
          "default": null,
          "unit": "K",
          "range": [1500, 15000],
          "examples": [6500],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "colorGrading"
                ]
              }
            }
          }
        },
        "saturation": {
          "type": "option<f32>",
          "doc": "Colour saturation; 0 is greyscale, 1 unchanged.",
          "default": null,
          "range": [0, 2],
          "examples": [1],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "colorGrading"
                ]
              }
            }
          }
        },
        "contrast": {
          "type": "option<f32>",
          "doc": "Contrast around middle grey; 1 unchanged.",
          "default": null,
          "range": [0.5, 2],
          "examples": [1],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "colorGrading"
                ]
              }
            }
          }
        },
        "lift": {
          "type": "option<color>",
          "doc": "Lift: a colour added to the shadows after tone mapping, fading out toward white; black leaves them unchanged.",
          "default": null,
          "examples": [
            [0, 0, 0, 1]
          ],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "colorGrading"
                ]
              }
            }
          }
        },
        "gamma": {
          "type": "option<color>",
          "doc": "Gamma: a per-channel midtone power after tone mapping; white is neutral, a darker channel darkens that channel's midtones.",
          "default": null,
          "examples": [
            [1, 1, 1, 1]
          ],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "colorGrading"
                ]
              }
            }
          }
        },
        "gain": {
          "type": "option<color>",
          "doc": "Gain: a per-channel multiplier on the whole image after tone mapping; white is neutral.",
          "default": null,
          "examples": [
            [1, 1, 1, 1]
          ],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "colorGrading"
                ]
              }
            }
          }
        },
        "lut": {
          "type": "option<asset<texture>>",
          "doc": "Colour lookup table applied last, as in Unity and Unreal: a strip texture of 16 (256x16) or 32 (1024x32) sRGB slices along red and green, one slice per blue step, imported uncompressed.",
          "default": null,
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "colorGrading"
                ]
              }
            }
          }
        },
        "lutContribution": {
          "type": "option<f32>",
          "doc": "How much of the lookup table applies, from 0 (none) to 1 (all).",
          "default": null,
          "range": [0, 1],
          "examples": [1],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "colorGrading"
                ]
              }
            }
          }
        },
        "vignette": {
          "type": "option<f32>",
          "doc": "Darkening toward the frame corners; 0 disables it.",
          "default": null,
          "range": [0, 1],
          "examples": [0.3],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "vignette"
                ]
              }
            }
          }
        },
        "focusDistance": {
          "type": "option<f32>",
          "doc": "Distance from the camera that is in focus; 0 turns depth of field off.",
          "default": null,
          "unit": "m",
          "range": [0, 10000],
          "examples": [10],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "depthOfField"
                ]
              }
            }
          }
        },
        "aperture": {
          "type": "option<f32>",
          "doc": "Lens aperture as an f-number: smaller numbers blur more (f/1.4 is shallow, f/16 keeps nearly everything sharp). The focal length follows the camera's field of view on a full-frame sensor.",
          "default": null,
          "range": [0.7, 32],
          "examples": [2.8],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "depthOfField"
                ]
              }
            }
          }
        },
        "nearBlur": {
          "type": "option<f32>",
          "doc": "Strength of the blur in front of the focus distance, from 0 (sharp) to 1 (physical).",
          "default": null,
          "range": [0, 1],
          "examples": [1],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "depthOfField"
                ]
              }
            }
          }
        },
        "farBlur": {
          "type": "option<f32>",
          "doc": "Strength of the blur behind the focus distance, from 0 (sharp) to 1 (physical).",
          "default": null,
          "range": [0, 1],
          "examples": [1],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "depthOfField"
                ]
              }
            }
          }
        },
        "shutterAngle": {
          "type": "option<f32>",
          "doc": "Shutter angle: 180° blurs motion over half a frame, 360° over a whole frame; 0 turns motion blur off. Samples per pixel follow the quality preset.",
          "default": null,
          "unit": "deg",
          "range": [0, 360],
          "examples": [180],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "motionBlur"
                ]
              }
            }
          }
        },
        "chromaticAberration": {
          "type": "option<f32>",
          "doc": "Strength of the red/blue fringes toward the frame edges; 0 turns it off.",
          "default": null,
          "range": [0, 1],
          "examples": [0.5],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "chromaticAberration"
                ]
              }
            }
          }
        },
        "aoIntensity": {
          "type": "option<f32>",
          "doc": "Ambient occlusion strength: 0 none, 1 physical, above 1 exaggerated.",
          "default": null,
          "range": [0, 4],
          "examples": [1],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "ambientOcclusion"
                ]
              }
            }
          }
        },
        "aoRadius": {
          "type": "option<f32>",
          "doc": "Ambient occlusion search radius.",
          "default": null,
          "unit": "m",
          "range": [0.05, 10],
          "examples": [1],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "ambientOcclusion"
                ]
              }
            }
          }
        },
        "reflectionIntensity": {
          "type": "option<f32>",
          "doc": "Screen-space reflection strength, from 0 (probe reflections only) to 1.",
          "default": null,
          "range": [0, 1],
          "examples": [1],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "reflections"
                ]
              }
            }
          }
        },
        "reflectionDistance": {
          "type": "option<f32>",
          "doc": "Longest screen-space reflection ray.",
          "default": null,
          "unit": "m",
          "range": [1, 500],
          "examples": [30],
          "editor": {
            "showIf": {
              "field": "module",
              "when": {
                "oneOf": [
                  "reflections"
                ]
              }
            }
          }
        }
      }
    },
    "PostProcessVolume": {
      "kind": "component",
      "doc": "A region whose post-processing overrides blend in as the camera approaches and enters it. Volumes apply in ascending `priority` (ties in entity ID order); each property one overrides moves toward its value by the volume's weight at the camera. Properties no volume overrides keep the engine defaults. Scenes saved with the former `PostProcess` component load as one global volume that overrides everything.",
      "module": "render",
      "version": 2,
      "aliases": [
        "PostProcess"
      ],
      "fields": {
        "shape": {
          "type": "VolumeShape",
          "doc": "Where the volume applies: everywhere, or inside a box or sphere placed and sized by the entity's transform.",
          "default": "global",
          "options": [
            "global",
            "box",
            "sphere"
          ]
        },
        "blendDistance": {
          "type": "f32",
          "doc": "Distance outside the box or sphere over which the volume fades out; 0 is a hard edge.",
          "default": 0,
          "unit": "m",
          "range": [0, 1000],
          "editor": {
            "showIf": {
              "field": "shape",
              "when": {
                "oneOf": [
                  "box",
                  "sphere"
                ]
              }
            }
          }
        },
        "priority": {
          "type": "f32",
          "doc": "Order among overlapping volumes: higher priorities apply after, and over, lower ones.",
          "default": 0,
          "range": [-1000, 1000]
        },
        "weight": {
          "type": "f32",
          "doc": "Overall strength of the volume's overrides, from 0 (none) to 1 (full).",
          "default": 1,
          "range": [0, 1]
        },
        "overrides": {
          "type": "list<PostOverride>",
          "doc": "The settings this volume changes, one entry per group. Anything not listed comes from lower-priority volumes or the defaults.",
          "default": []
        }
      }
    },
    "PrefabInstantiateParams": {
      "kind": "params",
      "doc": "Parameters of `prefab.instantiate`.",
      "fields": {
        "prefab": {
          "type": "asset<prefab>",
          "doc": "The prefab, as `@path#id`, `@path` or `@#id`.",
          "required": true
        },
        "id": {
          "type": "option<string>",
          "doc": "ID of the instance: a symbol (`$door`) or a concrete unused record ID. Minted when absent.",
          "default": null
        },
        "name": {
          "type": "option<string>",
          "doc": "Display name; absent keeps the prefab root's name.",
          "default": null
        },
        "parent": {
          "type": "option<entity>",
          "doc": "Parent entity; absent creates a root.",
          "default": null
        },
        "index": {
          "type": "option<u32>",
          "doc": "Position among the parent's children; absent appends.",
          "default": null
        },
        "position": {
          "type": "option<vec3>",
          "doc": "Local position of the instance.",
          "default": null,
          "unit": "m"
        }
      }
    },
    "PrimitiveMaterialOverride": {
      "kind": "struct",
      "doc": "One native material graph/instance replacing a selected model primitive's material.",
      "module": "render",
      "fields": {
        "primitive": {
          "type": "u32",
          "doc": "Zero-based primitive within the selected subtree, before `primitive` filtering.",
          "default": 0
        },
        "material": {
          "type": "asset",
          "doc": "Authoritative material graph or material-instance asset (`@path#id`).",
          "default": null
        }
      }
    },
    "ProjectImportSettings": {
      "kind": "record",
      "doc": "Defaults inherited by import sidecars which do not specify a preset.",
      "module": "asset",
      "prefix": "pi",
      "fields": {
        "preset": {
          "type": "CookPreset",
          "doc": "Default texture encoding quality. Balanced opens new projects quickly; HighQuality performs the full search. Source/texture overrides take priority.",
          "default": "balanced",
          "options": [
            "balanced",
            "highQuality",
            "fast"
          ]
        }
      }
    },
    "ProjectSetMainParams": {
      "kind": "params",
      "doc": "Parameters of `project.setMain`.",
      "fields": {
        "scene": {
          "type": "asset<scene>",
          "doc": "Existing scene path or asset reference to open when the project starts.",
          "required": true
        }
      }
    },
    "ProjectSettings": {
      "kind": "record",
      "doc": "Project metadata and policy represented as records so changes share history and undo.",
      "module": "core",
      "prefix": "p",
      "fields": {
        "settings": {
          "type": "json",
          "doc": "Project settings, including fields owned by plugins and future engine versions.",
          "default": null
        }
      }
    },
    "PropertySetParams": {
      "kind": "params",
      "doc": "Parameters of `property.set`.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Target entity; inside a prefab instance this writes an override.",
          "required": true
        },
        "path": {
          "type": "string",
          "doc": "Field path: `name`, or a component field such as `Light.intensity` or `Transform.position.y`.",
          "required": true
        },
        "value": {
          "type": "json",
          "doc": "New value, in the field's schema type and unit.",
          "required": true
        }
      }
    },
    "QualitySetting": {
      "kind": "enum",
      "doc": "Rendering quality. `auto` picks from the GPU: High on ray-tracing GPUs (Medium below 8 GiB of video memory), Low without ray tracing. Epic is never automatic.",
      "module": "render",
      "variants": {
        "auto": {
          "doc": "Detect from the GPU."
        },
        "low": {
          "doc": "Raster renderer with temporal antialiasing; no ray tracing."
        },
        "medium": {
          "doc": "Raster lighting with ambient occlusion and screen-space reflections."
        },
        "high": {
          "doc": "Raster lighting with stronger shadow, GI and screen-space effect budgets."
        },
        "epic": {
          "doc": "The highest raster shadow, GI and reflection budgets. The most expensive."
        }
      }
    },
    "RagdollBone": {
      "kind": "struct",
      "doc": "One capsule and parent constraint in a canonical powered-ragdoll asset.",
      "module": "animation",
      "fields": {
        "joint": {
          "type": "string",
          "doc": "Stable skeleton joint ID.",
          "default": ""
        },
        "parent": {
          "type": "option<u32>",
          "doc": "Parent body index; absent for a free root. Parents must precede children.",
          "default": null
        },
        "offset": {
          "type": "AnimTransform",
          "doc": "Body transform relative to the skeleton joint.",
          "default": {}
        },
        "radius": {
          "type": "f32",
          "doc": "Capsule radius in meters.",
          "default": 0.08
        },
        "halfHeight": {
          "type": "f32",
          "doc": "Capsule cylinder half-height in meters.",
          "default": 0.15
        },
        "mass": {
          "type": "f32",
          "doc": "Body mass in kg.",
          "default": 3
        },
        "limit": {
          "type": "JointLimit",
          "doc": "Bind-local angular constraint for the parent/body connection.",
          "default": {}
        },
        "motor": {
          "type": "MotorGains",
          "doc": "Bounded spring gains.",
          "default": {}
        }
      }
    },
    "RagdollProfile": {
      "kind": "struct",
      "doc": "Canonical body/constraint/motor configuration, cooked at import or spawn boundaries.",
      "module": "animation",
      "fields": {
        "bones": {
          "type": "list<RagdollBone>",
          "doc": "Bodies in stable parent-before-child order.",
          "default": []
        }
      }
    },
    "RenderSettings": {
      "kind": "struct",
      "doc": "Project-wide rendering settings, stored under `rendering` in `ara.project.json`. A player's `--quality` flag overrides `quality` for that run.",
      "module": "render",
      "fields": {
        "quality": {
          "type": "QualitySetting",
          "doc": "Default quality preset for Play, the editor's lit viewport and exported players.",
          "default": "auto",
          "options": [
            "auto",
            "low",
            "medium",
            "high",
            "epic"
          ]
        },
        "rayTracing": {
          "type": "bool",
          "doc": "Opt in to experimental hardware ray tracing for supported presets. False keeps every preset on raster and creates no ray-tracing presentation device. Takes effect when the player or editor GPU device is opened.",
          "default": false
        }
      }
    },
    "Retarget": {
      "kind": "struct",
      "doc": "Bone identity and reference pose used by a retargeting tool.",
      "module": "animation",
      "fields": {
        "role": {
          "type": "string",
          "doc": "Semantic role such as hips, leftFoot or head; empty for unspecified.",
          "default": ""
        },
        "reference": {
          "type": "AnimTransform",
          "doc": "Reference orientation defining the source bone's anatomical axes.",
          "default": {}
        },
        "length": {
          "type": "f32",
          "doc": "Bone length in meters; zero means unspecified.",
          "default": 0
        }
      }
    },
    "ReverbZone": {
      "kind": "component",
      "doc": "A room or space with its own reverb. The listener's zone drives the room reverb; sources in other zones reach the listener through portals.",
      "module": "audio",
      "fields": {
        "name": {
          "type": "string",
          "doc": "Unique zone name; portals, traces and diagnostics refer to zones by name.",
          "default": ""
        },
        "shape": {
          "type": "ZoneShape",
          "doc": "Volume shape.",
          "default": "box",
          "options": [
            "box",
            "sphere"
          ]
        },
        "position": {
          "type": "vec3",
          "doc": "World-space center, supplied from the entity transform by the bridge.",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "rotation": {
          "type": "vec4",
          "doc": "World rotation as a unit quaternion (x, y, z, w), supplied by the bridge.",
          "default": [0, 0, 0, 1]
        },
        "halfExtents": {
          "type": "vec3",
          "doc": "Box half extents.",
          "default": [5, 3, 5],
          "unit": "m"
        },
        "radius": {
          "type": "f32",
          "doc": "Sphere radius.",
          "default": 5,
          "unit": "m",
          "range": [0.1, 10000]
        },
        "fade": {
          "type": "f32",
          "doc": "Width inside the boundary over which the listener crossfades to the outer space.",
          "default": 1,
          "unit": "m",
          "range": [0, 100]
        },
        "priority": {
          "type": "i32",
          "doc": "Nested zones: the highest priority containing zone wins.",
          "default": 0
        },
        "material": {
          "type": "MaterialPreset",
          "doc": "Wall material, deriving absorption for the realtime room model.",
          "default": "generic",
          "options": [
            "generic",
            "brick",
            "concrete",
            "ceramic",
            "gravel",
            "carpet",
            "glass",
            "plaster",
            "wood",
            "metal",
            "rock"
          ]
        },
        "rt60": {
          "type": "option<vec3>",
          "doc": "Explicit low/mid/high reverberation times in seconds, overriding derived and baked values.",
          "default": null
        },
        "wet": {
          "type": "f32",
          "doc": "Reverb return gain.",
          "default": 1,
          "range": [0, 4]
        },
        "earlyReflections": {
          "type": "bool",
          "doc": "Geometric early reflections from the zone's walls.",
          "default": true
        },
        "useBaked": {
          "type": "bool",
          "doc": "Prefer baked probe reverb times inside this zone when cooked cells are loaded.",
          "default": true
        }
      }
    },
    "RigBone": {
      "kind": "struct",
      "doc": "One semantic bone binding, using a stable importer joint ID.",
      "module": "animation",
      "fields": {
        "role": {
          "type": "BoneRole",
          "doc": "Anatomical role, unique within this rig.",
          "default": "root",
          "options": [
            "root",
            "hips",
            "spine",
            "chest",
            "upperChest",
            "neck",
            "head",
            "leftShoulder",
            "leftUpperArm",
            "leftLowerArm",
            "leftHand",
            "rightShoulder",
            "rightUpperArm",
            "rightLowerArm",
            "rightHand",
            "leftUpperLeg",
            "leftLowerLeg",
            "leftFoot",
            "leftToes",
            "rightUpperLeg",
            "rightLowerLeg",
            "rightFoot",
            "rightToes"
          ]
        },
        "joint": {
          "type": "string",
          "doc": "Stable skeleton joint identity.",
          "default": ""
        }
      }
    },
    "RigMap": {
      "kind": "struct",
      "doc": "Canonical humanoid definition. Partial rigs are legal; ambiguity is never guessed.",
      "module": "animation",
      "fields": {
        "bones": {
          "type": "list<RigBone>",
          "doc": "Unique role-to-joint bindings.",
          "default": []
        }
      }
    },
    "RigidBody": {
      "kind": "component",
      "doc": "Rigid-body authoring settings; simulation state is written to pose and velocity.",
      "module": "physics",
      "fields": {
        "motion": {
          "type": "MotionType",
          "doc": "Static, kinematic, or dynamic motion.",
          "default": "static",
          "options": [
            "static",
            "kinematic",
            "dynamic"
          ]
        },
        "mass": {
          "type": "f32",
          "doc": "Mass in kilograms; zero computes mass from the collider's 1000 kg/m3 density.",
          "default": 0,
          "unit": "kg",
          "range": [0, null]
        },
        "allowSleep": {
          "type": "bool",
          "doc": "Permit inactive bodies to sleep.",
          "default": true
        },
        "continuous": {
          "type": "bool",
          "doc": "Use swept collision detection for fast bodies.",
          "default": false
        }
      }
    },
    "RigidBody2d": {
      "kind": "component",
      "doc": "Rigid-body authoring settings; simulation state is written to pose and velocity.",
      "module": "physics2d",
      "fields": {
        "motion": {
          "type": "MotionType2d",
          "doc": "Static, kinematic, or dynamic motion.",
          "default": "static",
          "options": [
            "static",
            "kinematic",
            "dynamic"
          ]
        },
        "mass": {
          "type": "f32",
          "doc": "Mass in kilograms; zero computes mass from the collider's 1 kg/m2 area density.",
          "default": 0,
          "unit": "kg",
          "range": [0, null]
        },
        "allowSleep": {
          "type": "bool",
          "doc": "Permit inactive bodies to sleep.",
          "default": true
        },
        "continuous": {
          "type": "bool",
          "doc": "Use swept collision detection for fast bodies.",
          "default": false
        },
        "lockRotation": {
          "type": "bool",
          "doc": "Prevent physical rotation, for upright props and platforms.",
          "default": false
        }
      }
    },
    "RotationKey": {
      "kind": "struct",
      "doc": "A unit quaternion key at an exact integer clip time.",
      "module": "animation",
      "fields": {
        "tick": {
          "type": "u32",
          "doc": "Clip time in ticks.",
          "default": 0
        },
        "value": {
          "type": "vec4",
          "doc": "Unit quaternion in XYZW order.",
          "default": [0, 0, 0, 1]
        }
      }
    },
    "SavePersistDeclaration": {
      "kind": "struct",
      "doc": "Reflected persistence flag. This extension descriptor references the Schema DB; it does not duplicate fields, defaults, versions or migration implementations.",
      "module": "save",
      "fields": {
        "typeName": {
          "type": "string",
          "doc": "Stable reflected type name.",
          "default": ""
        },
        "storage": {
          "type": "SaveStorage",
          "doc": "Component or infrastructure resource.",
          "default": "component",
          "options": [
            "component",
            "resource"
          ]
        },
        "persist": {
          "type": "bool",
          "doc": "Explicit opt-in. False declarations document excluded runtime/presentation data.",
          "default": false
        }
      }
    },
    "SaveStorage": {
      "kind": "enum",
      "doc": "Storage class referenced by a persistence declaration, independent of replication.",
      "module": "save",
      "variants": {
        "component": {
          "doc": "Authoritative gameplay data attached to a stable entity."
        },
        "resource": {
          "doc": "Registered service state; gameplay state still belongs to components."
        }
      }
    },
    "ScalarKey": {
      "kind": "struct",
      "doc": "A scalar key for a property curve.",
      "module": "animation",
      "fields": {
        "tick": {
          "type": "u32",
          "doc": "Clip time in ticks.",
          "default": 0
        },
        "value": {
          "type": "f32",
          "doc": "Finite property value in the addressed field's units.",
          "default": 0
        }
      }
    },
    "SkeletonData": {
      "kind": "struct",
      "doc": "An imported skeleton, ordered for a linear model-space traversal.",
      "module": "animation",
      "fields": {
        "joints": {
          "type": "list<AnimJoint>",
          "doc": "Parent-before-child joints; at least one joint is required.",
          "default": []
        },
        "motionRoot": {
          "type": "u32",
          "doc": "Root joint whose rigid motion is extracted by the runtime.",
          "default": 0
        },
        "inverseBind": {
          "type": "list<AnimMatrix>",
          "doc": "Explicit mesh-space inverse binds, in joint order. Empty derives them from bind transforms; glTF importers preserve the skin accessor here instead.",
          "default": []
        }
      }
    },
    "SkyAtmosphere": {
      "kind": "component",
      "doc": "A physical sky and aerial perspective lit by the scene's directional light. The sun's elevation sets the time of day; without this component the scene uses its `Environment` gradient. The first entity in ID order wins.",
      "module": "render",
      "fields": {
        "seaLevel": {
          "type": "f32",
          "doc": "World altitude of the planet surface (sea level); the sky and fog measure height from here.",
          "default": 0,
          "unit": "m",
          "examples": [0]
        },
        "aerosols": {
          "type": "f32",
          "doc": "Aerosol (haze, dust) density relative to clear Earth air. Raise it for dusty or humid skies: a whiter horizon, a wider sun glow and stronger aerial perspective.",
          "default": 1,
          "range": [0, 20]
        },
        "cloudCoverage": {
          "type": "f32",
          "doc": "Fraction of the sky covered by the lit cloud layer; 0 disables clouds.",
          "default": 0,
          "range": [0, 1]
        },
        "cloudHeight": {
          "type": "f32",
          "doc": "Altitude of the cloud layer above sea level.",
          "default": 2200,
          "unit": "m",
          "range": [500, 20000]
        }
      }
    },
    "SourceReplaceParams": {
      "kind": "params",
      "doc": "Parameters of source.replace.",
      "fields": {
        "path": {
          "type": "string",
          "doc": "Canonical project-relative C# source path.",
          "required": true
        },
        "baseHash": {
          "type": "string",
          "doc": "SHA-256 of the exact bytes that were analyzed.",
          "required": true
        },
        "text": {
          "type": "string",
          "doc": "Complete replacement source; line endings are preserved exactly.",
          "required": true
        }
      }
    },
    "Sprite": {
      "kind": "component",
      "doc": "A batched sprite with optional normal-mapped 2D illumination.",
      "module": "twoD",
      "fields": {
        "atlas": {
          "type": "option<asset>",
          "doc": "Atlas asset reference, resolved to a resident texture at extraction.",
          "default": null
        },
        "region": {
          "type": "string",
          "doc": "Stable region name in the atlas.",
          "default": ""
        },
        "normalAtlas": {
          "type": "option<asset>",
          "doc": "Optional normal atlas, using the same rectangles.",
          "default": null
        },
        "size": {
          "type": "vec2",
          "doc": "Desired world size in metres; zero selects source size / pixels per metre.",
          "default": [0, 0]
        },
        "tint": {
          "type": "vec4",
          "doc": "Linear, straight-alpha tint.",
          "default": [1, 1, 1, 1]
        },
        "sortingLayer": {
          "type": "i32",
          "doc": "Painter's sorting layer; lower draws first.",
          "default": 0
        },
        "order": {
          "type": "i32",
          "doc": "Painter's order within a layer; stable identity breaks ties.",
          "default": 0
        },
        "flipX": {
          "type": "bool",
          "doc": "Mirror horizontally about the pivot.",
          "default": false
        },
        "flipY": {
          "type": "bool",
          "doc": "Mirror vertically about the pivot.",
          "default": false
        },
        "nineSlice": {
          "type": "bool",
          "doc": "Apply the region's nine-slice borders when resizing.",
          "default": false
        },
        "lit": {
          "type": "bool",
          "doc": "Opt into normal-mapped local lights and geometric shadows.",
          "default": false
        },
        "parallax": {
          "type": "vec2",
          "doc": "Parallax factor; one follows the world, zero follows the camera.",
          "default": [1, 1]
        }
      }
    },
    "SpriteRegion": {
      "kind": "struct",
      "doc": "Atlas rectangle and authoring geometry, in source pixels.",
      "fields": {
        "x": {
          "type": "u32",
          "doc": "Pixel left edge.",
          "default": 0
        },
        "y": {
          "type": "u32",
          "doc": "Pixel top edge.",
          "default": 0
        },
        "width": {
          "type": "u32",
          "doc": "Source pixel width.",
          "default": 0
        },
        "height": {
          "type": "u32",
          "doc": "Source pixel height.",
          "default": 0
        },
        "pivot": {
          "type": "vec2",
          "doc": "Normalized pivot, measured from the bottom left.",
          "default": [0.5, 0.5]
        },
        "borders": {
          "type": "vec4",
          "doc": "Nine-slice borders in pixels: left, bottom, right, top.",
          "default": [0, 0, 0, 0]
        }
      }
    },
    "SpriteSetParams": {
      "kind": "params",
      "doc": "Complete typed component authoring update.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Target entity, including prefab addresses.",
          "required": true
        },
        "value": {
          "type": "Sprite",
          "doc": "Complete typed component; omitted fields use schema defaults.",
          "required": true
        }
      }
    },
    "Stimulus": {
      "kind": "component",
      "doc": "Something perceivers can see and remember (players, corpses, thrown objects).",
      "module": "ai",
      "fields": {
        "kind": {
          "type": "string",
          "doc": "Category name behaviours query (`player`, `corpse`).",
          "default": ""
        },
        "height": {
          "type": "f32",
          "doc": "Height of the sight target above the feet in metres.",
          "default": 1.2,
          "unit": "m",
          "range": [0, 100]
        },
        "visibility": {
          "type": "f32",
          "doc": "Detection range multiplier (0 = invisible, 0.5 = crouched in shadow).",
          "default": 1,
          "range": [0, 10]
        }
      }
    },
    "StopAudioParams": {
      "kind": "params",
      "doc": "Schema-discoverable `audio.stop` parameters; this stops presentation only.",
      "module": "audio",
      "fields": {
        "voice": {
          "type": "u64",
          "doc": "Session-local runtime voice handle.",
          "required": true
        },
        "atFrame": {
          "type": "u64",
          "doc": "Absolute presentation sample frame at which stopping begins.",
          "required": true
        },
        "fadeFrames": {
          "type": "u32",
          "doc": "Dry-source fade length in output frames; native DSP tails drain afterwards.",
          "default": 64
        }
      }
    },
    "StreamedWorld": {
      "kind": "component",
      "doc": "Streams a `.world`'s cells into play around the players (`ara-runtime-world`). Put it on one entity of the level scene; the cell documents stay out of the projection and arrive at tick boundaries. With a `Terrain`, navigation then follows the resident `TerrainChunk`s.",
      "module": "world",
      "fields": {
        "world": {
          "type": "option<asset<world>>",
          "doc": "The world manifest (`.world` document).",
          "default": null
        }
      }
    },
    "Terrain": {
      "kind": "component",
      "doc": "Puts a `.terrain` heightfield (and its `.foliage` scatter) in play: rendered by the landscape renderer, walkable for navigation, solid where `TerrainChunk`s exist.",
      "module": "terrain",
      "fields": {
        "terrain": {
          "type": "option<asset<terrain>>",
          "doc": "The heightfield manifest (`.terrain` document).",
          "default": null
        },
        "foliage": {
          "type": "option<asset<foliage>>",
          "doc": "Scatter rules over it (`.foliage` document), drawn by the landscape renderer.",
          "default": null
        }
      }
    },
    "TerrainChunk": {
      "kind": "component",
      "doc": "Collision for one terrain tile (grid coordinates of the level's `Terrain`). Author these in world cells to stream collision with the cells.",
      "module": "terrain",
      "fields": {
        "x": {
          "type": "i32",
          "doc": "Tile index along world X.",
          "default": 0
        },
        "z": {
          "type": "i32",
          "doc": "Tile index along world Z.",
          "default": 0
        }
      }
    },
    "TerrainCoord": {
      "kind": "struct",
      "doc": "Integer X/Z address in a terrain's fixed grid.",
      "module": "terrain",
      "fields": {
        "x": {
          "type": "i32",
          "doc": "Tile index along world X.",
          "default": 0
        },
        "z": {
          "type": "i32",
          "doc": "Tile index along world Z.",
          "default": 0
        }
      }
    },
    "TerrainCreateParams": {
      "kind": "params",
      "doc": "Grid creation parameters for an empty terrain document.",
      "module": "terrain",
      "fields": {
        "grid": {
          "type": "TerrainHeader",
          "doc": "Terrain grid dimensions and material channels.",
          "required": true
        }
      }
    },
    "TerrainDab": {
      "kind": "struct",
      "doc": "One brush dab; the stroke command groups all dabs into one transaction.",
      "module": "terrain",
      "fields": {
        "center": {
          "type": "vec2",
          "doc": "World X/Z brush centre in metres.",
          "default": [0, 0]
        },
        "radius": {
          "type": "f32",
          "doc": "Brush radius in metres.",
          "default": 0
        },
        "amount": {
          "type": "f32",
          "doc": "Signed displacement, paint strength or relaxation strength.",
          "default": 0
        }
      }
    },
    "TerrainHeader": {
      "kind": "record",
      "doc": "Stable terrain grid settings; adjacent tiles duplicate their shared border.",
      "module": "terrain",
      "prefix": "h",
      "fields": {
        "origin": {
          "type": "vec2",
          "doc": "World X/Z origin in metres.",
          "default": [0, 0]
        },
        "spacing": {
          "type": "f32",
          "doc": "Metres between adjacent height samples.",
          "default": 0
        },
        "cells": {
          "type": "u32",
          "doc": "Power-of-two cells per tile (16..256); samples are cells + 1.",
          "default": 0
        },
        "min": {
          "type": "TerrainCoord",
          "doc": "Inclusive minimum tile X/Z coordinates.",
          "default": {}
        },
        "max": {
          "type": "TerrainCoord",
          "doc": "Exclusive maximum tile X/Z coordinates.",
          "default": {}
        },
        "materials": {
          "type": "list<asset>",
          "doc": "Up to four surface material references, in weight-channel order.",
          "default": []
        }
      }
    },
    "TerrainImportParams": {
      "kind": "params",
      "doc": "Imports one immutable source tile, preserving subsequent layer edits.",
      "module": "terrain",
      "fields": {
        "layer": {
          "type": "string",
          "doc": "Existing non-destructive layer receiving this source tile.",
          "required": true
        },
        "coord": {
          "type": "TerrainCoord",
          "doc": "Destination tile address.",
          "required": true
        },
        "hash": {
          "type": "string",
          "doc": "Verified source payload key from the terrain cache.",
          "required": true
        }
      }
    },
    "TerrainLayer": {
      "kind": "record",
      "doc": "A non-destructive layer; order followed by stable ID defines composition.",
      "module": "terrain",
      "prefix": "l",
      "fields": {
        "name": {
          "type": "string",
          "doc": "Display name in terrain tools.",
          "default": ""
        },
        "priority": {
          "type": "u32",
          "doc": "Stable ordering independent of record/map iteration order.",
          "default": 0
        },
        "enabled": {
          "type": "bool",
          "doc": "Disabled layers are retained for undo and later re-enabling.",
          "default": false
        },
        "opacity": {
          "type": "f32",
          "doc": "Blend opacity from zero to one.",
          "default": 0
        }
      }
    },
    "TerrainLayerParams": {
      "kind": "params",
      "doc": "A non-destructive layer to insert.",
      "module": "terrain",
      "fields": {
        "id": {
          "type": "option<string>",
          "doc": "Optional concrete or symbolic layer ID.",
          "default": null
        },
        "layer": {
          "type": "TerrainLayer",
          "doc": "Layer settings.",
          "required": true
        }
      }
    },
    "TerrainLayerSetParams": {
      "kind": "params",
      "doc": "Change layer settings while retaining its gesture history.",
      "module": "terrain",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Existing layer record ID.",
          "required": true
        },
        "layer": {
          "type": "TerrainLayer",
          "doc": "Replacement layer controls.",
          "required": true
        }
      }
    },
    "TerrainOperation": {
      "kind": "enum",
      "doc": "Operation performed by one recorded brush gesture.",
      "module": "terrain",
      "variants": {
        "raise": {
          "doc": "Add a smooth radial displacement in metres."
        },
        "paint": {
          "doc": "Paint one normalized splat channel."
        },
        "hole": {
          "doc": "Set or clear holes in the selected area."
        },
        "stamp": {
          "doc": "Add a rotated height stamp sampled from an immutable binary tile."
        },
        "erode": {
          "doc": "Apply a bounded deterministic thermal relaxation kernel."
        },
        "import": {
          "doc": "Replace samples from an imported tile inside an ordered, undoable layer."
        }
      }
    },
    "TerrainStroke": {
      "kind": "record",
      "doc": "A complete gesture, retained as source rather than destructive tile snapshots.",
      "module": "terrain",
      "prefix": "s",
      "fields": {
        "layer": {
          "type": "string",
          "doc": "Owning layer record ID.",
          "default": ""
        },
        "sequence": {
          "type": "u64",
          "doc": "Gesture ordering within a layer; stable ID breaks concurrent ties.",
          "default": 0
        },
        "operation": {
          "type": "TerrainOperation",
          "doc": "Typed operation.",
          "default": "raise",
          "options": [
            "raise",
            "paint",
            "hole",
            "stamp",
            "erode",
            "import"
          ]
        },
        "dabs": {
          "type": "list<TerrainDab>",
          "doc": "Brush samples in gesture order (at most 4096).",
          "default": []
        },
        "channel": {
          "type": "u32",
          "doc": "Paint channel, from zero to three.",
          "default": 0
        },
        "iterations": {
          "type": "u32",
          "doc": "Erosion iterations (1..32), otherwise zero.",
          "default": 0
        },
        "stamp": {
          "type": "option<string>",
          "doc": "Immutable stamp payload hash; absent for other operations.",
          "default": null
        },
        "sourceTile": {
          "type": "option<TerrainCoord>",
          "doc": "Destination grid tile for an import layer; absent for brush operations.",
          "default": null
        },
        "angle": {
          "type": "f32",
          "doc": "Stamp angle in radians.",
          "default": 0
        }
      }
    },
    "TerrainStrokeParams": {
      "kind": "params",
      "doc": "A whole gesture, including every dab; do not issue one transaction per mouse sample.",
      "module": "terrain",
      "fields": {
        "id": {
          "type": "option<string>",
          "doc": "Optional concrete or symbolic stroke ID for reproducible authoring.",
          "default": null
        },
        "layer": {
          "type": "string",
          "doc": "Existing layer ID.",
          "required": true
        },
        "dabs": {
          "type": "list<TerrainDab>",
          "doc": "Ordered gesture samples.",
          "required": true
        },
        "channel": {
          "type": "option<u32>",
          "doc": "Material channel for paint; defaults to zero.",
          "default": null
        },
        "iterations": {
          "type": "option<u32>",
          "doc": "Thermal iterations, default eight.",
          "default": null
        },
        "stamp": {
          "type": "option<string>",
          "doc": "Immutable height stamp hash.",
          "default": null
        },
        "angle": {
          "type": "option<f32>",
          "doc": "Stamp rotation in radians.",
          "default": null
        }
      }
    },
    "TerrainTile": {
      "kind": "record",
      "doc": "Sparse touched-tile delta: a base payload and ordered references to gestures.",
      "module": "terrain",
      "prefix": "t",
      "fields": {
        "coord": {
          "type": "TerrainCoord",
          "doc": "Stable tile coordinate.",
          "default": {}
        },
        "base": {
          "type": "option<string>",
          "doc": "Imported base tile in the content-addressed cache; absent means flat ground.",
          "default": null
        },
        "strokes": {
          "type": "list<string>",
          "doc": "Gesture IDs touching this tile, in transaction order.",
          "default": []
        }
      }
    },
    "TextureSettings": {
      "kind": "struct",
      "doc": "Declarative texture import settings.",
      "module": "asset",
      "fields": {
        "preset": {
          "type": "option<CookPreset>",
          "doc": "Optional quality override; absent inherits the source/project preset. Changing it does not re-encode other texture tasks.",
          "default": null,
          "options": [
            "balanced",
            "highQuality",
            "fast"
          ]
        },
        "usage": {
          "type": "TextureUsage",
          "doc": "How color/normal/mask values are interpreted.",
          "default": "color",
          "options": [
            "color",
            "linear",
            "normal",
            "mask",
            "hdr",
            "lut"
          ]
        },
        "mipmaps": {
          "type": "bool",
          "doc": "Generate the complete mip chain through 1×1.",
          "default": true
        },
        "flipNormalY": {
          "type": "bool",
          "doc": "Invert normal Y for DirectX-authored tangent-space inputs.",
          "default": false
        },
        "maskChannel": {
          "type": "u8",
          "doc": "Source channel for BC4, R=0/G=1/B=2/A=3.",
          "default": 0,
          "range": [0, 3]
        },
        "maxDimension": {
          "type": "u32",
          "doc": "Maximum permitted source dimension (decode limits are also enforced).",
          "default": 16384,
          "range": [1, 16384]
        }
      }
    },
    "TextureUsage": {
      "kind": "enum",
      "doc": "Semantic texture usage selects transfer functions, mip filtering and BC format.",
      "module": "asset",
      "variants": {
        "color": {
          "doc": "sRGB color (alpha remains linear), BC7 sRGB."
        },
        "linear": {
          "doc": "Linear RGBA data, BC7 UNORM."
        },
        "normal": {
          "doc": "Tangent-space normals, normalized mips and BC5 XY."
        },
        "mask": {
          "doc": "A single linear scalar channel, BC4."
        },
        "hdr": {
          "doc": "Nonnegative linear radiance, BC6H UFLOAT."
        },
        "lut": {
          "doc": "A colour lookup table strip (post-process volumes' grading): values kept as authored, uncompressed RGBA half floats, without mips."
        }
      }
    },
    "TileCell": {
      "kind": "struct",
      "doc": "A signed source-cell address. Reflected as `TileCell` (world partition cells own `Cell`).",
      "fields": {
        "x": {
          "type": "i32",
          "doc": "Signed column / axial q.",
          "default": 0
        },
        "y": {
          "type": "i32",
          "doc": "Signed row / axial r.",
          "default": 0
        }
      }
    },
    "TileColliderSource2d": {
      "kind": "component",
      "doc": "Ownership marker for generated colliders, separate from gameplay body state.",
      "module": "physics2d",
      "fields": {
        "owner": {
          "type": "entity",
          "doc": "Map entity whose tiles generated this collider.",
          "default": null
        }
      }
    },
    "TileCollidersParams": {
      "kind": "params",
      "doc": "Tile collider generation request.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Plain tilemap entity (prefab generation belongs in its source document).",
          "required": true
        },
        "origin": {
          "type": "vec2",
          "doc": "World-space map offset in metres.",
          "required": true
        },
        "basis": {
          "type": "option<vec4>",
          "doc": "Optional row-major map basis, including hierarchy rotation/scale/shear.",
          "default": null
        }
      }
    },
    "TileDefinition": {
      "kind": "struct",
      "doc": "A tile's visual, terrain, collision and lighting definition.",
      "fields": {
        "region": {
          "type": "string",
          "doc": "Stable atlas region name.",
          "default": ""
        },
        "size": {
          "type": "vec2",
          "doc": "Drawn size in metres around the region pivot; zero uses the cell size. Taller tiles (walls, trees) overlap their neighbors and draw back to front.",
          "default": [0, 0],
          "unit": "m",
          "range": [0, null]
        },
        "terrain": {
          "type": "u32",
          "doc": "Auto-tiling terrain group; zero opts out of rules.",
          "default": 0
        },
        "solid": {
          "type": "bool",
          "doc": "Generate a static collider and shadow silhouette from this cell.",
          "default": false
        },
        "lit": {
          "type": "bool",
          "doc": "Opt into local lights and normal maps.",
          "default": false
        }
      }
    },
    "TileEraseParams": {
      "kind": "params",
      "doc": "An eraser stroke.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Tilemap entity.",
          "required": true
        },
        "layer": {
          "type": "string",
          "doc": "Stable layer ID.",
          "required": true
        },
        "cells": {
          "type": "list<TileCell>",
          "doc": "Cells to erase atomically.",
          "required": true
        },
        "autotile": {
          "type": "option<bool>",
          "doc": "Re-run terrain rules on the erased cells' neighbors in the same transaction (default false).",
          "default": null
        }
      }
    },
    "TileFillParams": {
      "kind": "params",
      "doc": "Bounded flood fill of edge-connected cells matching the seed's tile.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Tilemap entity.",
          "required": true
        },
        "layer": {
          "type": "string",
          "doc": "Stable layer ID.",
          "required": true
        },
        "seed": {
          "type": "TileCell",
          "doc": "Starting cell.",
          "required": true
        },
        "min": {
          "type": "TileCell",
          "doc": "Inclusive minimum coordinate; bounds make empty-space fills finite.",
          "required": true
        },
        "max": {
          "type": "TileCell",
          "doc": "Inclusive maximum coordinate.",
          "required": true
        },
        "tile": {
          "type": "u32",
          "doc": "New tile definition, zero to erase.",
          "required": true
        },
        "autotile": {
          "type": "option<bool>",
          "doc": "Re-run terrain rules on the filled region and its border (default false).",
          "default": null
        }
      }
    },
    "TileLayer": {
      "kind": "struct",
      "doc": "One map layer with stable identity, source cells and independent painter order.",
      "fields": {
        "id": {
          "type": "string",
          "doc": "Stable layer identity (`l_ground`), used in field paths and cache keys.",
          "default": ""
        },
        "sortingLayer": {
          "type": "i32",
          "doc": "Sorting layer shared with sprites.",
          "default": 0
        },
        "order": {
          "type": "i32",
          "doc": "Draw order within the sorting layer.",
          "default": 0
        },
        "parallax": {
          "type": "vec2",
          "doc": "Parallax factor per world axis.",
          "default": [1, 1]
        },
        "tint": {
          "type": "vec4",
          "doc": "Linear, straight-alpha tint applied to every tile, e.g. to darken backgrounds.",
          "default": [1, 1, 1, 1]
        },
        "cells": {
          "type": "map<u32>",
          "doc": "Signed `x,y` keys to positive tile numbers; missing cells are empty.",
          "default": {}
        }
      }
    },
    "TilePaintParams": {
      "kind": "params",
      "doc": "A stroke of explicitly addressed tile samples.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Tilemap entity, including prefab addresses.",
          "required": true
        },
        "layer": {
          "type": "string",
          "doc": "Stable layer ID.",
          "required": true
        },
        "cells": {
          "type": "list<PaintCell>",
          "doc": "Stroke samples in input order; later duplicates win.",
          "required": true
        },
        "autotile": {
          "type": "option<bool>",
          "doc": "Re-run terrain rules on the stroke and its neighbors in the same transaction (default false).",
          "default": null
        }
      }
    },
    "TileRule": {
      "kind": "struct",
      "doc": "First matching rule wins. Masks use `GridLayout::neighbors` bit order; a neighbor \"matches\" when its tile's definition has the rule's terrain.",
      "fields": {
        "terrain": {
          "type": "u32",
          "doc": "Terrain group to transform.",
          "default": 0
        },
        "required": {
          "type": "u32",
          "doc": "Neighbors which must share this terrain.",
          "default": 0
        },
        "forbidden": {
          "type": "u32",
          "doc": "Neighbors which must not share this terrain.",
          "default": 0
        },
        "tile": {
          "type": "u32",
          "doc": "Output tile number; its definition must have the same terrain.",
          "default": 0
        }
      }
    },
    "TileRuleParams": {
      "kind": "params",
      "doc": "Applies all terrain rules to a layer in one transaction.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Tilemap entity.",
          "required": true
        },
        "layer": {
          "type": "string",
          "doc": "Stable layer ID.",
          "required": true
        }
      }
    },
    "Tilemap": {
      "kind": "component",
      "doc": "Canonical text source for a tilemap. Binary chunks are derived cache products.",
      "module": "twoD",
      "fields": {
        "atlas": {
          "type": "option<asset>",
          "doc": "Atlas asset reference; never a native descriptor.",
          "default": null
        },
        "normalAtlas": {
          "type": "option<asset>",
          "doc": "Optional normal atlas matching the source regions.",
          "default": null
        },
        "layout": {
          "type": "GridLayout",
          "doc": "Grid, pointy hex or diamond layout.",
          "default": "grid",
          "options": [
            "grid",
            "hex",
            "isometric"
          ]
        },
        "cellSize": {
          "type": "vec2",
          "doc": "World dimensions of a cell's bounding box in metres.",
          "default": [1, 1]
        },
        "definitions": {
          "type": "map<TileDefinition>",
          "doc": "Tile number text to definitions; zero is reserved for empty cells.",
          "default": {}
        },
        "layers": {
          "type": "keyed<TileLayer>",
          "doc": "Stable layers. Their array order never determines painter order.",
          "default": []
        },
        "rules": {
          "type": "list<TileRule>",
          "doc": "Ordered auto-tiling rules.",
          "default": []
        }
      }
    },
    "TilemapSetParams": {
      "kind": "params",
      "doc": "Complete typed component authoring update.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Target entity, including prefab addresses.",
          "required": true
        },
        "value": {
          "type": "Tilemap",
          "doc": "Complete typed component; omitted fields use schema defaults.",
          "required": true
        }
      }
    },
    "ToneMapping": {
      "kind": "enum",
      "doc": "The display transform that compresses scene radiance into the screen's range.",
      "module": "render",
      "variants": {
        "filmic": {
          "doc": "Filmic ACES-style curve with a soft toe and highlight desaturation, similar to Unreal's default; the most cinematic."
        },
        "neutral": {
          "doc": "Khronos PBR Neutral: keeps material colours accurate up to bright highlights."
        },
        "acesFit": {
          "doc": "Narkowicz's per-channel ACES fit (the legacy curve; saturated highlights)."
        }
      }
    },
    "Transform": {
      "kind": "component",
      "doc": "Position, rotation and scale of an entity relative to its parent.",
      "module": "core",
      "fields": {
        "position": {
          "type": "vec3",
          "doc": "Position relative to the parent.",
          "default": [0, 0, 0],
          "unit": "m",
          "examples": [
            [0, 1, 0]
          ],
          "replicate": {
            "audience": "relevant",
            "quantize": 0.001,
            "interpolate": "linear",
            "rollback": true
          }
        },
        "rotation": {
          "type": "vec3",
          "doc": "Rotation relative to the parent, as XYZ Euler angles.",
          "default": [0, 0, 0],
          "unit": "deg",
          "examples": [
            [0, 90, 0]
          ],
          "replicate": {
            "audience": "relevant",
            "quantize": 0.01,
            "interpolate": "slerp",
            "rollback": true
          }
        },
        "scale": {
          "type": "vec3",
          "doc": "Scale relative to the parent; `[1, 1, 1]` is unscaled.",
          "default": [1, 1, 1],
          "examples": [
            [2, 2, 2]
          ]
        }
      }
    },
    "TransformLookAtParams": {
      "kind": "params",
      "doc": "Parameters of `transform.lookAt`.",
      "fields": {
        "entity": {
          "type": "entity",
          "doc": "Camera, light or other entity whose local -Z axis should face the target.",
          "required": true
        },
        "point": {
          "type": "option<vec3>",
          "doc": "World-space target position. Supply exactly one of point or target.",
          "default": null,
          "unit": "m"
        },
        "target": {
          "type": "option<entity>",
          "doc": "Target entity in this document; its world position is used.",
          "default": null
        },
        "up": {
          "type": "option<vec3>",
          "doc": "Preferred world-space up vector; defaults to +Y. At a pole a stable perpendicular axis is used.",
          "default": null
        }
      }
    },
    "TransformSetParams": {
      "kind": "params",
      "doc": "Parameters of `transform.set`.",
      "fields": {
        "entities": {
          "type": "list<entity>",
          "doc": "Entities to change; each gets a `Transform` if it has none.",
          "required": true
        },
        "position": {
          "type": "option<vec3>",
          "doc": "Position relative to the parent.",
          "default": null,
          "unit": "m"
        },
        "rotation": {
          "type": "option<vec3>",
          "doc": "Rotation relative to the parent, as XYZ Euler angles.",
          "default": null,
          "unit": "deg"
        },
        "scale": {
          "type": "option<vec3>",
          "doc": "Scale relative to the parent.",
          "default": null
        }
      }
    },
    "TranslateParams": {
      "kind": "params",
      "doc": "Generation request and completed provider output, committed as one undoable job.",
      "module": "l10n",
      "fields": {
        "request": {
          "type": "TranslationRequest",
          "doc": "Original generation request, including source and target fingerprints.",
          "required": true
        },
        "response": {
          "type": "TranslationResponse",
          "doc": "Completed response from the host's selected provider.",
          "required": true
        }
      }
    },
    "TranslationItem": {
      "kind": "struct",
      "doc": "One provider input; the source fingerprint makes late responses safe to reject.",
      "module": "l10n",
      "fields": {
        "key": {
          "type": "string",
          "doc": "Stable source key.",
          "default": ""
        },
        "source": {
          "type": "string",
          "doc": "Complete ICU MessageFormat source text.",
          "default": ""
        },
        "sourceHash": {
          "type": "string",
          "doc": "Source text plus parameter signature fingerprint.",
          "default": ""
        },
        "params": {
          "type": "map<L10nParamKind>",
          "doc": "Typed parameter signature the provider must preserve.",
          "default": {}
        },
        "note": {
          "type": "string",
          "doc": "Human context for the translator/provider.",
          "default": ""
        },
        "targetHash": {
          "type": "string",
          "doc": "Existing target fingerprint, or empty if absent; prevents late overwrites.",
          "default": ""
        }
      }
    },
    "TranslationRequest": {
      "kind": "struct",
      "doc": "Provider-independent generation job, suitable for a background worker or MCP host.",
      "module": "l10n",
      "fields": {
        "job": {
          "type": "string",
          "doc": "Stable host job ID used in provenance and response matching.",
          "default": ""
        },
        "sourceLocale": {
          "type": "string",
          "doc": "Source table locale.",
          "default": ""
        },
        "targetLocale": {
          "type": "string",
          "doc": "Destination table locale.",
          "default": ""
        },
        "items": {
          "type": "list<TranslationItem>",
          "doc": "Whole messages to translate without changing keys or signatures.",
          "default": []
        }
      }
    },
    "TranslationResponse": {
      "kind": "struct",
      "doc": "Provider response; no provider SDK or credentials enter the localization crate.",
      "module": "l10n",
      "fields": {
        "job": {
          "type": "string",
          "doc": "Request's exact job ID.",
          "default": ""
        },
        "provider": {
          "type": "string",
          "doc": "Provider identifier for provenance.",
          "default": ""
        },
        "model": {
          "type": "string",
          "doc": "Model/version identifier for provenance.",
          "default": ""
        },
        "translations": {
          "type": "map<string>",
          "doc": "Complete translated ICU patterns keyed by the requested source keys.",
          "default": {}
        }
      }
    },
    "UiSource": {
      "kind": "record",
      "doc": "Lossless UI source; persistence writes native XML through `SourceDocument`.",
      "module": "ui",
      "prefix": "us",
      "fields": {
        "source": {
          "type": "string",
          "doc": "Complete XML, including comments and stable asset identity metadata.",
          "default": ""
        }
      }
    },
    "UiSourceApplyParams": {
      "kind": "params",
      "doc": "Replaces a UI document's native markup through revision-checked source ops.",
      "module": "ui",
      "fields": {
        "source": {
          "type": "string",
          "doc": "Complete native UI XML. Existing identity metadata may be retained or omitted.",
          "required": true
        }
      }
    },
    "VectorKey": {
      "kind": "struct",
      "doc": "A vector key at an exact integer clip time.",
      "module": "animation",
      "fields": {
        "tick": {
          "type": "u32",
          "doc": "Clip time in ticks.",
          "default": 0
        },
        "value": {
          "type": "vec3",
          "doc": "Translation in meters or dimensionless scale.",
          "default": [0, 0, 0]
        }
      }
    },
    "Vehicle": {
      "kind": "component",
      "doc": "Four-wheel engine/automatic-gearbox vehicle, using S6's stable defaults.",
      "module": "physics",
      "fields": {
        "halfExtents": {
          "type": "vec3",
          "doc": "Chassis half extents.",
          "default": [0.9, 0.2, 2],
          "unit": "m",
          "range": [0.001, null]
        },
        "mass": {
          "type": "f32",
          "doc": "Chassis mass.",
          "default": 1500,
          "unit": "kg",
          "range": [0.001, null]
        },
        "wheelRadius": {
          "type": "f32",
          "doc": "All four wheel radii.",
          "default": 0.35,
          "unit": "m",
          "range": [0.001, null]
        },
        "wheelWidth": {
          "type": "f32",
          "doc": "All four wheel widths.",
          "default": 0.2,
          "unit": "m",
          "range": [0.001, null]
        },
        "suspensionMin": {
          "type": "f32",
          "doc": "Minimum suspension length.",
          "default": 0.2,
          "unit": "m",
          "range": [0, null]
        },
        "suspensionMax": {
          "type": "f32",
          "doc": "Maximum suspension length.",
          "default": 0.5,
          "unit": "m",
          "range": [0.001, null]
        },
        "suspensionFrequency": {
          "type": "f32",
          "doc": "Suspension spring frequency.",
          "default": 1.5,
          "unit": "Hz",
          "range": [0.001, null]
        },
        "suspensionDamping": {
          "type": "f32",
          "doc": "Suspension damping ratio.",
          "default": 0.5,
          "range": [0, null]
        },
        "maxSteerDeg": {
          "type": "f32",
          "doc": "Front wheel steering lock.",
          "default": 30,
          "unit": "deg",
          "range": [0, 89]
        },
        "engineMaxTorque": {
          "type": "f32",
          "doc": "Engine peak torque; Jolt's gearbox/engine curves supply the remaining defaults.",
          "default": 500,
          "unit": "N*m",
          "range": [0.001, null]
        },
        "rearWheelDrive": {
          "type": "bool",
          "doc": "Rear-wheel drive; false selects front-wheel drive.",
          "default": true
        },
        "layer": {
          "type": "u32",
          "doc": "Chassis collision layer.",
          "default": 1,
          "range": [1, 15]
        }
      }
    },
    "VehicleInput": {
      "kind": "component",
      "doc": "Replayable driver intent consumed every fixed tick.",
      "module": "physics",
      "fields": {
        "throttle": {
          "type": "f32",
          "doc": "Signed accelerator, with negative input selecting reverse.",
          "default": 0,
          "range": [-1, 1],
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        },
        "steer": {
          "type": "f32",
          "doc": "Signed steering, positive turns right.",
          "default": 0,
          "range": [-1, 1],
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        },
        "brake": {
          "type": "f32",
          "doc": "Service brake.",
          "default": 0,
          "range": [0, 1],
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        },
        "handBrake": {
          "type": "f32",
          "doc": "Rear-wheel handbrake.",
          "default": 0,
          "range": [0, 1],
          "replicate": {
            "audience": "owner",
            "rollback": true
          }
        }
      }
    },
    "VehicleTelemetry": {
      "kind": "component",
      "doc": "Vehicle drivetrain and suspension state mirrored into ECS after each tick.",
      "module": "physics",
      "fields": {
        "wheelsInContact": {
          "type": "u32",
          "doc": "Grounded wheel count.",
          "default": 0,
          "range": [0, 4],
          "replicate": {
            "audience": "relevant",
            "rollback": true
          }
        },
        "engineRpm": {
          "type": "f32",
          "doc": "Current engine speed in revolutions per minute.",
          "default": 0,
          "range": [0, null],
          "replicate": {
            "audience": "relevant",
            "rollback": true
          }
        },
        "gear": {
          "type": "i32",
          "doc": "Gear index (negative is reverse).",
          "default": 0,
          "replicate": {
            "audience": "relevant",
            "rollback": true
          }
        }
      }
    },
    "Velocity": {
      "kind": "component",
      "doc": "Authoritative velocity, synchronized at tick boundaries.",
      "module": "physics",
      "fields": {
        "linear": {
          "type": "vec3",
          "doc": "World-space linear velocity.",
          "default": [0, 0, 0],
          "unit": "m/s",
          "replicate": {
            "audience": "relevant",
            "rollback": true
          }
        },
        "angular": {
          "type": "vec3",
          "doc": "World-space angular velocity.",
          "default": [0, 0, 0],
          "unit": "rad/s",
          "replicate": {
            "audience": "relevant",
            "rollback": true
          }
        }
      }
    },
    "Velocity2d": {
      "kind": "component",
      "doc": "Authoritative velocity, synchronized at tick boundaries.",
      "module": "physics2d",
      "fields": {
        "linear": {
          "type": "vec2",
          "doc": "World-space linear velocity.",
          "default": [0, 0],
          "unit": "m/s",
          "replicate": {
            "audience": "relevant",
            "rollback": true
          }
        },
        "angular": {
          "type": "f32",
          "doc": "Counter-clockwise angular velocity.",
          "default": 0,
          "unit": "rad/s",
          "replicate": {
            "audience": "relevant",
            "rollback": true
          }
        }
      }
    },
    "VfxEnableParams": {
      "kind": "params",
      "doc": "Turn one module on or off without removing it.",
      "module": "vfx",
      "fields": {
        "emitter": {
          "type": "string",
          "doc": "Stable emitter name.",
          "required": true
        },
        "stage": {
          "type": "string",
          "doc": "One of spawn, initialize, update, render.",
          "required": true
        },
        "name": {
          "type": "string",
          "doc": "Stable module name.",
          "required": true
        },
        "enabled": {
          "type": "bool",
          "doc": "Whether the module runs; a disabled module keeps its place and settings.",
          "required": true
        }
      }
    },
    "VfxParameterParams": {
      "kind": "params",
      "doc": "Typed default parameter mutation.",
      "module": "vfx",
      "fields": {
        "key": {
          "type": "string",
          "doc": "Full namespaced parameter address.",
          "required": true
        },
        "value": {
          "type": "json",
          "doc": "Typed value object, e.g. {type:float,value:3}.",
          "required": true
        }
      }
    },
    "VfxStackParams": {
      "kind": "params",
      "doc": "A structured stack edit; the operation and module are domain-validated.",
      "module": "vfx",
      "fields": {
        "emitter": {
          "type": "string",
          "doc": "Stable emitter name.",
          "required": true
        },
        "stage": {
          "type": "string",
          "doc": "One of spawn, initialize, update, render.",
          "required": true
        },
        "operation": {
          "type": "string",
          "doc": "Insert, remove or move.",
          "required": true
        },
        "name": {
          "type": "string",
          "doc": "Stable existing module name for remove/move.",
          "required": true
        },
        "index": {
          "type": "option<u32>",
          "doc": "Destination position for insert/move.",
          "default": null
        },
        "module": {
          "type": "option<json>",
          "doc": "Typed StackModule JSON for insertion.",
          "default": null
        }
      }
    },
    "VfxTextParams": {
      "kind": "params",
      "doc": "Complete ID-free source edit, suitable for agents or a text editor.",
      "module": "vfx",
      "fields": {
        "source": {
          "type": "string",
          "doc": "Canonical ID-free effect JSON.",
          "required": true
        }
      }
    },
    "VirtualGeometrySettings": {
      "kind": "struct",
      "doc": "Offline cook policy; every value participates in the cache identity.",
      "module": "geo",
      "fields": {
        "groupSize": {
          "type": "u32",
          "doc": "Desired neighboring clusters per simplification group (2..=32).",
          "default": 8,
          "range": [2, 32]
        },
        "maxLevels": {
          "type": "u32",
          "doc": "Maximum hierarchy depth (1..=32).",
          "default": 24,
          "range": [1, 32]
        },
        "relativeError": {
          "type": "f32",
          "doc": "Relative error allowed in a single reduction (0..=1).",
          "default": 0.1,
          "range": [0, 1]
        }
      }
    },
    "VisualEffect": {
      "kind": "component",
      "doc": "A GPU particle effect drawn at this entity. Presentation only: gameplay reads ara-vfx CPU events, never GPU particles. `effect` names a cooked library effect (`campfire`, `sparks`, `depth_sparks`, `magic_swirl`, `smoke`, `muzzle_flash`, `rain`, `dust`).",
      "module": "vfx",
      "fields": {
        "effect": {
          "type": "string",
          "doc": "Cooked library effect name.",
          "default": "campfire"
        },
        "scale": {
          "type": "f32",
          "doc": "Uniform size: the effect's shape, sprite sizes and speeds grow together (2 doubles a campfire's height and spread).",
          "default": 1,
          "range": [0.05, 50]
        },
        "intensity": {
          "type": "f32",
          "doc": "Brightness multiplier on the effect's emitted and lit colour; its opacity is unchanged. Lower it for effects that glow too hot under a scene's exposure.",
          "default": 1,
          "range": [0, 50]
        }
      }
    },
    "VoiceParameters": {
      "kind": "struct",
      "doc": "Prepared voice controls. All values must be finite; linear gain is in [0,16].",
      "module": "audio",
      "fields": {
        "gain": {
          "type": "f32",
          "doc": "Linear amplitude, normally source gain times distance/cone attenuation.",
          "default": 1,
          "range": [0, 16]
        },
        "rate": {
          "type": "f32",
          "doc": "Playback rate, normally source pitch times Doppler.",
          "default": 1,
          "range": [0.03125, 32]
        },
        "direction": {
          "type": "vec3",
          "doc": "Unit listener-local direction, with forward along negative Z.",
          "default": [0, 0, -1]
        },
        "path": {
          "type": "AcousticPath",
          "doc": "Worker-computed occlusion, transmission and reflection send.",
          "default": {}
        }
      }
    },
    "VolumeShape": {
      "kind": "enum",
      "doc": "Where a post-process volume applies.",
      "module": "render",
      "variants": {
        "global": {
          "doc": "Everywhere, wherever the camera is."
        },
        "box": {
          "doc": "Inside a 1 m cube centred on the entity, sized and turned by its transform."
        },
        "sphere": {
          "doc": "Inside a 1 m diameter sphere centred on the entity, sized by its transform's scale."
        }
      }
    },
    "Wanderer": {
      "kind": "component",
      "doc": "Server-side AI: walks the navmesh to random points inside a box, pausing between.",
      "module": "gameplay",
      "fields": {
        "min": {
          "type": "vec3",
          "doc": "Minimum corner of the roaming box (world space).",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "max": {
          "type": "vec3",
          "doc": "Maximum corner of the roaming box (world space).",
          "default": [0, 0, 0],
          "unit": "m"
        },
        "pauseTicks": {
          "type": "u32",
          "doc": "Ticks to wait after arriving before choosing the next goal.",
          "default": 45
        },
        "resumeTick": {
          "type": "u64",
          "doc": "Tick at which the next goal is chosen. Simulation state.",
          "default": 0
        },
        "goals": {
          "type": "u32",
          "doc": "Goals chosen so far. Simulation state.",
          "default": 0
        }
      }
    },
    "WorldSettings": {
      "kind": "record",
      "doc": "Root world settings, kept in the manifest's single `w_` record.",
      "module": "world",
      "prefix": "w",
      "fields": {
        "cellSize": {
          "type": "f32",
          "doc": "Grid cell width and depth.",
          "default": 0,
          "unit": "m"
        }
      }
    },
    "ZoneShape": {
      "kind": "enum",
      "doc": "Reverb zone volume shape.",
      "module": "audio",
      "variants": {
        "box": {
          "doc": "Oriented box with `halfExtents`."
        },
        "sphere": {
          "doc": "Sphere with `radius`."
        }
      }
    }
  },
  "documents": {
    "animation": {
      "doc": "Animation skeletons, clips and controller graphs.",
      "schema": "ara://schema/animation/1",
      "idPrefix": "ac",
      "extension": "animation",
      "records": [
        "AnimAsset"
      ]
    },
    "foliage": {
      "doc": "Seeded scatter rules and manual foliage strokes.",
      "schema": "ara://schema/foliage/1",
      "idPrefix": "fo",
      "extension": "foliage",
      "records": [
        "FoliageHeader",
        "FoliageRule",
        "FoliageExclusion",
        "FoliagePaint"
      ]
    },
    "graph": {
      "doc": "A domain-typed graph with stable node, edge and socket identities.",
      "schema": "ara://schema/graph/1",
      "idPrefix": "gr",
      "extension": "graph",
      "records": [
        "GraphNode",
        "GraphEdge",
        "GraphHeader",
        "GraphEditor"
      ]
    },
    "import": {
      "doc": "Binary source asset identity and pure importer settings.",
      "schema": "ara://schema/import/1",
      "idPrefix": "as",
      "extension": "import.json",
      "records": [
        "ImportSettings"
      ]
    },
    "imports": {
      "doc": "Project texture import defaults, overridden by individual sources/textures.",
      "schema": "ara://schema/imports/1",
      "idPrefix": "ip",
      "extension": "imports",
      "records": [
        "ProjectImportSettings"
      ]
    },
    "l10n": {
      "doc": "One locale's messages, review provenance and explicit font fallback.",
      "schema": "ara://schema/l10n/1",
      "idPrefix": "lc",
      "extension": "l10n",
      "records": [
        "L10nLocaleConfig",
        "L10nStringEntry"
      ]
    },
    "materialinstance": {
      "doc": "A material definition reference and cheap per-object parameter overrides.",
      "schema": "ara://schema/materialinstance/1",
      "idPrefix": "mi",
      "extension": "materialinstance",
      "records": [
        "MaterialInstance"
      ],
      "singleRoot": true
    },
    "mixer": {
      "doc": "Audio mixer: bus tree, sends, ducking, voice limits, loudness targets and mix states.",
      "schema": "ara://schema/mixer/1",
      "idPrefix": "mx",
      "extension": "mixer",
      "records": [
        "AudioBus",
        "AudioMixState",
        "AudioMixerSettings"
      ]
    },
    "music": {
      "doc": "Interactive music: segments with stems and tempo maps, transitions, stingers.",
      "schema": "ara://schema/music/1",
      "idPrefix": "mu",
      "extension": "music",
      "records": [
        "MusicSegment",
        "MusicTransition",
        "MusicStinger",
        "MusicSettings"
      ]
    },
    "prefab": {
      "doc": "A reusable entity subtree with exactly one root, instantiated by reference.",
      "schema": "ara://schema/prefab/1",
      "idPrefix": "pf",
      "extension": "prefab",
      "records": [
        "Entity"
      ],
      "singleRoot": true
    },
    "project": {
      "doc": "Project metadata in ara.project.json and policy in settings/project.json.",
      "schema": "ara://schema/project/1",
      "idPrefix": "pj",
      "extension": "project.json",
      "records": [
        "ProjectSettings"
      ]
    },
    "scene": {
      "doc": "A level or sub-level: a flat map of entities.",
      "schema": "ara://schema/scene/1",
      "idPrefix": "sc",
      "extension": "scene",
      "records": [
        "Entity"
      ]
    },
    "terrain": {
      "doc": "Streamable layered heightfield manifest.",
      "schema": "ara://schema/terrain/1",
      "idPrefix": "tr",
      "extension": "terrain",
      "records": [
        "TerrainHeader",
        "TerrainLayer",
        "TerrainStroke",
        "TerrainTile"
      ]
    },
    "ui": {
      "doc": "Lossless native UI XML, edited through attributed source operations.",
      "schema": "ara://schema/ui/1",
      "idPrefix": "ui",
      "extension": "ui",
      "records": [
        "UiSource"
      ]
    },
    "world": {
      "doc": "Partitioned world manifest.",
      "schema": "ara://schema/world/1",
      "idPrefix": "wd",
      "extension": "world",
      "records": [
        "WorldSettings",
        "Layer",
        "Cell"
      ]
    }
  },
  "commands": {
    "animation.clip.set": {
      "kind": "command",
