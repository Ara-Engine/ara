    "ColliderKind": {
      "kind": "enum",
      "doc": "Primitive or cooked geometry selection. Cooked geometry is resolved by the asset worker.",
      "module": "physics",
      "variants": {
        "box": {
          "doc": "Box using half extents."
        },
        "sphere": {
          "doc": "Sphere using radius."
        },
