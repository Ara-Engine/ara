{
  "$schema": "ara://schema/reflection/1",
  "types": {
    "Animator": {
      "kind": "component",
      "doc": "Skeletal animation for this entity's `MeshRenderer.model`, compiled to an ara-anim program: an `idle` state and a `move` state whose 1D blend tree is driven by the entity's ground speed, cross-faded at `moveThreshold`.",
      "module": "animation",
      "fields": {
        "idle": {
          "type": "string",
          "doc": "Idle clip name.",
          "default": ""
        },
        "locomotion": {
          "type": "list<LocomotionClip>",
          "doc": "Moving blend samples in increasing speed order.",
          "default": []
        },
        "moveThreshold": {
          "type": "f32",
          "doc": "Ground speed separating idle from moving.",
          "default": 0.15,
          "unit": "m/s",
          "range": [0, null]
        },
        "fade": {
          "type": "f32",
          "doc": "Cross-fade duration between idle and moving.",
          "default": 0.2,
          "unit": "s",
          "range": [0, null]
        },
        "rootMotion": {
          "type": "bool",
          "doc": "Moves the entity by the extracted root motion (only without a character controller or navigation agent, which own movement).",
          "default": false
        }
      }
    },
    "Camera": {
      "kind": "component",
      "doc": "A viewpoint looking along the entity's local -Z axis. The lowest `priority` wins.",
      "module": "render",
      "fields": {
        "fov": {
          "type": "f32",
          "doc": "Vertical field of view.",
          "default": 55,
          "unit": "deg",
          "range": [1, 170]
        },
        "priority": {
          "type": "i32",
          "doc": "Selection order when several cameras exist; lower is preferred.",
          "default": 0
        }
      }
    },
    "CharacterController": {
