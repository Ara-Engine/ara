    "asset.delete": {
      "kind": "command",
      "summary": "Safely delete an authored file or folder; report every inbound reference before changing anything.",
      "params": "AssetDeleteParams",
      "hints": {
        "idempotent": false,
        "destructive": true
      },
      "scope": "edit:assets",
      "examples": [
        {
          "source": "unused/crate.prefab"
        }
      ]
    },
    "asset.duplicate": {
      "kind": "command",
      "summary": "Duplicate authored assets with new IDs and remapped internal references, with undo.",
      "params": "AssetDestinationParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:assets",
      "examples": [
        {
          "source": "props/crate.prefab",
          "destination": "props/crate-copy.prefab"
        }
      ]
    },
    "asset.import": {
      "kind": "job",
      "summary": "Import OS files/folders asynchronously with progress, cancellation, explicit conflicts and one undo step.",
      "params": "AssetImportParams",
      "hints": {
        "idempotent": false,
        "destructive": true
      },
      "scope": "edit:assets",
      "examples": [
        {
          "sources": [
            "C:/Art/crate"
          ],
          "destination": "props",
          "conflict": "rename"
        },
        {
          "sources": [
            "C:/Art/crate"
          ],
          "destination": "props",
          "dryRun": true
        }
      ]
    },
    "asset.move": {
      "kind": "command",
      "summary": "Move an authored file or folder, fixing references in the same undoable transaction.",
      "params": "AssetDestinationParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:assets",
      "examples": [
        {
          "source": "props/crate.prefab",
          "destination": "warehouse/crate.prefab"
        }
      ]
    },
    "asset.rename": {
      "kind": "command",
      "summary": "Rename an authored file or folder and repair its references, with undo.",
      "params": "AssetRenameParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:assets",
      "examples": [
        {
          "source": "props/crate.prefab",
          "name": "supply-crate.prefab"
        }
      ]
    },
    "audiograph.input.set": {
      "kind": "command",
      "summary": "Wire or set one audio graph input (or graph output) to a literal or another node.",
      "params": "AudioGraphSetInputParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "node": "filtered",
          "input": "cutoff",
          "value": 1200
        }
      ]
    },
    "audiograph.node.add": {
      "kind": "command",
      "summary": "Add an operation node to an audio graph.",
      "params": "AudioGraphAddParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "name": "filtered",
          "op": "lowpass",
          "args": {
            "in": "osc",
            "cutoff": 800
          }
        }
      ]
    },
    "audiograph.node.remove": {
      "kind": "command",
      "summary": "Remove an audio graph node or parameter and every reference to it.",
      "params": "AudioGraphRemoveParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "name": "filtered"
        }
      ]
    },
    "audiograph.param.set": {
      "kind": "command",
      "summary": "Edit an audio graph parameter's default, range or documentation.",
      "params": "AudioGraphParamParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "name": "pitch",
          "default": 220,
          "range": [20, 2000]
        }
      ]
    },
    "audiograph.rename": {
      "kind": "command",
      "summary": "Rename an audio graph parameter or node without changing its identity.",
      "params": "AudioGraphRenameParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "from": "osc",
          "to": "tone"
        }
      ]
    },
    "audiograph.text.apply": {
      "kind": "command",
      "summary": "Replace an audio graph with edited .audiograph text (names keep their IDs).",
      "params": "AudioGraphTextParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "text": "graph Tone { param pitch = 440; let osc = sine(pitch); output out = osc; }"
        }
      ]
    },
    "behavior.rename": {
      "kind": "command",
      "summary": "Rename a state, variable or query, keeping its identity and rewriting references.",
      "params": "BehaviorRenameParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "from": "Idle",
          "to": "Rest"
        }
      ]
    },
    "behavior.state.add": {
      "kind": "command",
      "summary": "Add an empty state at the top level or under a parent.",
      "params": "BehaviorStateAddParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "name": "Search",
          "parent": "Alert",
          "when": "known(target)"
        }
      ]
    },
    "behavior.state.remove": {
      "kind": "command",
      "summary": "Remove a state with its children and every transition into them.",
      "params": "BehaviorStateRemoveParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "name": "Search"
        }
      ]
    },
    "behavior.text.apply": {
      "kind": "command",
      "summary": "Apply behaviour text as undoable graph ops, keeping IDs of unchanged names.",
      "params": "BehaviorTextParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "text": "behavior Guard { state Idle { do wait(1); } }"
        }
      ]
    },
    "behavior.transition.add": {
      "kind": "command",
      "summary": "Add `on <when> -> <to>` to a state.",
      "params": "BehaviorTransitionParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "from": "Patrol",
          "to": "Chase",
          "when": "sees(nearest(\"player\"))"
        }
      ]
    },
    "behavior.var.set": {
      "kind": "command",
      "summary": "Set or clear a variable's default value expression.",
      "params": "BehaviorVarParams",
      "hints": {
        "idempotent": false,
        "destructive": false
      },
      "scope": "edit:scene",
      "examples": [
        {
          "name": "alert",
          "default": "0.5"
        }
      ]
    },
    "build_profile.create": {
      "kind": "command",
      "summary": "Create a portable export profile with reversible file history.",
