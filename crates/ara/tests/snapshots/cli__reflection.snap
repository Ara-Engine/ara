          "unit": "m",
          "range": [0, null]
        },
        "stickDown": {
          "type": "f32",
          "doc": "Distance searched below feet to stay on a descending surface.",
          "default": 0.5,
          "unit": "m",
          "range": [0, null]
        },
        "padding": {
          "type": "f32",
          "doc": "Capsule collision padding.",
