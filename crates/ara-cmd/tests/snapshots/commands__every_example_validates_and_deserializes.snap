---
source: crates/ara-cmd/tests/commands.rs
expression: "ara_json::to_canonical_string(&reg.catalog())"
---
{
  "asset.delete": {
    "kind": "command",
    "summary": "Safely delete an authored file or folder; report every inbound reference before changing anything.",
    "params": "AssetDeleteParams",
    "hints": {
      "idempotent": false,
      "destructive": true
    },
    "scope": "edit:assets",
    "examples": [
      {
        "source": "unused/crate.prefab"
      }
    ]
  },
  "asset.duplicate": {
    "kind": "command",
    "summary": "Duplicate authored assets with new IDs and remapped internal references, with undo.",
    "params": "AssetDestinationParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:assets",
    "examples": [
      {
        "source": "props/crate.prefab",
        "destination": "props/crate-copy.prefab"
      }
    ]
  },
  "asset.import": {
    "kind": "job",
    "summary": "Import OS files/folders asynchronously with progress, cancellation, explicit conflicts and one undo step.",
    "params": "AssetImportParams",
    "hints": {
      "idempotent": false,
      "destructive": true
    },
    "scope": "edit:assets",
    "examples": [
      {
        "sources": [
          "C:/Art/crate"
        ],
        "destination": "props",
        "conflict": "rename"
      },
      {
        "sources": [
          "C:/Art/crate"
        ],
        "destination": "props",
        "dryRun": true
      }
    ]
  },
  "asset.move": {
    "kind": "command",
    "summary": "Move an authored file or folder, fixing references in the same undoable transaction.",
    "params": "AssetDestinationParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:assets",
    "examples": [
      {
        "source": "props/crate.prefab",
        "destination": "warehouse/crate.prefab"
      }
    ]
  },
  "asset.rename": {
    "kind": "command",
    "summary": "Rename an authored file or folder and repair its references, with undo.",
    "params": "AssetRenameParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:assets",
    "examples": [
      {
        "source": "props/crate.prefab",
        "name": "supply-crate.prefab"
      }
    ]
  },
  "build_profile.create": {
    "kind": "command",
    "summary": "Create a portable export profile with reversible file history.",
    "params": "BuildProfileCreateParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:assets",
    "examples": [
      {
        "name": "windows",
        "preset": {
          "platform": "windows",
          "config": "dev",
          "lane": "nativeAot",
          "playerTemplate": "runtime",
          "assembly": "Game",
          "content": "content",
          "templates": []
        }
      }
    ]
  },
  "component.add": {
    "kind": "command",
    "summary": "Add a component to an entity, with optional initial values.",
    "params": "ComponentAddParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "entity": "e_8b21",
        "component": "Transform",
        "value": {
          "position": [0, 1, 0]
        }
      }
    ]
  },
  "component.remove": {
    "kind": "command",
    "summary": "Remove a component from an entity (for prefab entities, from this instance only).",
    "params": "ComponentRemoveParams",
    "hints": {
      "idempotent": false,
      "destructive": true
    },
    "scope": "edit:scene",
    "examples": [
      {
        "entity": "e_8b21",
        "component": "Transform"
      }
    ]
  },
  "doc.create": {
    "kind": "command",
    "summary": "Create a canonical empty scene, prefab or other registered document.",
    "params": "DocCreateParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "path": "levels/arena.scene",
        "id": "sc_arena001"
      }
    ]
  },
  "doc.delete": {
    "kind": "command",
    "summary": "Delete a loaded document and its records with history and undo.",
    "params": "DocDeleteParams",
    "hints": {
      "idempotent": false,
      "destructive": true
    },
    "scope": "edit:scene",
    "examples": [
      {
        "document": "@levels/old.scene#sc_old001"
      }
    ]
  },
  "entity.create": {
    "kind": "command",
    "summary": "Create an entity, optionally with a parent, a position among its siblings and components.",
    "params": "EntityCreateParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "id": "$crate",
        "name": "Crate",
        "components": {
          "Transform": {
            "position": [2, 0, 3]
          }
        }
      },
      {
        "name": "Lid",
        "parent": "$crate",
        "index": 0
      }
    ]
  },
  "entity.delete": {
    "kind": "command",
    "summary": "Delete entities and their descendants (prefab entities are removed from their instance).",
    "params": "EntityDeleteParams",
    "hints": {
      "idempotent": false,
      "destructive": true
    },
    "scope": "edit:scene",
    "examples": [
      {
        "entities": [
          "e_8b21"
        ]
      }
    ]
  },
  "entity.inspect": {
    "kind": "query",
    "summary": "Show an entity's name, parent and components with prefab overrides applied.",
    "params": "EntityInspectParams",
    "hints": {
      "idempotent": true,
      "destructive": false
    },
    "scope": "read",
    "examples": [
      {
        "entity": "e_4f9a/e_m4tz"
      }
    ]
  },
  "entity.reparent": {
    "kind": "command",
    "summary": "Move an entity under a new parent (or to the root) at a position among its siblings.",
    "params": "EntityReparentParams",
    "hints": {
      "idempotent": true,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "entity": "e_8b21",
        "parent": "e_1c0d",
        "index": 0
      },
      {
        "entity": "e_8b21"
      }
    ]
  },
  "folder.create": {
    "kind": "command",
    "summary": "Create an authored folder, optionally adding missing parents, in one undoable transaction.",
    "params": "FolderCreateParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:assets",
    "examples": [
      {
        "path": "props/warehouse",
        "parents": true
      }
    ]
  },
  "prefab.apply": {
    "kind": "command",
    "summary": "Apply overrides and removals to a chosen prefab source in one undoable transaction.",
    "params": "PrefabApplyParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "entity": "e_4f9a"
      }
    ]
  },
  "prefab.create": {
    "kind": "command",
    "summary": "Create a prefab asset and replace its source subtree in one undoable transaction.",
    "params": "PrefabCreateParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "entity": "e_8b21",
        "path": "prefabs/crate.prefab"
      }
    ]
  },
  "prefab.instantiate": {
    "kind": "command",
    "summary": "Place an instance of a prefab; its content stays linked to the prefab.",
    "params": "PrefabInstantiateParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "prefab": "@prefabs/crate.prefab",
        "id": "$crate",
        "position": [0, 0, 4]
      }
    ]
  },
  "prefab.override.revert": {
    "kind": "command",
    "summary": "Revert overrides of a prefab instance back to the prefab's values.",
    "params": "OverrideRevertParams",
    "hints": {
      "idempotent": true,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "entity": "e_4f9a/e_m4tz",
        "path": "MeshRenderer.tint"
      },
      {
        "entity": "e_4f9a"
      }
    ]
  },
  "prefab.override.set": {
    "kind": "command",
    "summary": "Override a value of a prefab instance (or of an entity inside it).",
    "params": "OverrideSetParams",
    "hints": {
      "idempotent": true,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "entity": "e_4f9a/e_m4tz",
        "path": "MeshRenderer.tint",
        "value": [1, 0, 0, 1]
      }
    ]
  },
  "prefab.variant": {
    "kind": "command",
    "summary": "Create a linked prefab variant while preserving base inheritance and instance placement.",
    "params": "PrefabCreateParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "entity": "e_4f9a",
        "path": "prefabs/crate-red.prefab"
      }
    ]
  },
  "project.migrate": {
    "kind": "command",
    "summary": "Apply an explicitly reviewed project-layout migration as one reversible transaction.",
    "params": "ProjectMigrateParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:assets",
    "examples": [
      {
        "planToken": "reviewed-inventory-token"
      }
    ]
  },
  "project.setMain": {
    "kind": "command",
    "summary": "Set ara.project.json's startup scene with history and undo.",
    "params": "ProjectSetMainParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "scene": "@levels/arena.scene#sc_arena001"
      }
    ]
  },
  "property.set": {
    "kind": "command",
    "summary": "Set one field of an entity (its name or a component field).",
    "params": "PropertySetParams",
    "hints": {
      "idempotent": true,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "entity": "e_8b21",
        "path": "Transform.position.y",
        "value": 2
      },
      {
        "entity": "e_8b21",
        "path": "name",
        "value": "Crate"
      }
    ]
  },
  "source.replace": {
    "kind": "command",
    "summary": "Create, replace or relocate C# source at its checked base hash, with offline undo and redo.",
    "params": "SourceReplaceParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "path": "scripts/Game/Door.cs",
        "baseHash": "9160d4be34c8695bd172a76c7c7966587ea5a4d991ad22c87b2b91af54aa9ebb",
        "text": "after\n"
      }
    ]
  },
  "test.spawnRow": {
    "kind": "job",
    "summary": "Create a row of entities.",
    "params": "SpawnRowParams",
    "hints": {
      "idempotent": false,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "count": 2
      }
    ]
  },
  "transform.lookAt": {
    "kind": "command",
    "summary": "Aim local -Z at a world point or entity with a preferred world up vector.",
    "params": "TransformLookAtParams",
    "hints": {
      "idempotent": true,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "entity": "e_camera",
        "point": [0, 1, 0],
        "up": [0, 1, 0]
      }
    ]
  },
  "transform.set": {
    "kind": "command",
    "summary": "Set the local position, rotation and/or scale of entities.",
    "params": "TransformSetParams",
    "hints": {
      "idempotent": true,
      "destructive": false
    },
    "scope": "edit:scene",
    "examples": [
      {
        "entities": [
          "e_8b21"
