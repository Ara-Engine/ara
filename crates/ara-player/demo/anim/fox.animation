{
  "$schema": "ara://schema/animation/1",
  "id": "ac_foxanim1",
  "records": {
    "an_fox": {
      "name": "Fox locomotion",
      "controller": {
        "parameters": {
          "speed": {}
        },
        "nodes": {
          "idle": {
            "clip": "@anim/fox.animation#an_survey"
          },
          "move": {
            "kind": "blend1d",
            "parameterX": "speed",
            "samples": [
              {
                "node": "walk",
                "x": 1.4
              },
              {
                "node": "run",
                "x": 4.5
              }
            ]
          },
          "run": {
            "clip": "@anim/fox.animation#an_run"
          },
          "walk": {
            "clip": "@anim/fox.animation#an_walk"
          }
        },
        "states": {
          "idle": {
            "node": "idle"
          },
          "move": {
            "node": "move",
            "duration": 44800
          }
        },
        "transitions": [
          {
            "id": "start",
            "from": "idle",
            "to": "move",
            "duration": 9600,
            "conditions": [
              {
                "parameter": "speed",
                "comparison": "greater",
                "floatValue": 0.15
              }
            ]
          },
          {
            "id": "stop",
            "from": "move",
            "to": "idle",
            "duration": 9600,
            "conditions": [
              {
                "parameter": "speed",
                "comparison": "less",
                "floatValue": 0.075
              }
            ]
          }
        ],
        "initial": "idle"
      }
    },
    "an_foxmatch": {
      "name": "Fox motion matching",
      "controller": {
        "parameters": {
          "feature00": {},
          "feature01": {},
          "feature02": {},
          "feature03": {},
          "feature04": {},
          "feature05": {},
          "feature06": {},
          "feature07": {},
          "feature08": {},
          "feature09": {},
          "feature10": {},
          "feature11": {},
          "feature12": {},
          "feature13": {},
          "feature14": {},
          "feature15": {},
          "feature16": {},
          "feature17": {},
          "feature18": {},
          "feature19": {},
          "feature20": {},
          "feature21": {},
          "feature22": {},
          "feature23": {},
          "feature24": {},
          "feature25": {},
          "feature26": {},
          "feature27": {},
          "feature28": {},
          "feature29": {},
          "feature30": {},
          "feature31": {},
          "feature32": {},
          "feature33": {},
          "feature34": {},
          "feature35": {},
          "feature36": {},
          "feature37": {},
          "feature38": {},
          "speed": {}
        },
        "nodes": {
          "idle": {
            "clip": "@anim/fox.animation#an_survey"
          },
          "locomotion": {
            "kind": "motionMatching",
            "clip": "@anim/fox.animation#an_foxmatch",
            "matching": {
              "query": [
                "feature00",
                "feature01",
                "feature02",
                "feature03",
                "feature04",
                "feature05",
                "feature06",
                "feature07",
                "feature08",
                "feature09",
                "feature10",
                "feature11",
                "feature12",
                "feature13",
                "feature14",
                "feature15",
                "feature16",
                "feature17",
                "feature18",
                "feature19",
                "feature20",
                "feature21",
                "feature22",
                "feature23",
                "feature24",
                "feature25",
                "feature26",
                "feature27",
                "feature28",
                "feature29",
                "feature30",
                "feature31",
                "feature32",
                "feature33",
                "feature34",
                "feature35",
                "feature36",
                "feature37",
                "feature38"
              ]
            }
          }
        },
        "states": {
          "idle": {
            "node": "idle"
          },
          "move": {
            "node": "locomotion"
          }
        },
        "transitions": [
          {
            "id": "start",
            "from": "idle",
            "to": "move",
            "duration": 9600,
            "conditions": [
              {
                "parameter": "speed",
                "comparison": "greater",
                "floatValue": 0.15
              }
            ]
          },
          {
            "id": "stop",
            "from": "move",
            "to": "idle",
            "duration": 9600,
            "conditions": [
              {
                "parameter": "speed",
                "comparison": "less",
                "floatValue": 0.075
              }
            ]
          }
        ],
        "initial": "idle"
      },
      "motionDatabase": {
        "clips": [
          "@anim/fox.animation#an_walk",
          "@anim/fox.animation#an_run"
        ],
        "bones": [
          "node21",
          "node25",
          "node11",
          "node14"
        ],
        "horizons": [9600, 19200]
      }
    },
    "an_run": {
      "name": "Run"
    },
    "an_survey": {
      "name": "Survey"
    },
    "an_walk": {
