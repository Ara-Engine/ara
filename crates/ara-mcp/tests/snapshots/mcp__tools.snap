  {
    "name": "ara_logs",
    "title": "Read diagnostics",
    "description": "Diagnostics from every subsystem (stable ARA codes, locations, machine-applicable fixes), grouped by code with counts, the subjects involved and the best fix, within a `budget` of characters. Pass the returned `cursor` as `since` to see only what is new; filter by `codes`, `severity`, `subjects` (`entity:e_8b21`, `asset:@meshes/crate.glb`) or `origin`; `group: false` lists entries one by one. To understand one, use ara_why.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "description": "Session handle from `session.begin`."
        },
        "since": {
          "description": "Only entries new or repeated after this cursor (`cursor` of a previous call).",
          "type": "integer"
        },
        "codes": {
          "description": "Only these codes (`ARA1302`, `ARA-EXP-AND-007`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "severity": {
          "description": "Minimum severity (default `info`).",
          "$ref": "#/$defs/SeverityParam"
        },
        "entity": {
          "description": "Only entries about this entity (record ID or address prefix).",
          "type": "string"
        },
        "subjects": {
          "description": "Only entries about these subjects (`entity:e_8b21`, `asset:@meshes/crate.glb`, `system:physics.step`, `pass:gbuffer`, `module:Gameplay`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "origin": {
          "description": "Only entries caused by `engine`, `human`, `agent` or `agent:<name>`.",
          "type": "string"
        },
        "text": {
          "description": "Only entries whose message contains this text.",
          "type": "string"
        },
        "group": {
          "description": "Group entries by code with counts, subjects and the best fix (default true); `false` lists them one by one.",
          "type": "boolean"
        },
        "budget": {
          "description": "Approximate size of the text answer in characters (default 2000).",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "limit": {
          "description": "Maximum entries in `entries`, newest kept (default 10 grouped, 50 not).",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "session"
      ],
      "additionalProperties": false,
      "$defs": {
        "SeverityParam": {
          "description": "A diagnostic severity.",
          "type": "string",
          "oneOf": [
            {
              "const": "error",
              "description": "Errors only."
            },
            {
              "const": "warning",
              "description": "Warnings and errors."
            },
            {
              "const": "info",
              "description": "Everything."
            }
          ]
        }
      }
    },
    "annotations": {
      "title": "Read diagnostics",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "ara_why",
    "title": "Explain a problem",
    "description": "Explain why something is wrong, in one call: an entity and its symptom (`name:Crate not visible`), a diagnostic code (`ARA1302`), an asset (`@materials/crate.material`) or a topic (`did reload fall back to L3`, `is the frame slow`). Returns a short ranked list of likely causes, each with its evidence and runnable fixes (commands to pass to ara_apply as is), plus what was checked and ruled out. Use it before inspecting by hand. `list: true` shows what it can explain.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "description": "Session handle from `session.begin`."
        },
        "question": {
          "description": "What to explain: an entity and symptom (`name:Crate not visible`), a code (`ARA1302`), an asset (`@meshes/crate.glb`) or a topic (`did reload fall back to L3`, `is the frame slow`).",
          "type": "string"
        },
        "doc": {
          "description": "Document for entity selectors (default: the one holding the entity, else the main scene).",
          "type": "string"
        },
        "list": {
          "description": "List the explainers and example questions instead of answering.",
          "type": "boolean"
        }
      },
      "required": [
        "session"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Explain a problem",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "ara_session",
    "title": "Session, history and review",
    "description": "Sessions, history and review. `action: \"begin\"` with your `client` name returns the `session` handle the other tools take, the scopes granted and the project's documents (over `ara mcp` a session also begins by itself on first use). Then: `status`, `diff` (what you changed, was → now), `checkpoint`, `rollback` (undo back to a checkpoint), `history`, `undo`, `redo`, `review` (unreviewed changes), `revert` (per transaction or entity, also another agent's), `end`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "begin",
            "status",
            "diff",
            "checkpoint",
            "rollback",
            "end",
            "history",
            "undo",
            "redo",
            "review",
            "revert"
          ],
          "description": "What to do. `begin`: Begin a session: returns the handle every other call takes, and the scopes granted. `status`: The session's scopes, turns, unreviewed changes, checkpoints and unsaved documents. `diff`: What the session changed since a checkpoint, per entity, with was → now per field. `checkpoint`: Mark the current revision to roll back to. Agent turns get one automatically. `rollback`: Undo every transaction of this session after a checkpoint, all or nothing. `end`: End the session; its handle stops working. `history`: Transactions newest first: author, why, revision, review status and touched entities. `undo`: Undo the author's latest transaction, or a given one, as a new transaction. `redo`: Redo the author's most recently undone transaction. `review`: Agent transactions by review status (default: unreviewed), with per-entity status. `revert`: Revert agent changes per transaction or per entity (inverse ops, conflict-checked)."
        },
        "client": {
          "type": "string",
          "description": "Who is connecting: `claude-code`, `codex`, `editor`, `ara-cli`. (for: begin)"
        },
        "author": {
          "type": "string",
          "description": "Transaction author: `human` or `agent:<name>`. Defaults to `agent:<client>`. / Only this author (`human`, `agent:claude`). (for: begin, history)"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Scopes to request: `read`, `edit:scene`, `edit:assets`, `edit:code`, `play`, `run`, `import`, `bake`, `build`, `generate:$`, `fs:outside-project`, `net`. Defaults to everything the approval policy allows. The policy may grant fewer. (for: begin)"
        },
        "label": {
          "type": "string",
          "description": "Short description of the work, shown in review. / What the checkpoint marks. (for: begin, checkpoint)"
        },
        "session": {
          "type": "string",
          "description": "Session handle from `session.begin`. (not for: begin)"
        },
        "checkpoint": {
          "type": "string",
          "description": "Show changes since this checkpoint (`cp_...`); default: the session's start. (for: diff)"
        },
        "to": {
          "type": "string",
          "description": "Checkpoint (`cp_...`) to return to. Every later transaction of this session is undone, all or nothing. Agent sessions get one checkpoint per turn. (for: rollback)"
        },
        "doc": {
          "type": "string",
          "description": "Only transactions touching this document. (for: history)"
        },
        "since": {
          "type": "integer",
          "description": "Only transactions after this revision. (for: history)"
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Maximum transactions, newest first (default 20). / Maximum transactions, newest first (default 50). (for: history, review)"
        },
        "txn": {
          "type": "string",
          "description": "Transaction to undo (`tx_...`); default: the session author's latest. / Transaction (`tx_...`). With `entity`, only that entity's changes in it. (for: undo, revert)"
        },
        "status": {
          "$ref": "#/$defs/ReviewStatus",
          "description": "Only transactions with this status (default: `applied`). (for: review)"
        },
        "entity": {
          "type": "string",
          "description": "Entity (`e_8b21`, or `sc_arena001/e_8b21` to name the document). Without `txn`: its changes in every unreviewed transaction. (for: revert)"
        },
        "all": {
          "type": "boolean",
          "description": "Every unreviewed transaction. (for: revert)"
        }
      },
      "required": [
        "action"
      ],
      "$defs": {
        "ReviewStatus": {
          "description": "Review state of a transaction or entity.",
          "type": "string",
          "oneOf": [
            {
              "const": "applied",
              "description": "Applied live, not reviewed yet."
            },
            {
              "const": "accepted",
              "description": "Kept by a reviewer."
            },
            {
              "const": "reverted",
              "description": "Undone."
            }
          ]
        }
      }
    },
    "annotations": {
      "title": "Session, history and review",
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "ara_docs",
    "title": "Search the docs",
    "description": "Search this engine version's generated docs: conventions (axes, units, IDs, references), commands, components and error codes. The same pages as llms.txt.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Words to look for (`prefab override`)."
        },
        "session": {
          "type": "string",
          "description": "Session handle from `session.begin`."
        },
        "limit": {
          "description": "Maximum results (default 5).",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "full": {
          "description": "Return each page's full markdown, not just a snippet.",
          "type": "boolean"
        }
      },
      "required": [
        "query",
        "session"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Search the docs",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "ara_jobs",
    "title": "Jobs",
    "description": "Long-running work (import, bake, build, generate): `start` a job on a document, then `status` (progress, result), `list` or `cancel`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "status",
            "start",
            "cancel"
          ],
          "description": "What to do. `list`: Every job of this host run with status and progress. `status`: One job's status, progress, result or diagnostics. `start`: Start a registered job on a document; progress streams on the `jobs` topic. `cancel`: Cancel a running job."
        },
        "session": {
          "type": "string",
          "description": "Session handle from `session.begin`."
        },
        "job": {
          "type": "string",
          "description": "Job ID (`jb_...`). / Job name from the registry (`schema.list {kind: \"job\"}`). (not for: list)"
        },
        "doc": {
          "type": "string",
          "description": "Document the job works on. (for: start)"
        },
        "args": {
          "description": "Job arguments, per its params schema. (for: start)"
        },
        "why": {
          "type": "string",
          "description": "Why, shown in review. (for: start)"
        }
      },
      "required": [
        "action",
        "session"
      ]
    },
    "annotations": {
      "title": "Jobs",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  }
]
