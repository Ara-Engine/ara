---
source: crates/ara-mcp/tests/mcp.rs
expression: pretty
---
[
  {
    "name": "ara_query",
    "title": "Query entities",
    "description": "Find entities (or documents) without dumping scenes. Compact syntax in `q`: space-separated terms that must all hold: `Light` (has the component), `!Light`, `name:Crate*`, a bare word (`radio`: names containing it), `parent:e_1c0d`, `under:e_1c0d`, `prefab:crate`, `depth<=1`, comparisons such as `Light.intensity>500` or `Transform.position.y<=0`. Or the JSON form in `filter`. Paginated (`limit`, `cursor`); returns entity handles (`e_8b21`; `e_4f9a/e_m4tz` inside prefab instances) with one scene-to-text line each. `fields` returns chosen values.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "description": "Session handle from `session.begin`."
        },
        "q": {
          "description": "Compact query: space-separated terms that must all hold. `Light` (has the component), `!Light` (lacks it), `name:Crate*`, a bare word (`radio`: names containing it), `parent:e_1c0d`, `under:e_1c0d`, `prefab:crate`, `depth<=1`, `e_8b21` (an ID), field comparisons such as `Light.intensity>500`, `Light.kind=spot`, `Transform.position.y<=0`.",
          "type": "string"
        },
        "filter": {
          "description": "The same conditions as JSON; combined with `q`.",
          "$ref": "#/$defs/Filter"
        },
        "doc": {
          "description": "Document (asset ID, path or `@path#id`); default: every scene and prefab.",
          "type": "string"
        },
        "kind": {
          "description": "Search entities (default) or documents.",
          "$ref": "#/$defs/QueryKind"
        },
        "fields": {
          "description": "Field paths to return per entity (`Light.intensity`), effective values.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detail": {
          "description": "Per-item detail: `summary` (default), `handles` or `full`.",
          "$ref": "#/$defs/Detail"
        },
        "limit": {
          "description": "Page size (default 50, max 500).",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "cursor": {
          "description": "`next` from the previous page.",
          "type": "string"
        }
      },
      "required": [
        "session"
      ],
      "additionalProperties": false,
      "$defs": {
        "Compare": {
          "description": "A field comparison in a query filter.",
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Field path on the entity (`Light.intensity`, `Transform.position.y`, `name`).",
              "default": ""
            },
            "op": {
              "$ref": "#/$defs/CompareOp",
              "description": "Comparison operator.",
              "default": "eq"
            },
            "value": {
              "description": "Value to compare the effective (default-filled) field value with.",
              "default": null
            }
          },
          "additionalProperties": false
        },
        "CompareOp": {
          "description": "A comparison operator.",
          "type": "string",
          "oneOf": [
            {
              "const": "eq",
              "description": "Equal (numbers compare numerically)."
            },
            {
              "const": "ne",
              "description": "Not equal."
            },
            {
              "const": "gt",
              "description": "Greater than."
            },
            {
              "const": "ge",
              "description": "Greater than or equal."
            },
            {
              "const": "lt",
              "description": "Less than."
            },
            {
              "const": "le",
              "description": "Less than or equal."
            }
          ]
        },
        "Detail": {
          "description": "What a query returns per item.",
          "type": "string",
          "oneOf": [
            {
              "const": "summary",
              "description": "Address, name, components and position (the default)."
            },
            {
              "const": "handles",
              "description": "Only handles."
            },
            {
              "const": "full",
              "description": "Everything stored on the entity."
            }
          ]
        },
        "Filter": {
          "description": "The JSON form of a query: every set condition must hold. The compact `q` syntax parses into this.",
          "type": "object",
          "properties": {
            "has": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Components the entity must have (`[\"Light\"]`).",
              "default": []
            },
            "lacks": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Components the entity must not have.",
              "default": []
            },
            "name": {
              "description": "Name glob, case-insensitive (`Crate*`).",
              "type": "string"
            },
            "parent": {
              "description": "Only direct children of this entity.",
              "type": "string"
            },
            "under": {
              "description": "Only descendants of this entity.",
              "type": "string"
            },
            "prefab": {
              "description": "Only prefab instances whose prefab path contains this text.",
              "type": "string"
            },
            "maxDepth": {
              "description": "Only entities at most this deep (roots are depth 0).",
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Only these entity IDs or addresses.",
              "default": []
            },
            "where": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Compare"
              },
              "description": "Field comparisons.",
              "default": []
            }
          },
          "additionalProperties": false
        },
        "QueryKind": {
          "description": "What `query` searches.",
          "type": "string",
          "oneOf": [
            {
              "const": "entities",
              "description": "Entities (prefab instances expanded)."
            },
            {
              "const": "documents",
              "description": "Documents and imported assets of the project."
            }
          ]
        }
      }
    },
    "annotations": {
      "title": "Query entities",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "ara_inspect",
    "title": "Inspect a document",
    "description": "Read a document as token-tuned text: the hierarchy summary (default; `depth`, paginated with `cursor`), or with `entities` every component field with its unit (defaults filled in). `format: \"json\"` for structured output. Y-up, meters, degrees.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "doc": {
          "description": "Document: a path (`levels/outpost.scene`, or just `outpost`), asset ID or `@path#id`. Default: the document holding `entities`, else the project's main scene.",
          "type": "string"
        },
        "session": {
          "type": "string",
          "description": "Session handle from `session.begin`."
        },
        "entities": {
          "description": "Entities to show in full: IDs, addresses (`e_4f9a/e_m4tz`) or name selectors (`name:Crate`, `name:Gate/DoorLamp`). Absent: a summary of the document's hierarchy.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depth": {
          "description": "Hierarchy depth of the summary (default 2).",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "format": {
          "description": "`text` (default) or `json`.",
          "$ref": "#/$defs/Format"
        },
        "limit": {
          "description": "Summary page size (default 100).",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "cursor": {
          "description": "`next` from the previous summary page.",
          "type": "string"
        }
      },
      "required": [
        "session"
      ],
      "additionalProperties": false,
      "$defs": {
        "Format": {
          "description": "Output format of `inspect`.",
          "type": "string",
          "oneOf": [
            {
              "const": "text",
              "description": "Token-tuned text (the default)."
            },
            {
              "const": "json",
              "description": "Structured JSON."
            }
          ]
        }
      }
    },
    "annotations": {
      "title": "Inspect a document",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "ara_schema",
    "title": "Search the schema",
    "description": "The tool-search layer: find and describe components, value types, enums, commands, queries, jobs and protocol methods. `search` by words, `list` by kind, `describe` for JSON Schemas, units and examples. Look a command up here before using it in ara_apply.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "describe",
            "search"
          ],
          "description": "What to do. `list`: List components, types, commands, queries, jobs and methods (names and one-line summaries). `describe`: Full description of types, commands or methods, with JSON Schemas and examples. `search`: Search components, fields, commands and methods by words in their names and docs."
        },
        "session": {
          "type": "string",
          "description": "Session handle from `session.begin`."
        },
        "kind": {
          "$ref": "#/$defs/SchemaKind",
          "description": "Only this kind of entry. (not for: describe)"
        },
        "module": {
          "type": "string",
          "description": "Only types of this module (`core`, `render`). (for: list)"
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Type, command or method names (`Transform`, `entity.create`, `cmd.apply`). (for: describe)"
        },
        "name": {
          "type": "string",
          "description": "One name; the same as `names: [name]`. (for: describe)"
        },
        "query": {
          "type": "string",
          "description": "Words to look for in names and docs (`light intensity`). (for: search)"
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Maximum results (default 10). (for: search)"
        }
      },
      "required": [
        "action",
        "session"
      ],
      "$defs": {
        "SchemaKind": {
          "description": "What `schema.list` and `schema.search` look through.",
          "type": "string",
          "oneOf": [
            {
              "const": "component",
              "description": "Entity components."
            },
            {
              "const": "record",
              "description": "Document record types."
            },
            {
              "const": "struct",
              "description": "Value structs nested in components."
            },
            {
              "const": "enum",
              "description": "Enums."
            },
            {
              "const": "params",
              "description": "Command params types."
            },
            {
              "const": "command",
              "description": "Commands (edits)."
            },
            {
              "const": "query",
              "description": "Queries (reads)."
            },
            {
              "const": "job",
              "description": "Jobs (long-running work)."
            },
            {
              "const": "method",
              "description": "Engine Protocol methods."
            }
          ]
        }
      }
    },
    "annotations": {
      "title": "Search the schema",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "ara_apply",
    "title": "Apply commands",
    "description": "Change documents. Runs `commands` (each `{cmd, args, as?}`; the commands and their args are listed under `cmd`) in order as one atomic transaction on `doc` (default: the document holding the entities you name, else the main scene), recorded with your `why` (required) for human review; any error rolls everything back and returns located diagnostics with machine-applicable fixes. Entities: IDs (`e_8b21`, `e_4f9a/e_m4tz` inside a prefab instance), `$name` symbols minted by `as` in an earlier call, or `name:Crate` / `name:Floor/Crate`. The result lists every created, modified and deleted entity with its ID. `dryRun: true` returns the exact diff without applying. Each call is one turn with a checkpoint you can roll back to (ara_session).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CallSpec"
          },
          "description": "Calls, run in order as one atomic transaction."
        },
        "doc": {
          "description": "Document to edit: a path (`levels/outpost.scene`, or just `outpost`), asset ID or `@path#id`. Default: the one document holding every entity the commands address, else the project's main scene.",
          "type": "string"
        },
        "session": {
          "type": "string",
          "description": "Session handle from `session.begin`."
        },
        "why": {
          "description": "Why, in a sentence; shown in review next to the change. Required for agent sessions (except dry runs).",
          "type": "string"
        },
        "dryRun": {
          "description": "Validate and return the diff without applying anything.",
          "type": "boolean"
        },
        "base": {
          "description": "Revision the batch was planned against; fails if later edits touched the same fields.",
          "type": "integer"
        },
        "idempotencyKey": {
          "description": "Retrying with the same key returns the first result instead of applying twice.",
          "type": "string"
        }
      },
      "required": [
        "commands",
        "session"
      ],
      "additionalProperties": false,
      "$defs": {
        "CallSpec": {
          "description": "One call in an `ara_apply` / `cmd.apply` batch.",
          "type": "object",
          "properties": {
            "cmd": {
              "type": "string",
              "description": "Command name (`entity.create`); find them with `schema.search`.",
              "default": ""
            },
            "args": {
              "description": "Command arguments, per the command's params schema (`schema.describe`)."
            },
            "as": {
              "description": "Symbolic ID (`$crate`; the `$` may be left out) for the record this call creates; later calls may use it as `$crate` anywhere an entity is expected. The result maps it to the real ID. Asset args may skip the `@`. Entity args also take IDs (`e_8b21`) and name selectors (`name:Crate`, `name:Floor/Crate`).",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "annotations": {
      "title": "Apply commands",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "ara_run",
    "title": "Run code",
    "description": "Run C# against the typed engine SDK inside a transaction (code mode). Edits still become commands, so they stay reviewable and revertible. Not available in this engine build yet: calls return diagnostic ARA1806 until a service provides it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "description": "Session handle from ara_session `begin`."
        }
      },
      "required": [
        "session"
      ]
    },
    "annotations": {
      "title": "Run code",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "ara_capture",
