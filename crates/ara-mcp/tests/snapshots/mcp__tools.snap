  {
    "name": "ara_play",
    "title": "Control play",
    "description": "Control play worlds: start, stop, pause, step N ticks with action-level input, watch expressions, `until` conditions, record and replay. Not available in this engine build yet: calls return diagnostic ARA1806 until a service provides it.",
    "inputSchema": {
      "type": "object",
