  {
    "name": "ara_test",
    "title": "Run tests",
    "description": "Run unit, play and golden tests; structured results with captures and replay handles for failures. Not available in this engine build yet: calls return diagnostic ARA1806 until a service provides it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "description": "Session handle from ara_session `begin`."
        }
      },
      "required": [
        "session"
      ]
    },
    "annotations": {
      "title": "Run tests",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
