// Participating media along the path-traced reference's camera-visible path segments
// (transport.slang referenceMain): the raster look's fog model (fog.slang; ara-render's
// look-fog.slangh), integrated per pixel instead of on a froxel grid, so the reference
// shows beams, cone edges and shadow shafts at full resolution. Each path sample marches
// MEDIUM_STEPS jittered strata (dense near the camera, as the froxel slices), tracing
// the sun's shadow in each and one phase-weighted ambient ray in a random one, and takes
// one equiangular distance per local light (Kulla and Fajardo 2012) with an area sample
// on the light and its shadow ray. Single scattering from the sun and local lights; the
// ambient ray sees the sky, or a surface's emission and direct light (one bounce).
// Include after common.slangh.
static const uint MEDIUM_STEPS=12;
// How far sky rays meet height fog without the physical sky (look.slangh FOG_RANGE).
static const float MEDIUM_SKY=4000;
// The strata's warp: t = 2 (2^(u L) - 1) for u in 0..1, L = log2(1 + length / 2).
float mediumWarp(float u,float L){return 2*(exp2(u*L)-1);}
// The medium at `p`, `t` metres along the camera ray: height fog's grey extinction
// (times the volumetric extinction scale), scattering (clamped to it, as raster's
// fogMedium) and emission, plus with `air` the atmosphere's aerial perspective past its
// start depth (per metre: the renderer's sun's shadowable single scattering, the rest,
// and extinction).
struct MediumPoint{float3 extinction;float3 scattering;float3 emission;float3 sun;float3 source;};
MediumPoint mediumPoint(Frame f,float3 o,float3 d,float t,bool air){
    float3 p=o+d*t;MediumPoint m;
    float profile=exp(-max(p.y-f.look.z,0)/f.atmosphere.z),density=f.atmosphere.y*profile;
    float e=density*f.fogLight.w;
    m.extinction=e;m.scattering=min(density*f.atmosphere.w*f.fog.rgb,float3(e,e,e));m.emission=f.fogLight.rgb*profile;
    m.sun=0;m.source=0;
    if(air){
        AtmosphereSegment s=atmosphereAerialPoint(atmosphereModel(),ri(f,TRANSMITTANCE),ri(f,MULTISCATTER),f.camera.xyz,d,p,t>atmosphereModel().tent.w?1:0);
        m.extinction+=s.extinction;m.sun=s.sun;m.source=s.source;
    }
    return m;
}
// Transmittance from `o` to `t` along `d`: eight jittered strata (`jitter`) of the
// medium's extinction.
float3 mediumTransmittance(Frame f,float3 o,float3 d,float t,bool air,float jitter){
    float L=log2(1+t/2);float3 tau=0;
    for(uint k=0;k<8;k++){
        float a=mediumWarp(float(k)/8,L),b=mediumWarp(float(k+1)/8,L);
        tau+=mediumPoint(f,o,d,lerp(a,b,jitter),air).extinction*(b-a);
    }
    return exp(-tau);
}
// Clips [t0, t1] to where A + B t <= 0.
void mediumClip(float A,float B,inout float t0,inout float t1){
    if(abs(B)<1e-9){if(A>0)t1=t0;return;}
    float t=-A/B;if(B>0)t1=min(t1,t);else t0=max(t0,t);
}
// Clips [t0, t1] of the ray `w` + t `d` (relative to a spot's apex) to the forward nappe
// of its cone (unit axis `a`, half-angle cosine `c` > 0); ara-render's
// look-fog-lights.slang clipCone.
void mediumClipCone(float3 w,float3 d,float3 a,float c,inout float t0,inout float t1){
    float da=dot(d,a),wa=dot(w,a),c2=c*c,A=da*da-c2,B=wa*da-c2*dot(w,d),C=wa*wa-c2*dot(w,w);
    float r0=t0,r1=t0;
    if(abs(A)>1e-7){float disc=B*B-A*C;if(disc>=0){float s=sqrt(disc),x=(-B-s)/A,y=(-B+s)/A;r0=clamp(min(x,y),t0,t1);r1=clamp(max(x,y),t0,t1);}}
    else if(abs(B)>1e-9)r0=r1=clamp(-C/(2*B),t0,t1);
    float lo=t1,hi=t0;
    for(uint k=0;k<3;k++){
        float s=k==0?t0:k==1?r0:r1,e=k==0?r0:k==1?r1:t1;if(e<=s)continue;
        float3 v=w+d*(0.5*(s+e));if(dot(v,a)>=c*length(v)){lo=min(lo,s);hi=max(hi,e);}
    }
    t0=lo;t1=hi;
}
// A rect's barn doors along one axis (look-fog-lights.slang clipBarnDoors): the hull of
// the two wedges the doors leave lit.
void mediumClipDoors(float p0,float p1,float z0,float z1,float a,float2 door,inout float t0,inout float t1){
    float n0=t0,n1=t1,f0=t0,f1=t1,k=door.x/door.y,q=(2*a+door.x)/door.y;
    mediumClip(p0-k*z0-a,p1-k*z1,n0,n1);mediumClip(-p0-k*z0-a,-p1-k*z1,n0,n1);
    mediumClip(p0-q*z0+a,p1-q*z1,f0,f1);mediumClip(-p0-q*z0+a,-p1-q*z1,f0,f1);
    bool near=n1>n0,far=f1>f0;
    t0=near&&far?min(n0,f0):near?n0:f0;t1=near&&far?max(n1,f1):near?n1:far?f1:t0;
}
// Light local light `l` scatters towards `o` along `d` over [0, `reach`]: one equiangular
// distance in the part of the ray its light can reach (range sphere; a spot's outer cone;
// the half-space before a rect or disc and a rect's barn doors), an area sample on the
// light there, its shadow ray and the transmittance back to `o`.
float3 mediumLocalLight(Frame f,LocalLight l,float3 o,float3 d,float reach,bool air,inout uint rng){
    float3 w=o-l.p.xyz;float b=-dot(w,d),h2=max(dot(w,w)-b*b,0.),range=l.p.w;
    if(h2>=range*range)return 0;
    float chord=sqrt(range*range-h2),t0=max(b-chord,0.),t1=min(b+chord,reach);
    uint kind=localKind(l);float3 n=normalize(l.cone.xyz);
    if(kind==1&&l.cone.w>0.01)mediumClipCone(w,d,n,l.cone.w,t0,t1);
    else if(kind>=2){
        mediumClip(-dot(w,n),-dot(d,n),t0,t1);
        if(kind==2&&l.rect.w>0){
            float3 x=l.tangentLength.xyz,y=cross(x,n);float2 extent=max(l.rect.xy,0.001);
            mediumClipDoors(dot(w,x),dot(d,x),dot(w,n),dot(d,n),extent.x,l.rect.zw,t0,t1);
            mediumClipDoors(dot(w,y),dot(d,y),dot(w,n),dot(d,n),extent.y,l.rect.zw,t0,t1);
        }
    }
    if(t1<=t0)return 0;
    float h=max(sqrt(h2),1e-3),a0=atan2(t0-b,h),span=atan2(t1-b,h)-a0;
    float t=b+h*tan(a0+span*random(rng)),inverse=span*(h*h+(t-b)*(t-b))/h;
    MediumPoint m=mediumPoint(f,o,d,t,air);if(all(m.scattering<=0))return 0;
    float3 p=o+d*t;LocalSample s=sampleLocalLight(l,p,rng);
    if(s.distance<=0||all(s.value<=0))return 0;
    float3 visible=shadowTransmittance(f,p,s.direction,s.distance,rng);
    if(all(visible<=0))return 0;
    return mediumTransmittance(f,o,d,t,air,random(rng))*m.scattering*s.value*visible*(phaseM(dot(d,s.direction),f.fog.w)*l.params.w*inverse);
}
// Light the medium scatters towards `o` along `d` over [0, `reach`] (`light`) and the
// transmittance across it (`through`). `air`: the segment ends on a surface under the
// physical sky (sky rays carry the aerial perspective in the sky's own radiance). Height
// fog, the sun (shadowed with volumetric fog), the atmosphere, emission, ambient light and,
// with volumetric fog, every local light by its volumetric intensity (params.w), as the
// raster renderer's fog.
void mediumSegment(Frame f,float3 o,float3 d,float reach,bool air,inout uint rng,out float3 light,out float3 through){
    light=0;through=1;if(reach<=0||(f.display.w&1)==0)return;
    bool physical=(f.display.w&2)!=0,volumetric=f.weather.z>0.5;float g=f.fog.w,L=log2(1+reach/2);
    float3 sun=f.sunDirection.xyz;uint ambient=min(uint(random(rng)*MEDIUM_STEPS),MEDIUM_STEPS-1);
    for(uint k=0;k<MEDIUM_STEPS;k++){
        float u0=float(k)/MEDIUM_STEPS,u1=float(k+1)/MEDIUM_STEPS,t0=mediumWarp(u0,L),t1=mediumWarp(u1,L);
        float t=mediumWarp(lerp(u0,u1,random(rng)),L);
        float3 p=o+d*t;MediumPoint m=mediumPoint(f,o,d,t,air);
        float3 source=m.emission;
        float3 sunlight=physical?solarIrradiance(f,p):f.sunLux.rgb;
        if(any(sunlight>0)&&(any(m.scattering>0)||any(m.sun>0))){
            float3 visible=volumetric?shadowTransmittance(f,p,sun,10000,rng):float3(1);
            // The height fog's sun and sky light past the volumetric distance (Unreal's
            // height fog contribution), as fog.slang.
            float contribution=physical&&(!volumetric||t>=f.weather.w)?atmosphereModel().skyFactor.w:1;
            source+=sunlight*visible*m.scattering*(phaseM(dot(d,sun),g)*contribution);
            if(physical)source+=m.sun*visible*cloudShadow(f,p);
        }
        source+=m.source;
        if(k==ambient&&any(m.scattering>0)){
            // In-scattered ambient light from one uniform direction (phase-weighted over
            // 4 pi), standing for every stratum's.
            float z=1-2*random(rng),phi=2*PI*random(rng),r=sqrt(max(0.,1-z*z));float3 dir=float3(r*cos(phi),z,r*sin(phi));
            Hit hit;float3 seen;
            if(!trace(f,p,dir,10000,rng,hit))seen=environment(f,dir);
            else{Surface s=surface(f,hit.id,hit.primitive,hit.bary);if(dot(s.normal,-dir)<0)s.normal=-s.normal;seen=s.emissive+direct(f,s,-dir,rng);}
            float contribution=physical&&(!volumetric||t>=f.weather.w)?atmosphereModel().skyFactor.w:1;
            source+=m.scattering*seen*(phaseM(dot(d,dir),g)*4*PI*MEDIUM_STEPS*contribution);
        }
        // The stratum's share: its point, through the medium before it, over du/dt.
        light+=through*exp(-m.extinction*(t-t0))*source*(L*0.69314718*(t+2)/MEDIUM_STEPS);
        through*=exp(-m.extinction*(t1-t0));
    }
    if(!volumetric)return;
    uint4 head=buffers[f.scene.x].Load<uint4>(0);
    for(uint i=0;i<head.w;i++){
        LocalLight l=localLight(f,head.z+i*LIGHT_BYTES);
        if(l.params.w>0)light+=mediumLocalLight(f,l,o,d,reach,air,rng);
    }
}
