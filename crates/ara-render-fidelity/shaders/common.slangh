// Shared linear-radiance transport. All dimensions/offsets match frame.rs/scene.rs.
struct Root {uint frame;uint pass;uint arg;uint pad0;uint pad1;uint pad2;uint pad3;uint pad4;};
#ifdef VULKAN
#define BIND(n) [[vk::binding(n,0)]]
[[vk::push_constant]] ConstantBuffer<Root> root;
#else
#define BIND(n)
ConstantBuffer<Root> root:register(b0,space0);
#endif
BIND(0) Texture2D<float4> textures[128]:register(t0,space1);
BIND(1) RWByteAddressBuffer buffers[64]:register(u0,space2);
BIND(2) SamplerState samplers[3]:register(s0,space0);
BIND(3) RWTexture2D<float4> images[64]:register(u0,space3);
#ifndef RASTER
BIND(4) RaytracingAccelerationStructure acceleration[16]:register(t0,space4);
#endif
static const float PI=3.141592653589793;
static const uint WORLD=0,NORMAL=2,BASE=4,MOTION=5,DEPTH=6,RAW=7,HISTORY=8,MOMENTS=10,FILTER0=12,FILTER1=13,BLOOM0=14,BLOOM1=15,POST=16,UPSCALED=17,OUTPUT=18,DIRECT=21,DIRECT_HISTORY=22;
struct Frame {
    float4x4 inverseVp;float4x4 vp;float4x4 previousVp;
    float4 camera;float4 previousCamera;uint4 sizes;uint4 scene;
    float4 origin;float4 spacing;uint4 counts;uint4 probes;
    float4 sunDirection;float4 sunLux;float4 temporal;float4 post;float4 lens;
    uint4 control;uint4 transport;float4 jitter;uint4 read[6];uint4 write[6];
};
Frame frame(){return buffers[NonUniformResourceIndex(root.frame)].Load<Frame>(0);}
uint ri(Frame f,uint i){return f.read[i/4][i%4];}
uint wi(Frame f,uint i){return f.write[i/4][i%4];}
float4 pixel(Frame f,uint i,int2 p){return textures[NonUniformResourceIndex(ri(f,i))].Load(int3(clamp(p,int2(0),int2(f.sizes.xy)-1),0));}
float4 sampleImage(Frame f,uint i,float2 uv){return textures[NonUniformResourceIndex(ri(f,i))].SampleLevel(samplers[2],uv,0);}
void store(Frame f,uint i,uint2 p,float4 v){images[NonUniformResourceIndex(wi(f,i))][p]=v;}
uint hash(uint x){x^=x>>16;x*=0x7feb352d;x^=x>>15;x*=0x846ca68b;x^=x>>16;return x;}
float random(inout uint state){state=hash(state+0x9e3779b9);return float(state>>8)*(1./16777216.);}
float3 basis(float3 n,float3 v){float3 t=normalize(cross(abs(n.y)<0.99?float3(0,1,0):float3(1,0,0),n));return t*v.x+cross(n,t)*v.y+n*v.z;}
float3 cosineDirection(float3 n,inout uint rng){float u=random(rng),v=random(rng);return basis(n,float3(sqrt(u)*cos(2*PI*v),sqrt(u)*sin(2*PI*v),sqrt(1-u)));}
float3 coneDirection(float3 n,float radius,inout uint rng){float u=random(rng),v=random(rng);return normalize(basis(n,float3(sqrt(u)*radius*cos(2*PI*v),sqrt(u)*radius*sin(2*PI*v),1)));}
float2 envUv(float3 d){return float2(atan2(d.z,d.x)/(2*PI)+0.5,acos(clamp(d.y,-1.,1.))/PI);}
float3 environment(Frame f,float3 d){return textures[NonUniformResourceIndex(f.scene.z)].SampleLevel(samplers[1],envUv(d),0).rgb;}
struct Material {float4 colour;float4 emissiveRoughness;float4 surface;uint4 textures;uint4 flags;};
struct Vertex {float3 position;float3 normal;float2 uv;float4 tangent;};
struct Surface {float3 position;float3 previousPosition;float3 normal;float3 geometricNormal;float3 albedo;float3 emissive;float roughness;float metal;float alpha;uint id;uint material;};
uint4 mesh(Frame f,uint id){return buffers[NonUniformResourceIndex(f.scene.x)].Load<uint4>(32+id*16);}
Material material(Frame f,uint id){return buffers[NonUniformResourceIndex(f.scene.x)].Load<Material>(buffers[NonUniformResourceIndex(f.scene.x)].Load(4)+id*80);}
Vertex vertex(Frame f,uint offset,uint index){return buffers[NonUniformResourceIndex(f.scene.x)].Load<Vertex>(offset+index*48);}
float4 tex(uint i,float2 uv){return textures[NonUniformResourceIndex(i)].SampleLevel(samplers[0],uv,0);}
float2 hitUv(Frame f,uint id,uint primitive,float2 bary){uint4 m=mesh(f,id);uint3 ix=buffers[NonUniformResourceIndex(f.scene.x)].Load<uint3>(m.y+primitive*12);return vertex(f,m.x,ix.x).uv*(1-bary.x-bary.y)+vertex(f,m.x,ix.y).uv*bary.x+vertex(f,m.x,ix.z).uv*bary.y;}
bool accept(Frame f,uint id,uint primitive,float2 bary,inout uint rng){Material m=material(f,mesh(f,id).w);if(m.flags.x==0)return true;float a=m.colour.a*tex(m.textures.x,hitUv(f,id,primitive,bary)).a;return m.flags.x==1?a>=m.surface.w:random(rng)<a;}
Surface surface(Frame f,uint id,uint primitive,float2 bary){
    uint4 m=mesh(f,id);uint3 ix=buffers[NonUniformResourceIndex(f.scene.x)].Load<uint3>(m.y+primitive*12);
    Vertex a=vertex(f,m.x,ix.x),b=vertex(f,m.x,ix.y),c=vertex(f,m.x,ix.z);float3 w=float3(1-bary.x-bary.y,bary);
    Surface s;s.position=a.position*w.x+b.position*w.y+c.position*w.z;s.previousPosition=s.position;
    uint previousCount=buffers[NonUniformResourceIndex(f.scene.w)].Load(0);
    if(id<previousCount){uint4 previousMesh=buffers[NonUniformResourceIndex(f.scene.w)].Load<uint4>(32+id*16);
        if(previousMesh.z>primitive*3+2){uint3 previousIndices=buffers[NonUniformResourceIndex(f.scene.w)].Load<uint3>(previousMesh.y+primitive*12);
            Vertex pa=buffers[NonUniformResourceIndex(f.scene.w)].Load<Vertex>(previousMesh.x+previousIndices.x*48),pb=buffers[NonUniformResourceIndex(f.scene.w)].Load<Vertex>(previousMesh.x+previousIndices.y*48),pc=buffers[NonUniformResourceIndex(f.scene.w)].Load<Vertex>(previousMesh.x+previousIndices.z*48);
            s.previousPosition=pa.position*w.x+pb.position*w.y+pc.position*w.z;
        }
    }

    s.geometricNormal=normalize(cross(b.position-a.position,c.position-a.position));
    s.normal=normalize(a.normal*w.x+b.normal*w.y+c.normal*w.z);if(dot(s.geometricNormal,s.normal)<0)s.geometricNormal=-s.geometricNormal;float2 uv=a.uv*w.x+b.uv*w.y+c.uv*w.z;
    float4 tangent=a.tangent*w.x+b.tangent*w.y+c.tangent*w.z;float3 t=normalize(tangent.xyz-s.normal*dot(tangent.xyz,s.normal));
    Material mat=material(f,m.w);float3 normal=tex(mat.textures.y,uv).xyz*2-1;normal.xy*=mat.surface.y;
    s.normal=normalize(t*normal.x+cross(s.normal,t)*tangent.w*normal.y+s.normal*normal.z);
    float4 base=mat.colour*tex(mat.textures.x,uv);s.albedo=max(base.rgb,0);s.alpha=base.a;
    float4 mr=tex(mat.textures.z,uv);s.metal=saturate(mat.surface.x*mr.b);s.roughness=clamp(mat.emissiveRoughness.w*mr.g,0.045,1);
    s.emissive=max(mat.emissiveRoughness.rgb*tex(mat.textures.w,uv).rgb,0);s.id=id;s.material=m.w;return s;
}
struct Hit {float distance;uint id;uint primitive;float2 bary;bool front;};
bool trace(Frame f,float3 origin,float3 direction,float maximum,inout uint rng,out Hit hit){
    hit=(Hit)0;hit.distance=maximum;
#ifndef RASTER
    RayDesc ray;ray.Origin=origin;ray.Direction=direction;ray.TMin=0.001;ray.TMax=maximum;
    // Fully opaque extractions bypass candidate material loads. Masked/blended
    // scenes retain candidate evaluation, including stochastic alpha transmission.
    uint flags=buffers[NonUniformResourceIndex(f.scene.x)].Load(16)!=0?RAY_FLAG_FORCE_OPAQUE:RAY_FLAG_FORCE_NON_OPAQUE;
    RayQuery<RAY_FLAG_NONE> q;q.TraceRayInline(acceleration[NonUniformResourceIndex(f.scene.y)],flags,255,ray);
    while(q.Proceed()){if(q.CandidateType()==CANDIDATE_NON_OPAQUE_TRIANGLE && accept(f,q.CandidateInstanceID(),q.CandidatePrimitiveIndex(),q.CandidateTriangleBarycentrics(),rng))q.CommitNonOpaqueTriangleHit();}
    if(q.CommittedStatus()!=COMMITTED_TRIANGLE_HIT)return false;
    hit.distance=q.CommittedRayT();hit.id=q.CommittedInstanceID();hit.primitive=q.CommittedPrimitiveIndex();hit.bary=q.CommittedTriangleBarycentrics();hit.front=q.CommittedTriangleFrontFace();return true;
#else
    bool found=false;uint count=buffers[NonUniformResourceIndex(f.scene.x)].Load(0);
    for(uint id=0;id<count;id++){uint4 m=mesh(f,id);for(uint p=0;p<m.z/3;p++){
        uint3 ix=buffers[NonUniformResourceIndex(f.scene.x)].Load<uint3>(m.y+p*12);float3 a=vertex(f,m.x,ix.x).position,b=vertex(f,m.x,ix.y).position,c=vertex(f,m.x,ix.z).position;
        float3 e1=b-a,e2=c-a,h=cross(direction,e2);float det=dot(e1,h);if(abs(det)<1e-8)continue;float inv=1/det;float3 v=origin-a;float u=dot(v,h)*inv;float3 q=cross(v,e1);float vv=dot(direction,q)*inv;float t=dot(e2,q)*inv;
        if(u>=0 && vv>=0 && u+vv<=1 && t>0.001 && t<hit.distance && accept(f,id,p,float2(u,vv),rng)){hit.distance=t;hit.id=id;hit.primitive=p;hit.bary=float2(u,vv);hit.front=det>0;found=true;}
    }}return found;
#endif
}
// Offset on the geometric side used by the outgoing ray, never along a perturbed normal.
float3 rayOrigin(Surface s,float3 outgoing){return s.position+s.geometricNormal*(dot(outgoing,s.geometricNormal)>=0?0.001:-0.001);}
float smith(float cosine,float a2){return 2*cosine/max(cosine+sqrt(a2+(1-a2)*cosine*cosine),1e-6);}
// Heitz 2018 visible-normal sampling: bounded weights at grazing angles.
float3 visibleGgx(Surface s,float3 v,inout uint rng){
    float3 t=normalize(cross(abs(s.normal.y)<0.99?float3(0,1,0):float3(1,0,0),s.normal)),b=cross(s.normal,t);
    float a=s.roughness*s.roughness;float3 vh=normalize(float3(a*dot(v,t),a*dot(v,b),max(dot(v,s.normal),1e-5)));
    float lensq=dot(vh.xy,vh.xy);float3 t1=lensq>0?float3(-vh.y,vh.x,0)/sqrt(lensq):float3(1,0,0);float3 t2=cross(vh,t1);
    float r=sqrt(random(rng)),phi=2*PI*random(rng),x=r*cos(phi),y=r*sin(phi),blend=0.5*(1+vh.z);
    y=lerp(sqrt(max(0,1-x*x)),y,blend);float3 nh=x*t1+y*t2+sqrt(max(0,1-x*x-y*y))*vh;
    float3 h=normalize(float3(a*nh.xy,max(nh.z,0)));return t*h.x+b*h.y+s.normal*h.z;
}
float3 fresnel(float cosine,float3 f0){return f0+(1-f0)*pow(1-saturate(cosine),5);}
float3 evaluate(Surface s,float3 v,float3 l,out float pdf){
    float nv=max(dot(s.normal,v),1e-5),nl=max(dot(s.normal,l),0.);float3 h=normalize(v+l);float nh=max(dot(s.normal,h),0.),vh=max(dot(v,h),1e-5);
    float a=s.roughness*s.roughness,a2=a*a;float d=a2/(PI*pow(nh*nh*(a2-1)+1,2));
    float g=2*nv/(nv+sqrt(a2+(1-a2)*nv*nv))*2*nl/max(nl+sqrt(a2+(1-a2)*nl*nl),1e-6);
    float3 F=fresnel(vh,lerp(float3(0.04),s.albedo,s.metal));float mixture=lerp(0.5,1.,s.metal);
    pdf=lerp(nl/PI,d*smith(nv,a2)/(4*nv),mixture);
    return ((1-F)*(1-s.metal)*s.albedo/PI+d*g*F/max(4*nv*nl,1e-6))*nl;
}
float3 sampleBrdf(Surface s,float3 v,inout uint rng,out float3 weight){
    float3 l;float choice=random(rng);if(choice<lerp(0.5,1.,s.metal)){
        l=reflect(-v,visibleGgx(s,v,rng));
    }else l=cosineDirection(s.normal,rng);
    float pdf;weight=evaluate(s,v,l,pdf)/max(pdf,1e-8);return l;
}
float3 direct(Frame f,Surface s,float3 v,inout uint rng){
    float3 origin=rayOrigin(s,s.normal);Hit hit;float pdf;float3 sum=0;
    float3 l=coneDirection(normalize(f.sunDirection.xyz),f.sunDirection.w,rng);
    if(dot(s.normal,l)>0 && !trace(f,origin,l,10000,rng,hit))sum+=evaluate(s,v,l,pdf)*f.sunLux.rgb;
    uint4 head=buffers[NonUniformResourceIndex(f.scene.x)].Load<uint4>(0);
    for(uint i=0;i<head.w;i++){
        float4 position=buffers[NonUniformResourceIndex(f.scene.x)].Load<float4>(head.z+i*64);
        float4 colour=buffers[NonUniformResourceIndex(f.scene.x)].Load<float4>(head.z+i*64+16);
        float4 cone=buffers[NonUniformResourceIndex(f.scene.x)].Load<float4>(head.z+i*64+32);
        float4 params=buffers[NonUniformResourceIndex(f.scene.x)].Load<float4>(head.z+i*64+48);
        float3 delta=position.xyz-s.position;float dist=length(delta);l=delta/max(dist,1e-5);if(dist>position.w)continue;
        float spot=params.x<0.5?1:smoothstep(cone.w,max(cone.w+1e-4,params.y),dot(-l,normalize(cone.xyz)));
        float fade=pow(saturate(1-pow(dist/position.w,4)),2);float3 sampled=coneDirection(l,0.025/max(dist,0.025),rng);
        if(dot(s.normal,sampled)>0 && !trace(f,origin,sampled,max(dist-0.03,0.001),rng,hit))sum+=evaluate(s,v,sampled,pdf)*colour.rgb*(colour.w/(4*PI*max(dist*dist,0.01)))*fade*spot;
    }return sum;
}
float2 octEncode(float3 n){n/=abs(n.x)+abs(n.y)+abs(n.z);float2 p=n.xy;if(n.z<0)p=(1-abs(p.yx))*float2(p.x>=0?1:-1,p.y>=0?1:-1);return p*0.5+0.5;}
float3 octDecode(float2 p){p=p*2-1;float3 n=float3(p,1-abs(p.x)-abs(p.y));float t=saturate(-n.z);n.xy+=float2(n.x>=0?-t:t,n.y>=0?-t:t);return normalize(n);}
float4 probeLoad(uint buffer,uint probe,uint texel){return buffers[NonUniformResourceIndex(buffer)].Load<float4>((probe*102+texel)*16);}
// Fold bilinear taps across octahedral edges, including the shared corner.
uint octIndex(int2 p,int size){
    if(p.x<0){p.x=-p.x-1;p.y=size-1-p.y;}else if(p.x>=size){p.x=2*size-1-p.x;p.y=size-1-p.y;}
    if(p.y<0){p.y=-p.y-1;p.x=size-1-p.x;}else if(p.y>=size){p.y=2*size-1-p.y;p.x=size-1-p.x;}
    return uint(p.y*size+p.x);
}
float4 probeSample(uint buffer,uint probe,float3 direction,int size,uint offset){
    float2 uv=octEncode(direction)*size-0.5;int2 p=int2(floor(uv));float2 a=frac(uv);
    return lerp(lerp(probeLoad(buffer,probe,offset+octIndex(p,size)),probeLoad(buffer,probe,offset+octIndex(p+int2(1,0),size)),a.x),
                lerp(probeLoad(buffer,probe,offset+octIndex(p+int2(0,1),size)),probeLoad(buffer,probe,offset+octIndex(p+1,size)),a.x),a.y);
}
float3 probePosition(Frame f,uint index){uint x=index%f.counts.x,y=(index/f.counts.x)%f.counts.y,z=index/(f.counts.x*f.counts.y);return f.origin.xyz+float3(x,y,z)*f.spacing.xyz;}
float3 irradianceBiased(Frame f,float3 position,float3 normal,uint probeBuffer,float3 bias){
    float3 biased=position+bias;float3 grid=(biased-f.origin.xyz)/f.spacing.xyz;int3 base=clamp(int3(floor(grid)),int3(0),int3(f.counts.xyz)-2);float3 alpha=saturate(grid-base);float3 sum=0;float total=0;
    for(uint k=0;k<8;k++){
        uint3 d=uint3(k&1,(k>>1)&1,(k>>2)&1);uint3 p=uint3(base)+d;uint id=(p.z*f.counts.y+p.y)*f.counts.x+p.x;
        float4 meta=probeLoad(probeBuffer,id,100);if(meta.w<0.5)continue;
        float3 delta=biased-probePosition(f,id)-meta.xyz;float distance=length(delta);float3 dir=delta/max(distance,1e-6);
        float2 moments=probeSample(probeBuffer,id,dir,8,36).xy;
        float variance=max(moments.y-moments.x*moments.x,0.0001);float visibility=distance<=moments.x?1:pow(variance/(variance+pow(distance-moments.x,2)),3);
        float3 trilinear=lerp(1-alpha,alpha,float3(d));float weight=trilinear.x*trilinear.y*trilinear.z*max(0.02,pow(saturate(dot(-dir,normal)*0.5+0.5),2))*visibility;
        sum+=probeSample(probeBuffer,id,normal,6,0).rgb*weight;total+=weight;
    }return total>1e-6?sum/total:float3(0);
}
float3 irradiance(Frame f,float3 position,float3 normal,uint probeBuffer){return irradianceBiased(f,position,normal,probeBuffer,normal*min(0.15,min(f.spacing.x,min(f.spacing.y,f.spacing.z))*0.2));}
float3 indirect(Frame f,Surface s,float3 v,uint probes){float3 gn=dot(s.geometricNormal,v)>0?s.geometricNormal:-s.geometricNormal;float3 bias=gn*min(0.15,min(f.spacing.x,min(f.spacing.y,f.spacing.z))*0.2)+v*0.05;float3 F=fresnel(sqrt(0.5+0.5*saturate(dot(s.normal,v))),lerp(float3(0.04),s.albedo,s.metal));return irradianceBiased(f,s.position,s.normal,probes,bias)*s.albedo*(1-s.metal)*(1-F)/PI;}
float3 cameraRay(Frame f,float2 pixelPosition){float2 uv=pixelPosition/float2(f.sizes.xy);float4 p=mul(f.inverseVp,float4(uv.x*2-1,1-uv.y*2,1,1));return normalize(p.xyz/p.w-f.camera.xyz);}

// Shared validity is also used by checkerboard transport, so uncovered pixels
// always receive a fresh ray rather than an uninitialized reconstruction sample.
bool reproject(Frame f,uint2 p,out float2 uv,out int2 at){
    uint slot=f.control.x;float4 world=pixel(f,WORLD+slot,p),normal=pixel(f,NORMAL+slot,p),motion=pixel(f,MOTION,p);
    uv=(float2(p)+0.5)/float2(f.sizes.xy)+motion.xy+(f.jitter.zw-f.jitter.xy)/float2(f.sizes.xy);at=int2(uv*f.sizes.xy);
    if(f.temporal.x>0 || f.temporal.y>0 || world.w==0 || any(uv<=0) || any(uv>=1))return false;
    float4 oldWorld=pixel(f,WORLD+1-slot,at),oldNormal=pixel(f,NORMAL+1-slot,at);
    float3 currentDirect=pixel(f,DIRECT,p).rgb,oldDirect=pixel(f,DIRECT_HISTORY+1-slot,at).rgb;
    bool illumination=length(currentDirect-oldDirect)<=max(0.2,length(oldDirect)*0.25);
    return illumination && oldWorld.w==world.w && abs(length(oldWorld.xyz-f.previousCamera.xyz)-motion.z)<max(0.015,motion.z*0.01)
        && dot(normal.xyz,oldNormal.xyz)>0.92 && abs(normal.w-oldNormal.w)<0.1;
}
