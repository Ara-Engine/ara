// The fidelity renderer's bindings of the shared physical atmosphere
// (atmosphere-model.slangh: a verified copy of the raster look's, so both renderers and
// the path-traced reference draw the same sky). The model record (frame.rs `sky`)
// follows the frame's private rows at row 10; LUT targets are rows 24..27.
static const uint TRANSMITTANCE=24,MULTISCATTER=25,SKYVIEW=26,FROXELS=27;
#include "atmosphere-model.slangh"
AtmosphereModel atmosphereModel(){return buffers[root.frame].Load<AtmosphereModel>(sizeof(Frame)+224+10*16);}
float phaseM(float cosine,float g){return atmospherePhaseMie(cosine,g);}
float noise2(float2 p){int2 i=int2(floor(p));float2 a=frac(p);a=a*a*(3-2*a);float n00=float(hash(asuint(i.x)*73856093u^asuint(i.y)*19349663u)&65535)/65535.;float n10=float(hash(asuint(i.x+1)*73856093u^asuint(i.y)*19349663u)&65535)/65535.;float n01=float(hash(asuint(i.x)*73856093u^asuint(i.y+1)*19349663u)&65535)/65535.;float n11=float(hash(asuint(i.x+1)*73856093u^asuint(i.y+1)*19349663u)&65535)/65535.;return lerp(lerp(n00,n10,a.x),lerp(n01,n11,a.x),a.y);}
float cloudDensity(Frame f,float2 p){float n=0,m=0.5;for(uint i=0;i<5;i++){n+=noise2(p)*m;p=p*2.03+17.7;m*=0.5;}return smoothstep(1-f.weather.x,1-f.weather.x+0.18,n);}
// The cloud layer's shadow on the sun at `position` (1 without clouds).
float cloudShadow(Frame f,float3 position){
    if(f.weather.x<=0 || f.sunDirection.y<=0.01)return 1;
    float2 p=position.xz+f.sunDirection.xz*((f.weather.y-position.y)/f.sunDirection.y);
    return exp(-cloudDensity(f,p*0.00025)*3/max(f.sunDirection.y,0.2));
}
// Sun illuminance on surfaces at `position` (lux): the atmosphere's surface
// transmittance (global or per pixel, atmosphereSurfaceLight) and the clouds' shadow.
float3 solarIrradiance(Frame f,float3 position){
    AtmosphereModel a=atmosphereModel();
    float3 t=atmosphereSunSurface(a,ri(f,TRANSMITTANCE),atan(f.sunDirection.w),position.y-a.apFactor.w,f.sunDirection.y);
    return f.sunLux.rgb*t*cloudShadow(f,position);
}
// The sky along `d` (cd/m2): the sky-view LUT, the atmosphere lights' discs (`disk`)
// and the planar cloud layer, as the raster look's skyRadiance.
float3 atmosphereEnvironment(Frame f,float3 d,bool disk){
    AtmosphereModel a=atmosphereModel();
    float3 c=atmosphereSky(a,ri(f,TRANSMITTANCE),ri(f,SKYVIEW),f.camera.xyz,d,disk);
    if(f.weather.x>0 && d.y>0.01){
        float2 pos=f.camera.xz+d.xz*((f.weather.y-f.camera.y)/d.y);
        float density=cloudDensity(f,pos*0.00025),shade=cloudDensity(f,(pos+f.sunDirection.xz*250)*0.00025);
        float optical=density*3/max(d.y,0.2),t=exp(-optical);
        float3 light=f.sunLux.rgb*(0.045+0.2*exp(-shade*2.2))*max(f.sunDirection.y,0.05);
        c=c*t+light*(1-t);
    }return c;
}
// Froxel fog (fog.slang): 64x36 columns, FROXEL_SLICES logarithmic slices (the first 32
// to 4 km, the rest carrying the aerial perspective to 111 km), cumulative in-scatter
// (x 0..63) and transmittance (x 64..127) per slice end in a FROXEL_SLICES*128 x 36 atlas.
static const uint FROXEL_SLICES=46;
float froxelEnd(uint z){return 2*(exp2(log2(2001.)*float(z+1)/32)-1);}
float3 sampleFroxel(Frame f,float2 uv,float distance,out float3 trans){
    float slice=log2(1+distance/2)/log2(1+4000./2)*32;
    float z=clamp(slice-1,0.,float(FROXEL_SLICES-1));uint lo=uint(z),hi=min(lo+1,FROXEL_SLICES-1);const float width=FROXEL_SLICES*128;
    float2 a=(clamp(uv,float2(0.5/64,0.5/36),float2(63.5/64,35.5/36))*float2(64,36));
    float3 x=textures[NonUniformResourceIndex(ri(f,FROXELS))].SampleLevel(samplers[2],float2((lo*128+a.x)/width,a.y/36),0).rgb;
    float3 y=textures[NonUniformResourceIndex(ri(f,FROXELS))].SampleLevel(samplers[2],float2((hi*128+a.x)/width,a.y/36),0).rgb;
    float3 tx=textures[NonUniformResourceIndex(ri(f,FROXELS))].SampleLevel(samplers[2],float2((lo*128+64+a.x)/width,a.y/36),0).rgb;
    float3 ty=textures[NonUniformResourceIndex(ri(f,FROXELS))].SampleLevel(samplers[2],float2((hi*128+64+a.x)/width,a.y/36),0).rgb;
    trans=lerp(tx,ty,frac(z));float3 light=lerp(x,y,frac(z));
    if(slice<1){trans=lerp(float3(1),trans,slice);light*=slice;}
    return light;
}
