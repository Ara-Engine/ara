diff --git a/packages/cli/src/serve/runner.rs b/packages/cli/src/serve/runner.rs
index cd6b699..25f180b 100644
--- a/packages/cli/src/serve/runner.rs
+++ b/packages/cli/src/serve/runner.rs
@@ -33,0 +34,45 @@ use tokio::process::Command;
+// Windows can notify between truncate and write. Read only after the writer
+// closes, so an empty/partial snapshot cannot queue a duplicate of the same save.
+async fn ara_native_rust_snapshot(path: &Path) -> std::io::Result<String> {
+    #[cfg(windows)]
+    if std::env::var_os("ARA_NATIVE_RUST_WRITER_SNAPSHOT").as_deref()
+        != Some(std::ffi::OsStr::new("0"))
+    {
+        use std::{io::Read, os::windows::fs::OpenOptionsExt};
+        let began = std::time::Instant::now();
+        loop {
+            // FILE_SHARE_READ | FILE_SHARE_DELETE permits atomic replacement,
+            // but refuses an in-progress writer until it releases its handle.
+            match std::fs::OpenOptions::new().read(true).share_mode(0x5).open(path) {
+                Ok(mut file) => {
+                    let mut contents = String::new();
+                    file.read_to_string(&mut contents)?;
+                    return Ok(contents);
+                }
+                Err(error) if matches!(error.raw_os_error(), Some(2 | 3 | 32 | 33))
+                    && began.elapsed() < std::time::Duration::from_secs(1) =>
+                {
+                    tokio::time::sleep(std::time::Duration::from_millis(5)).await;
+                }
+                Err(error) => return Err(error),
+            }
+        }
+    }
+    std::fs::read_to_string(path)
+}
+
+// Optional cross-process latency evidence for Ara's native-only driver.
+fn ara_native_trace(event: &str, details: serde_json::Value) {
+    let Some(directory) = std::env::var_os("ARA_HOTPATCH_TRACE_DIR") else { return };
+    let at = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_micros());
+    let pid = std::process::id();
+    let path = PathBuf::from(directory);
+    if std::fs::create_dir_all(&path).is_ok() {
+        let row = serde_json::json!({"event":event,"at_us":at,"pid":pid,"details":details});
+        if let Ok(bytes) = serde_json::to_vec(&row) {
+            let _ = std::fs::write(path.join(format!("{event}-{at}-{pid}.json")), bytes);
+        }
+    }
+}
