material TerrainBlend : surface budget 1 {
  param grass : TextureColor = @textures/grass.png#tx_grass001;
  param rock : TextureColor = @textures/rock.png#tx_rock0001;
  param scale : float = 0.25;
  let world : vec3 = worldPosition();
  let normal : vec3 = worldNormal();
  let grassColor : ColorLinear = triplanar(grass, world, normal, scale);
  let rockColor : ColorLinear = triplanar(rock, world, normal, scale);
  let uv0 : vec2 = uv();
  let blend : float = noise(uv0);
  let terrainColor : ColorLinear = lerp(grassColor, rockColor, blend);
  let roughness : float = 0.85;
  output baseColor = terrainColor;
  output roughness = roughness;
}
