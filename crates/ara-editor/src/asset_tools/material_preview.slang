// Editor-only analytic preview geometry; the material evaluation is generated by ara-material.
struct PreviewVarying {float4 position:SV_Position;float2 uv:TEXCOORD0;};
[shader("vertex")]
PreviewVarying previewVertex(uint vertex:SV_VertexID){
    float2 p=float2((vertex<<1)&2,vertex&2);PreviewVarying v;v.position=float4(p*float2(2,-2)+float2(-1,1),0,1);v.uv=p;return v;
}
struct PreviewOutput {float4 color:SV_Target0;float entity:SV_Target1;};
float3 previewTone(float3 v){v=max(v,0);v=(v*(2.51*v+0.03))/(v*(2.43*v+0.59)+0.14);return pow(saturate(v),1./2.2);}
[shader("fragment")]
PreviewOutput previewFragment(PreviewVarying v){
    float3 eye=float3(2.8,1.7,3.8),forward=normalize(-eye),right=normalize(cross(forward,float3(0,1,0))),up=cross(right,forward);
    float2 xy=v.uv*float2(2,-2)+float2(-1,1);float3 ray=normalize(forward+(right*xy.x+up*xy.y)*0.32);
    bool plane=(draw.flags&1)!=0;float b=dot(eye,ray),c=dot(eye,eye)-1,disc=b*b-c;
    float distance=plane?-eye.z/ray.z:(disc>0?-b-sqrt(disc):-1);
    float3 p=eye+distance*ray;bool hit=distance>0 && (!plane || max(abs(p.x),abs(p.y))<1.15);
    PreviewOutput output;output.entity=hit?1:0;
    if(!hit){float3 bg=lerp(float3(0.075,0.085,0.105),float3(0.025,0.03,0.04),v.uv.y);output.color=float4(previewTone(bg),1);return output;}
    float3 n=plane?float3(0,0,1):normalize(p);float3 tangent=normalize(cross(abs(n.y)>0.99?float3(0,0,1):float3(0,1,0),n));
    AraMaterialInput input;input.worldPosition=p;input.worldNormal=n;input.worldTangent=tangent;input.worldBitangent=cross(n,tangent);input.viewDirection=normalize(eye-p);
    input.uv=plane?p.xy*0.5+0.5:float2(atan2(n.z,n.x)/(2*3.14159265)+0.5,acos(clamp(n.y,-1,1))/3.14159265);
    AraSurface surface=ara_evaluate(input);
    float3 radiance=PREVIEW_SURFACE?ara_engine_light(surface,input,normalize(float3(-0.4,0.8,0.65)),float3(2.4,2.25,2.05),float3(0.1,0.13,0.18)):surface.color;
    output.color=float4(previewTone(radiance),1);return output;
}
