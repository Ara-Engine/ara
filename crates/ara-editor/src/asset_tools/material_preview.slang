// Editor-only analytic preview geometry; the material evaluation is generated by ara-material.
// The shot matches model thumbnails (asset_tools/studio.rs): the same 3/4 bearing, key
// light, softbox studio and backdrop, with 4x rotated-grid supersampling per pixel.
struct PreviewVarying {float4 position:SV_Position;float2 uv:TEXCOORD0;};
[shader("vertex")]
PreviewVarying previewVertex(uint vertex:SV_VertexID){
    float2 p=float2((vertex<<1)&2,vertex&2);PreviewVarying v;v.position=float4(p*float2(2,-2)+float2(-1,1),0,1);v.uv=p;return v;
}
struct PreviewOutput {float4 color:SV_Target0;float entity:SV_Target1;};
float3 previewTone(float3 v){v=max(v,0);v=(v*(2.51*v+0.03))/(v*(2.43*v+0.59)+0.14);return pow(saturate(v),1./2.2);}
static const float3 PREVIEW_KEY=normalize(float3(-0.38,0.74,0.56));
static const float2 PREVIEW_GRID[4]={float2(-0.125,-0.375),float2(0.375,-0.125),float2(0.125,0.375),float2(-0.375,0.125)};
// Soft-edged rectangular softbox through a gnomonic projection (studio.rs `softbox`).
float previewSoftbox(float3 d,float3 centre,float2 size){
    float facing=dot(d,centre);if(facing<=0)return 0;
    float3 t=normalize(cross(centre,float3(0,1,0))),b=cross(t,centre);
    float2 o=abs(float2(dot(d,t),dot(d,b))/facing);float2 e=saturate((size-o)/(size*0.3));e=e*e*(3-2*e);return e.x*e.y;
}
// Studio radiance; `spread` widens the softboxes (energy-preserving) for rough reflections.
float3 previewStudio(float3 d,float spread){
    float3 r=0.05+0.06*max(d.y,0)+0.16*exp(-(d.y*d.y)/(0.14*0.14+spread*0.5));
    float2 key=float2(0.45,0.3)+spread,fill=float2(0.3,0.6)+spread,rim=float2(0.8,0.12)+spread;
    r+=float3(2.2,2.13,2.02)*(0.135/(key.x*key.y))*previewSoftbox(d,PREVIEW_KEY,key);
    r+=float3(0.56,0.6,0.65)*(0.18/(fill.x*fill.y))*previewSoftbox(d,normalize(float3(0.95,0.25,0.2)),fill);
    r+=2.6*(0.096/(rim.x*rim.y))*previewSoftbox(d,normalize(float3(0.1,0.55,-0.83)),rim);
    return r;
}
float3 previewEnvBrdf(float3 f0,float roughness,float nv){
    float4 r=roughness*float4(-1,-0.0275,-0.572,0.022)+float4(1,0.0425,1.04,-0.04);
    float a=min(r.x*r.x,exp2(-9.28*nv))*r.x+r.y;float2 ab=float2(-1.04,1.04)*a+r.zw;return f0*ab.x+ab.y;
}
// The thumbnail backdrop (studio::backdrop), already display-encoded.
float3 previewBackdrop(float2 uv){
    float glow=saturate(1-length(uv-float2(0.5,0.42))*1.6);glow*=glow*10;
    return (lerp(float3(60,63,69),float3(34,36,40),uv.y)+glow)/255.;
}
[shader("fragment")]
PreviewOutput previewFragment(PreviewVarying v){
    float3 eye=6*float3(0.5305,0.4078,0.7432),forward=normalize(-eye),right=normalize(cross(forward,float3(0,1,0))),up=cross(right,forward);
    // Flags (material_preview.rs Shot): 1 plane, 2 raw data values, 4 head-on UV swatch.
    bool plane=(draw.flags&1)!=0,data=(draw.flags&2)!=0,swatch=(draw.flags&4)!=0;float2 pixel=float2(ddx(v.uv.x),ddy(v.uv.y));
    float3 sum=0;float covered=0;
    for(uint s=0;s<4;s++){
        float2 uv=v.uv+PREVIEW_GRID[s]*pixel;float2 xy=uv*float2(2,-2)+float2(-1,1);float3 ray=normalize(forward+(right*xy.x+up*xy.y)*0.192);
        float b=dot(eye,ray),c=dot(eye,eye)-1,disc=b*b-c;
        float distance=plane?-eye.z/ray.z:-b-sqrt(max(disc,0));
        float3 p=eye+distance*ray;bool hit=distance>0 && (plane?max(abs(p.x),abs(p.y))<1.15:disc>0);
        if(swatch){p=float3(uv.x*2-1,1-uv.y*2,0);hit=true;}
        // Every sample evaluates the material so texture derivatives stay uniform.
        float3 n=plane||swatch?float3(0,0,1):normalize(p);float3 tangent=normalize(cross(abs(n.y)>0.99?float3(0,0,1):float3(0,1,0),n));
        AraMaterialInput input;input.worldPosition=p;input.worldNormal=n;input.worldTangent=tangent;input.worldBitangent=cross(n,tangent);input.viewDirection=swatch?float3(0,0,1):normalize(eye-p);
        input.uv=swatch?uv:plane?p.xy*0.5+0.5:float2(atan2(n.z,n.x)/(2*3.14159265)+0.5,acos(clamp(n.y,-1,1))/3.14159265);
        AraSurface surface=ara_evaluate(input);
        float3 radiance=surface.color;
        if(PREVIEW_SURFACE){
            float3 shading=ara_normalize(input.worldTangent*surface.normal.x+input.worldBitangent*surface.normal.y+input.worldNormal*surface.normal.z);
            float3 view=input.viewDirection;float nv=saturate(dot(shading,view));
            float metallic=saturate(surface.metallic),roughness=saturate(surface.roughness),coat=saturate(surface.clearCoat);
            float3 f0=lerp(float3(0.04),surface.baseColor,metallic);float3 reflected=reflect(-view,shading);
            float3 specular=previewEnvBrdf(f0,roughness,nv)*previewStudio(reflected,roughness*roughness*1.5);
            float3 diffuse=surface.baseColor*(1-metallic)*previewStudio(shading,1.2);
            float3 coating=coat*previewEnvBrdf(float3(0.04),saturate(surface.clearCoatRoughness),nv)*previewStudio(reflected,surface.clearCoatRoughness*surface.clearCoatRoughness*1.5);
            radiance=0.8*(ara_engine_light(surface,input,PREVIEW_KEY,float3(1.8,1.75,1.66),float3(0))+diffuse+specular+coating);
        }
        // Raw data reads as its value (sRGB-encoded); lit shots go through the tone curve.
        float3 shown=data?pow(saturate(radiance),1./2.2):previewTone(radiance);
        sum+=hit?shown:previewBackdrop(uv);covered+=hit?1:0;
    }
    PreviewOutput output;output.entity=covered>0?1:0;output.color=float4(sum*0.25,1);return output;
}
