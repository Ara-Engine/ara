    "why": "The scout: a capsule character with a two-frame flipbook",
    "calls": [
      {"command": "entity.create", "params": {"id": "e_hero1", "name": "Scout"}},
      {"command": "sprite.set", "params": {"entity": "e_hero1", "value": {"atlas": "@art/platformer.png#at_platform1", "normalAtlas": "@art/platformer-normal.png#at_normal01", "region": "heroIdle", "size": [1, 1.5], "sortingLayer": 3, "lit": true}}},
      {"command": "flipbook.set", "params": {"entity": "e_hero1", "value": {"frames": [{"region": "heroIdle", "ticks": 8}, {"region": "heroStep", "ticks": 8}], "looping": true}}},
      {"command": "physics2d.set", "params": {"entity": "e_hero1", "pose": {"position": [-3, -1.5]}, "character": {"radius": 0.375, "height": 1.5}}}
    ]
  },
  {
    "doc": "sc_platform1",
