[
  {
    "doc": "sc_platform1",
    "why": "Ruins tilemap: terrain rules turn exposed ground into grass, the rest into dirt",
    "calls": [
      {"command": "entity.create", "params": {"id": "e_map1", "name": "Ruins tilemap"}},
      {
        "command": "tilemap.set",
        "params": {
          "entity": "e_map1",
          "value": {
            "atlas": "@art/platformer.png#at_platform1",
            "normalAtlas": "@art/platformer-normal.png#at_normal01",
            "definitions": {
              "1": {"region": "grass", "terrain": 1, "solid": true, "lit": true},
              "2": {"region": "dirt", "terrain": 1, "solid": true, "lit": true},
              "3": {"region": "stone", "solid": true, "lit": true},
              "4": {"region": "stone"}
            },
            "layers": [
              {"id": "l_backdrop", "sortingLayer": -5, "parallax": [0.625, 0.625], "tint": [0.14, 0.17, 0.26, 1]},
              {"id": "l_ground"},
              {"id": "l_ruins", "sortingLayer": 1}
            ],
            "rules": [
              {"terrain": 1, "forbidden": 4, "tile": 1},
              {"terrain": 1, "tile": 2}
            ]
          }
        }
      }
    ]
  },
  {
    "doc": "sc_platform1",
    "why": "Ground: one bounded, auto-tiled fill",
    "calls": [
      {"command": "tilemap.fill", "params": {"entity": "e_map1", "layer": "l_ground", "seed": {"x": 0, "y": -3}, "min": {"x": -24, "y": -7}, "max": {"x": 24, "y": -3}, "tile": 2, "autotile": true}}
    ]
  },
  {
    "doc": "sc_platform1",
    "why": "A hill stroke; autotile re-grasses its top and turns the ground below into dirt",
    "calls": [
      {"command": "tilemap.paint", "params": {"entity": "e_map1", "layer": "l_ground", "autotile": true, "cells": [
        {"x": 5, "y": -2, "tile": 2}, {"x": 6, "y": -2, "tile": 2}, {"x": 7, "y": -2, "tile": 2},
        {"x": 8, "y": -2, "tile": 2}, {"x": 9, "y": -2, "tile": 2}, {"x": 10, "y": -2, "tile": 2},
        {"x": 7, "y": -1, "tile": 2}, {"x": 8, "y": -1, "tile": 2}, {"x": 9, "y": -1, "tile": 2}, {"x": 10, "y": -1, "tile": 2}
      ]}}
    ]
  },
  {
    "doc": "sc_platform1",
    "why": "Dig a pit",
    "calls": [
      {"command": "tilemap.erase", "params": {"entity": "e_map1", "layer": "l_ground", "autotile": true, "cells": [
        {"x": 1, "y": -3}, {"x": 2, "y": -3}, {"x": 1, "y": -4}, {"x": 2, "y": -4}, {"x": 1, "y": -5}, {"x": 2, "y": -5},
        {"x": 1, "y": -6}, {"x": 2, "y": -6}, {"x": 1, "y": -7}, {"x": 2, "y": -7}
      ]}}
    ]
  },
  {
    "doc": "sc_platform1",
    "why": "Ruined platforms and a parallax colonnade behind them",
    "calls": [
      {"command": "tilemap.fill", "params": {"entity": "e_map1", "layer": "l_ruins", "seed": {"x": -8, "y": 0}, "min": {"x": -8, "y": 0}, "max": {"x": -4, "y": 0}, "tile": 3}},
      {"command": "tilemap.fill", "params": {"entity": "e_map1", "layer": "l_ruins", "seed": {"x": 0, "y": 2}, "min": {"x": 0, "y": 2}, "max": {"x": 3, "y": 2}, "tile": 3}},
      {"command": "tilemap.fill", "params": {"entity": "e_map1", "layer": "l_backdrop", "seed": {"x": -1, "y": -3}, "min": {"x": -1, "y": -3}, "max": {"x": -1, "y": 1}, "tile": 4}},
      {"command": "tilemap.fill", "params": {"entity": "e_map1", "layer": "l_backdrop", "seed": {"x": 5, "y": -3}, "min": {"x": 5, "y": -3}, "max": {"x": 5, "y": 3}, "tile": 4}},
      {"command": "tilemap.paint", "params": {"entity": "e_map1", "layer": "l_backdrop", "cells": [{"x": 4, "y": 3, "tile": 4}, {"x": 6, "y": 3, "tile": 4}, {"x": -2, "y": 1, "tile": 4}]}}
    ]
  },
  {
    "doc": "sc_platform1",
    "why": "Static colliders for every solid tile, regenerated as owned entities",
    "calls": [
      {"command": "tilemap.colliders.generate", "params": {"entity": "e_map1", "origin": [0, 0]}}
    ]
  },
  {
