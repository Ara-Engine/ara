// Native material evaluation for software trace hits. Native raster ABI.
// No hardware acceleration binding, screen colour or screen ambient sampling.
#pragma once
struct ReflectVertex {float3 position;float3 normal;float2 uv;float4 tangent;float2 uv1;uint weights;uint color;};
struct ReflectUv {float2 offset;float2 scale;float rotation;uint set;uint2 reserved;};
struct ReflectMaterial {Material pbr;ReflectUv uv[6];uint4 slots;float4 factors;uint4 layers;};
struct ReflectInstance {uint4 meta;float4x4 world;float4x4 previous;float4 nx;float4 ny;float4 nz;};
// A hit triangle: corners in world space (normals and tangents transformed as the
// G-buffer's vertices), barycentric weights and the instance's material.
struct ReflectTriangle {ReflectVertex a;ReflectVertex b;ReflectVertex c;float3 w;uint material;};
ReflectInstance reflectInstance(Look l,uint instance){return buffers[NonUniformResourceIndex(l.rtInfo[0].y)].Load<ReflectInstance>(128+instance*192);}
ReflectMaterial reflectMaterial(Look l,uint id){return buffers[NonUniformResourceIndex(l.rtInfo[0].w)].Load<ReflectMaterial>(id*320);}
// Corner `v` in world space through object-to-world `m`: normals by its inverse
// transpose (the cofactor columns `k`, signed by `handedness`, the determinant's
// sign, which also flips the tangent frame of mirrored instances).
ReflectVertex reflectWorldVertex(float3x4 m,float3 k0,float3 k1,float3 k2,float handedness,ReflectVertex v){
    v.position=mul(m,float4(v.position,1));
    v.normal=(k0*v.normal.x+k1*v.normal.y+k2*v.normal.z)*handedness;
    v.tangent=float4(mul(m,float4(v.tangent.xyz,0)),v.tangent.w*handedness);
    return v;
}
// Triangle `primitive` of instance `instance` through object-to-world `m`.
ReflectTriangle reflectTriangleThrough(Look l,uint instance,uint primitive,float2 bary,float3x4 m){
    uint entry=buffers[NonUniformResourceIndex(l.rtInfo[1].y)].Load(instance*4);
    uint4 g=buffers[NonUniformResourceIndex(l.rtInfo[0].z)].Load4(entry*32);
    uint3 ix=buffers[NonUniformResourceIndex(g.z)].Load3(g.w+primitive*12);
    float3 c0=float3(m[0][0],m[1][0],m[2][0]),c1=float3(m[0][1],m[1][1],m[2][1]),c2=float3(m[0][2],m[1][2],m[2][2]);
    float3 k0=cross(c1,c2),k1=cross(c2,c0),k2=cross(c0,c1);float handedness=dot(c0,k0)<0?-1:1;
    ReflectTriangle t;t.w=float3(1-bary.x-bary.y,bary);t.material=buffers[NonUniformResourceIndex(l.rtInfo[0].y)].Load(128+instance*192);
    t.a=reflectWorldVertex(m,k0,k1,k2,handedness,buffers[NonUniformResourceIndex(g.x)].Load<ReflectVertex>(g.y+ix.x*64));
    t.b=reflectWorldVertex(m,k0,k1,k2,handedness,buffers[NonUniformResourceIndex(g.x)].Load<ReflectVertex>(g.y+ix.y*64));
    t.c=reflectWorldVertex(m,k0,k1,k2,handedness,buffers[NonUniformResourceIndex(g.x)].Load<ReflectVertex>(g.y+ix.z*64));
    uint4 meta=buffers[NonUniformResourceIndex(l.rtInfo[0].y)].Load4(128+instance*192);
    if(meta.z!=0){
        t.a.color=buffers[NonUniformResourceIndex(meta.y>>1)].Load((meta.z-1+ix.x)*4);
        t.b.color=buffers[NonUniformResourceIndex(meta.y>>1)].Load((meta.z-1+ix.y)*4);
        t.c.color=buffers[NonUniformResourceIndex(meta.y>>1)].Load((meta.z-1+ix.z)*4);
    }
    return t;
}
// A triangle as this frame's instance rows place it (alpha tests, back faces of a
// traced interface).
ReflectTriangle reflectTriangle(Look l,uint instance,uint primitive,float2 bary){
    float4x4 world=buffers[NonUniformResourceIndex(l.rtInfo[0].y)].Load<float4x4>(128+instance*192+16);
    return reflectTriangleThrough(l,instance,primitive,bary,float3x4(world[0],world[1],world[2]));
}
// The native UV transform, evaluated independently for every material slot.
float2 reflectUv(ReflectUv t,ReflectVertex v){float2 p=(t.set==0?v.uv:v.uv1)*t.scale;float s,c;sincos(t.rotation,s,c);return t.offset+float2(c*p.x-s*p.y,s*p.x+c*p.y);}
// Map `slot` of `m` at the hit (as native-raster.slang sampleMap), at the mip a ray
// cone `width` metres wide covers: the triangle's texels per metre times the width.
float4 reflectMap(Look l,ReflectMaterial m,uint slot,ReflectTriangle t,float width){
    uint id=slot<4?m.pbr.textures[min(slot,3)]:(slot==4?m.slots.x:m.slots.y);
    if(id==0xffffffff)return float4(slot==1?float3(0,0,1):float3(1),1);
    float2 a=reflectUv(m.uv[slot],t.a),b=reflectUv(m.uv[slot],t.b),c=reflectUv(m.uv[slot],t.c);
    float2 uv=a*t.w.x+b*t.w.y+c*t.w.z;uint table=l.rtInfo[1].x;
    float2 size=float2(ntInfo(table,id).zw);float2 du=(b-a)*size,dv=(c-a)*size;
    float texels=abs(du.x*dv.y-du.y*dv.x),area=length(cross(t.b.position-t.a.position,t.c.position-t.a.position));
    float lod=max(0,log2(max(width,1e-6))+0.5*log2(max(texels,1e-12)/max(area,1e-12)));
    if(slot==1)return float4(ntNormal(table,id,uv,lod,m.pbr.surface.y),1);
    bool decode=slot==0?(m.pbr.flags.y&(1u<<25))!=0:slot==3 && (m.pbr.flags.y&(1u<<26))!=0;
    return ntSampleColorLevel(table,id,uv,lod,decode);
}
// Normal-mapped shading normal around the interpolated vertex normal `n`: the
// authored tangent frame, or one derived from the normal map's UVs (slots.w).
float3 reflectNormal(Look l,ReflectMaterial m,ReflectTriangle t,float3 n,float width){
    if(m.pbr.textures.y==0xffffffff)return n;
    float4 tangent=t.a.tangent*t.w.x+t.b.tangent*t.w.y+t.c.tangent*t.w.z;
    float3 tg=tangent.xyz-n*dot(tangent.xyz,n);float handedness=tangent.w<0?-1:1;
    if(m.slots.w!=0){
        float2 u=reflectUv(m.uv[1],t.a),du=reflectUv(m.uv[1],t.b)-u,dv=reflectUv(m.uv[1],t.c)-u;float determinant=du.x*dv.y-du.y*dv.x;
        if(abs(determinant)>1e-10){
            float3 e1=t.b.position-t.a.position,e2=t.c.position-t.a.position;
            tg=(e1*dv.y-e2*du.y)/determinant;tg-=n*dot(tg,n);
            handedness=dot(cross(n,tg),(e2*du.x-e1*dv.x)/determinant)<0?-1:1;
        }
    }
    if(dot(tg,tg)<1e-12)return n;
    tg=normalize(tg);float3 sampled=reflectMap(l,m,1,t,width).xyz;
    return normalize(tg*sampled.x+cross(n,tg)*handedness*sampled.y+n*sampled.z);
}
// One material's surface at the hit (native-raster.slang surfaceMaterial with
// explicit mips; no geometric specular AA: a cone-filtered ray is not a pixel).
Surface reflectMaterialSurface(Look l,ReflectMaterial m,ReflectTriangle t,float3 n,float width){
    Surface s;float4 base=reflectMap(l,m,0,t,width)*m.pbr.color;s.albedo=max(0,base.rgb);s.alpha=base.a;
    s.normal=reflectNormal(l,m,t,n,width);
    float4 mr=reflectMap(l,m,2,t,width);s.roughness=clamp(m.pbr.emissiveRoughness.w*mr.g,0.045,1);s.metal=saturate(m.pbr.surface.x*mr.b);
    s.emissive=max(0,m.pbr.emissiveRoughness.rgb*reflectMap(l,m,3,t,width).rgb);
    s.ao=lerp(1,reflectMap(l,m,4,t,width).r,m.factors.x);
    s.transmission=saturate(m.factors.y*reflectMap(l,m,5,t,width).r)*(1-s.metal);return s;
}
float4 reflectWeights(uint packed){return float4(packed&255,(packed>>8)&255,(packed>>16)&255,packed>>24)/255.;}
float4 reflectPaintWeights(ReflectMaterial m,float4 color){
    float4 weights=0;
    for(uint i=0;i<min(m.slots.z,4u);i++){
        uint recipe=(m.pbr.flags.z>>(8*i))&255;float w=1;
        for(uint c=0;c<4;c++){uint term=(recipe>>(2*c))&3;w*=term==1?color[c]:term==2?1-color[c]:1;}
        weights[i]=w;
    }
    float sum=dot(weights,float4(1));return sum>1e-6?weights/sum:float4(1,0,0,0);
}
// The hit's surface; terrain splats (slots.z layers) blend their layers by the
// vertex weights in the top projection.
Surface reflectSurfaceOf(Look l,uint material,ReflectTriangle t,float3 n,float width){
    ReflectMaterial m=reflectMaterial(l,material);
    float4 color=reflectWeights(t.a.color)*t.w.x+reflectWeights(t.b.color)*t.w.y+reflectWeights(t.c.color)*t.w.z;
    bool tint=(m.pbr.flags.y&(1u<<29))!=0;
    if(m.slots.z==0){Surface s=reflectMaterialSurface(l,m,t,n,width);if(tint){s.albedo*=color.rgb;s.alpha*=color.a;}return s;}
    float4 weights=(m.pbr.flags.y&(1u<<30))!=0?reflectPaintWeights(m,color):reflectWeights(t.a.weights)*t.w.x+reflectWeights(t.b.weights)*t.w.y+reflectWeights(t.c.weights)*t.w.z;
    if(m.slots.z<4)weights.w=0;if(m.slots.z<3)weights.z=0;if(m.slots.z<2)weights.y=0;
    float sum=dot(weights,float4(1));weights=sum>1e-8?weights/sum:float4(1,0,0,0);
    Surface s=(Surface)0;
    for(uint i=0;i<min(m.slots.z,4u);i++){
        float w=weights[i];if(w<=0)continue;
        Surface layer=reflectMaterialSurface(l,reflectMaterial(l,m.layers[i]),t,n,width);
        s.albedo+=layer.albedo*w;s.alpha+=layer.alpha*w;s.normal+=layer.normal*w;s.roughness+=layer.roughness*w;
        s.metal+=layer.metal*w;s.emissive+=layer.emissive*w;s.ao+=layer.ao*w;s.transmission+=layer.transmission*w;
    }
    s.normal=dot(s.normal,s.normal)>1e-12?normalize(s.normal):n;
    if(tint){s.albedo*=color.rgb;s.alpha*=color.a;}return s;
}
// Whether an alpha-tested candidate is solid: base colour alpha against the cutoff.
bool reflectAlphaAccept(Look l,uint instance,uint primitive,float2 bary,float width){
    ReflectTriangle t=reflectTriangle(l,instance,primitive,bary);ReflectMaterial m=reflectMaterial(l,t.material);
    if(m.pbr.flags.x!=1)return true;
    float4 color=reflectWeights(t.a.color)*t.w.x+reflectWeights(t.b.color)*t.w.y+reflectWeights(t.c.color)*t.w.z;
    float alpha=reflectMap(l,m,0,t,width).a*m.pbr.color.a;
    if((m.pbr.flags.y&(1u<<30))!=0){
        float4 weights=reflectPaintWeights(m,color);alpha=0;
        for(uint i=0;i<min(m.slots.z,4u);i++){ReflectMaterial layer=reflectMaterial(l,m.layers[i]);alpha+=weights[i]*reflectMap(l,layer,0,t,width).a*layer.pbr.color.a;}
    }
    if((m.pbr.flags.y&(1u<<29))!=0)alpha*=color.a;
    return alpha>=m.pbr.surface.w;
}
