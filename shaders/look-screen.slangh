// Screen traces shared by reflections (look-ssr.slang) and screen probe GI
// (look-screen-gi.slang): last frame's colour pyramid, and the closest-depth (Hi-Z)
// pyramid rays traverse in a few dozen steps whatever their length. Include after
// look.slangh.
// Look rows (look/screen_gi.rs ScreenGi::write; zero: none):
//   screenInfo[0]: x Hi-Z atlas (sampled), y (storage), z probe atlas (sampled), w (storage)
//   screenInfo[1]: x probe records (sampled), y (storage), z probes per row, w tile (render px)
//   screenInfo[2]: the half-resolution gather: diffuse, specular (sampled), diffuse, specular (storage)
//   screenInfo[3]: x promoted-emission pyramid (sampled), y (storage)
//   screenParams[0]: x Hi-Z steps per ray, y Hi-Z levels, z probe trace reach (m), w probe bias (render px)
//   screenParams[1]: x emitted luminance (cd/m2) above which hosts made emitter lights
// Colour pyramid of the previous resolved frame: levels 1..SSR_LEVELS of the render size
// packed side by side (as the bloom atlas), sampled between levels by footprint.
static const uint SSR_LEVELS=6;
uint2 ssrLevelSize(Frame f,uint level){return max(f.extent.xy>>level,uint2(1));}
uint2 ssrLevelOrigin(Frame f,uint level){uint x=0;for(uint j=1;j<level;j++)x+=max(f.extent.x>>j,1u);return uint2(x,0);}
// Bilinear level `level` of a pyramid atlas in that layout (sampled index `image`).
float3 pyramidLevel(Frame f,uint image,uint level,float2 uv){
    float2 size=float2(ssrLevelSize(f,level)),atlas=float2(f.extent.x,max(f.extent.y/2,1u));
    return historyTex(image,(float2(ssrLevelOrigin(f,level))+clamp(uv*size,0.5,size-0.5))/atlas).rgb;
}
float3 ssrLevel(Frame f,Look l,uint level,float2 uv){return pyramidLevel(f,l.ssrImages.x,level,uv);}
// Level 0: last frame's full-resolution history itself (root word 1, pre-exposed), so a
// near-mirror lobe reflects at full detail instead of the half-size level 1. Only the
// passes recorded with the history as their input (LookPass::SsrTrace) may read it.
float3 ssrSharp(Frame f,Look l,float2 uv){return historyTex(root.materials,uv).rgb/exposureScale(f,exposureState(l).y);}
// The colour pyramid at a fractional level (0: the sharp history).
float3 ssrPyramid(Frame f,Look l,float2 uv,float level){
    uint lo=uint(level);
    return level<1?lerp(ssrSharp(f,l,uv),ssrLevel(f,l,1,uv),level):lerp(ssrLevel(f,l,lo,uv),ssrLevel(f,l,min(lo+1,SSR_LEVELS),uv),frac(level));
}
// Levels 1..SSR_LEVELS of pyramid `image` (no history binding needed).
float3 pyramidBlurred(Frame f,uint image,float2 uv,float level){
    level=clamp(level,1,SSR_LEVELS);uint lo=uint(level);
    return lerp(pyramidLevel(f,image,lo,uv),pyramidLevel(f,image,min(lo+1,SSR_LEVELS),uv),frac(level));
}
// Pixel position (and reversed-Z depth) of a world point in the current frame.
float3 ssrProject(Frame f,float3 world){
    float4 c=mul(f.vp,float4(world,1));float3 n=c.xyz/c.w;return float3((n.x*0.5+0.5)*f.extent.x,(0.5-n.y*0.5)*f.extent.y,n.z);
}

// The Hi-Z pyramid (look-screen-gi.slang hizMain): level k holds, per cell of 2^k x
// 2^k render pixels, the closest depth (reversed-Z: the largest value) inside it. Level
// 0 is the depth target itself; levels 1.. are packed side by side in one R32F atlas,
// each ceil(extent / 2^k) cells (so cell = floor(pixel / 2^k) at every level, and the
// last odd row and column are never dropped).
static const uint HIZ_MAX_LEVELS=8;
uint2 hizSize(Frame f,uint k){return (f.extent.xy+(1u<<k)-1)>>k;}
uint hizOrigin(Frame f,uint k){uint x=0;for(uint j=1;j<k;j++)x+=hizSize(f,j).x;return x;}
float hizLoad(Frame f,Look l,uint k,int2 c){
    if(k==0)return pixel(f.extra.x,c).x;
    return pixel(l.screenInfo[0].x,int2(hizOrigin(f,k),0)+c).x;
}
// Linear view depth of reversed-Z `depth` at pixel position `xy` (metres along the view).
float hizViewDepth(Frame f,float2 xy,float depth){return dot(worldAtDepth(f,xy,depth)-f.camera.xyz,f.forward.xyz);}
// Hi-Z traversal (Uludag 2014) of the screen segment from `o` to `o + d` (pixels, and
// reversed-Z depth, which is affine along a projected segment): each step either
// skips a whole cell the ray passes in front of (and climbs a level) or descends
// where it may meet the cell's closest surface. A level-0 crossing is a hit when the
// ray lies within `thickness` (a share of the view depth, at least 5 cm) behind that
// pixel's surface; deeper, it passed behind thin foreground and crawls on behind it
// at level 0. Returns the hit's segment parameter (0..1), or -1: no hit within
// `steps` (the segment ends on screen or at the screen's edge first). Deterministic.
float hizTrace(Frame f,Look l,float3 o,float3 d,uint steps,uint levels,float thickness){
    float3 inv=float3(abs(d.x)>1e-6?1/d.x:1e12,abs(d.y)>1e-6?1/d.y:1e12,abs(d.z)>1e-12?1/d.z:1e30);
    float2 side=float2(d.x>=0?1:0,d.y>=0?1:0),nudge=float2(d.x>=0?1e-3:-1e-3,d.y>=0?1e-3:-1e-3);
    // Start just past the first pixel's edge: no self-intersection with the origin.
    float2 first=(floor(o.xy)+side-o.xy)*inv.xy;float t=min(first.x,first.y)+1e-4;
    int level=0;float2 bound=float2(f.extent.xy);
    for(uint i=0;i<steps;i++){
        if(t>1)return -1;
        float3 p=o+d*t;if(any(p.xy<0)||any(p.xy>=bound))return -1;
        float size=float(1u<<uint(level));int2 cell=int2(floor(p.xy/size));
        float surface=hizLoad(f,l,uint(level),cell);
        float2 planes=(float2(cell)+side)*size+nudge;float2 exits=(planes-o.xy)*inv.xy;float exit=min(exits.x,exits.y);
        if(p.z>surface){
            // In front of everything in the cell: does it reach the closest plane inside?
            float reach=d.z<0?(surface-o.z)*inv.z:1e30;
            if(reach<exit){t=max(t,reach);level--;}
            else{t=exit;level=min(level+1,int(levels));}
        }else if(level>0){level--;}
        else{
            // A level-0 crossing: compare view depths of the ray and the pixel's surface.
            float ray=hizViewDepth(f,p.xy,p.z),scene=hizViewDepth(f,floor(p.xy)+0.5,surface);
            if(ray-scene<max(0.05,scene*thickness))return t;
            t=exit;
        }
        if(level<0){
            // Met the closest plane of a level-0 pixel from the front: a hit there.
            p=o+d*t;float s=hizLoad(f,l,0,int2(floor(p.xy)));
            float ray=hizViewDepth(f,p.xy,p.z),scene=hizViewDepth(f,floor(p.xy)+0.5,s);
            if(abs(ray-scene)<max(0.05,scene*thickness))return t;
            level=0;t=exit;
        }
    }
    return -1;
}
// The screen segment of the world ray from `world` along unit `r` up to `reach` metres:
// clipped in world space in front of the near plane (a segment reaching behind the
// camera has no linear projection), then at the screen's edge. `a` start, `b` end
// (pixels, reversed-Z); returns the clipped world reach (the end before the screen cut).
float screenSegment(Frame f,float3 world,float3 r,float reach,out float3 a,out float3 b){
    float ahead=dot(world-f.camera.xyz,f.forward.xyz),toward=dot(r,f.forward.xyz);
    if(toward<0)reach=min(reach,max(ahead-f.camera.w*2,0)/-toward);
    a=ssrProject(f,world);b=ssrProject(f,world+r*reach);
    float2 span=b.xy-a.xy,bound=float2(f.extent.xy)-0.5;float keep=1;
    if(span.x>0)keep=min(keep,(bound.x-a.x)/span.x);else if(span.x<0)keep=min(keep,(0.5-a.x)/span.x);
    if(span.y>0)keep=min(keep,(bound.y-a.y)/span.y);else if(span.y<0)keep=min(keep,(0.5-a.y)/span.y);
    b=lerp(a,b,saturate(keep));
    return reach;
}
