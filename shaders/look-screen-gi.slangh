// Screen probe GI (look/screen_gi.rs; Lumen's screen probes as the pattern, deterministic
// and noise-free): one probe per tile of render pixels, placed on the G-buffer surface
// at the tile's centre, traces SCREEN_PROBE_RAYS fixed directions over its hemisphere
// through the Hi-Z pyramid (look-screen.slangh), shades hits from last frame's colour
// pyramid and continues misses into the world probes' radiance (look-gi.slangh). Its
// atlas tile holds that radiance (hemi-octahedral 8x8), GGX-prefiltered levels for rough
// lobes and the cosine-convolved irradiance (4x4). Pixels interpolate
// the four nearest probes that share their plane (screenProbeLobes); where none
// does, the world probes stand in. Include after look-screen.slangh.
static const uint SCREEN_PROBE_RAYS=64;
// Atlas tile per probe, 20x8 texels: x 0..7 the traced radiance (rgb, a hit distance in
// metres); four 4x4 GGX-prefiltered levels for perceptual roughness 0.4, 0.6, 0.8 and 1
// (x 8..11 y 0..3, x 12..15 y 0..3, x 8..11 y 4..7, x 12..15 y 4..7); x 16..19 y 0..3
// the cosine-convolved irradiance.
static const uint2 SCREEN_PROBE_TILE=uint2(20,8);
static const uint2 SCREEN_PROBE_IRRADIANCE=uint2(16,0);
// Probe records (one RGBA32F texel per probe): xyz world position, w the normal
// (octEncode, 16 bits per axis, as f32 bits); w zero: no probe (the tile shows sky).
uint screenProbesPerRow(Look l){return l.screenInfo[1].z;}
uint screenProbeTileSize(Look l){return l.screenInfo[1].w;}
// Hemi-octahedral mapping (Cigolle et al. 2014): the upper hemisphere (z >= 0) onto
// the unit square; directions below it fold onto the horizon.
float2 hemiOctEncode(float3 d){
    d.z=max(d.z,0);d/=abs(d.x)+abs(d.y)+d.z+1e-12;
    return float2(d.x+d.y,d.x-d.y)*0.5+0.5;
}
float3 hemiOctDecode(float2 uv){
    float2 e=uv*2-1;float2 p=float2(e.x+e.y,e.x-e.y)*0.5;
    return normalize(float3(p,1-abs(p.x)-abs(p.y)));
}
// An orthonormal frame around `n` (Duff et al. 2017): tangent, bitangent.
void probeFrame(float3 n,out float3 t,out float3 b){
    float s=n.z>=0?1:-1,a=-1/(s+n.z),c=n.x*n.y*a;
    t=float3(1+s*n.x*n.x*a,s*c,-s*n.x);b=float3(c,s+n.y*n.y*a,-n.y);
}
uint packNormal(float3 n){float2 e=octEncode(n);return uint(e.x*65535+0.5)|(uint(e.y*65535+0.5)<<16);}
float3 unpackNormal(uint v){return octDecode(float2(v&65535,v>>16)/65535.);}
// Solid angle of hemi-octahedral texel `uv` (centre) of side `texel` (in uv), from
// the mapping's Jacobian by central differences.
float hemiOctSolidAngle(float2 uv,float texel){
    float h=texel*0.25;
    float3 dx=hemiOctDecode(uv+float2(h,0))-hemiOctDecode(uv-float2(h,0));
    float3 dy=hemiOctDecode(uv+float2(0,h))-hemiOctDecode(uv-float2(0,h));
    return length(cross(dx,dy))*(texel*texel)/(4*h*h);
}
// Bilinear radiance of probe tile `origin` along local direction `local` from the
// square level at texel offset `at` with `n` texels per side, clamped inside it.
float3 screenProbeLevel(Look l,float2 atlas,uint2 origin,uint2 at,float n,float3 local){
    float2 q=clamp(hemiOctEncode(local)*n,0.5,n-0.5);
    return textures[NonUniformResourceIndex(l.screenInfo[0].z)].SampleLevel(samplers[2],(float2(origin+at)+q)/atlas,0).rgb;
}
// Level k's texel origin in a tile: 0 the traced 8x8, 1..4 the prefiltered 4x4 levels.
uint2 screenProbeLevelAt(uint k){return k==0?uint2(0,0):uint2(8+((k-1)&1)*4,((k-1)>>1)*4);}
// Pre-filtered radiance for a lobe of perceptual `roughness` along `local`: between
// the traced directions themselves (about roughness 0.2, a texel's width) and the GGX
// levels, linearly in roughness.
float3 screenProbeRadiance(Look l,float2 atlas,uint2 origin,float3 local,float roughness){
    float m=clamp((roughness-0.2)/0.2,0,4);uint lo=min(uint(m),3u);
    float3 a=screenProbeLevel(l,atlas,origin,screenProbeLevelAt(lo),lo==0?8:4,local);
    float3 b=screenProbeLevel(l,atlas,origin,screenProbeLevelAt(lo+1),4,local);
    return lerp(a,b,saturate(m-float(lo)));
}
// The weight GGX (alpha^2 `a2`, height-correlated Smith) gives light from `l` reflected
// from normal `n` towards `v` (n.v `nv`): D(h) G2 / (4 n.v n.l) n.l, constant factors
// dropped (callers normalize).
float ggxLobe(float3 n,float3 v,float3 l,float nv,float a2){
    float nl=dot(n,l);if(nl<=0)return 0;
    float nh=saturate(dot(n,normalize(v+l))),t=nh*nh*(a2-1)+1;
    return a2/(t*t)/(nl*sqrt(nv*nv*(1-a2)+a2)+nv*sqrt(nl*nl*(1-a2)+a2))*nl;
}
// Screen-probe light at render pixel `p` (surface `world`, normal `n`, view `v`,
// reflection along `reflected` for perceptual `roughness`): irradiance facing `n` and
// the radiance the specular lobe reflects (per unit albedo). The 3x3 probes around the
// pixel weigh by a tent 1.5 tiles wide (nine probes' 64 directions each: a small
// bright source one probe's rays catch and its neighbour's miss does not turn into
// blotches), times how close each lies to the pixel's plane (relative to its view
// distance) and how alike their normals are. Glossy lobes read the GGX-prefiltered
// levels along `reflected` (the split sum, n = v = r); rough ones (past roughness 0.5,
// all past 0.7) weigh the 0.4 level's 16 directions by the lobe this view really
// sees, D(h) G2 n.l with the view's own v, normalized: at grazing views it is much
// wider than the split sum's, reaching what lies ahead along the surface. Returns the
// share the probes cover (0: no probe shares the pixel's surface; the world probes
// stand in).
float screenProbeLobes(Frame f,Look l,int2 p,float3 world,float3 n,float3 v,float3 reflected,float roughness,out float3 irradiance,out float3 radiance){
    irradiance=0;radiance=0;
    uint tile=screenProbeTileSize(l),row=screenProbesPerRow(l);
    int2 grid=int2(row,(f.extent.y+tile-1)/tile);float2 atlas=float2(uint2(grid)*SCREEN_PROBE_TILE);
    float2 g=(float2(p)+0.5)/float(tile)-0.5;int2 c=int2(round(g));
    float distance=length(world-f.camera.xyz),plane=max(0.02,distance*0.015*float(tile)/16);
    float exact=smoothstep(0.5,0.7,roughness),a=roughness*roughness,a2=a*a,nv=clamp(dot(n,v),0.001,1);
    float total=0;float3 lobe=0;float lobeWeight=0;
    for(uint k=0;k<9;k++){
        int2 q=c+int2(int(k%3)-1,int(k/3)-1);if(any(q<0)||any(q>=grid))continue;
        float2 tent=saturate(1-abs(g-float2(q))/1.5);float w=tent.x*tent.y;if(w<=0)continue;
        float4 record=pixel(l.screenInfo[1].x,q);uint packed=asuint(record.w);if(packed==0)continue;
        float3 pn=unpackNormal(packed);
        w*=exp(-abs(dot(n,record.xyz-world))/plane)*pow(saturate(dot(pn,n)),4);
        if(w<1e-5)continue;
        float3 tb,bb;probeFrame(pn,tb,bb);uint2 origin=uint2(q)*SCREEN_PROBE_TILE;
        float3 ln=float3(dot(n,tb),dot(n,bb),dot(n,pn)),lr=float3(dot(reflected,tb),dot(reflected,bb),dot(reflected,pn));
        irradiance+=screenProbeLevel(l,atlas,origin,SCREEN_PROBE_IRRADIANCE,4,ln)*w;
        if(exact<1)radiance+=screenProbeRadiance(l,atlas,origin,lr,roughness)*w*(1-exact);
        [branch]if(exact>0){
            for(uint j=0;j<16;j++){
                uint2 t=uint2(j%4,j/4);float3 d=hemiOctDecode((float2(t)+0.5)/4);d=tb*d.x+bb*d.y+pn*d.z;
                float lw=ggxLobe(n,v,d,nv,a2)*w;
                if(lw>0){lobe+=pixel(l.screenInfo[0].z,int2(origin+screenProbeLevelAt(1)+t)).rgb*lw;lobeWeight+=lw;}
            }
        }
        total+=w;
    }
    if(total<=1e-5)return 0;
    irradiance/=total;radiance/=total;
    if(exact>0)radiance+=(lobeWeight>0?lobe/lobeWeight:float3(0))*exact;
    return smoothstep(0.02,0.15,total);
}
