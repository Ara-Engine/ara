// Probe-volume GI (look/gi.rs): a pool of probe lattices, finest first (a fine one
// over built-up content, a coarse one over the whole world). Each probe owns a one-time 8x8 octahedral surface
// cache (averaged hit albedo, normal, emissive, distance and sky fraction per
// texel), static 16x16 distance moments (atlas) and its relocation. Every frame the
// caches are relit (sun, local lights, sky, emissive, last frame's probes for
// bounces) into an 8x8 octahedral radiance atlas (what each probe sees, and how far,
// in 64 directions: the reflections' radiance cache) and the 6x6 irradiance atlas it
// convolves to, both sampled DDGI-style with Chebyshev visibility and hardware
// bilinear filtering.
// Include after look.slangh. No rays are traced at runtime.
// Fold bilinear taps across octahedral edges, including the shared corner.
uint octIndex(int2 p,int size){
    if(p.x<0){p.x=-p.x-1;p.y=size-1-p.y;}else if(p.x>=size){p.x=2*size-1-p.x;p.y=size-1-p.y;}
    if(p.y<0){p.y=-p.y-1;p.x=size-1-p.x;}else if(p.y>=size){p.y=2*size-1-p.y;p.x=size-1-p.x;}
    return uint(p.y*size+p.x);
}
// Solid angle of texel `t` of a `size`-texel octahedral map (octDecode's mapping).
// Before normalizing, octDecode lands on the octahedron |x|+|y|+|z| = 1, where a
// unit of uv area spans 4/|p|^3 steradians; 4x4 midpoints integrate it within 1%.
// Texels near the axes cover about half the mean (4 pi / size^2), diagonal ones 1.5x.
float octSolidAngle(uint2 t,uint size){
    float sum=0;
    for(uint k=0;k<16;k++){
        float2 e=(float2(t)+(float2(k%4,k/4)+0.5)/4)/float(size)*2-1;
        float3 p=float3(e,1-abs(e.x)-abs(e.y));float s=max(-p.z,0);p.x+=p.x>=0?-s:s;p.y+=p.y>=0?-s:s;
        float r=length(p);sum+=1/(r*r*r);
    }
    return sum*4/(16*float(size*size));
}
// Mean hit distance (m) of a surface-cache texel, for reflections' parallax: the top
// byte of its normal word, eight bits of log2 (look/gi.rs log_distance).
float giParallax(uint normalWord){return exp2(float(normalWord>>24)/255*24-8);}
// IEEE half to float from bits; no 16-bit shader capabilities are required.
float halfToFloat(uint h){uint e=(h>>10)&31,m=h&1023;float v=e==0?float(m)*exp2(-24.):exp2(float(e)-15.)*(1+float(m)/1024.);return (h&0x8000)!=0?-v:v;}
// A pool shades once converged, fading in by its weight (look/gi.rs GiGpu::weight).
float giWeight(Look l){return asfloat(l.giUpdate.w);}
bool giEnabled(Look l){return l.giCounts.w>0 && giWeight(l)>0;}
// One lattice of the probe pool (look/gi.rs ProbeLayout; finest first): first probe
// centre and edge falloff (cells), spacing and surface bias (m), dimensions and
// first global probe id.
// Rows are picked with constant indices only: indexing the record's arrays by a
// variable spills them to local memory in every shader that includes this.
struct GiLattice{float3 origin;float falloff;float3 spacing;float bias;uint3 counts;uint base;};
// Distance the lattice's moments clamp to and are normalized by (look/gi.rs moment_limit).
float giMomentLimit(GiLattice g){return 2*max(g.spacing.x,max(g.spacing.y,g.spacing.z));}
GiLattice giLattice(Look l,uint i){
    float4 o=i==0?l.giLatticeOrigin[0]:i==1?l.giLatticeOrigin[1]:i==2?l.giLatticeOrigin[2]:l.giLatticeOrigin[3];
    float4 s=i==0?l.giLatticeSpacing[0]:i==1?l.giLatticeSpacing[1]:i==2?l.giLatticeSpacing[2]:l.giLatticeSpacing[3];
    uint4 c=i==0?l.giLatticeCounts[0]:i==1?l.giLatticeCounts[1]:i==2?l.giLatticeCounts[2]:l.giLatticeCounts[3];
    GiLattice g;g.origin=o.xyz;g.falloff=o.w;g.spacing=s.xyz;g.bias=s.w;g.counts=c.xyz;g.base=c.w;return g;
}
// The lattice holding global probe `id`.
uint giLatticeOf(Look l,uint id){
    uint n=l.giCounts.x;
    return (n>3 && id>=l.giLatticeCounts[3].w)?3:(n>2 && id>=l.giLatticeCounts[2].w)?2:(n>1 && id>=l.giLatticeCounts[1].w)?1:0;
}
float3 giProbePosition(Look l,uint id){
    GiLattice g=giLattice(l,giLatticeOf(l,id));uint local=id-g.base;
    uint x=local%g.counts.x,y=(local/g.counts.x)%g.counts.y,z=local/(g.counts.x*g.counts.y);
    return g.origin+float3(x,y,z)*g.spacing;
}
// Relocation offset (xyz) and active flag (w).
float4 giMeta(Look l,uint probe){return buffers[NonUniformResourceIndex(l.giBuffers.y)].Load<float4>(probe*16);}
// Probe tiles in an atlas, `l.giUpdate.z` per row, each with a one-texel border
// folded across the octahedral edges so hardware bilinear filtering is seamless.
uint2 giTile(Look l,uint probe,uint size){uint w=l.giUpdate.z;return uint2(probe%w,probe/w)*(size+2)+1;}
float2 giAtlas(Look l,uint size){uint w=l.giUpdate.z;return float2(w,(l.giCounts.w+w-1)/w)*(size+2);}
float3 giSampleIrradiance(Look l,uint image,uint probe,float3 direction){
    return textures[NonUniformResourceIndex(image)].SampleLevel(samplers[2],(float2(giTile(l,probe,6))+octEncode(direction)*6)/giAtlas(l,6),0).rgb;
}
// Radiance a probe sees along `direction` (rgb) and the distance to it (w; far for
// the sky), from the bordered 8x8 radiance atlas.
float4 giSampleRadiance(Look l,uint probe,float3 direction){
    return textures[NonUniformResourceIndex(l.giRadiance.x)].SampleLevel(samplers[2],(float2(giTile(l,probe,8))+octEncode(direction)*8)/giAtlas(l,8),0);
}
// Radiance reflected towards a point at `offset` from probe `id` along `reflection`,
// parallax-corrected: the reflected ray meets the surroundings where the probe saw
// them (a sphere of the distance it recorded along that direction), and the probe is
// read towards that point, as box-projected reflection captures are.
float3 giProbeReflection(Look l,uint id,float3 offset,float3 reflection){
    float4 seen=giSampleRadiance(l,id,reflection);
    float b=dot(offset,reflection),disc=b*b-dot(offset,offset)+seen.w*seen.w;
    if(disc>0){float3 hit=offset+reflection*(sqrt(disc)-b);if(dot(hit,hit)>1e-6)seen=giSampleRadiance(l,id,normalize(hit));}
    return seen.rgb;
}
// Chebyshev visibility of a point `distance` metres from probe `probe` along
// `direction`, from its 16x16 per-texel distance moments (mean, mean squared; the
// atlas holds them over `limit`, look/gi.rs moment_limit), crushed cubically. The four nearest texels each test the point and their visibilities blend
// bilinearly (percentage-closer style), so it varies smoothly across texel borders
// without blending the moments themselves: a mixture of a wall's near distance and
// the open space past its edge has a huge variance that passes any point, and would
// leak the outside through walls thinner than the probe spacing.
float giVisibility(Look l,uint probe,float3 direction,float distance,float limit){
    float2 q=float2(giTile(l,probe,16))+octEncode(direction)*16-0.5;int2 b=int2(floor(q));float2 t=q-float2(b);float sum=0;
    for(uint k=0;k<4;k++){
        int2 o=int2(k&1,k>>1);float2 m=textures[NonUniformResourceIndex(l.giImages.w)].Load(int3(b+o,0)).xy*float2(limit,limit*limit);
        float variance=max(m.y-m.x*m.x,0.0001);float v=distance<=m.x?1:pow(variance/(variance+(distance-m.x)*(distance-m.x)),3);
        sum+=v*(o.x==1?t.x:1-t.x)*(o.y==1?t.y:1-t.y);
    }
    return sum;
}
// Weight of lattice `g` at `p`: one inside, falling smoothly to zero over its outer
// `falloff` cells (from half a cell outside its outermost probes).
float giLatticeCoverage(GiLattice g,float3 p){
    float3 grid=(p-g.origin)/g.spacing,extent=float3(g.counts)-1;
    float3 inside=saturate((min(grid,extent-grid)+0.5)/g.falloff);inside=inside*inside*(3-2*inside);
    return inside.x*inside.y*inside.z;
}
// Irradiance facing `normal` from one lattice's eight probes and, with `both`, the
// radiance a surface of perceptual `roughness` reflects along `reflection`: the
// probes' parallax-corrected radiance (giProbeReflection), blending into their
// irradiance (a cosine lobe, over PI) by GGX's alpha as the lobe outgrows the
// radiance texels. DDGI weights: trilinear, backface and Chebyshev visibility against
// static moments, the latter two crushed cubically below 0.2 so probes behind thin
// walls do not leak; a point seeing under a third of its probes' unoccluded weight
// darkens by its share. The point is offset along the normal and towards `v` by the
// lattice's surface bias.
void giLatticeLobes(Look l,GiLattice g,uint image,float3 position,float3 normal,float3 reflection,float3 v,float roughness,bool both,out float3 diffuse,out float3 specular,bool irradiance=true){
    float rough=saturate(roughness*roughness);
    float3 biased=position+normal*g.bias+v*(g.bias*0.33);float3 grid=(biased-g.origin)/g.spacing;
    float lift=0.05*max(g.spacing.x,max(g.spacing.y,g.spacing.z));
    int3 base=clamp(int3(floor(grid)),int3(0),int3(g.counts)-2);float3 alpha=saturate(grid-base);diffuse=0;specular=0;float total=0,open=0;
    for(uint k=0;k<8;k++){
        uint3 d=uint3(k&1,(k>>1)&1,(k>>2)&1);uint3 p=uint3(base)+d;uint id=g.base+(p.z*g.counts.y+p.y)*g.counts.x+p.x;
        float4 meta=giMeta(l,id);if(meta.w<0.5)continue;
        float3 delta=biased-(g.origin+float3(p)*g.spacing)-meta.xyz;float distance=length(delta);float3 dir=delta/max(distance,1e-6);
        // Visibility tests the point lifted off its surface by a share of the largest
        // spacing: on a flat landform's lattice (far apart, a quarter metre high) every
        // point lies at a grazing angle from probes just above the ground, in texels
        // whose rays mostly hit the ground nearby, and would read as hidden.
        float3 tested=delta+normal*lift;float far=length(tested);
        float visibility=giVisibility(l,id,tested/max(far,1e-6),far,giMomentLimit(g));
        float3 trilinear=lerp(1-alpha,alpha,float3(d));float cell=trilinear.x*trilinear.y*trilinear.z;
        float facing=max(0.02,pow(saturate(dot(-dir,normal)*0.5+0.5),2));float unseen=facing<0.2?facing*facing*facing/0.04:facing;
        float weight=facing*visibility;if(weight<0.2)weight*=weight*weight/0.04;weight*=cell;
        if(irradiance)diffuse+=giSampleIrradiance(l,image,id,normal)*weight;
        if(both){
            float3 s=0;
            [branch]if(rough<0.98)s=giProbeReflection(l,id,position-(g.origin+float3(p)*g.spacing)-meta.xyz,reflection)*(1-rough);
            [branch]if(rough>0.02)s+=giSampleIrradiance(l,image,id,reflection)*(rough/PI);
            specular+=s*weight;
        }
        total+=weight;open+=unseen*cell;
    }
    // Normalizing alone hands a point that sees none of its probes (a gap narrower than
    // the spacing, between two blocks) the full light of the least-occluded one, often
    // one in the open: light wrapping into the gap. Below a third of the weight the
    // probes would carry unoccluded, the point darkens with its visible share.
    if(total>1e-6){float seen=smoothstep(0,0.33,total/max(open,1e-6));diffuse*=seen/total;specular*=seen/total;}
}
// Irradiance (and reflected radiance, giLatticeLobes) from the pool at `position`:
// lattices front to back, finest first,
// each weighted by its coverage of what the finer ones left, so a fine lattice
// blends into the coarse one across its falloff without a seam. Returns the pool's
// coverage (the coarsest lattice fades to the sky at its own edge); `v` biases
// towards the viewer (zero for probe relighting). `irradiance` false skips the diffuse
// lobe (callers that read only the reflection; a literal at every call site).
float giPoolLobes(Look l,uint image,float3 position,float3 normal,float3 reflection,float3 v,float roughness,bool both,out float3 diffuse,out float3 specular,bool irradiance=true){
    diffuse=0;specular=0;float remaining=1;
    for(uint i=0;i<l.giCounts.x&&remaining>1e-3;i++){
        // Finer lattices cross-fade in once they land after the coarsest (giParams.y).
        GiLattice g=giLattice(l,i);float c=giLatticeCoverage(g,position)*(i+1<l.giCounts.x?l.giParams.y:1);
        if(c<=0)continue;
        float w=c*remaining;float3 d,s;giLatticeLobes(l,g,image,position,normal,reflection,v,roughness,both,d,s,irradiance);
        diffuse+=d*w;specular+=s*w;remaining-=w;
    }
    float coverage=1-remaining;if(coverage>1e-6){diffuse/=coverage;specular/=coverage;}
    return coverage;
}
// Diffuse irradiance at `position` facing `normal` from the pool in atlas `image`.
float3 giIrradiance(Look l,uint image,float3 position,float3 normal){
    float3 d,s;giPoolLobes(l,image,position,normal,normal,float3(0,0,0),1,false,d,s);return d;
}
