// Ara raster core ABI: bindings, the frame record and scene records shared by every
// raster shader. Column-major matrices, metres, linear HDR, reversed-Z.
// `cascade`: the shadow pass; native G-buffer and forward passes carry the texture
// footprint scale there instead (f32 bits of Frame.upscale.z; zero reads as one).
struct Root { uint frame; uint materials; uint material; uint entity; uint cascade; uint mode; uint sample; uint flags; };
#ifdef VULKAN
#define BIND(n) [[vk::binding(n,0)]]
[[vk::push_constant]] ConstantBuffer<Root> root;
#else
#define BIND(n)
ConstantBuffer<Root> root : register(b0,space0);
#endif
BIND(5) Texture2D<float4> textures[] : register(t0,space1);
BIND(1) RWByteAddressBuffer buffers[] : register(u0,space2);
BIND(2) SamplerState samplers[3] : register(s0,space0);
BIND(3) RWTexture2D<float4> images[64] : register(u0,space3);
static const float PI=3.14159265359;
struct Frame {
    float4x4 vp;
    float4x4 previousVp; // last frame's, unjittered (history is in unjittered screen space)
    float4x4 inverseVp;
    float4x4 shadows[4];
    float4 camera;
    float4 forward;
    float4 sunDirection;
    float4 sunColorExposure;
    float4 splits;
    uint4 extent;
    uint4 gbuffer;
    uint4 extra;
    uint4 lighting;
    uint4 post;
    uint4 temporal;
    // x: look constants buffer (look.slangh); y cascade texels, z cascades; w:
    // sampled native motion (RG16F, unjittered current-minus-previous UV),
    // u32::MAX without.
    uint4 look;
    // Temporal upscaling (Renderer::resize_upscaled): xy render size (scene passes,
    // G-buffer, HDR), zw display size (history, output). `extent` holds one of the
    // two: render in the scene passes' record, display in the resolve/post record.
    uint4 sizes;
    // xy this frame's sample offset from render pixel centres in render pixels (+y
    // down; zero without jitter), z texture footprint scale (render / display), w unused.
    float4 upscale;
};
// Shaded surface. `ao` is material ambient occlusion (opaque G-buffer albedo.a).
// `transmission` (0..1, resolved factor times map) is the share of diffuse light
// passing through a forward (transparent) surface instead of scattering; opaque
// G-buffer surfaces have none.
struct Surface {float3 albedo;float alpha;float3 normal;float roughness;float metal;float3 emissive;float ao;float transmission;};
struct Material { float4 color; float4 emissiveRoughness; float4 surface; uint4 textures; uint4 flags; };
struct Light {float4 positionRange;float4 colorLumens;float4 directionOuter;float4 parameters;};
// Tiled light lists (ara_render::scene::TILE_LIGHTS): a count, then the indices.
static const uint TILE_LIGHTS=128,TILE_STRIDE=TILE_LIGHTS+1;
Frame frame() {return buffers[NonUniformResourceIndex(root.frame)].Load<Frame>(0);}
float4 tex(uint index,float2 uv) {return textures[NonUniformResourceIndex(index)].SampleLevel(samplers[0],uv,0);}
float4 envTex(uint index,float2 uv) {return textures[NonUniformResourceIndex(index)].SampleLevel(samplers[1],uv,0);}
float4 historyTex(uint index,float2 uv) {return textures[NonUniformResourceIndex(index)].SampleLevel(samplers[2],uv,0);}
float4 pixel(uint index,int2 p) {return textures[NonUniformResourceIndex(index)].Load(int3(p,0));}
// World position at a (sub)pixel `position` and reversed-Z `depth`, through the
// jittered inverse view-projection the G-buffer was drawn with.
float3 worldAtDepth(Frame f,float2 position,float depth){
    float2 uv=position/float2(f.extent.xy);float4 h=mul(f.inverseVp,float4(uv.x*2-1,1-uv.y*2,depth,1));return h.xyz/h.w;
}
// Octahedral unit-vector encoding into [0,1]^2 (G-buffer normals, probe atlases).
float2 octEncode(float3 n){n/=abs(n.x)+abs(n.y)+abs(n.z);float2 p=n.xy;if(n.z<0)p=(1-abs(p.yx))*float2(p.x>=0?1:-1,p.y>=0?1:-1);return p*0.5+0.5;}
float3 octDecode(float2 p){p=p*2-1;float3 n=float3(p,1-abs(p.x)-abs(p.y));float t=saturate(-n.z);n.xy+=float2(n.x>=0?-t:t,n.y>=0?-t:t);return normalize(n);}
// The compact G-buffer (Renderer targets): RGBA8 sRGB albedo + material AO,
// RG16 octahedral normal, RGBA8 roughness/metal, B10G11R11 emissive; positions
// come from depth. The fill and forward outputs encode with gbufferEncode*, and
// every consumer decodes through these, so the formats change in one place.
// Base colour (rgb) and material ambient occlusion (a).
float4 gbufferAlbedo(Frame f,int2 p){return pixel(f.gbuffer.x,p);}
// Unit world normal (arbitrary where no surface was drawn).
float3 gbufferNormal(Frame f,int2 p){return octDecode(pixel(f.gbuffer.y,p).xy);}
// Perceptual roughness (x) and metalness (y).
float2 gbufferMaterial(Frame f,int2 p){return pixel(f.gbuffer.z,p).xy;}
// How much the surface occludes screen-space ambient occlusion: alpha-tested
// cutouts (chain-link, leaves) are mostly holes the depth buffer cannot show, so
// they receive it but cast none; solid surfaces cast it fully.
float gbufferOccluder(Frame f,int2 p){return pixel(f.gbuffer.z,p).z;}
// Emitted radiance.
float3 gbufferEmissive(Frame f,int2 p){return pixel(f.gbuffer.w,p).rgb;}
// Fill-side encodings; `alpha` is the forward pass's blend weight (one for opaque).
float4 gbufferEncodeNormal(float3 n,float alpha){return float4(octEncode(n),0,alpha);}
float4 gbufferEncodeMaterial(float roughness,float metal,float occluder,float alpha){return float4(roughness,metal,occluder,alpha);}
float4 gbufferEncodeEmissive(float3 emissive,float alpha){return float4(min(emissive,65000),alpha);}
// Reversed-Z depth: zero where no opaque surface was drawn.
float gbufferDepth(Frame f,int2 p){return pixel(f.extra.x,p).x;}
// World position of pixel `p`'s opaque surface, rebuilt from depth; `covered` is
// false where none was drawn.
float3 gbufferWorld(Frame f,int2 p,out bool covered){
    float depth=gbufferDepth(f,p);covered=depth>0;return worldAtDepth(f,float2(p)+0.5,depth);
}
float2 environmentUv(float3 d) {return float2(atan2(d.z,d.x)/(2*PI)+0.5,acos(clamp(d.y,-1.,1.))/PI);}
float3 environmentDirection(float2 uv) {float phi=(uv.x-0.5)*2*PI;float theta=uv.y*PI;return float3(cos(phi)*sin(theta),cos(theta),sin(phi)*sin(theta));}
