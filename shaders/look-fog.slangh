// Fog media and their lighting, shared by the coarse fog grid (look-sky.slang fogMain)
// and the near froxel volume (look-volumetric.slang; look/volumetric.rs). Include after
// look-shading.slangh.
//
// A local fog volume (look/volumetric.rs FogVolume::row): world-to-local rows onto the
// unit sphere or cube, then x density (1/m), y height falloff (1/m), z radial falloff
// share, w shape (1 box); albedo rgb and the centre's height; emission rgb.
struct FogVolumeRecord{float4 local0;float4 local1;float4 local2;float4 shape;float4 albedo;float4 emissive;};
static const uint FOG_VOLUME_BYTES=96;
// Participating media at a point: grey extinction (1/m), scattering coefficient (rgb:
// extinction times albedo) and emitted radiance per metre.
struct FogMedium{float extinction;float3 scattering;float3 emission;};
// Height fog (LOOK_FOG; on volumetric fog its extinction scale and emission) plus every
// local fog volume holding `p`.
FogMedium fogMedium(Frame f,Look l,float3 p){
    FogMedium m;m.extinction=0;m.scattering=0;m.emission=0;
    if((l.flags.y&LOOK_FOG)!=0){
        float profile=exp(-max(p.y-l.look.z,0)/l.atmosphere.z),density=l.atmosphere.y*profile;
        bool lit=(l.flags.y&LOOK_FOG_SHADOWED)!=0;
        m.extinction=density*(lit?l.volumetric.w:1);m.scattering=density*l.atmosphere.w*l.fog.rgb;
        if(lit)m.emission=l.volumetricEmissive.rgb*profile;
    }
    for(uint i=0;i<l.volumetricAtlas.z;i++){
        // The look record's row (uniform): no NonUniformResourceIndex.
        FogVolumeRecord v=buffers[f.look.x].Load<FogVolumeRecord>(l.volumetricAtlas.w+i*FOG_VOLUME_BYTES);
        float4 h=float4(p,1);float3 q=float3(dot(v.local0,h),dot(v.local1,h),dot(v.local2,h));
        float r=v.shape.w>0.5?max(abs(q.x),max(abs(q.y),abs(q.z))):length(q);
        if(r>=1)continue;
        float profile=smoothstep(0,1,saturate((1-r)/max(v.shape.z,1e-3)))*exp(clamp(-v.shape.y*(p.y-v.albedo.w),-30.,10.));
        float density=v.shape.x*profile;
        m.extinction+=density;m.scattering+=density*v.albedo.rgb;m.emission+=v.emissive.rgb*profile;
    }
    // Energy conservation under an extinction scale below one.
    m.scattering=min(m.scattering,float3(m.extinction,m.extinction,m.extinction));
    return m;
}
// Probe irradiance facing up plus facing down (E(+y)+E(-y)) at a point in open air,
// from the pool in atlas `image`: each lattice's eight probes trilinear and
// Chebyshev-weighted against their moments (no surface, so no backface weight),
// lattices finest first as giPoolLobes blends them. Returns the pool's coverage.
float giFogIrradiance(Look l,uint image,float3 p,out float3 sum){
    sum=0;float remaining=1;
    for(uint i=0;i<l.giCounts.x&&remaining>1e-3;i++){
        GiLattice g=giLattice(l,i);float c=giLatticeCoverage(g,p)*(i+1<l.giCounts.x?l.giParams.y:1);
        if(c<=0)continue;
        float3 grid=(p-g.origin)/g.spacing;int3 base=clamp(int3(floor(grid)),int3(0),int3(g.counts)-2);float3 alpha=saturate(grid-base);
        float3 lattice=0;float total=0;
        for(uint k=0;k<8;k++){
            uint3 d=uint3(k&1,(k>>1)&1,(k>>2)&1);uint3 q=uint3(base)+d;uint id=g.base+(q.z*g.counts.y+q.y)*g.counts.x+q.x;
            float4 meta=giMeta(l,id);if(meta.w<0.5)continue;
            float3 delta=p-(g.origin+float3(q)*g.spacing)-meta.xyz;float distance=length(delta);
            float2 moments=giSampleMoments(l,id,delta/max(distance,1e-6));
            float variance=max(moments.y-moments.x*moments.x,0.0001);float visibility=distance<=moments.x?1:pow(variance/(variance+pow(distance-moments.x,2)),3);
            float3 t=lerp(1-alpha,alpha,float3(d));float weight=visibility;if(weight<0.2)weight*=weight*weight/0.04;weight*=t.x*t.y*t.z;
            lattice+=(giSampleIrradiance(l,image,id,float3(0,1,0))+giSampleIrradiance(l,image,id,float3(0,-1,0)))*weight;total+=weight;
        }
        if(total>1e-6)lattice/=total;
        float w=c*remaining;sum+=lattice*w;remaining-=w;
    }
    float coverage=1-remaining;if(coverage>1e-6)sum/=coverage;
    return coverage;
}
// Mean radiance the fog's particles receive at `p` besides the sun and local lights
// (an isotropic share, (E up + E down) / 2 pi): probe GI where the pool covers `p`, so
// enclosed rooms are lit by their own bounce rather than the open sky; elsewhere the
// sky's (or environment's) irradiance under distant landforms (horizonSky).
float3 fogAmbient(Frame f,Look l,float3 p){
    uint irradiance=physicalSky(l)?l.sampled1.x:f.lighting.x;
    float3 sky=(envTex(irradiance,environmentUv(float3(0,1,0))).rgb+envTex(irradiance,environmentUv(float3(0,-1,0))).rgb)*skyLight(l);
    float coverage=0;float3 probes=0;
    [branch]if(giEnabled(l))coverage=giFogIrradiance(l,l.giImages.y,p,probes)*giWeight(l);
    if(coverage<0.99)sky*=horizonSky(l,p);
    return lerp(sky,probes,coverage)/(2*PI);
}
// Visibility of `p` from shadowed local light `index` (`light`, shape row `shape`) for fog:
// look-shadow.slangh shadowFog in its face (media have no surface), the source's penumbra
// or `footprint` (m) wide, whichever is wider.
float fogLocalShadow(Look l,Light light,LightShape shape,uint index,float3 p,float footprint,bool smooth=false){
    ShadowMap s;if(!shadowLocal(l,index,p,light.positionRange.xyz,light.positionRange.w,s))return 1;
    float v=shadowFog(l,s,p,normalize(light.positionRange.xyz-p),localShadowLightShaped(light,shape,p),footprint,smooth);return v<0?1:v;
}
// Squared distance inside which a source's near field softens for fog, which sees it
// from its centre: the radius of a disc of its emitting area (a sphere's or disc's
// radius; a tube's or rect's equal-area radius), at least 10 cm. `shape`: its shape row.
float fogNearField(Light light,LightShape shape){
    float r=light.parameters.z,r2=r*r;
    if(lightKind(light)==LIGHT_RECT)r2=4*shape.rect.x*shape.rect.y/PI;
    else if(lightKind(light)<LIGHT_RECT)r2+=2*r*shape.tangentLength.w/PI;
    return max(0.01,r2);
}
// The shape row fog's lighting of `light` (`index`) reads; zero when it has none.
LightShape fogLightShape(Frame f,Light light,uint index){return lightShaped(light)?loadLightShape(f.lighting.w,index):(LightShape)0;}
// Solid angle of the triangle with corners `a`, `b`, `c` seen from the origin (Van
// Oosterom and Strackee 1983).
float solidAngleTriangle(float3 a,float3 b,float3 c){
    float la=length(a),lb=length(b),lc=length(c);
    return 2*atan2(abs(dot(a,cross(b,c))),la*lb*lc+dot(a,b)*lc+dot(a,c)*lb+dot(b,c)*la);
}
// Light local light `light` (shape row `shape`) sends through `p` from every direction it
// covers there (luminance times solid angle: what fog scatters, before the phase
// function), and the direction towards it (`toward`). Area sources keep their exact near
// field, so beams stay flat and bright right under a wide emitter: a rect's luminance
// over the solid angle of the part its barn doors leave visible, a sphere's over its cap,
// a disc's over its ellipse (exact on its axis and far away). Ideal points and tubes take
// their intensity over the squared distance, at least `nearField` (fogNearField). Far
// away every kind is its lightIntensity over the squared distance.
float3 fogLightIllumination(Look l,Light light,LightShape shape,float nearField,float3 p,out float3 toward){
    float3 delta=light.positionRange.xyz-p;float d2=dot(delta,delta),d=sqrt(d2);toward=delta/max(d,1e-6);
    uint kind=lightKind(light);float r=light.parameters.z;
    if(kind==LIGHT_RECT){
        float3 n=light.directionOuter.xyz,t=shape.tangentLength.xyz,b=cross(t,n);float z=-dot(delta,n);
        if(z<=0||d>=light.positionRange.w)return 0;
        float2 extent=max(shape.rect.xy,0.001),sx=barnDoorSpan(extent.x,-dot(delta,t),z,shape.rect.zw),sy=barnDoorSpan(extent.y,-dot(delta,b),z,shape.rect.zw);
        if(sx.x>=sx.y||sy.x>=sy.y)return 0;
        float3 c0=delta+t*sx.x+b*sy.x,c1=delta+t*sx.y+b*sy.x,c2=delta+t*sx.y+b*sy.y,c3=delta+t*sx.x+b*sy.y;
        toward=normalize(c0+c2);
        float omega=solidAngleTriangle(c0,c1,c2)+solidAngleTriangle(c0,c2,c3);
        float luminance=light.colorLumens.w/(4*PI)/(4*extent.x*extent.y);
        return light.colorLumens.rgb*(luminance*omega*lightFade(light,d)*lightProfile(l,shape.tables.x,light,shape,-toward));
    }
    float3 intensity=lightIntensityShaped(l,light,shape,p);
    if(all(intensity<=0))return 0;
    if(kind==LIGHT_DISC){
        // Omega / (pi r^2 cos) of the disc's ellipse, 2 (1 - d / s) / (r^2 cos), s^2 = d^2 + r^2 cos.
        float c=-dot(delta,light.directionOuter.xyz)/max(d,1e-6),s=sqrt(d2+r*r*c);
        return intensity*(2/(s*(s+d)));
    }
    if(r>0&&shape.tangentLength.w<=0){
        // A sphere's cap over its disc: 2 (1 - sqrt(1 - r^2/d^2)) / r^2.
        float dd=max(d2,r*r);
        return intensity*(2/(dd*(1+sqrt(1-r*r/dd))));
    }
    return intensity/max(d2,nearField);
}
// In-scattering local light `index` (`light`) gives fog at `p` seen along `d`
// (illumination times the phase function; multiply by the scattering coefficient): its
// light through `p` (fogLightIllumination: its intensity's falloff, a spot's cone, a
// rect's or disc's one-sided cosine, barn doors and light profile, with area sources'
// near field), its shadow where the fog samples local shadows (LOOK_LOCAL_INDIRECT), and
// its volumetric scattering intensity (parameters.w; zero keeps it out of fog).
// `footprint`: the sample's radius (m), the shadow's narrowest filter. `shape` and
// `nearField`: fogLightShape and fogNearField, loaded once per light. `smooth`:
// shadowFog's continuous level blend (per-pixel fog).
float3 fogLocalLight(Look l,Light light,uint index,LightShape shape,float nearField,float3 p,float3 d,float g,float footprint=0,bool smooth=false){
    if(light.parameters.w<=0)return 0;
    float3 toward;float3 lit=fogLightIllumination(l,light,shape,nearField,p,toward);
    if(all(lit<=0))return 0;
    float shadow=(l.flags.y&LOOK_LOCAL_INDIRECT)!=0?fogLocalShadow(l,light,shape,index,p,footprint,smooth):1;
    return lit*(light.parameters.w*shadow*phaseM(dot(d,toward),g));
}
// fogLocalLight loading the light's shape row.
float3 fogLocalLight(Frame f,Look l,Light light,uint index,float3 p,float3 d,float g,float footprint=0){
    LightShape shape=fogLightShape(f,light,index);
    return fogLocalLight(l,light,index,shape,fogNearField(light,shape),p,d,g,footprint);
}
// Length-weighted share of a homogeneous segment's source that leaves it (Hillaire's
// energy-conserving integral, (1 - exp(-e ds)) / e), stable for clear air.
float segmentWeight(float e,float ds){float x=e*ds;return x<1e-4?ds*(1-0.5*x):(1-exp(-x))/e;}
float3 segmentWeight(float3 e,float ds){return float3(segmentWeight(e.x,ds),segmentWeight(e.y,ds),segmentWeight(e.z,ds));}
