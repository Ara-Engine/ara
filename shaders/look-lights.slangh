// Local lights (ara_render::scene::Light, LIGHT_BYTES per record): ideal points and
// spots, their sphere and tube sources, rect lights with barn doors and discs, shaded
// physically: area sources with linearly transformed cosines (Heitz, Dupuy, Hill and
// Neubelt 2016; discs and spheres after Heitz and Hill 2017), against the GGX tables
// look::ltc fits to Ara's own lobe (look.lightInfo[0]: x inverse matrices, y the
// horizon-clipped sphere integral). Every consumer (deferred and forward shading, ray
// hits, probe relight, fog) reads records through these helpers.
// Include after raster.slangh and look.slangh.
static const uint LIGHT_BYTES=112;
// Light kinds (parameters.x modulo LIGHT_SHAPED).
static const uint LIGHT_POINT=0,LIGHT_SPOT=1,LIGHT_RECT=2,LIGHT_DISC=3;
// Added to a point's or spot's kind when its shape row matters to it (a light
// profile; sphere and tube sources have a radius, which marks them already).
static const uint LIGHT_SHAPED=4;
// The record past raster.slangh's 64-byte core (scene::Light): xyz the unit width axis
// (rect width, tube axis, profile azimuth zero), w the tube's length (m); the rect's
// half width and height (m) and its barn-door tips' outward and normal offsets (m);
// light-table word offsets (Renderer::set_light_tables; zero none): x profile.
struct LightShape{float4 tangentLength;float4 rect;uint4 tables;};
Light loadLight(uint buffer,uint index){return buffers[NonUniformResourceIndex(buffer)].Load<Light>(index*LIGHT_BYTES);}
LightShape loadLightShape(uint buffer,uint index){return buffers[NonUniformResourceIndex(buffer)].Load<LightShape>(index*LIGHT_BYTES+64);}
uint lightKind(Light light){return uint(light.parameters.x+0.5)%LIGHT_SHAPED;}
// Whether the light shades as an area (rect, disc, or a point or spot with a source).
bool lightHasArea(Light light){return lightKind(light)>=LIGHT_RECT||light.parameters.z>0;}
// Whether its shape row matters (an area or a profile; tubes have a radius).
bool lightShaped(Light light){return light.parameters.x>1.5||light.parameters.z>0;}
// Windowed inverse-square reach: one near the source, zero at its range.
float lightFade(Light light,float d){return pow(saturate(1-pow(d/light.positionRange.w,4)),2);}
// A spot's cone weight along `fromLight` (unit, light to point); one for other kinds.
float lightCone(Light light,float3 fromLight){
    return lightKind(light)==LIGHT_SPOT?smoothstep(light.directionOuter.w,max(light.directionOuter.w+1e-4,light.parameters.y),dot(fromLight,light.directionOuter.xyz)):1;
}
// The span of a rect's half extent `a` along one of its axes that a point at offset `p`
// on that axis and height `z` above the light (z > 0) sees past the barn doors: flaps
// hinged at the two edges whose tips lie `door.x` further out and `door.y` above the
// plane. Exact for each axis (lines past both flaps of an axis are linear in the point
// on the light). Empty when x >= y.
float2 barnDoorSpan(float a,float p,float z,float2 door){
    if(door.y<=0)return float2(-a,a);
    if(z<=door.y){float reach=a+door.x*z/door.y;return abs(p)<=reach?float2(-a,a):float2(1,-1);}
    float k=door.y/z,edge=a+door.x;
    return float2(max(-a,(-edge-p*k)/(1-k)),min(a,(edge-p*k)/(1-k)));
}
// The photometric profile at word `offset` of the light tables (look.lightInfo[0].z;
// look::Renderer::set_light_tables) towards `fromLight` (unit, from the light): nadir
// along its axis, azimuth zero along its width axis; bilinear, peak one. One without.
float lightProfile(Look l,uint offset,Light light,LightShape shape,float3 fromLight){
    uint buffer=l.lightInfo[0].z;if(offset==0)return 1;
    uint2 size=buffers[NonUniformResourceIndex(buffer)].Load2(offset*4);
    float3 n=light.directionOuter.xyz,t=shape.tangentLength.xyz,b=cross(t,n);
    float v=acos(clamp(dot(fromLight,n),-1.,1.))/PI*float(size.x-1),h=(atan2(dot(fromLight,b),dot(fromLight,t))/(2*PI)+1)*float(size.y);
    uint v0=min(uint(v),size.x-2),h0=uint(h)%size.y,h1=(h0+1)%size.y;float tv=saturate(v-float(v0)),th=frac(h);
    uint at=(offset+2)*4;
    float a0=asfloat(buffers[NonUniformResourceIndex(buffer)].Load(at+(h0*size.x+v0)*4)),a1=asfloat(buffers[NonUniformResourceIndex(buffer)].Load(at+(h0*size.x+v0+1)*4));
    float b0=asfloat(buffers[NonUniformResourceIndex(buffer)].Load(at+(h1*size.x+v0)*4)),b1=asfloat(buffers[NonUniformResourceIndex(buffer)].Load(at+(h1*size.x+v0+1)*4));
    return lerp(lerp(a0,a1,tv),lerp(b0,b1,tv),th);
}
// Luminous intensity (cd, tinted) `light` sends towards `p` as seen from its centre,
// windowed by its range: points and spheres in every direction, spots in their cone,
// rects and discs as Lambertian emitters in front of them (a rect through its barn
// doors). Fog in-scattering and other far-field consumers read it.
float3 lightIntensity(Frame f,Look l,Light light,uint index,float3 p){
    float3 delta=p-light.positionRange.xyz;float d=length(delta);if(d>=light.positionRange.w)return 0;
    float3 fromLight=delta/max(d,1e-6);float scale=light.colorLumens.w/(4*PI)*lightFade(light,d)*lightCone(light,fromLight);
    uint kind=lightKind(light);LightShape shape=(LightShape)0;
    if(lightShaped(light)){shape=loadLightShape(f.lighting.w,index);scale*=lightProfile(l,shape.tables.x,light,shape,fromLight);}
    if(kind>=LIGHT_RECT){
        float3 n=light.directionOuter.xyz;float z=dot(delta,n);if(z<=0)return 0;
        scale*=z/max(d,1e-6);
        if(kind==LIGHT_RECT){
            float3 t=shape.tangentLength.xyz,b=cross(t,n);
            float2 extent=max(shape.rect.xy,0.001),sx=barnDoorSpan(extent.x,dot(delta,t),z,shape.rect.zw),sy=barnDoorSpan(extent.y,dot(delta,b),z,shape.rect.zw);
            scale*=max(sx.y-sx.x,0)*max(sy.y-sy.x,0)/(4*extent.x*extent.y);
        }
    }
    return light.colorLumens.rgb*scale;
}

// LTC table lookups: 64x64 entries over [0,1]^2, sampled at texel centres.
static const float LTC_SIZE=64;
float2 ltcUv(float2 x){return x*((LTC_SIZE-1)/LTC_SIZE)+0.5/LTC_SIZE;}
// What every area light shading one surface shares: the shading frame (rows: tangent
// towards the viewer, bitangent, normal) and the inverse lobe transform in it.
struct AreaPixel{float3x3 frame;float3x3 lobe;bool ready;};
AreaPixel areaPixel(Look l,Surface s,float3 v){
    AreaPixel a;float3 n=s.normal,t=v-n*dot(v,n);float tl=dot(t,t);
    t=tl>1e-8?t*rsqrt(tl):normalize(cross(n,abs(n.y)<0.999?float3(0,1,0):float3(1,0,0)));
    a.frame=float3x3(t,cross(n,t),n);
    float4 m=textures[NonUniformResourceIndex(l.lightInfo[0].x)].SampleLevel(samplers[2],ltcUv(float2(s.roughness,sqrt(1-saturate(dot(n,v))))),0);
    a.lobe=float3x3(m.x,0,m.y,0,1,0,m.z,0,m.w);a.ready=true;return a;
}
// One edge's term of a polygon's vector form factor (2 pi times it): the angle between
// unit directions `a` and `b` along their unit normal.
float3 ltcEdge(float3 a,float3 b){float3 c=cross(a,b);float s=length(c);return s>1e-7?c*(atan2(s,dot(a,b))/s):0;}
// Edge a -> b (transformed, relative to the shading point, unnormalised) clipped to
// the upper hemisphere: its share of the clamped-cosine integral (z of ltcEdge) and,
// in `exit` / `entry` (w one once set), where it leaves or enters through the horizon.
float ltcClippedEdge(float3 a,float3 b,inout float4 exit,inout float4 entry){
    if(a.z<0&&b.z<0)return 0;
    float3 from=a,to=b;
    if(a.z<0){from=a+(b-a)*(a.z/(a.z-b.z));entry=float4(from,1);}
    else if(b.z<0){to=a+(b-a)*(a.z/(a.z-b.z));exit=float4(to,1);}
    return ltcEdge(normalize(from),normalize(to)).z;
}
// Clamped-cosine integral (form factor) under transform `m` of the convex quad
// p0..p3 (relative to the shading point, in the shading frame): every edge clipped at
// the horizon and closed along it, so it is exact for any placement, either winding.
float ltcQuad(float3x3 m,float3 p0,float3 p1,float3 p2,float3 p3){
    p0=mul(m,p0);p1=mul(m,p1);p2=mul(m,p2);p3=mul(m,p3);float4 exit=0,entry=0;
    float sum=ltcClippedEdge(p0,p1,exit,entry)+ltcClippedEdge(p1,p2,exit,entry)+ltcClippedEdge(p2,p3,exit,entry)+ltcClippedEdge(p3,p0,exit,entry);
    if(exit.w>0&&entry.w>0)sum+=ltcEdge(normalize(exit.xyz),normalize(entry.xyz)).z;
    return max(dot(cross(p1-p0,p2-p0),p0)<0?-sum:sum,0)/(2*PI);
}
// The horizon-clipped form factor of a spherical cap with vector form factor `F`
// (look::ltc's table: Snyder's cap integral, tabulated by length and elevation).
float ltcCap(Look l,float3 F){
    float len=length(F);if(len<=1e-7)return 0;
    return len*textures[NonUniformResourceIndex(l.lightInfo[0].y)].SampleLevel(samplers[2],ltcUv(float2(F.z/len*0.5+0.5,saturate(len))),0).r;
}
// Clamped-cosine integral under `m` of the ellipse with centre `c` and conjugate
// semi-axes `u`, `w` (relative to the shading point, in the shading frame): the
// transformed ellipse's principal axes, the elliptic cone through it and that cone's
// form factor and axis (its distinct eigenvalue; Heitz and Hill 2017), clipped as a cap.
float ltcEllipse(Look l,float3x3 m,float3 c,float3 u,float3 w){
    c=mul(m,c);u=mul(m,u);w=mul(m,w);
    float d11=dot(u,u),d22=dot(w,w),d12=dot(u,w),angle=0.5*atan2(2*d12,d11-d22),ca=cos(angle),sa=sin(angle);
    float3 a1=u*ca+w*sa,a2=w*ca-u*sa;float e1=length(a1),e2=length(a2);if(e1<1e-8||e2<1e-8)return 0;
    float3 u1=a1/e1,u2=a2/e2,u3=normalize(cross(u1,u2));if(dot(u3,c)<0)u3=-u3;
    float z=dot(u3,c);if(z<=1e-6)return 0;
    float x0=dot(u1,c)/z,y0=dot(u2,c)/z,a=z*z/(e1*e1),b=z*z/(e2*e2);
    // The cone (x - x0 z)^2 a + (y - y0 z)^2 b = z^2 as x^T Q x = 0 in (u1, u2, u3).
    float q00=a,q11=b,q22=a*x0*x0+b*y0*y0-1,q02=-a*x0,q12=-b*y0;
    // Q's eigenvalues: the largest from Smith's (1961) trigonometric solution. The other two
    // are the roots of the deflated quadratic, with product det Q / eMax = -a b / eMax
    // (det Q = -a b) and sum (S2 - product) / eMax from the principal minors S2: no
    // subtraction of nearly equal terms, which left a near edge-on ellipse (a light seen
    // along its plane, eMid ~ 1e-4 of eMax) with eMid and so the form factor wrong by
    // several times, in a speckled line along the plane.
    float qm=(q00+q11+q22)/3,p=sqrt(((q00-qm)*(q00-qm)+(q11-qm)*(q11-qm)+(q22-qm)*(q22-qm)+2*(q02*q02+q12*q12))/6);
    float b00=(q00-qm)/p,b11=(q11-qm)/p,b22=(q22-qm)/p,b02=q02/p,b12=q12/p;
    float phi=acos(clamp((b00*(b11*b22-b12*b12)-b11*b02*b02)*0.5,-1.,1.))/3;
    float eMax=qm+2*p*cos(phi),pair=-a*b/eMax,minors=a*b*(1+x0*x0+y0*y0)-(a+b),sum=(minors-pair)/eMax;
    float eMid=0.5*(sum+sqrt(sum*sum-4*pair)),eNeg=pair/eMid;
    float form=saturate(-eNeg*rsqrt(max((eMax-eNeg)*(eMid-eNeg),1e-30)));
    float3 axis=normalize(u1*(a*x0/(a-eNeg))+u2*(b*y0/(b-eNeg))+u3);
    return ltcCap(l,axis*form);
}
// A tube's outline as one quad of its broadside area facing the shading point: from
// `centre` (relative to the point) along `axis` (half length `reach`, the length plus
// pi r / 2 so the rounded ends keep their area) and `side` (the radius). One quad
// costs a rect's eight edges; the exact capsule outline cost three times that.
float ltcTube(float3x3 m,float3 centre,float3 axis,float reach,float3 side){
    float3 h=axis*reach;return ltcQuad(m,centre-h-side,centre+h-side,centre+h+side,centre-h+side);
}
// Light reflected towards `v` by surface `s` (lobes `o`) at `world` from local light
// `index` (`light`), before shadowing: an ideal point or spot through the BRDF at its
// centre (within 10 cm, the near field softens), else its area integrated with LTC,
// diffuse through the identity and specular through the pixel's lobe (`a`, loaded on
// the first area light). Area sources emit uniform luminance: the light's intensity
// (colorLumens.w / 4 pi, cd along its axis) over its projected area.
// `size`: the source's extent in metres (zero for an ideal point), which softens its
// shadows (localShadow).
float3 localLight(Frame f,Look l,Surface s,Lobes o,float3 v,float3 world,uint index,Light light,inout AreaPixel a,out float size){
    size=0;
    float3 delta=light.positionRange.xyz-world;float d2=dot(delta,delta),range=light.positionRange.w;
    if(d2>=range*range)return 0;
    float d=sqrt(d2);float3 toLight=delta/max(d,1e-6);
    float3 intensity=light.colorLumens.rgb*(light.colorLumens.w/(4*PI)*lightFade(light,d)*lightCone(light,-toLight));
    if(all(intensity<=0))return 0;
    LightShape shape=(LightShape)0;
    if(lightShaped(light)){shape=loadLightShape(f.lighting.w,index);intensity*=lightProfile(l,shape.tables.x,light,shape,-toLight);}
    if(!lightHasArea(light))return brdf(s,v,toLight,o)*intensity/max(d2,0.01);
    if(!a.ready)a=areaPixel(l,s,v);
    uint kind=lightKind(light);float3 n=light.directionOuter.xyz,t=shape.tangentLength.xyz;
    float diffuse=0,specular=0,area=1;
    if(kind>=LIGHT_RECT){
        // One-sided: nothing behind its plane.
        float z=-dot(delta,n);if(z<=0)return 0;
        float3 b=cross(t,n);
        if(kind==LIGHT_RECT){
            float2 extent=max(shape.rect.xy,0.001);area=4*extent.x*extent.y;
            size=2*max(extent.x,extent.y);
            float2 sx=barnDoorSpan(extent.x,-dot(delta,t),z,shape.rect.zw),sy=barnDoorSpan(extent.y,-dot(delta,b),z,shape.rect.zw);
            if(sx.x>=sx.y||sy.x>=sy.y)return 0;
            float3 p0=mul(a.frame,delta+t*sx.x+b*sy.x),p1=mul(a.frame,delta+t*sx.y+b*sy.x),p2=mul(a.frame,delta+t*sx.y+b*sy.y),p3=mul(a.frame,delta+t*sx.x+b*sy.y);
            diffuse=ltcQuad(float3x3(1,0,0,0,1,0,0,0,1),p0,p1,p2,p3);specular=ltcQuad(a.lobe,p0,p1,p2,p3);
        }else{
            float r=max(light.parameters.z,0.001);area=PI*r*r;
            float3 c=mul(a.frame,delta),u=mul(a.frame,t*r),w=mul(a.frame,b*r);
            size=2*r;
            diffuse=ltcEllipse(l,float3x3(1,0,0,0,1,0,0,0,1),c,u,w);specular=ltcEllipse(l,a.lobe,c,u,w);
        }
    }else{
        float r=max(light.parameters.z,0.001),span=shape.tangentLength.w;size=max(2*r,span);
        if(span<=0){
            // A sphere: its cap exactly for diffuse light, and for the lobe the disc
            // facing the point with the sphere's silhouette (radius r d / sqrt(d^2 - r^2)).
            area=PI*r*r;float dd=max(d,r*1.001),sine2=r*r/(dd*dd);
            float3 c=mul(a.frame,delta),axis=mul(a.frame,toLight),u=normalize(cross(axis,abs(axis.z)<0.999?float3(0,0,1):float3(1,0,0))),w=cross(axis,u);
            float silhouette=r*rsqrt(1-sine2);
            diffuse=ltcCap(l,axis*sine2);specular=ltcEllipse(l,a.lobe,c,u*silhouette,w*silhouette);
        }else{
            // A tube (capsule) seen broadside: its outline in the plane through its axis
            // facing the point.
            area=2*r*span+PI*r*r;
            float3 side=cross(t,toLight);float sl=dot(side,side);
            side=sl>1e-8?side*rsqrt(sl):normalize(cross(t,abs(t.y)<0.999?float3(0,1,0):float3(1,0,0)));
            float3 c=mul(a.frame,delta),axis=mul(a.frame,t),sideFrame=mul(a.frame,side*r);float reach=span*0.5+PI*r*0.25;
            diffuse=ltcTube(float3x3(1,0,0,0,1,0,0,0,1),c,axis,reach,sideFrame);specular=ltcTube(a.lobe,c,axis,reach,sideFrame);
        }
    }
    // Radiance: luminance (intensity / area) times the Lambert base's pi x form factor
    // and the compensated specular albedo's share of the lobe.
    return intensity/area*(o.diffuse*(PI*diffuse)+o.albedo*specular);
}
// Irradiance (lux) local light `index` gives a surface facing `n` at `p`, before
// shadowing: the clamped-cosine form factor of its area (probe relight).
float3 lightIrradiance(Frame f,Look l,Light light,uint index,float3 p,float3 n){
    float3 delta=light.positionRange.xyz-p;float d2=dot(delta,delta),range=light.positionRange.w;
    if(d2>=range*range)return 0;
    float d=sqrt(d2);float3 toLight=delta/max(d,1e-6);
    float3 intensity=light.colorLumens.rgb*(light.colorLumens.w/(4*PI)*lightFade(light,d)*lightCone(light,-toLight));
    if(all(intensity<=0))return 0;
    LightShape shape=(LightShape)0;
    if(lightShaped(light)){shape=loadLightShape(f.lighting.w,index);intensity*=lightProfile(l,shape.tables.x,light,shape,-toLight);}
    if(!lightHasArea(light))return intensity*saturate(dot(n,toLight))/max(d2,0.01);
    float3 t0=n.y<0.999&&n.y>-0.999?normalize(cross(float3(0,1,0),n)):float3(1,0,0);
    float3x3 frame=float3x3(t0,cross(n,t0),n),identity=float3x3(1,0,0,0,1,0,0,0,1);
    uint kind=lightKind(light);float3 ln=light.directionOuter.xyz,t=shape.tangentLength.xyz;
    float form=0,area=1;
    if(kind>=LIGHT_RECT){
        float z=-dot(delta,ln);if(z<=0)return 0;
        float3 b=cross(t,ln);
        if(kind==LIGHT_RECT){
            float2 extent=max(shape.rect.xy,0.001);area=4*extent.x*extent.y;
            float2 sx=barnDoorSpan(extent.x,-dot(delta,t),z,shape.rect.zw),sy=barnDoorSpan(extent.y,-dot(delta,b),z,shape.rect.zw);
            if(sx.x>=sx.y||sy.x>=sy.y)return 0;
            form=ltcQuad(identity,mul(frame,delta+t*sx.x+b*sy.x),mul(frame,delta+t*sx.y+b*sy.x),mul(frame,delta+t*sx.y+b*sy.y),mul(frame,delta+t*sx.x+b*sy.y));
        }else{
            float r=max(light.parameters.z,0.001);area=PI*r*r;
            form=ltcEllipse(l,identity,mul(frame,delta),mul(frame,t*r),mul(frame,b*r));
        }
    }else{
        float r=max(light.parameters.z,0.001),span=shape.tangentLength.w;
        if(span<=0){area=PI*r*r;float dd=max(d,r*1.001);form=ltcCap(l,mul(frame,toLight)*(r*r/(dd*dd)));}
        else{
            area=2*r*span+PI*r*r;float3 side=cross(t,toLight);float sl=dot(side,side);
            side=sl>1e-8?side*rsqrt(sl):normalize(cross(t,abs(t.y)<0.999?float3(0,1,0):float3(1,0,0)));
            form=ltcTube(identity,mul(frame,delta),mul(frame,t),span*0.5+PI*r*0.25,mul(frame,side*r));
        }
    }
    return intensity/area*(PI*form);
}
