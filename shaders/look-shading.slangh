// Raster surface shading shared by deferred lighting and forward transparency.
// Include after raster.slangh and look.slangh.
#include "look-gi.slangh"
#include "look-horizon.slangh"
#include "look-vsm.slangh"
#include "look-captures.slangh"
#include "look-translucent.slangh"
#include "look-shadow.slangh"
#include "look-planar.slangh"
// Cascaded sun shadows (renderer/frame.rs): f.look.y texels per cascade side, f.look.z
// active cascades, far distances in f.splits.
uint cascadeIndex(Frame f,float3 world){float d=dot(world-f.camera.xyz,f.forward.xyz);return d<f.splits.x?0:d<f.splits.y?1:d<f.splits.z?2:3;}
// Sun visibility for fog samples of footprint radius `footprint` (m): the cascade
// holding `world`, else the far map (look-shadow.slangh shadowFog: soft shafts in a
// few gathers). (The horizon describes the ground, not the air above it: fog keeps the
// maps.)
float fogVisibility(Frame f,Look l,float3 world,float footprint=0){
    uint c=cascadeIndex(f,world);float d=dot(world-f.camera.xyz,f.forward.xyz);ShadowLight sun=shadowSun(l.sunLux.w);
    bool cascade=c<f.look.z && d<component(f.splits,c);
    [loop]for(uint k=cascade?0u:1u;k<(l.farInfo.z!=0?2u:1u);k++){
        float v=shadowFog(l,k==0?shadowCascade(f,l,c):shadowFar(l),world,f.sunDirection.xyz,sun,footprint);if(v>=0)return v;
    }
    return 1;
}
// Visibility of `world` from shadowed local light `index` (look::local) at `light`,
// reaching `range`, whose source `shape` spans half-axes a, b (m; zero for an ideal
// point): look-shadow.slangh shadowSoft in the light's face. `penumbra`: the kernel's
// half-width (m).
float localShadowShape(Look l,uint index,float3 world,float3 normal,float3 light,float range,ShadowLight shape,out float penumbra){
    penumbra=0;ShadowMap s;if(!shadowLocal(l,index,world,light,range,s))return 1;
    float v=shadowSoft(l,s,world,normal,normalize(light-world),shape,penumbra);return v<0?1:v;
}
// localShadowShape for a round source `size` metres across (zero: an ideal point)
// facing the receiver (probe relight and ray hits).
float localShadow(Look l,uint index,float3 world,float3 normal,float3 light,float size=0,float range=1){
    float3 d=normalize(light-world),u=normalize(cross(d,abs(d.y)<0.9?float3(0,1,0):float3(1,0,0)));
    ShadowLight shape;shape.a=u*(size*0.5);shape.b=cross(d,u)*(size*0.5);shape.disc=true;shape.tangent=0;
    float unused;return localShadowShape(l,index,world,normal,light,range,shape,unused);
}
// Sun visibility at `world` in the sun maps (renderer/frame.rs cascades, look/far.rs):
// contact-hardening penumbrae of the sun disc (look-shadow.slangh shadowSoft;
// Look.sunLux.w its angular radius). Blends into the next cascade over the last tenth
// of each, then the far map, past which it is lit (`mapped` false). `penumbra`: the
// kernel's half-width (m). One lookup per map in a loop: each inlined copy would add
// to every lighting shader's size.
float mapVisibility(Frame f,Look l,float3 world,float3 normal,out bool mapped,out float penumbra) {
    float d=dot(world-f.camera.xyz,f.forward.xyz);float4 splits=f.splits;uint count=f.look.z,c=cascadeIndex(f,world);
    float blend=0;
    if(c<count){float far=component(splits,c),near=c==0?0:component(splits,c-1),band=(far-near)*0.1;blend=saturate((d-(far-band))/max(band,1e-3));}
    else if(l.farInfo.z==0){mapped=false;penumbra=0;return 1;}
    mapped=c<count;float v=0;penumbra=0;ShadowLight sun=shadowSun(l.sunLux.w);
    [loop]for(uint k=0;k<(blend>0?2u:1u);k++){
        uint m=c+k;bool cascade=m<count;
        float p,s=shadowSoft(l,cascade?shadowCascade(f,l,m):shadowFar(l),world,normal,f.sunDirection.xyz,sun,p);
        if(s<0){if(!cascade&&k==0){mapped=false;return 1;}s=1;}
        else if(!cascade&&k==0)mapped=true;
        float w=k==0?1-blend:blend;v+=w*s;penumbra+=w*p;
    }
    return v;
}
// The sun's penumbra half-width (m) at `world` from the cascade holding it, else the
// far map (look-shadow.slangh shadowReach: the blocker search alone); zero where no
// blocker is near or no map holds it.
float mapReach(Frame f,Look l,float3 world,float3 normal){
    uint c=cascadeIndex(f,world);bool cascade=c<f.look.z;if(!cascade&&l.farInfo.z==0)return 0;
    return max(shadowReach(cascade?shadowCascade(f,l,c):shadowFar(l),world,normal,f.sunDirection.xyz,shadowSun(l.sunLux.w)),0);
}
// Sun visibility at `world`: `pages` where the virtual shadow map resolved it
// (look-vsm.slangh: vsmMask, vsmVisibility), else the sun maps; at every distance the
// horizon of distant landforms (look-horizon.slangh), so far terrain stays shadowed
// past them: only past HORIZON_NEAR where a map shades `world`. Shaders sample pages
// only through the mask or their own entry points: inline page lookups would cost
// every preset registers (and occupancy).
float visibility(Frame f,Look l,float3 world,float3 normal,float pages=-1){
    bool mapped=pages>=0;
    float penumbra;float v=mapped?pages:mapVisibility(f,l,world,normal,mapped,penumbra);
    return v>0?min(v,horizonSun(l,world,mapped)):0;
}
// Schlick's Fresnel. Cycles' metals use the F82-tint model (Hoffman 2023, "Generalization
// of Adobe's Fresnel Model"): Schlick minus b cos (1 - cos)^6, b = Schlick(1/7) (1 - tint)
// 7 / (6/7)^6, so F at cos 1/7 is Schlick times the tint. No content or material carries a
// tint (white: b = 0, exactly Schlick); a tint subtracts that term here and b/126 in meanFresnel.
// The grazing reflectance F90 is 1, except below 2% F0: no real material reflects that
// little, so such F0 is occlusion (Unreal's saturate(50 F0.g)) and a black metal stays
// black instead of mirroring the sky at grazing angles.
float grazing(float3 f0){return saturate(50*f0.g);}
float3 fresnel(float cosine,float3 f0){float m=1-saturate(cosine),m2=m*m;return f0+(grazing(f0)-f0)*(m2*m2*m);}
// Hemispherical average of fresnel, 2 int F(mu) mu dmu.
float3 meanFresnel(float3 f0){return f0+(grazing(f0)-f0)/21;}
// Ara's GGX lobe (alpha `a` = roughness^2, height-correlated Smith masking as in Cycles):
// the energy its single scattering loses towards a viewer with masking `g` = G1(v),
// K = 1/E - 1 for Kulla and Conty 2017's directional albedo E. A polynomial fit to offline
// quadrature (rows: powers of g, high to low; columns: 1, a, a^2, a^3): E within 0.44% for
// n.v >= 0.01 (3.5% below, at silhouettes).
float specularLoss(float g,float a){
    float4 p=float4(1,a,a*a,a*a*a);
    float k=dot(p,float4(-26.992674,24.19879,23.560875,-17.80212));
    k=k*g+dot(p,float4(80.678413,-102.840874,-0.156378,15.487353));
    k=k*g+dot(p,float4(-93.803902,161.34404,-96.72551,34.476097));
    k=k*g+dot(p,float4(52.955402,-118.814537,120.470482,-54.776974));
    k=k*g+dot(p,float4(-14.62627,41.991596,-56.709965,28.578594));
    k=k*g+dot(p,float4(1.845784,-6.130684,11.342569,-5.297616));
    return max(k*g+dot(p,float4(-0.052449,0.206786,-0.347631,0.213451)),0);
}
// The same lobe's mean Schlick weight s = <(1 - v.h)^5>, so its albedo with Fresnel is
// E (f0 + (1 - f0) s): the split sum's scale E (1 - s) and bias E s (Karis 2013). Fit as
// s = (1 - m)^5, m a polynomial (matrices: powers of roughness `r`, high to low; rows 1, g,
// g^2; columns 1, nv, nv^2): a dielectric's albedo within 1%.
float fresnelWeight(float g,float nv,float r){
    float3 u=float3(1,nv,nv*nv),w=float3(1,g,g*g);
    float m=dot(w,mul(float3x3(-0.312138,2.704782,1.929146,-2.604868,4.766642,-16.716455,2.793438,-8.240801,15.790338),u));
    m=m*r+dot(w,mul(float3x3(0.830226,-8.764472,-0.782407,-1.695137,2.157336,25.210638,0.881528,6.947778,-25.12462),u));
    m=m*r+dot(w,mul(float3x3(-0.057622,14.697845,-6.248118,0.16941,-15.589355,-0.322813,-0.113,1.872354,6.617512),u));
    float t=1-saturate(m),t2=t*t;return t2*t2*t;
}
// The lobe's hemispherical average albedo E_avg = 2 int E(mu) mu dmu (Kulla and Conty
// 2017) at roughness `r`, within 0.2%.
float averageAlbedo(float r){return 0.996096+r*(0.041679+r*(0.105196+r*(-1.868613+r*1.135544)));}
// Kulla and Conty 2017's multiple-scattering Fresnel F_avg E_avg / (1 - F_avg (1 - E_avg)):
// the share of the energy single scattering loses that leaves after bouncing between
// microfacets. Darker channels lose more of it, which saturates rough gold and copper.
float3 multipleFresnel(float3 mean,float eavg){return mean*eavg/(1-mean*(1-eavg));}
// A surface's lobes towards the viewer (specularLobes), computed once per pixel and read
// by brdf for every light and by ibl.
struct Lobes{
    float3 f0;     // Fresnel at normal incidence.
    float3 scale;  // Multiple-scattering scale of the specular lobe, 1 + F_ms (1/E - 1).
    float3 albedo; // Directional albedo of the scaled specular lobe, E (f0 + (1 - f0) s) scale.
    float3 diffuse;// Lambert reflectance over PI under the dielectric layer, times 1 - that layer's albedo.
    float nv,a2,lv;// clamp(n.v, 0.001, 1); alpha^2; sqrt(nv^2 (1 - a2) + a2), v's Smith term.
};
// Energy-compensated GGX as Cycles' Principled BSDF v2 evaluates it: single scattering
// times 1 + F_ms (1/E - 1) for the view direction (Kulla and Conty 2017's albedos, applied
// as Turquin 2019's scale), so a white rough lobe reflects all it receives and coloured
// metals keep their multiple-bounce saturation. The Lambert base lies under a dielectric
// (f0 0.04) layer and receives what that layer, with its own multiple scattering, does
// not reflect towards the viewer: 1 - (0.04 E + 0.96 E s)(1 + F_ms(0.04) (1/E - 1)), the
// same for every light and the environment, so a white rough dielectric reflects all it
// receives. (Attenuating by a layer estimate instead, Cycles' f0 + (1 - f0) s or
// f0 + (1 - f0) E s, loses up to 7% or 3% of it at grazing angles, and both matched the
// Cycles references worse in every region.)
Lobes specularLobes(Surface s,float3 v){
    Lobes o;o.nv=clamp(dot(s.normal,v),0.001,1);float a=s.roughness*s.roughness;o.a2=a*a;
    o.lv=sqrt(o.nv*o.nv*(1-o.a2)+o.a2);float g=2*o.nv/(o.nv+o.lv);
    float k=specularLoss(g,a),e=1/(1+k),bias=e*fresnelWeight(g,o.nv,s.roughness),eavg=averageAlbedo(s.roughness);
    o.f0=lerp(float3(0.04),s.albedo,s.metal);o.scale=1+multipleFresnel(meanFresnel(o.f0),eavg)*k;
    o.albedo=(o.f0*e+(grazing(o.f0)-o.f0)*bias)*o.scale;
    float layer=(0.04*e+0.96*bias)*(1+multipleFresnel(meanFresnel(float3(0.04)),eavg).x*k);
    o.diffuse=s.albedo*(1-s.metal)*(1-s.transmission)*(1-layer)/PI;
    return o;
}
// Direct light reflected towards `v` from direction `l` (per unit illuminance) by
// specularLobes' `o`: GGX D, the height-correlated Smith visibility G2 / (4 n.v n.l)
// (Heitz 2014, as Cycles) and Schlick Fresnel, scaled for multiple scattering, over the
// Lambert base.
float3 brdf(Surface s,float3 v,float3 l,Lobes o){
    float3 h=normalize(v+l);float nl=saturate(dot(s.normal,l)),nh=saturate(dot(s.normal,h)),vh=saturate(dot(v,h));
    float t=nh*nh*(o.a2-1)+1,d=o.a2/(PI*t*t),visibility=0.5/(nl*o.lv+o.nv*sqrt(nl*nl*(1-o.a2)+o.a2));
    return (o.diffuse+d*visibility*fresnel(vh,o.f0)*o.scale)*nl;
}
// brdf for a single light.
float3 brdf(Surface s,float3 v,float3 l){return brdf(s,v,l,specularLobes(s,v));}
// Material occlusion policy: whether the frame computes dynamic occlusion for ambient
// light, screen-space occlusion (the look's AO at a non-zero power: Medium's GTAO,
// High/Epic's visibility bitmask) together with the probes' visibility. Then the
// material's occlusion map no longer scales ambient light: it would count occlusion
// twice, and Cycles and the path tracer ignore glTF occlusion. Otherwise (Low, or a
// scene that turns AO or GI off) the map is the fallback, applied to indirect light as
// glTF specifies. Deferred lighting folds it into Surface::ao; ibl applies it to
// forward surfaces and ray hits.
bool dynamicOcclusion(Look l){return (l.flags.y&LOOK_AMBIENT_OCCLUSION)!=0 && l.ao.w>0 && giEnabled(l);}
// The High/Epic tier's screen-space ambient light at full-resolution pixel `p`
// (look-ao.slang aoBitmaskMain): the denoised half-resolution visibility (returned,
// with the volume intensity's power) and one-bounce irradiance from geometry within
// the radius (`bounce`), upsampled with depth-similar weights; where no neighbour
// shares the pixel's depth (silhouettes), the nearest in depth stands in.
float screenAmbient(Frame f,Look l,int2 p,out float3 bounce){
    bounce=0;if((l.flags.y&LOOK_AMBIENT_OCCLUSION)==0)return 1;
    int2 half=int2((f.extent.xy+1)/2);float2 h=(float2(p)+0.5)*0.5-0.5;int2 b=int2(floor(h));float2 t=h-float2(b);
    float depth=pixel(f.extra.x,p).x;float4 sum=0,nearest=float4(0,0,0,1);float total=0,best=1e30;
    for(uint k=0;k<4;k++){
        int2 o=int2(k&1,k>>1),q=clamp(b+o,int2(0),half-1);float dz=abs(pixel(f.extra.x,q*2).x/max(depth,1e-7)-1);
        float w=(o.x==1?t.x:1-t.x)*(o.y==1?t.y:1-t.y)*exp(-dz*50);float4 a=pixel(l.aoImages.y,q);
        sum+=a*w;total+=w;if(dz<best){best=dz;nearest=a;}
    }
    float4 a=total>1e-3?sum/total:nearest;bounce=a.rgb;
    return l.ao.w==1?a.a:pow(saturate(a.a),l.ao.w);
}
// Screen-space ambient visibility at full-resolution pixel `p` (camera distance
// `distance`): a depth-aware bilinear upsample of the denoised half-resolution GTAO.
// Where no neighbour shares the pixel's depth (silhouettes), the nearest in depth
// stands in rather than a blend of the other side's surfaces. `high` (the High/Epic
// variant, compile-time): one, as ibl reads that tier's screen-space ambient light
// itself (screenAmbient), once.
float screenOcclusion(Frame f,Look l,int2 p,float distance,bool high=false){
    if(high)return 1;
    if((l.flags.y&LOOK_AMBIENT_OCCLUSION)==0)return 1;
    int2 half=int2((f.extent.xy+1)/2);float2 h=(float2(p)+0.5)*0.5-0.5;int2 b=int2(floor(h));float2 t=h-float2(b);
    float sum=0,total=0,best=1e30,nearest=1;
    for(uint k=0;k<4;k++){
        int2 o=int2(k&1,k>>1);float2 v=pixel(l.aoImages.y,clamp(b+o,int2(0),half-1)).rg;float dz=abs(v.g-distance);
        float w=(o.x==1?t.x:1-t.x)*(o.y==1?t.y:1-t.y)*exp(-dz/max(distance*0.02,0.05));
        sum+=v.r*w;total+=w;if(dz<best){best=dz;nearest=v.r;}
    }
    // Volume intensity (look.ao.w): a power on the visibility, 1 physical.
    float ao=total>1e-3?sum/total:nearest;return l.ao.w==1?ao:pow(saturate(ao),l.ao.w);
}
// Multi-bounce ambient occlusion (Jimenez et al. 2016): light inter-reflected
// inside the occluded cavity brightens AO on bright albedo.
float3 multiBounce(float ao,float3 albedo){
    float3 a=2.0404*albedo-0.3324,b=-4.7951*albedo+0.6417,c=2.7552*albedo+0.6903;
    return max(float3(ao),((ao*a+b)*ao+c)*ao);
}
// Specular occlusion from ambient occlusion (Lagarde & de Rousiers 2014).
float specularOcclusion(float nv,float ao,float roughness){
    return saturate(pow(nv+ao,exp2(-16*roughness*roughness-1))-1+ao);
}
// Gathered probe lobes at full-resolution pixel `p` (camera distance `distance`):
// a depth-aware bilinear upsample of the half-resolution gather (`giGatherMain`).
// Returns the volume coverage; zero when no lobe was gathered nearby.
float gatheredLobes(Frame f,Look l,int2 p,float distance,out float3 diffuse,out float3 specular){
    int2 half=int2((f.extent.xy+1)/2);float2 h=(float2(p)+0.5)*0.5-0.5;int2 b=int2(floor(h));float2 t=h-float2(b);
    diffuse=0;specular=0;float coverage=0,total=0,best=1e30;float4 nearestD=0,nearestS=0;
    for(uint k=0;k<4;k++){
        int2 o=int2(k&1,k>>1),q=clamp(b+o,int2(0),half-1);float4 d=pixel(l.giGather.x,q),s=pixel(l.giGather.y,q);float dz=abs(d.w-distance);
        float w=(o.x==1?t.x:1-t.x)*(o.y==1?t.y:1-t.y)*exp(-dz/max(distance*0.02,0.05));
        diffuse+=d.rgb*w;specular+=s.rgb*w;coverage+=s.w*w;total+=w;if(dz<best){best=dz;nearestD=d;nearestS=s;}
    }
    // No neighbour at this depth (a silhouette): the nearest in depth, as for AO.
    if(total<=1e-3){diffuse=nearestD.rgb;specular=nearestS.rgb;return nearestS.w;}
    diffuse/=total;specular/=total;return coverage/total;
}
// Screen probe light at full-resolution pixel `p` (look-screen-gi.slang
// screenGatherMain): irradiance and pre-filtered specular radiance, upsampled from half
// resolution with depth-similar weights; returns the share the probes cover (zero
// without screen probe GI this frame, LOOK_SCREEN_GI).
float screenLobes(Frame f,Look l,int2 p,out float3 irradiance,out float3 radiance){
    irradiance=0;radiance=0;if((l.flags.y&LOOK_SCREEN_GI)==0)return 0;
    int2 half=int2((f.extent.xy+1)/2);float2 h=(float2(p)+0.5)*0.5-0.5;int2 b=int2(floor(h));float2 t=h-float2(b);
    float depth=pixel(f.extra.x,p).x;float4 d=0,s=0,nearestD=0,nearestS=0;float total=0,best=1e30;
    for(uint k=0;k<4;k++){
        int2 o=int2(k&1,k>>1),q=clamp(b+o,int2(0),half-1);float dz=abs(pixel(f.extra.x,q*2).x/max(depth,1e-7)-1);
        float w=(o.x==1?t.x:1-t.x)*(o.y==1?t.y:1-t.y)*exp(-dz*50);float4 a=pixel(l.screenInfo[2].x,q),r=pixel(l.screenInfo[2].y,q);
        d+=a*w;s+=r*w;total+=w;if(dz<best){best=dz;nearestD=a;nearestS=r;}
    }
    if(total>1e-3){d/=total;s/=total;}else{d=nearestD;s=nearestS;}
    irradiance=d.rgb;radiance=s.rgb;return saturate(d.w);
}
// The hybrid path's reflections at full-resolution pixel `p` (renderer::rt,
// look-rt.slang rtFilterMain): ray-traced reflections composited over screen-space
// ones, rgb and a confidence like screenReflection. Read only by the `rays` PSO
// variant (lighting_high_rt), never behind a runtime test.
float4 rtReflection(Look l,int2 p){return pixel(l.rtInfo[1].z,p);}
// Traced reflection (look-ssr.slang: on screen, then through the captures) at
// full-resolution pixel `p`: rgb radiance, a confidence (zero without a hit), and in
// `captured` the share of it the captures resolved. Upsampled from half resolution
// with depth- and normal-similar weights: where a floor strip meets the grating beside
// it at the same depth, each keeps its own reflection (no stair-stepped half-resolution
// edge).
float4 screenReflection(Frame f,Look l,int2 p,out float captured){
    captured=0;
    if((l.flags.y&LOOK_REFLECTIONS)==0)return 0;
    int2 half=int2((f.extent.xy+1)/2);float2 h=(float2(p)+0.5)*0.5-0.5;int2 b=int2(floor(h));float2 t=h-float2(b);
    float depth=pixel(f.extra.x,p).x;float3 n=gbufferNormal(f,p);float4 sum=0,nearest=0;float total=0,best=1e30,fromCaptures=0,nearestCaptured=0;
    for(uint k=0;k<4;k++){
        int2 o=int2(k&1,k>>1),q=clamp(b+o,int2(0),half-1);float d=pixel(f.extra.x,q*2).x;
        float bend=1-saturate(dot(gbufferNormal(f,q*2),n)),dz=abs(d/max(depth,1e-7)-1)+bend;
        float w=(o.x==1?t.x:1-t.x)*(o.y==1?t.y:1-t.y)*exp(-dz*40);float4 r=pixel(l.ssrImages.y,q);
        // A negative confidence marks a result mostly from the captures.
        float c=r.a<0?1:0;r.a=abs(r.a);
        sum+=r*w;fromCaptures+=c*w;total+=w;if(dz<best){best=dz;nearest=r;nearestCaptured=c;}
    }
    // Volume intensity (look.ssr.w) scales the hit confidence; probes fill the rest.
    float4 r=total>1e-3?sum/total:nearest;captured=total>1e-3?fromCaptures/total:nearestCaptured;r.w*=l.ssr.w;return r;
}
float4 screenReflection(Frame f,Look l,int2 p){float captured;return screenReflection(f,l,p,captured);}
// The share of a surface's reflection screen probes resolve (look-screen-gi.slangh):
// none on near-mirrors, whose lobe is narrower than a probe texel (reflection traces
// and captures own them), all past roughness 0.35.
float screenProbeSpecularShare(float roughness){return smoothstep(0.12,0.35,roughness);}
// The direction probe and sky reflections are looked up along for a lobe of
// perceptual `roughness` at normal `n`, viewed from `v`: GGX's dominant direction
// (Lagarde and de Rousiers 2014), the mirror direction pulled towards the normal as
// roughness grows. Along the mirror direction itself, a rough floor at a grazing view
// averages the ground under the horizon and reflects too little sky.
float3 specularDirection(float3 n,float3 v,float roughness){
    float a=roughness*roughness,smooth=saturate(1-a);
    return normalize(lerp(n,reflect(-v,n),smooth*(sqrt(smooth)+a)));
}
// Ambient light: the physical sky's IBL under a sky atmosphere, otherwise the
// environment map's (32x16 irradiance, five-level 256x640 GGX prefilter strip for
// roughness 0, .25, .5, .75, 1). Inside the probe volume, probe irradiance replaces
// the sky's diffuse light and the probes' radiance cache its reflections: what the
// nearby probes see along the reflection, parallax-corrected, blending into their
// irradiance lobe as roughness grows (giLatticeLobes), so an enclosed floor reflects
// its ceiling and walls, never the sky beyond them. Reflections are looked up along
// specularDirection, the lobe's dominant direction. Outside the volume, the heightfield's sky visibility
// (look-horizon.slangh) occludes the sky's light instead. Reflected light takes the
// compensated specular albedo of specularLobes' `o` (the split sum, scaled for multiple
// scattering like direct light), diffuse light its Lambert base, and ambient occlusion
// inter-reflects. `gathered` reads the half-resolution gather at pixel `p` (deferred
// lighting); forward surfaces search the probes directly.
// `high`: the High/Epic tier's PSO variant (Quality::high_tier; lighting_high and
// native_forward_high). Always a compile-time constant at the entry point, so
// tier-only code costs other presets nothing. Its deferred pixels take the
// visibility-bitmask pass's occlusion and near-field bounce (screenAmbient).
// `rays`: the hybrid High/Epic variant (lighting_high_rt, D29) reads ray-traced
// reflections composited over screen-space ones (rtReflection) instead.
// `diffuseOnly`: the diffuse share alone (the gi_diffuse view, lighting_gi and
// lighting_high_gi), a compile-time constant like `high`.
// `view` (a compile-time constant; the lighting_refl PSOs): 1 returns the reflected
// light alone, 2 a colour per reflection source weighted by its share (REFLECTION_*).
float3 ibl(Frame f,Look l,Surface s,Lobes o,float3 world,float3 v,int2 p,bool gathered,bool high=false,bool rays=false,bool diffuseOnly=false,uint view=0) {
    // Material occlusion policy (dynamicOcclusion) for forward surfaces and ray hits,
    // which have no screen-space occlusion of their own; deferred pixels arrive with it.
    if(!gathered && dynamicOcclusion(l))s.ao=1;
    uint irradiance=physicalSky(l)?l.sampled1.x:f.lighting.x,prefilter=physicalSky(l)?l.sampled1.y:f.lighting.y;
    float3 reflected=specularDirection(s.normal,v,s.roughness);float2 uv=environmentUv(reflected);float level=s.roughness*4;float low=floor(level);float upper=min(low+1,4);
    float3 spec=lerp(envTex(prefilter,float2(uv.x,(uv.y*127+0.5+low*128)/640)).rgb,envTex(prefilter,float2(uv.x,(uv.y*127+0.5+upper*128)/640)).rgb,frac(level))*skyLight(l);
    float3 ambient=envTex(irradiance,environmentUv(s.normal)).rgb*skyLight(l);
    float coverage=0;float3 diffuseGi=0,specularGi=0;
    [branch]if(giEnabled(l)){
        if(gathered)coverage=gatheredLobes(f,l,p,length(world-f.camera.xyz),diffuseGi,specularGi);
        else coverage=giPoolLobes(l,l.giImages.y,world,s.normal,reflected,v,s.roughness,true,diffuseGi,specularGi);
        coverage*=giWeight(l);
    }
    // Where the probe volume does not reach (and across its fade), distant
    // landforms occlude the sky's light (look-horizon.slangh): no seam at its edge.
    // Inside it the sky term weighs under 1%: the lookup is skipped.
    float sky=coverage<0.99?horizonSky(l,world):1;float3 ambientSky=ambient*sky,specSky=spec*sky;
    [branch]if(coverage>0){
        ambient=lerp(ambientSky,diffuseGi,coverage);
        spec=lerp(specSky,specularGi,coverage);
    }else{ambient=ambientSky;spec=specSky;}
    // High/Epic: local reflection captures (look-captures.slangh) replace probe and
    // sky reflections where they cover; screen-space (or ray) reflections stay on
    // top. SSR's confidence fades over 0.2..0.9 so its partial fringe at the hit/miss
    // edge (which changes frame to frame) hands over smoothly, and pixels it covers
    // fully skip the captures. Deferred pixels test only their tile's captures,
    // forward surfaces every visible one. Debug modes (`ARA_CAPTURE_DEBUG`): `mirror`
    // returns the captures alone along every mirror direction; `only` drops SSR
    // where captures cover.
    float4 r=0;float captured=0,boxed=0;
    if(gathered)r=rays?rtReflection(l,p):screenReflection(f,l,p,captured);
    if(high){
        uint debug=l.captureInfo[1].w;
        [branch]if(r.a<0.999||debug!=0){
            uint mask=gathered?captureTileMask(f,l,p):l.captureInfo[1].z;
            float4 c=captureReflection(l,world,s.normal,v,(debug&CAPTURE_DEBUG_MIRROR)!=0?0:s.roughness,mask);
            if(!diffuseOnly&&(debug&CAPTURE_DEBUG_MIRROR)!=0)return c.rgb;
            spec=lerp(spec,c.rgb,c.a);boxed=c.a;
            // Under a capture, SSR's low-confidence fringe fades into it smoothly.
            if(!rays&&(debug&CAPTURE_DEBUG_ONLY)==0)r.a=lerp(r.a,smoothstep(0.2,0.9,r.a),c.a);
            if((debug&CAPTURE_DEBUG_ONLY)!=0)r.a*=1-c.a;
        }
    }
    // Traced reflections (SSR, RT; `r`) carry their own visibility, so specular
    // occlusion and the screen bounce fill darken only the probe/sky/capture fallback.
    // High/Epic deferred pixels take screen probes (screenLobes) where they cover: they
    // traced their own occlusion and near-field bounce, so they replace the screen-space
    // ambient light below, and own rough reflections (screenProbeSpecularShare), under
    // which single mirror traces fade out.
    float3 screenIrradiance=0,screenRadiance=0;float sp=0,spSpec=0;
    if(high&&gathered){
        sp=screenLobes(f,l,p,screenIrradiance,screenRadiance);spSpec=sp*screenProbeSpecularShare(s.roughness);
        if(!rays)r.a*=1-sp*smoothstep(0.25,0.4,s.roughness);
    }
    float3 incident,specular;
    if(high&&gathered){
        // Screen-space ambient light (look-ao.slang aoBitmaskMain; s.ao is the material's
        // alone here, screenOcclusion): probe and sky light reach the visible sectors only
        // and the one-bounce irradiance fills the hidden ones, so near-field bounce
        // replaces, never adds to, what the probes carry there. The specular share screen
        // occlusion hides reflects the bounce's mean radiance. Material occlusion beyond
        // the screen's darkens both, with multi-bounce.
        float3 bounce;float visible=screenAmbient(f,l,p,bounce),ao=min(s.ao,visible);
        float so=specularOcclusion(o.nv,ao,s.roughness),screenSo=specularOcclusion(o.nv,visible,s.roughness);
        incident=(ambient*visible+bounce)*multiBounce(min(1,ao/max(visible,1e-4)),s.albedo);
        incident=lerp(incident,screenIrradiance*multiBounce(s.ao,s.albedo),sp);
        float3 fallback=(spec*screenSo+bounce*((1-screenSo)/(PI*max(1-visible,0.05))))*multiBounce(min(1,so/max(screenSo,1e-4)),o.f0);
        specular=lerp(lerp(fallback,screenRadiance,spSpec),r.rgb,r.a);
    }else{
        // Multi-bounce for both lobes (Jimenez et al. 2016; F0 for the specular): occluded
        // cavities inter-reflect, so rough metals are not darkened twice (probe lobes
        // already see their surroundings, then ambient occlusion again).
        incident=ambient*multiBounce(s.ao,s.albedo);specular=lerp(spec*multiBounce(specularOcclusion(o.nv,s.ao,s.roughness),o.f0),r.rgb,gathered?r.a:0);
    }
    if(view==1)return specular*o.albedo;
    if(view==2){
        // Screen green, planar mirror view white, capture trace blue, screen probes
        // yellow, box-projected captures cyan, probes orange, sky magenta; surfaces too
        // rough to trace are dimmed.
        float screen=r.a*(1-captured),traced=r.a*captured,rest=1-r.a,screenProbes=rest*spSpec,left=rest-screenProbes;
        float box=left*boxed,probes=left*(1-boxed)*coverage,sky=left-box-probes;
        float planar=gathered&&planarSurface(f,l,world,s.normal)?screen:0;screen-=planar;
        float3 c=screen*float3(0.1,0.85,0.1)+planar*float3(0.95,0.95,0.95)+traced*float3(0.15,0.35,1)+screenProbes*float3(1,0.9,0.1)+box*float3(0,0.8,0.8)+probes*float3(1,0.45,0)+sky*float3(0.9,0.15,0.8);
        float shade=0.55+0.45*saturate(dot(s.normal,v));
        return c*shade*(s.roughness<l.ssr.x||(l.flags.y&LOOK_REFLECTIONS)==0?1:0.25)/max(hdrExposure(f,l),1e-6);
    }
    return diffuseOnly?incident*o.diffuse:incident*o.diffuse+specular*o.albedo;
}
// ibl with the surface's own specularLobes.
float3 ibl(Frame f,Look l,Surface s,float3 world,float3 v,int2 p,bool gathered,bool high=false,bool rays=false){
    return ibl(f,l,s,specularLobes(s,v),world,v,p,gathered,high,rays);
}
// Local lights (after Lobes and brdf, which they shade with).
#include "look-lights.slangh"
// The shadow shape of local light `index` (`light`) seen from `world` (look-shadow.slangh
// ShadowLight): a rect's or disc's half-axes, a sphere's disc facing the point, a tube's
// half-length and radius as a box; zero for an ideal point or spot.
// `shape`: its shape row (localShadowLight loads it).
ShadowLight localShadowLightShaped(Light light,LightShape shape,float3 world){
    ShadowLight s;s.a=0;s.b=0;s.disc=true;s.tangent=0;
    if(!lightHasArea(light))return s;
    uint kind=lightKind(light);
    float3 n=light.directionOuter.xyz,t=shape.tangentLength.xyz,d=normalize(light.positionRange.xyz-world);
    if(kind==LIGHT_RECT){float2 e=max(shape.rect.xy,0.001);s.a=t*e.x;s.b=cross(t,n)*e.y;s.disc=false;return s;}
    float r=max(light.parameters.z,0.001);
    if(kind==LIGHT_DISC){s.a=t*r;s.b=cross(t,n)*r;return s;}
    float3 u=normalize(cross(d,abs(d.y)<0.9?float3(0,1,0):float3(1,0,0)));float span=shape.tangentLength.w;
    if(span<=0){s.a=u*r;s.b=cross(d,u)*r;return s;}
    float3 side=cross(t,d);float sl=dot(side,side);side=sl>1e-8?side*rsqrt(sl):u;
    s.a=t*(span*0.5+r);s.b=side*r;s.disc=false;return s;
}
ShadowLight localShadowLight(Frame f,Light light,uint index,float3 world){
    return localShadowLightShaped(light,lightHasArea(light)?loadLightShape(f.lighting.w,index):(LightShape)0,world);
}
// Linear HDR radiance leaving `world` towards the camera (before fog and exposure).
// `gathered`: deferred G-buffer pixels read the half-resolution probe gather.
float3 shade(Frame f,Look l,Surface s,float3 world,int2 p,bool gathered,bool high=false,bool rays=false) {
    float3 v=normalize(f.camera.xyz-world);Lobes o=specularLobes(s,v);float3 result=s.emissive+ibl(f,l,s,o,world,v,p,gathered,high,rays);
    // The sun lights front faces only (brdf ends in N.L): back faces skip its shadows.
    // The High tier passes the sun through blended films and glass (coloured,
    // look-translucent.slangh).
    if(dot(s.normal,f.sunDirection.xyz)>0){
        float pages=gathered?vsmMask(l,p):-1,lit=visibility(f,l,world,s.normal,pages);
        float3 through=high && lit>0?translucentSun(l,world):float3(1,1,1);
        result+=brdf(s,v,f.sunDirection.xyz,o)*sunAt(f,l,world)*lit*through;
    }
    uint tilesX=(f.extent.x+15)/16;uint tile=(uint(p.y)/16*tilesX+uint(p.x)/16)*TILE_STRIDE;
    uint count=buffers[NonUniformResourceIndex(f.lighting.z)].Load(tile*4);AreaPixel area=(AreaPixel)0;
    for(uint i=0;i<count;i++) {
        uint index=buffers[NonUniformResourceIndex(f.lighting.z)].Load((tile+1+i)*4);
        // look-lights.slangh: points, spots, spheres, tubes, rects and discs.
        Light light=loadLight(f.lighting.w,index);
