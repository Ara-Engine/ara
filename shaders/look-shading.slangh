        if(any(c>0)){float unused;c*=localShadowShape(l,index,world,s.normal,light.positionRange.xyz,light.positionRange.w,localShadowLight(f,light,index,world),unused);}
        result+=c;
    }
    return result;
}
// A forward fragment's premultiplied output (ONE, ONE_MINUS_SRC_ALPHA): radiance `c`
// over `coverage`, stopping `stop` of what lies behind. Safe to blend: a non-finite
// result contributes nothing (an upstream NaN or Inf would turn black and spread
// through the temporal resolve), negative radiance is zero, and luminance is at most
// FORWARD_PEAK times display white at the frame's exposure. Forward geometry is often
// thinner than a pixel (rims, lenses, wires): a glint on the sample the jitter lands
// on would otherwise outshine what the area-filtered pixel holds, flicker against the
// history and bloom into a smear. `c` carries `exposure` (1: radiance; refraction
// composes in the HDR target's pre-exposed space, look-refract.slangh refractExposure).
static const float FORWARD_PEAK=64;
float4 forwardOutput(Frame f,float3 c,float coverage,float stop,float exposure=1){
    if(any(isnan(c))||any(isinf(c))||isnan(coverage)||isnan(stop))return 0;
    c=max(c,0);float peak=FORWARD_PEAK*exposure/exposureScale(f,0),y=luminance(c);
    return float4((y>peak?c*(peak/y):c)*saturate(coverage),saturate(stop));
}
// Premultiplied forward colour of a transparent or transmissive surface: alpha is
// coverage times the share of light it stops; reflections keep full strength
// over what it transmits (blending ONE, ONE_MINUS_SRC_ALPHA). `exposure`: the HDR
// target's pre-exposure (hdrExposure; native draws load it per vertex).
float4 forwardColour(Frame f,Look l,Surface s,float3 world,int2 p,float exposure,bool high=false){
    float2 uv=(float2(p)+0.5)/float2(f.extent.xy);
    // Clamped in radiance (forwardOutput), then pre-exposed like every HDR writer.
    float4 o=forwardOutput(f,applyFog(f,l,shade(f,l,s,world,p,false,high),world,uv,FOG_LIGHTS_FRONT),s.alpha,s.alpha*(1-s.transmission));
    return float4(min(o.rgb*exposure,60000),o.a);
}
// World-space view ray through pixel centre `p`.
float3 viewRay(Frame f,float2 p){
    float2 uv=p/float2(f.extent.xy);float4 far=mul(f.inverseVp,float4(uv.x*2-1,1-uv.y*2,0.00001,1));
    return normalize(far.xyz/far.w-f.camera.xyz);
}
// Background radiance: the physical sky (with sun disk) or the environment map,
// fogged (fogBackground).
float3 background(Frame f,Look l,float3 d,float2 uv){
    return fogBackground(f,l,physicalSky(l)?skyRadiance(f,l,d,true):envTex(f.extra.w,environmentUv(d)).rgb,d,uv);
}
