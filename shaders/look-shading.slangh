// Raster surface shading shared by deferred lighting and forward transparency.
// Include after raster.slangh and look.slangh.
#include "look-gi.slangh"
// Cascaded sun shadows (renderer/frame.rs): f.look.y texels per cascade side in a
// 2x2 D32 atlas, f.look.z active cascades, far distances in f.splits.
uint cascadeIndex(Frame f,float3 world){float d=dot(world-f.camera.xyz,f.forward.xyz);return d<f.splits.x?0:d<f.splits.y?1:d<f.splits.z?2:3;}
// A 3x3 box of bilinear compares (16 texels from four gathers) inside cascade `c`,
// with normal offset and depth bias both scaled to the cascade's texel size.
float cascadeVisibility(Frame f,uint c,float3 world,float3 normal){
    float res=float(f.look.y);float4x4 m=f.shadows[c];float texel=2/(length(m[0].xyz)*res);
    float4 h=mul(m,float4(world+normal*texel*1.5,1));float3 q=h.xyz/h.w;float2 uv=float2(q.x*0.5+0.5,0.5-q.y*0.5);
    if(any(uv<0)||any(uv>1)||q.z<0||q.z>1)return 1;
    float depth=q.z+texel*length(m[2].xyz);
    float2 origin=float2(c%2,c/2)*res,position=origin+uv*res-0.5,base=floor(position),t=position-base;
    float4 wx=float4(1-t.x,1,1,t.x)/3,wy=float4(1-t.y,1,1,t.y)/3;float sum=0;
    for(uint j=0;j<2;j++)for(uint i=0;i<2;i++){
        // Gather the 2x2 texels (base-1+2i.., base-1+2j..); w is top-left, z top-right,
        // x bottom-left, y bottom-right. Centres stay inside the cascade's tile.
        float2 g=clamp(base+float2(2*i,2*j),origin+1,origin+res-1)/(res*2);
        float4 d=textures[NonUniformResourceIndex(f.extra.z)].GatherRed(samplers[2],g);float4 lit=step(d,depth);
        sum+=wx[2*i]*wy[2*j]*lit.w+wx[2*i+1]*wy[2*j]*lit.z+wx[2*i]*wy[2*j+1]*lit.x+wx[2*i+1]*wy[2*j+1]*lit.y;
    }
    return sum;
}
// Sun visibility at `world`: blends into the next cascade over the last tenth of
// each and fades out over the last tenth of the shadow distance.
float visibility(Frame f,float3 world,float3 normal) {
    float d=dot(world-f.camera.xyz,f.forward.xyz);float4 splits=f.splits;uint count=f.look.z,c=cascadeIndex(f,world);
    if(c>=count)return 1;
    float far=splits[c],near=c==0?0:splits[c-1],band=(far-near)*0.1,blend=saturate((d-(far-band))/max(band,1e-3));
    float v=cascadeVisibility(f,c,world,normal);
    if(blend>0)v=lerp(v,c+1<count?cascadeVisibility(f,c+1,world,normal):1.,blend);
    return v;
}
float3 fresnel(float cosine,float3 f0){return f0+(1-f0)*pow(1-saturate(cosine),5);}
float3 brdf(Surface s,float3 v,float3 l) {
    float3 h=normalize(v+l);float nl=saturate(dot(s.normal,l));float nv=max(dot(s.normal,v),0.001);float nh=saturate(dot(s.normal,h));float vh=saturate(dot(v,h));
    float a=s.roughness*s.roughness;float a2=a*a;float d=a2/(PI*pow(nh*nh*(a2-1)+1,2));
    float k=pow(s.roughness+1,2)/8;float g=nv/(nv*(1-k)+k)*nl/(nl*(1-k)+k);
    float3 F=fresnel(vh,lerp(float3(0.04),s.albedo,s.metal));
    return ((1-F)*(1-s.metal)*s.albedo/PI+d*g*F/max(4*nv*nl,0.001))*nl;
}
// Screen-space ambient visibility at full-resolution pixel `p` (camera distance
// `distance`): a depth-aware bilinear upsample of the denoised half-resolution GTAO.
float screenOcclusion(Frame f,Look l,int2 p,float distance){
    if((l.flags.y&LOOK_AMBIENT_OCCLUSION)==0)return 1;
    int2 half=int2((f.extent.xy+1)/2);float2 h=(float2(p)+0.5)*0.5-0.5;int2 b=int2(floor(h));float2 t=h-float2(b);float sum=0,total=0;
    for(uint k=0;k<4;k++){
        int2 o=int2(k&1,k>>1);float2 v=pixel(l.aoImages.y,clamp(b+o,int2(0),half-1)).rg;
        float w=(o.x==1?t.x:1-t.x)*(o.y==1?t.y:1-t.y)*exp(-abs(v.g-distance)/max(distance*0.02,0.05))+1e-4;
        sum+=v.r*w;total+=w;
    }return sum/total;
}
// Multi-bounce ambient occlusion (Jimenez et al. 2016): light inter-reflected
// inside the occluded cavity brightens AO on bright albedo.
float3 multiBounce(float ao,float3 albedo){
    float3 a=2.0404*albedo-0.3324,b=-4.7951*albedo+0.6417,c=2.7552*albedo+0.6903;
    return max(float3(ao),((ao*a+b)*ao+c)*ao);
}
// Specular occlusion from ambient occlusion (Lagarde & de Rousiers 2014).
float specularOcclusion(float nv,float ao,float roughness){
    return saturate(pow(nv+ao,exp2(-16*roughness*roughness-1))-1+ao);
}
// Gathered probe lobes at full-resolution pixel `p` (camera distance `distance`):
// a depth-aware bilinear upsample of the half-resolution gather (`giGatherMain`).
// Returns the volume coverage; zero when no lobe was gathered nearby.
float gatheredLobes(Frame f,Look l,int2 p,float distance,out float3 diffuse,out float3 specular){
    int2 half=int2((f.extent.xy+1)/2);float2 h=(float2(p)+0.5)*0.5-0.5;int2 b=int2(floor(h));float2 t=h-float2(b);
    diffuse=0;specular=0;float coverage=0,total=0;
    for(uint k=0;k<4;k++){
        int2 o=int2(k&1,k>>1),q=clamp(b+o,int2(0),half-1);float4 d=pixel(l.giGather.x,q),s=pixel(l.giGather.y,q);
        float w=(o.x==1?t.x:1-t.x)*(o.y==1?t.y:1-t.y)*exp(-abs(d.w-distance)/max(distance*0.02,0.05))+1e-5;
        diffuse+=d.rgb*w;specular+=s.rgb*w;coverage+=s.w*w;total+=w;
    }
    diffuse/=total;specular/=total;return coverage/total;
}
// Screen-space reflection at full-resolution pixel `p`: rgb radiance, a confidence
// (zero without a hit). Upsampled from half resolution with depth-similar weights.
float4 screenReflection(Frame f,Look l,int2 p){
    if((l.flags.y&LOOK_REFLECTIONS)==0)return 0;
    int2 half=int2((f.extent.xy+1)/2);float2 h=(float2(p)+0.5)*0.5-0.5;int2 b=int2(floor(h));float2 t=h-float2(b);
    float depth=pixel(f.extra.x,p).x;float4 sum=0;float total=0;
    for(uint k=0;k<4;k++){
        int2 o=int2(k&1,k>>1),q=clamp(b+o,int2(0),half-1);float d=pixel(f.extra.x,q*2).x;
        float w=(o.x==1?t.x:1-t.x)*(o.y==1?t.y:1-t.y)*exp(-abs(d/max(depth,1e-7)-1)*40)+1e-5;
        sum+=pixel(l.ssrImages.y,q)*w;total+=w;
    }return sum/total;
}
// Ambient light: the physical sky's IBL under a sky atmosphere, otherwise the
// environment map's (32x16 irradiance, five-level 256x640 GGX prefilter strip for
// roughness 0, .25, .5, .75, 1). Inside the probe volume, probe irradiance replaces
// the sky's diffuse light and occludes its reflections by the ratio of probe to
// sky irradiance in the mirror direction; rough reflections use the probes.
// `gathered` reads the half-resolution gather at pixel `p` (deferred lighting);
// forward surfaces search the probes directly.
float3 ibl(Frame f,Look l,Surface s,float3 world,float3 v,int2 p,bool gathered) {
    uint irradiance=physicalSky(l)?l.sampled1.x:f.lighting.x,prefilter=physicalSky(l)?l.sampled1.y:f.lighting.y;
    float nv=saturate(dot(s.normal,v));float3 F=fresnel(nv,lerp(float3(0.04),s.albedo,s.metal));
    float3 reflected=reflect(-v,s.normal);float2 uv=environmentUv(reflected);float level=s.roughness*4;float low=floor(level);float high=min(low+1,4);
    float3 spec=lerp(envTex(prefilter,float2(uv.x,(uv.y*127+0.5+low*128)/640)).rgb,envTex(prefilter,float2(uv.x,(uv.y*127+0.5+high*128)/640)).rgb,frac(level));
    float3 ambient=envTex(irradiance,environmentUv(s.normal)).rgb;
    float coverage=0;float3 diffuseGi=0,specularGi=0;
    [branch]if(giEnabled(l)){
        if(gathered)coverage=gatheredLobes(f,l,p,length(world-f.camera.xyz),diffuseGi,specularGi);
        else{coverage=giCoverage(l,world);if(coverage>0)giLobes(l,l.giImages.y,world,s.normal,reflected,giBias(l,s.normal,v),diffuseGi,specularGi);}
    }
    [branch]if(coverage>0){
        float occlusion=saturate(luminance(specularGi)/max(luminance(envTex(irradiance,uv).rgb),1e-4));
        ambient=lerp(ambient,diffuseGi,coverage);
        spec=lerp(spec,lerp(spec*occlusion,specularGi/PI,s.roughness),coverage);
    }
    if(gathered){float4 r=screenReflection(f,l,p);spec=lerp(spec,r.rgb,r.a);}
    float3 diffuse=ambient*s.albedo*(1-s.metal)*(1-F)/PI*multiBounce(s.ao,s.albedo);
    // Analytic split-sum environment BRDF fit (Lazarov, Epic 2014).
    float4 r=s.roughness*float4(-1,-0.0275,-0.572,0.022)+float4(1,0.0425,1.04,-0.04);
    float a004=min(r.x*r.x,exp2(-9.28*nv))*r.x+r.y;float2 ab=float2(-1.04,1.04)*a004+r.zw;
    return diffuse+spec*(F*ab.x+ab.y)*specularOcclusion(nv,s.ao,s.roughness);
}
// Linear HDR radiance leaving `world` towards the camera (before fog and exposure).
// `gathered`: deferred G-buffer pixels read the half-resolution probe gather.
float3 shade(Frame f,Look l,Surface s,float3 world,int2 p,bool gathered) {
    float3 v=normalize(f.camera.xyz-world);float3 result=s.emissive+ibl(f,l,s,world,v,p,gathered);
    result+=brdf(s,v,f.sunDirection.xyz)*sunAt(f,l,world)*visibility(f,world,s.normal);
    uint tilesX=(f.extent.x+15)/16;uint tile=(uint(p.y)/16*tilesX+uint(p.x)/16)*65;
    uint count=buffers[NonUniformResourceIndex(f.lighting.z)].Load(tile*4);
    for(uint i=0;i<count;i++) {
        uint index=buffers[NonUniformResourceIndex(f.lighting.z)].Load((tile+1+i)*4);
        Light light=buffers[NonUniformResourceIndex(f.lighting.w)].Load<Light>(index*64);
        float3 delta=light.positionRange.xyz-world;float d2=max(dot(delta,delta),0.01);float d=sqrt(d2);float3 toLight=delta/d;
        float fade=pow(saturate(1-pow(d/light.positionRange.w,4)),2);float spot=1;
        if(light.parameters.x>0.5)spot=smoothstep(light.directionOuter.w,light.parameters.y,dot(-toLight,light.directionOuter.xyz));
        float solidAngle=light.parameters.x>0.5?2*PI*(1-light.directionOuter.w):4*PI;
        float3 illuminance=light.colorLumens.rgb*(light.colorLumens.w/(solidAngle*d2))*fade*spot;
        result+=brdf(s,v,toLight)*illuminance;
    }
    return result;
}
// World-space view ray through pixel centre `p`.
float3 viewRay(Frame f,float2 p){
    float2 uv=p/float2(f.extent.xy);float4 far=mul(f.inverseVp,float4(uv.x*2-1,1-uv.y*2,0.00001,1));
    return normalize(far.xyz/far.w-f.camera.xyz);
}
// Background radiance: the physical sky (with sun disk) or the environment map,
// the latter fogged over the whole froxel range.
float3 background(Frame f,Look l,float3 d,float2 uv){
    if(physicalSky(l))return skyRadiance(f,l,d,true);
    return applyFog(f,l,envTex(f.extra.w,environmentUv(d)).rgb,f.camera.xyz+d*FOG_RANGE,uv);
}
