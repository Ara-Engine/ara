// Software secondary queries and native hit lighting. No screen-colour lookup.
#pragma once
#include "trace.slangh"
#include "reflect-material.slangh"
#include "look-glass.slangh"
static const uint REFLECT_SOLID=1|2|8|16,REFLECT_ALL=63,REFLECT_SHADOW=1|2;
void reflectCount(Look l,uint slot,uint value=1){
    uint sum=WaveActiveSum(value);
    if(WaveIsFirstLane()){uint unused;buffers[l.rtInfo[1].w].InterlockedAdd(slot*4,sum,unused);}
}
struct ReflectAlpha : ITraceAlpha {
    Look l;
    bool accept(TraceScene scene,TraceCandidate c){
        // Resolve the current native resident row every query. Trace's alpha
        // records mark cutouts only; their sampled-heap indices are never used.
        return reflectAlphaAccept(l,c.user,c.primitive,c.barycentrics,c.t*l.rtParams[0].z);
    }
};
bool reflectClosest(Look l,float3 origin,float3 direction,float reach,uint mask,out TraceHit hit){
    reflectCount(l,2);ReflectAlpha alpha;alpha.l=l;
    return traceClosestWith(traceScene(l.rtInfo[0].x),traceRay(origin,direction,0.00001,reach,0,mask,l.rtParams[0].z),alpha,hit);
}
bool reflectBlocked(Look l,float3 origin,float3 direction,float reach){
    reflectCount(l,3);ReflectAlpha alpha;alpha.l=l;
    return traceAnyWith(traceScene(l.rtInfo[0].x),traceRay(origin,direction,0.00001,reach,0,REFLECT_SHADOW,l.rtParams[0].z),alpha);
}
Surface reflectSurface(Look l,TraceHit hit,float3 direction,float width,out float3 position,out float3 geometric,out float3 outward){
    ReflectTriangle t=reflectTriangle(l,hit.user,hit.primitive,hit.barycentrics);
    position=t.a.position*t.w.x+t.b.position*t.w.y+t.c.position*t.w.z;
    float3 n=t.a.normal*t.w.x+t.b.normal*t.w.y+t.c.normal*t.w.z;
    geometric=cross(t.b.position-t.a.position,t.c.position-t.a.position);
    geometric=dot(geometric,geometric)>1e-20?normalize(geometric):-direction;
    n=dot(n,n)>1e-12?normalize(n):geometric;
    if(dot(geometric,n)<0)geometric=-geometric;
    outward=geometric;
    if(dot(geometric,direction)>0){geometric=-geometric;n=-n;}
    Surface s=reflectSurfaceOf(l,t.material,t,n,width);
    if(dot(s.normal,geometric)<=0)s.normal=n;
    return s;
}
float3 reflectMiss(Frame f,Look l,float3 direction){
    return (physicalSky(l)?skyRadiance(f,l,direction,false):envTex(f.extra.w,environmentUv(direction)).rgb)*skyLight(l);
}
// Straight secondary shadow visibility. Opaque/cutout geometry uses any-hit;
// transparent interfaces are then processed in distance order, never nearest RGB.
float3 reflectTransmittance(Look l,float3 origin,float3 direction,float reach){
    if(reflectBlocked(l,origin,direction,reach))return 0;
    float3 through=1;uint4 objects=0,materials=0;uint count=0;float3 absorption=0;
    [loop]for(uint layer=0;layer<16;layer++){
        TraceHit hit;if(!reflectClosest(l,origin,direction,reach,4,hit))return through*exp(-absorption*reach);
        float3 at,n,outward;Surface s=reflectSurface(l,hit,direction,hit.t*l.rtParams[0].z,at,n,outward);
        ReflectMaterial m=reflectMaterial(l,reflectTriangle(l,hit.user,hit.primitive,hit.barycentrics).material);
        through*=exp(-absorption*hit.t);
        float coverage=m.pbr.flags.x==2?saturate(s.alpha):1;
        through*=glassTransmittance(coverage,s.transmission,s.albedo,glassIor(asuint(m.factors.z)),dot(n,direction));
        if((asuint(m.factors.z)&65535)!=0){
            if(dot(outward,direction)<0){
                if(count>=4){reflectCount(l,6);return through;}
                objects[count]=hit.user;materials[count]=reflectTriangle(l,hit.user,hit.primitive,hit.barycentrics).material;count++;
                absorption=glassAbsorption(asuint(m.factors.w));
            }else {
                if(count==0 || objects[count-1]!=hit.user){reflectCount(l,6);return through;}
                count--;absorption=count>0?glassAbsorption(asuint(reflectMaterial(l,materials[count-1]).factors.w)):float3(0);
            }
        }
        reach-=hit.t+l.rtParams[1].x;origin=at+direction*l.rtParams[1].x;
        if(reach<=0)return through;
    }
    reflectCount(l,5);return through;
}
// Existing BRDF, light shapes, physical units and probe GI evaluated at the hit.
// Shadow maps supply their source-shaped penumbra where allocated. Unmapped
// lights use the shared software any-hit path; no screen-colour term is present.
float3 reflectShade(Frame f,Look l,Surface s,float3 position,float3 geometric,float3 v){
    Lobes o=specularLobes(s,v);float3 c=s.emissive+ibl(f,l,s,o,position,v,int2(0),false);
    float3 origin=position+geometric*l.rtParams[1].x;
    if(dot(s.normal,f.sunDirection.xyz)>0){
        bool mapped;float penumbra;
        float vis=mapVisibility(f,l,position,s.normal,mapped,penumbra);
        float3 through=mapped?translucentSun(l,position):reflectTransmittance(l,origin,f.sunDirection.xyz,l.rtParams[0].y);
        c+=brdf(s,v,f.sunDirection.xyz,o)*sunAt(f,l,position)*vis*through*horizonSun(l,position,mapped);
    }
    AreaPixel area=(AreaPixel)0;
    for(uint i=0;i<f.extent.z;i++){
        Light light=loadLight(f.lighting.w,i);float size;
        float3 e=localLight(f,l,s,o,v,position,i,light,area,size);
        if(any(e>0)){
            ShadowMap map;float3 d=light.positionRange.xyz-origin;float reach=length(d);
            float3 vis=shadowLocal(l,i,position,light.positionRange.xyz,light.positionRange.w,map)
                ?float3(localShadow(l,i,position,s.normal,light.positionRange.xyz,size,light.positionRange.w))
                :reflectTransmittance(l,origin,d/max(reach,1e-6),max(reach-l.rtParams[1].x,0.00001));
            c+=e*vis;
        }
    }
    return c;
}
// Today's volume radiance and prefiltered captures, until B3 supplies a patch lobe.
float3 reflectPrefiltered(Frame f,Look l,float3 world,float3 n,float3 v,float roughness){
    float3 direction=specularDirection(n,v,roughness);float2 uv=environmentUv(direction);
    uint prefilter=physicalSky(l)?l.sampled1.y:f.lighting.y;float level=roughness*4,lo=floor(level),hi=min(lo+1,4);
    float3 c=lerp(envTex(prefilter,float2(uv.x,(uv.y*127+0.5+lo*128)/640)).rgb,envTex(prefilter,float2(uv.x,(uv.y*127+0.5+hi*128)/640)).rgb,frac(level))*skyLight(l);
    if(giEnabled(l)){
        float3 diffuse,specular;float weight=giPoolLobes(l,l.giImages.y,world,n,direction,v,roughness,true,diffuse,specular)*giWeight(l);
        c=lerp(c*horizonSky(l,world),specular,weight);
    }
    float4 capture=captureReflection(l,world,n,v,roughness,l.captureInfo[1].z);
    return lerp(c,capture.rgb,capture.a);
}
