// Raster look constants and the physical atmosphere (look/frame.rs LookFrame).
// Include after raster.slangh. The atmosphere is shared with ara-render-fidelity
// (atmosphere-model.slangh): Hillaire's LUT model with Unreal's SkyAtmosphere parameters.
#include "atmosphere-model.slangh"
struct Look {
    float4 sunLux;     // rgb top-of-atmosphere sun illuminance (lux), w angular radius (rad)
    float4 atmosphere; // x sea level (m), y fog extinction at base (1/m), z fog scale height (m), w fog albedo
    float4 fog;        // rgb fog tint, w Henyey-Greenstein anisotropy
    float4 look;       // x contrast, y vignette, z fog base altitude (m)
    float4 grading;    // rgb white-balance gain, w saturation
    float4 exposure;   // x manual multiplier (0: automatic), y compensation gain, z adaptation (1/s), w frame seconds
    float4 metering;   // x,y EV100 range, z,w trimmed histogram fractions
    float4 bloom;      // x energy fraction
    uint4 flags;       // x tone curve, y LOOK_* bits, z frame number
    uint4 sampled0;    // transmittance, multiscatter, sky view, froxels
    uint4 sampled1;    // sky irradiance, sky prefilter, bloom down, bloom up
    uint4 storage0;    // as sampled0
    uint4 storage1;    // as sampled1
    uint4 state;       // x exposure state buffer
    float4 giParams;   // x irradiance hysteresis, y finer lattices' arrival weight
    uint4 giCounts;    // x lattices in the pool, y/z last frame's relit window (first, count), w probes (0: no probe GI)
    uint4 giBuffers;   // x surface caches, y probe relocation/state (buffers)
    uint4 giUpdate;    // x first relit probe, y relit probes this frame, z atlas probes per row, w shading weight (f32 bits)
    uint4 giImages;    // irradiance read (sampled), write (sampled), write (storage), moments (sampled)
    float4 ao;         // x radius (m), y slices, z steps per side, w intensity (power on visibility; 1 physical)
    uint4 aoImages;    // trace, denoised (sampled), trace, denoised (storage); half resolution
    uint4 giGather;    // diffuse, specular (sampled), diffuse, specular (storage); half resolution
    float4 ssr;        // x max roughness, y max distance (m), z march steps, w intensity (scales hit confidence)
    uint4 ssrImages;   // pyramid, trace (sampled), pyramid, trace (storage)
    float4 weather;    // x cloud coverage (0..1), y cloud layer altitude (m), z sky light scale
    float4x4 farShadow; // light view-projection of the far shadow map
    uint4 farInfo;     // x far map (sampled), y texels per side, z drawn (0: none)
    uint4 cascadeMaps; // sampled cascade maps, in cascade order
    float4 terrain;    // x terrain detail distance (m): layer normal/MR maps end there
    uint4 localShadows; // x shading table (storage), y atlas (sampled; 0 none), zw atlas texels
    float4 horizonRect;    // heightfield (look::horizon): world x, z origin, x, z size
    float4 horizonHeight;  // height = x*depth + y of the capture; z top-surface tolerance (m)
    uint4 horizonImages;   // x capture, y sun visibility, z sky visibility (sampled; 0 none), w capture texels
    uint4 horizonStorage;  // x sun visibility, y sky visibility (storage), z sky texels
    uint4 vsm;             // virtual shadow maps (look::vsm): x page table, y atlas (sampled; 0 none), z page views, w atlas pages per row
    uint4 vsmRequest;      // x page-request bits (storage; 0 no marks), z atlas page rows
    float4x4 vsmSpace;     // the sun's light rotation
    float4 vsmDepth;       // depth = x*light z + y; z level bias; w level zero radius (m)
    uint4 vsmMask;         // x projected page visibility (sampled; 0 none), y (storage)
    float4 giLatticeOrigin[4];  // probe lattices, finest first (look-gi.slangh GiLattice): xyz first probe centre, w edge falloff (cells)
    float4 giLatticeSpacing[4]; // xyz probe separation, w surface bias (m)
    uint4 giLatticeCounts[4];   // xyz dimensions, w first global probe id
    // Display grading and lens effects (post-process volumes; look-post.slang).
    float4 lift;       // rgb display-space lift added to the shadows (0 neutral)
    float4 gamma;      // rgb display-space midtone power (1 neutral)
    float4 gain;       // rgb display-space gain (1 neutral), w chromatic aberration strength (0 off)
    uint4 lut;         // x colour lookup table strip (sampled; 0 none), y slices (16 or 32), z contribution (f32 bits)
    // Depth of field (look-dof.slang): radius = y*(1 - x/depth) render pixels.
    float4 dof;        // x focus distance (m; 0 off), y circle-of-confusion scale (render px), z largest radius (render px), w near strength
    float4 dofBlur;    // x far strength, y gather samples
    uint4 dofImages;   // prepared, gathered (sampled), prepared, gathered (storage); half render resolution
    uint4 dofOutput;   // x composite (storage), y composite (sampled); render resolution
    // Motion blur (look-motion.slangh): gathered by the post pass's motion variant.
    float4 motion;     // x shutter fraction of a frame (0 off), y samples, z longest blur (display px)
    uint4 motionImages; // tile max, neighbour max (sampled), tile max, neighbour max (storage); display / 16
    // Preview-4 fidelity blocks, one owner each (look/frame.rs): reflection captures,
    // hybrid ray queries, refraction, soft shadows and bitmask ambient light.
    float4 captureParams[2]; uint4 captureInfo[2];
    float4 rtParams[2];      uint4 rtInfo[2];
    float4 refractParams[2]; uint4 refractInfo[2];
    float4 shadowParams[2];  uint4 shadowInfo[2];
    // shadowParams[0]: visibility-bitmask ambient light (look-ao.slang aoBitmaskMain), x
    // sample thickness (m), y bounce intensity; shadowInfo[0].x bit 0: last frame's colour
    // pyramid feeds the bounce. The soft sun shadows read sunLux.w; [1] is spare.
    float4 exposureCurve[4]; // automatic exposure's compensation curve: (EV100, stops) keys xy, zw in rising EV
    uint4 giRadiance;        // probe radiance atlas (look-gi.slangh giSampleRadiance): x sampled, y storage
    // Volumetric fog (look/volumetric.rs; look-fog.slangh, look-volumetric.slang). Local fog
    // volume records follow the struct at byte volumetricAtlas.w (look-fog.slangh).
    float4 volumetric;         // x near volume distance (m), y slice scale (m), z history weight (0: none), w height fog extinction scale
    float4 volumetricEmissive; // rgb height fog emission (radiance per metre at base density), w the sun's scattering scale in fog
    uint4 volumetricGrid;      // x, y froxels, z slices, w render pixels per froxel side
    uint4 volumetricAtlas;     // x slices per atlas row, y frames since the history reset, z fog volumes, w their byte offset
    uint4 volumetricImages;    // injection history, injection, integrated (sampled), injection (storage)
    uint4 volumetricStorage;   // x integrated (storage), y ambient (storage), z ambient (sampled)
    uint4 volumetricAmbient;   // ambient light grid: xyz cells (froxels / 4, 4, 2), w slices per atlas row
    // Local lights (look-lights.slangh): lightInfo[0] x LTC inverse matrices, y LTC sphere
    // integral (sampled), z light tables (storage; 0 none); lightParams reserved.
    float4 lightParams[2];   uint4 lightInfo[2];
    // The sky atmosphere (look/atmosphere.rs record): planet, media, art direction and
    // both atmosphere lights; meaningful under LOOK_PHYSICAL_SKY only.
    AtmosphereModel sky;
    // Screen traces and screen probe GI (look/screen_gi.rs; rows in look-screen.slangh).
    float4 screenParams[2];  uint4 screenInfo[4];
};
static const uint LOOK_PHYSICAL_SKY=1,LOOK_FOG=2,LOOK_RESET=4,LOOK_AMBIENT_OCCLUSION=8,LOOK_REFLECTIONS=16,LOOK_SNAP=32,LOOK_LOCAL_INDIRECT=64,LOOK_REFLECTION_SOURCES=128,LOOK_VOLUMETRIC=256,LOOK_FOG_SHADOWED=512,LOOK_SCREEN_GI=1024;
// Automatic exposure's extra compensation (stops) at metered scene EV100 `ev`:
// linear between the curve's keys, flat beyond its ends. Constant row indices only.
float exposureCurve(Look l,float ev){
    float2 a=l.exposureCurve[0].xy;float stops=a.y;bool done=ev<=a.x;
    [unroll]for(uint i=0;i<8;i++){
        float4 row=l.exposureCurve[i/2];float2 b=(i&1)==0?row.xy:row.zw;
        if(!done && ev<=b.x){stops=lerp(a.y,b.y,saturate((ev-a.x)/max(b.x-a.x,1e-6)));done=true;}
        if(!done)stops=b.y;
        a=b;
    }
    return stops;
}
// The look record (a frame record row: uniform, so no NonUniformResourceIndex).
Look look(Frame f){return buffers[f.look.x].Load<Look>(0);}
// Exposure state (look-post.slang exposureMain): applied multiplier, the previous
// one, EV100 and metered luminance. The TAA history (RGBA16F) is stored pre-exposed
// by the applied multiplier `taaMain` sees (x); exposureMain then keeps that value
// as y, so history readers after it, and the next frame's readers before it, decode
// with y. The buffer starts zeroed and captures zero it again (reproducible
// convergence): `exposureScale` then substitutes the frame's exposure argument.
// The metering histogram's 256 counts follow the state, at byte EXPOSURE_BINS;
// they are zero between frames.
static const uint EXPOSURE_BINS=16;
// Uniform (a Look row): no NonUniformResourceIndex, so the load can stay scalar in
// every lit pixel (exposeHdr) rather than a per-lane bindless fetch.
float4 exposureState(Look l){return buffers[l.state.x].Load<float4>(0);}
float exposureScale(Frame f,float s){
    float fallback=f.sunColorExposure.w;return s>0 && s<1e30?s:fallback>0 && fallback<1e30?fallback:1;
}
// The raster HDR target (RGBA16F) holds radiance pre-exposed by the multiplier this
// frame applies (exposureState x, as the TAA history): writers store exposeHdr, and
// readers that need radiance divide by hdrExposure. External writers (VFX) apply the
// same multiplier (ara_render::HdrExposure).
float hdrExposure(Frame f,Look l){return exposureScale(f,exposureState(l).x);}
float3 exposeHdr(Frame f,Look l,float3 radiance){return min(radiance*hdrExposure(f,l),60000);}
bool physicalSky(Look l){return (l.flags.y&LOOK_PHYSICAL_SKY)!=0;}
// Scale of the light the sky casts (ambient, reflections, probe bounce, fog ambient)
// over the sky drawn in the background (Look::sky_light; Unreal's sky light intensity).
float skyLight(Look l){return l.weather.z;}
float4 lut(uint index,float2 uv){return textures[NonUniformResourceIndex(index)].SampleLevel(samplers[2],uv,0);}
float luminance(float3 c){return dot(c,float3(0.2126,0.7152,0.0722));}

float3 srgb(float3 x){return lerp(12.92*x,1.055*pow(max(x,0),1/2.4)-0.055,step(0.0031308,x));}
// Display curves shared with the fidelity post pass (forward.w: 0 ACES fit, 1 PBR
// Neutral, 2 fitted ACES filmic pre-scaled to keep 18% grey, 3..5 AgX: agxCurve).
float3 tonemap(float3 x){return saturate((x*(2.51*x+0.03))/(x*(2.43*x+0.59)+0.14));}
float3 neutralCurve(float3 c){
    float minimum=min(c.x,min(c.y,c.z));float offset=minimum<=0.08?minimum-6.25*minimum*minimum:0.04;c-=offset;
    float peak=max(c.x,max(c.y,c.z));if(peak<=0.76)return c;
    float compressed=1-0.0576/(peak-0.52);float blend=1-1/(1+0.15*(peak-compressed));return lerp(c*(compressed/peak),float3(compressed),blend);
}
float3 filmicCurve(float3 c){
    c*=1.464;
    float3 v=float3(dot(float3(0.59719,0.35458,0.04823),c),dot(float3(0.07600,0.90834,0.01566),c),dot(float3(0.02840,0.13383,0.83777),c));
    v=(v*(v+0.0245786)-0.000090537)/(v*(0.983729*v+0.4329510)+0.238081);
    return saturate(float3(dot(float3(1.60475,-0.53108,-0.07367),v),dot(float3(-0.10208,1.10813,-0.00605),v),dot(float3(-0.00327,-0.07276,1.07602),v)));
}
// AgX (Troy Sobotka's image formation as Blender 5.1 ships it; ara_render_fidelity
// colour.rs `agx` is the same maths): an independent analytic form fitted to Blender's
// OCIO processor, within 0.5 (mean) and 2 (p95) 8-bit codes of it over 3.5k colours.
// The two-segment hyperbolic sigmoid of log2 exposure over -10..+6.5 stops around 18%
// grey, pivoting there with slope 2.38: x/(1+x^p)^(1/p) below (toe) and above
// (shoulder), scaled to reach 0 and 1 at the ends; it yields Rec.1886 (2.4) code values.
float3 agxSigmoid(float3 l){
    float3 above=step(0.606060606,l),scale=lerp(0.563481689,0.723107701,above),power=lerp(1.522003776,1.489164645,above);
    float3 t=2.380159557*abs(l-0.606060606)/scale;
    return 0.489437090+sign(l-0.606060606)*scale*t*pow(1+pow(t,power),-1/power);
}
// Blender's AgX looks, applied per channel in its AgX Log space (Rec.2020 with
// Blender's inset matrix, log2 over 25 stops): `look` 1 Punchy (a shadow curve
// below 0.4, then CDL power 1.0912), 2 Medium High Contrast (contrast 1.2 about mid
// grey, 0.4).
float3 agxLook(float3 c,uint look){
    float3 v=max(float3(dot(float3(0.544814746,0.373787398,0.081397855),c),dot(float3(0.140416948,0.754137555,0.105445497),c),dot(float3(0.088810420,0.178871756,0.732317824),c)),1e-10);
    float3 l=(log2(v)+12.47393)/25;
    if(look==2)l=(l-0.4)*1.2+0.4;
    else{l=saturate(l);float3 d=min(l-0.4,0);l=lerp(0.367932255+d*(0.576921404+d*(-13.071582562+d*(-68.043428823+d*(-110.187104976+d*-47.912392721)))),pow(l,1.0912),step(0.4,l));}
    v=exp2(l*25-12.47393);
    return float3(dot(float3(2.114473395,-1.027378470,-0.087094925),v),dot(float3(-0.370504268,1.552926184,-0.182421916),v),dot(float3(-0.165931398,-0.254715528,1.420646926),v));
}
// Linear Rec.709 after exposure to linear display Rec.709 through AgX; `look` 0 base,
// 1 Punchy, 2 Medium High Contrast (agxLook): the fitted inset, the sigmoid, the
// outset, the display power and the return to Rec.709.
float3 agxCurve(float3 c,uint look){
    if(look!=0)c=agxLook(c,look);
    float3 v=max(float3(dot(float3(0.586284653,0.320481389,0.093233958),c),dot(float3(0.115577053,0.766820846,0.117602100),c),dot(float3(0.090460175,0.189264504,0.720275322),c)),1e-10);
    float3 s=agxSigmoid(saturate((log2(v)+12.47393)/16.5));
    s=pow(max(float3(dot(float3(0.977084882,0.019273491,0.003641627),s),dot(float3(0.017531670,1.012742383,-0.030274053),s),dot(float3(0.012019836,0.012047557,0.975932607),s)),0),2.4);
    return saturate(float3(dot(float3(1.807087207,-0.635807619,-0.171279588),s),dot(float3(-0.224544003,1.237837193,-0.013293189),s),dot(float3(-0.184566066,-0.281406333,1.465972400),s)));
}
// The physical sky (atmosphere-model.slangh; l.sky, look/atmosphere.rs): the
// transmittance (sampled0.x), multiple-scattering (y) and sky-view (z) LUTs.
float phaseM(float cosine,float g){return atmospherePhaseMie(cosine,g);}
// Planar clouds (as the fidelity sky): five octaves of value noise thresholded
// by the coverage, at the layer altitude.
uint lookHash(uint x){x^=x>>16;x*=0x7feb352d;x^=x>>15;x*=0x846ca68b;x^=x>>16;return x;}
float noise2(float2 p){
    int2 i=int2(floor(p));float2 a=frac(p);a=a*a*(3-2*a);
    float n00=float(lookHash(asuint(i.x)*73856093u^asuint(i.y)*19349663u)&65535)/65535.,n10=float(lookHash(asuint(i.x+1)*73856093u^asuint(i.y)*19349663u)&65535)/65535.;
    float n01=float(lookHash(asuint(i.x)*73856093u^asuint(i.y+1)*19349663u)&65535)/65535.,n11=float(lookHash(asuint(i.x+1)*73856093u^asuint(i.y+1)*19349663u)&65535)/65535.;
    return lerp(lerp(n00,n10,a.x),lerp(n01,n11,a.x),a.y);
}
float cloudDensity(Look l,float2 p){float n=0,m=0.5;for(uint i=0;i<5;i++){n+=noise2(p)*m;p=p*2.03+17.7;m*=0.5;}return smoothstep(1-l.weather.x,1-l.weather.x+0.18,n);}
// The cloud layer's shadow on the sun at `position` (1 without clouds).
float cloudShadow(Frame f,Look l,float3 position){
    if(l.weather.x<=0 || f.sunDirection.y<=0.01)return 1;
    float2 p=position.xz+f.sunDirection.xz*((l.weather.y-position.y)/f.sunDirection.y);
    return exp(-cloudDensity(l,p*0.00025)*3/max(f.sunDirection.y,0.2));
}
// Sun illuminance reaching surfaces at `position` (lux): through the atmosphere
// (Unreal's global transmittance, or per-pixel at the surface's altitude with the
// planet's shadow; atmosphereSurfaceLight) and the cloud layer's shadow.
float3 sunAt(Frame f,Look l,float3 position){
    float3 lux=f.sunColorExposure.rgb;if(!physicalSky(l))return lux;
    lux*=atmosphereSunSurface(l.sky,l.sampled0.x,l.sunLux.w,position.y-l.sky.apFactor.w,f.sunDirection.y);
    return lux*cloudShadow(f,l,position);
}
// Sky radiance along `d` (cd/m²): the sky-view LUT times the sky luminance factor,
// plus the atmosphere lights' analytic discs (`disk`) and the cloud layer.
float3 skyRadiance(Frame f,Look l,float3 d,bool disk){
    float3 c=atmosphereSky(l.sky,l.sampled0.x,l.sampled0.z,f.camera.xyz,d,disk);
    if(l.weather.x>0 && d.y>0.01){
        float2 at=f.camera.xz+d.xz*((l.weather.y-f.camera.y)/d.y);
        float density=cloudDensity(l,at*0.00025),shade=cloudDensity(l,(at+f.sunDirection.xz*250)*0.00025);
        float t=exp(-density*3/max(d.y,0.2));float3 light=l.sunLux.rgb*(0.045+0.2*exp(-shade*2.2))*max(f.sunDirection.y,0.05);
        c=c*t+light*(1-t);
    }return c;
}
// Froxel fog: 64x36 columns, FOG_SLICES logarithmic slices (the first 32 to FOG_RANGE,
// 4 km, the rest carrying the aerial perspective to 111 km); per slice the cumulative
// in-scatter (x 0..63) and transmittance (x 64..127) of a FOG_SLICES*128 x 36 atlas
// (look/gpu.rs FOG_SLICES).
static const float FOG_RANGE=4000;
static const uint FOG_SLICES=46;
float froxelSlice(float distance){return log2(1+distance/2)/log2(1+FOG_RANGE/2)*32;}
// Far end of slice `z` (0-based) in metres.
float froxelEnd(uint z){return 2*(exp2(log2(1+FOG_RANGE/2)*float(z+1)/32)-1);}
float3 sampleFroxel(Look l,float2 uv,float distance,out float3 trans){
    float slice=froxelSlice(distance),z=clamp(slice-1,0.,float(FOG_SLICES-1));uint lo=uint(z),hi=min(lo+1,FOG_SLICES-1);
    float2 a=clamp(uv,float2(0.5/64,0.5/36),float2(63.5/64,35.5/36))*float2(64,36);const float width=FOG_SLICES*128;
    float3 x=lut(l.sampled0.w,float2((lo*128+a.x)/width,a.y/36)).rgb,y=lut(l.sampled0.w,float2((hi*128+a.x)/width,a.y/36)).rgb;
    float3 tx=lut(l.sampled0.w,float2((lo*128+64+a.x)/width,a.y/36)).rgb,ty=lut(l.sampled0.w,float2((hi*128+64+a.x)/width,a.y/36)).rgb;
    trans=lerp(tx,ty,frac(z));float3 light=lerp(x,y,frac(z));
    if(slice<1){trans=lerp(float3(1),trans,slice);light*=slice;}
    return light;
}
// The near fog volume (look/volumetric.rs): slices on an exponential view-depth
// distribution, depth = c (2^(t log2(1 + D/c)) - 1) for t in 0..1 (c volumetric.y, D
// volumetric.x), tiled volumetricAtlas.x per atlas row.
float nearDepth(Look l,float t){float c=l.volumetric.y;return c*(exp2(t*log2(1+l.volumetric.x/c))-1);}
float nearSlice(Look l,float depth){float c=l.volumetric.y;return log2(1+max(depth,0)/c)/log2(1+l.volumetric.x/c);}
// Texel origin of slice `z` in a near volume atlas.
uint2 nearTile(Look l,uint z){uint columns=l.volumetricAtlas.x;return uint2(z%columns,z/columns)*l.volumetricGrid.xy;}
// Bilinear tap of slice `z` at froxel coordinates `xy` (texel units), clamped inside the
// slice's tile so neighbouring slices never bleed in.
float4 nearTap(Look l,uint image,uint z,float2 xy){
    uint3 grid=l.volumetricGrid.xyz;uint columns=l.volumetricAtlas.x;
    float2 size=float2(grid.xy)*float2(columns,(grid.z+columns-1)/columns);
    return lut(image,(float2(nearTile(l,z))+clamp(xy,0.5,float2(grid.xy)-0.5))/size);
}
// Integrated in-scatter (rgb) and transmittance (a) from the camera to view depth
// `depth` (at most the volume's distance) through render uv `uv`. Slices store their
// far ends; between them the value interpolates linearly.
float4 sampleNear(Frame f,Look l,float2 uv,float depth){
    float2 xy=uv*float2(f.extent.xy)/float(l.volumetricGrid.w);uint slices=l.volumetricGrid.z,image=l.volumetricImages.z;
    float s=nearSlice(l,depth)*slices;
    if(s<1)return lerp(float4(0,0,0,1),nearTap(l,image,0,xy),s);
    float z=min(s-1,float(slices-1));uint lo=uint(z),hi=min(lo+1,slices-1);
    return lerp(nearTap(l,image,lo,xy),nearTap(l,image,hi,xy),frac(z));
}
// Aerial perspective and fog between the camera and `world`: on near volume frames
// the volume up to its distance, and the coarse grid's segment behind it (which it
// integrates from there), so the two compose exactly; else the coarse grid alone.
float3 applyFog(Frame f,Look l,float3 colour,float3 world,float2 uv){
    bool near=(l.flags.y&LOOK_VOLUMETRIC)!=0;
    if((l.flags.y&(LOOK_PHYSICAL_SKY|LOOK_FOG))==0 && l.volumetricAtlas.z==0)return colour;
    float3 offset=world-f.camera.xyz;float depth=dot(offset,f.forward.xyz);
    if(!near||depth>l.volumetric.x){float3 trans;float3 light=sampleFroxel(l,uv,length(offset),trans);colour=colour*trans+light;}
    if(near){float4 v=sampleNear(f,l,uv,depth);colour=colour*v.a+v.rgb;}
    return colour;
}
// Fog over background radiance `c` seen along `d`: the whole froxel range over an
// environment map; the physical sky carries its own aerial perspective, so only the
// near volume (height fog, fog volumes and shafts in front of the sky) lies over it.
float3 fogBackground(Frame f,Look l,float3 c,float3 d,float2 uv){
    if(!physicalSky(l))return applyFog(f,l,c,f.camera.xyz+d*FOG_RANGE,uv);
    if((l.flags.y&LOOK_VOLUMETRIC)!=0){float4 v=sampleNear(f,l,uv,l.volumetric.x);c=c*v.a+v.rgb;}
    return c;
}
// Normal offset in texels for a surface at `nl` (cosine to the light) in the fine
// maps (virtual sun pages, local faces): 1.5 facing the light, widening towards
// grazing incidence, where a constant offset leaves the surface's own depth
// shadowing it in stripes. The cascades and far map keep 1.5: their texels are
// coarse enough that a wider offset lifts receivers past small occluders.
float shadowOffset(float nl){return 1.5+2.5*sqrt(saturate(1-nl*nl));}
