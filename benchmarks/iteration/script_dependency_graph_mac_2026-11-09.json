  "controller_source": "from pathlib import Path\nimport json,hashlib,subprocess,sys,os,re,time,datetime,shutil\nroot=Path.cwd();base=root/'target/perf-win-2026-11-09';out=base/'dependency-graph-probe';out.mkdir(exist_ok=False)\nsys.path.insert(0,str(root/'benchmarks/iteration/unity/features'))\nimport project,monitor\nsha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\nlog=(base/'dependencies-unit.log').read_text();exe=root/re.search(r'Running unittests[^\\n]+\\(([^)]+)\\)',log)[1]\nsources=[root/'Cargo.toml',root/'Cargo.lock',root/'.cargo/config.toml',root/'crates/ara-script/Cargo.toml',*sorted((root/'crates/ara-script/src').rglob('*.rs'))]\ninputs={str(p.relative_to(root)):sha(p) for p in sources}\nfor p in sources:\n target=out/'source'/p.relative_to(root);target.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(p,target)\ndigest=sha(exe);frozen=out/('test-'+digest);shutil.copy2(exe,frozen)\nrecord={'scope':'Developer test-profile dependency planning and real Bevy schedule initialization, not CLR compilation/full play latency','command':['/usr/bin/nice','-n','10',str(frozen),'host::dependencies::tests::bench::dependency_plan_benchmark','--exact','--ignored','--nocapture','--test-threads=1'],'executable_sha256':digest,'input_sha256':inputs,'rustc':subprocess.check_output(['rustc','-Vv'],text=True),'cargo':subprocess.check_output(['cargo','-V'],text=True),'environment':{k:os.environ.get(k) for k in ['RUSTFLAGS','CARGO_BUILD_JOBS','RUSTUP_TOOLCHAIN']},'git_head':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),'build_log':log}\na=project.resources(strict=False);record['before']=a\nif a['busy_tools']:raise RuntimeError('competing tools before graph probe')\nobserved=[];start=time.monotonic()\nwith (out/'stdout.log').open('w') as stdout,(out/'stderr.log').open('w') as stderr:\n child=subprocess.Popen(record['command'],stdout=stdout,stderr=stderr)\n print('graph probe started',child.pid,flush=True)\n while child.poll() is None:\n  if time.monotonic()-start>180:child.terminate();child.wait(timeout=10);raise RuntimeError('graph probe timeout')\n  try:child.wait(timeout=1)\n  except subprocess.TimeoutExpired:observed.append(project.resources(strict=False))\n status=child.wait()\nz=project.resources(strict=False);record.update(exit_code=status,observations=observed,after=z)\nrecord['source_unchanged']=all(sha(root/p)==h for p,h in inputs.items())\nrecord['accepted']=not status and record['source_unchanged'] and not any(x['busy_tools'] for x in [a,*observed,z]) and monitor.power_stable(a,observed,z)\nrows=[json.loads(s[s.index('{'):]) for s in (out/'stdout.log').read_text().splitlines() if '{\"scope\":' in s]\nrecord['result']=rows[-1] if rows else None\n(out/'report.json').write_text(json.dumps(record,indent=2)+'\\n')\nprint(json.dumps({'exit_code':status,'accepted':record['accepted'],'result':record['result']}),flush=True)\nif not record['accepted'] or not rows:raise RuntimeError('unaccepted graph probe; preserve outputs')\n",
  "resource_guard_function_source": "def resources(strict=True):\n    \"\"\"Timed engines require quiet tools; smoke/build lanes retain observed context.\"\"\"\n    busy = []\n    rows = subprocess.check_output([\"ps\", \"-axo\", \"pid=,pcpu=,comm=\"], text=True)\n    for line in rows.splitlines():\n        parts = line.split(None, 2)\n        if len(parts) != 3:\n            continue\n        pid, cpu, command = parts\n        build = any(name in command.lower() for name in [\"rustc\", \"/cargo\", \"clippy-driver\", \"/dotnet\", \"vbcscompiler\"])\n        test = \"/target/\" in command and any(name in command for name in [\"/deps/\", \"/examples/\"])\n        if float(cpu) > 1 and (build or test):\n            argv = subprocess.run([\"ps\", \"-p\", pid, \"-o\", \"command=\"], capture_output=True, text=True).stdout.strip()\n            busy.append({\"pid\": int(pid), \"pcpu\": float(cpu), \"command\": argv})\n    if busy and strict:\n        raise RuntimeError(\"competing tool/test work observed; no valid timing claim: \" + json.dumps(busy))\n    return {\"loadavg\": list(os.getloadavg()), \"busy_tools\": busy, \"strict_timing_guard\": strict,\n            \"power\": subprocess.check_output([\"pmset\", \"-g\", \"batt\"], text=True).strip()}\n",
  "power_guard_source": "def power_stable(before, observations, after):\n    \"\"\"A transient source switch is invalid even when the endpoints agree.\"\"\"\n    source = before[\"power\"].splitlines()[0]\n    return all(record[\"power\"].splitlines()[0] == source for record in [*observations, after])\n",
