<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <!-- Existing compiler-test friendship; this diagnostic tool is never shipped. -->
    <AssemblyName>Ara.CompileServer.Tests</AssemblyName><IsTestProject>false</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TieredCompilation>false</TieredCompilation><ConcurrentGarbageCollection>true</ConcurrentGarbageCollection><InvariantGlobalization>true</InvariantGlobalization>
    <AraSdk Condition="'$(AraSdk)' == ''">$(MSBuildThisFileDirectory)../../../dotnet/artifacts/bin/Ara.CompileServer/release</AraSdk>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Ara.CompileServer"><HintPath>$(AraSdk)/Ara.CompileServer.dll</HintPath></Reference>
    <Reference Include="Ara.Runtime"><HintPath>$(AraSdk)/Ara.Runtime.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(AraSdk)/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(AraSdk)/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
