    "control_partition_helper_source": "\"\"\"Control-only row partitioning of the unchanged independent Python buffer oracle.\"\"\"\nimport argparse,hashlib,json,multiprocessing,struct,sys,time\nfrom pathlib import Path\nsys.dont_write_bytecode=True\nROOT=Path(__file__).resolve().parents[3]\nSOURCE=ROOT/'benchmarks/iteration/unity/features/reference.py'\nsys.path.insert(0,str(SOURCE.parent))\nimport reference\nROWS=None\nSETTINGS=None\n\ndef chunk(bounds):\n    start,stop=bounds\n    rows=ROWS[start:stop]\n    for tick in range(SETTINGS.steps):\n        reference.step(rows,SETTINGS.case,tick,SETTINGS.percent,'spread')\n    # Original encoder supplies all row fields/words; replace only local-count header.\n    return reference.encode(rows,SETTINGS.case,SETTINGS.steps)[24:]\n\ndef produce(args):\n    global ROWS,SETTINGS\n    if args.case not in ('buffer_fixed','buffer_resize'):raise ValueError('partitioning only applies to row-independent buffer cases')\n    if args.entities<1 or args.steps<0 or not 1<=args.workers<=15 or not 0<=args.percent<=100:raise ValueError('invalid oracle parameters')\n    destination=args.output.resolve()\n    if not destination.is_relative_to(ROOT/'target')or destination.exists():raise ValueError('fresh ownedtarget oracle output required')\n    before=hashlib.sha256(SOURCE.read_bytes()).hexdigest();start=time.monotonic();SETTINGS=args\n    ROWS=reference.initial(args.case,args.entities,8,args.length)\n    bounds=[(args.entities*i//args.workers,args.entities*(i+1)//args.workers)for i in range(args.workers)]\n    # Fresh CLI parent imports no GUI or threaded native libraries; fork shares only\n    # immutable initial rows. Each child mutates disjoint logical IDs privately.\n    with multiprocessing.get_context('fork').Pool(args.workers)as pool:\n        parts=pool.map(chunk,bounds)\n    data=struct.pack('<8sIIII',b'ARAECSF1',1,reference.CASES.index(args.case)+1,args.entities,args.steps)+b''.join(parts)\n    if hashlib.sha256(SOURCE.read_bytes()).hexdigest()!=before:raise ValueError('reference source changed during computation')\n    destination.parent.mkdir(parents=True,exist_ok=True)\n    with destination.open('xb')as output:output.write(data)\n    proof={'reference_source_sha256':before,'control_helper_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),'case':args.case,'entities':args.entities,'steps':args.steps,'length':args.length,'percent':args.percent,'workers':args.workers,'start_method':'fork','partition_contract':'Original reference.initial/step/encode; disjoint IDs preserve order; buffer step does not depend on len(rows)','state_bytes':len(data),'state_sha256':hashlib.sha256(data).hexdigest(),'wall_seconds':time.monotonic()-start,'timings_accepted':False}\n    destination.with_suffix('.oracle.json').write_text(json.dumps(proof,indent=2)+'\\n');print(json.dumps(proof),flush=True)\n\nif __name__=='__main__':\n    parser=argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('--case',required=True,choices=['buffer_fixed','buffer_resize']);parser.add_argument('--entities',type=int,required=True);parser.add_argument('--steps',type=int,required=True);parser.add_argument('--length',type=int,default=64);parser.add_argument('--percent',type=int,default=100);parser.add_argument('--workers',type=int,default=8);parser.add_argument('--output',type=Path,required=True)\n    produce(parser.parse_args())\n",
