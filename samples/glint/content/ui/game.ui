<!-- ara:asset ui_glint000000001 -->
<ui id="glint">
<panel id="hud">
<panel id="clock"><panel id="tag-box" class="ol"><text id="tag-a" class="tag ols" text="SKYWARD"/><text id="tag" class="tag" text="SKYWARD"/></panel><panel id="time" class="row"><panel id="t-min-cell" class="dg"><panel id="t-min-box" class="ol"><text id="t-min-a" class="tm ola" text="0"/><text id="t-min" class="tm" text="0"/></panel></panel><panel id="t-colon-box" class="ol"><text id="t-colon-a" class="tm ola" text=":"/><text id="t-colon" class="tm" text=":"/></panel><panel id="t-s1-cell" class="dg"><panel id="t-s1-box" class="ol"><text id="t-s1-a" class="tm ola" text="0"/><text id="t-s1" class="tm" text="0"/></panel></panel><panel id="t-s2-cell" class="dg"><panel id="t-s2-box" class="ol"><text id="t-s2-a" class="tm ola" text="0"/><text id="t-s2" class="tm" text="0"/></panel></panel><panel id="t-dot-box" class="ol"><text id="t-dot-a" class="tm ola" text="."/><text id="t-dot" class="tm" text="."/></panel><panel id="t-c1-cell" class="dgs"><panel id="t-c1-box" class="ol"><text id="t-c1-a" class="tc ola" text="0"/><text id="t-c1" class="tc" text="0"/></panel></panel><panel id="t-c2-cell" class="dgs"><panel id="t-c2-box" class="ol"><text id="t-c2-a" class="tc ola" text="0"/><text id="t-c2" class="tc" text="0"/></panel></panel></panel><panel id="target" class="row"><panel id="goal-time-box" class="ol"><text id="goal-time-a" class="tg ols" text="GOLD"/><text id="goal-time" class="tg" text="GOLD"/></panel></panel><panel id="best" class="row"><panel id="best-label-box" class="ol"><text id="best-label-a" class="tb ols" text="BEST"/><text id="best-label" class="tb" text="BEST"/></panel><panel id="b-min-box" class="ol"><text id="b-min-a" class="tb ols" text="0:"/><text id="b-min" class="tb" text="0:"/></panel><panel id="b-sec-box" class="ol"><text id="b-sec-a" class="tb ols" text="00."/><text id="b-sec" class="tb" text="00."/></panel><panel id="b-cs-box" class="ol"><text id="b-cs-a" class="tb ols" text="00"/><text id="b-cs" class="tb" text="00"/></panel></panel></panel>
<panel id="counters"><panel id="orbs-row" class="counter row"><image class="ci" id="orbs-icon" src="orb"/><panel id="orbs-box" class="ol"><text id="orbs-a" class="ct ola" text="0 / 0"/><text id="orbs" class="ct" text="0 / 0"/></panel></panel><panel id="gates-row" class="counter row"><image class="ci" id="gates-icon" src="flag"/><panel id="gates-box" class="ol"><text id="gates-a" class="ct ola" text="0 / 3"/><text id="gates" class="ct" text="0 / 3"/></panel></panel><panel id="falls-row" class="counter row"><image class="ci" id="falls-icon" src="fall"/><panel id="falls-box" class="ol"><text id="falls-a" class="ct ola" text="0"/><text id="falls" class="ct" text="0"/></panel></panel></panel>
<panel id="keys" class="row"><panel id="key-w" class="key"><text id="key-w-t" class="kt" text="W"/></panel><panel id="key-a" class="key"><text id="key-a-t" class="kt" text="A"/></panel><panel id="key-s" class="key"><text id="key-s-t" class="kt" text="S"/></panel><panel id="key-d" class="key"><text id="key-d-t" class="kt" text="D"/></panel><panel id="key-roll-box" class="ol"><text id="key-roll-a" class="keylabel ols" text="ROLL"/><text id="key-roll" class="keylabel" text="ROLL"/></panel><panel id="key-space" class="key keywide"><text id="key-space-t" class="kt" text="SPACE"/></panel><panel id="key-jump-box" class="ol"><text id="key-jump-a" class="keylabel ols" text="JUMP"/><text id="key-jump" class="keylabel" text="JUMP"/></panel><panel id="key-e" class="key"><text id="key-e-t" class="kt" text="E"/></panel><panel id="key-retry-box" class="ol"><text id="key-retry-a" class="keylabel ols" text="RETRY"/><text id="key-retry" class="keylabel" text="RETRY"/></panel></panel>
<panel id="fade-full" class="fade full"/><panel id="fade-half" class="fade half"/><panel id="fade-light" class="fade light"/>
<panel id="win" class="scrim"><panel id="win-content"><panel id="medal-box"><image class="wm" id="medal-gold" src="medal_gold"/><image class="wm" id="medal-silver" src="medal_silver"/><image class="wm" id="medal-bronze" src="medal_bronze"/></panel><text id="win-medal" text="GOLD"/><panel id="win-time" class="row"><text id="w-min" text="0:"/><text id="w-sec" text="00."/><text id="w-cs" text="00"/></panel><text id="win-title" text="COURSE CLEAR"/><panel id="tiers" class="row"><panel id="tier-gold" class="tier"><panel id="tier-gold-row" class="row tierrow"><image id="tier-gold-icon" class="ti" src="medal_gold"/><text id="tier-gold-time" class="tt" text="1:00"/></panel><panel id="tier-gold-mark" class="tiermark"/></panel><panel id="tier-silver" class="tier"><panel id="tier-silver-row" class="row tierrow"><image id="tier-silver-icon" class="ti" src="medal_silver"/><text id="tier-silver-time" class="tt" text="1:15"/></panel><panel id="tier-silver-mark" class="tiermark"/></panel><panel id="tier-bronze" class="tier"><panel id="tier-bronze-row" class="row tierrow"><image id="tier-bronze-icon" class="ti" src="medal_bronze"/><text id="tier-bronze-time" class="tt" text="1:40"/></panel><panel id="tier-bronze-mark" class="tiermark"/></panel></panel><panel id="splits"><panel id="split-1" class="split row"><image id="split-1-icon" class="si" src="flag"/><text class="st" id="split-1-label" text="GATE 1"/><panel id="split-1-time" class="row"><text class="st" id="s1-min" text="0:"/><text class="st" id="s1-sec" text="00."/><text class="st" id="s1-cs" text="00"/></panel></panel><panel id="split-2" class="split row"><image id="split-2-icon" class="si" src="flag"/><text class="st" id="split-2-label" text="GATE 2"/><panel id="split-2-time" class="row"><text class="st" id="s2-min" text="0:"/><text class="st" id="s2-sec" text="00."/><text class="st" id="s2-cs" text="00"/></panel></panel><panel id="split-3" class="split row"><image id="split-3-icon" class="si" src="flag"/><text class="st" id="split-3-label" text="GATE 3"/><panel id="split-3-time" class="row"><text class="st" id="s3-min" text="0:"/><text class="st" id="s3-sec" text="00."/><text class="st" id="s3-cs" text="00"/></panel></panel><panel id="split-orbs" class="split row"><image id="split-orbs-icon" class="si" src="orb"/><text class="st" id="orb-label" text="ORBS"/><text class="st" id="win-orbs" text="0 / 0"/></panel><panel id="split-falls" class="split row"><image id="split-falls-icon" class="si" src="fall"/><text class="st" id="fall-label" text="FALLS"/><text class="st" id="win-falls" text="0"/></panel></panel><panel id="again" class="row"><panel id="again-roll" class="action row"><panel id="key-again" class="key"><text id="key-again-t" class="kt" text="E"/></panel><text id="again-label" class="actionlabel" text="ROLL AGAIN"/></panel><button id="win-leave" action="leave" text="TITLE"/></panel></panel></panel>
</panel>
<panel id="main-menu" class="screen"><panel id="menu-content"><text id="eyebrow" text="A ROLLING COURSE ABOVE THE CLOUDS"/><panel id="logo-box"><text id="logo-shadow" class="logo" text="GLINT"/><text id="logo" class="logo" text="GLINT"/></panel><panel id="title-rule" class="row"><panel id="rule-a"/><panel id="rule-b"/><panel id="rule-c"/></panel><panel id="menu-buttons"><button id="solo" action="solo" text="ROLL"/><button id="quit" action="quit" text="QUIT"/></panel></panel></panel>
<panel id="lobby" class="screen"><panel id="lobby-side" class="side"/><panel id="lobby-content"><text id="lobby-eyebrow" text="COURSE 01"/><text id="lobby-title" text="SKYWARD"/><panel id="medals"><panel id="lobby-gold" class="medal row"><image id="lobby-gold-icon" class="mi" src="medal_gold"/><text id="lobby-gold-name" class="medal-name" text="GOLD"/><text id="lobby-gold-time" class="medal-time" text="1:00"/></panel><panel id="lobby-silver" class="medal row"><image id="lobby-silver-icon" class="mi" src="medal_silver"/><text id="lobby-silver-name" class="medal-name" text="SILVER"/><text id="lobby-silver-time" class="medal-time" text="1:15"/></panel><panel id="lobby-bronze" class="medal row"><image id="lobby-bronze-icon" class="mi" src="medal_bronze"/><text id="lobby-bronze-name" class="medal-name" text="BRONZE"/><text id="lobby-bronze-time" class="medal-time" text="1:40"/></panel></panel><panel id="lobby-buttons"><button id="ready" action="ready" text="START"/><button id="lobby-leave" action="leave" text="BACK"/></panel></panel></panel>
<panel id="loading" class="screen solid"><text id="loading-title" text="LOADING"/><text id="loading-progress" text=""/></panel>
<panel id="pause" class="scrim"><panel id="pause-content"><text id="pause-title" text="PAUSED"/><button id="resume" action="resume" text="RESUME"/><button id="pause-leave" action="leave" text="LEAVE RUN"/></panel></panel>
</ui>
