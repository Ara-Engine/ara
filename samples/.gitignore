# Downloaded third-party content (see assets.lock.json; `ara-samples fetch` restores it).
.cache/
# Fetched files and generated kit geometry stay local; their import sidecars are committed.
*/content/third_party/**
!*/content/third_party/**/
!*/content/third_party/**/*.import.json
*/content/kit/**
!*/content/kit/**/
!*/content/kit/**/*.import.json
# Glint's synthesised sounds are generated too (`ara-samples kits glint`).
glint/content/audio/*.wav
# Project-local state (journal, cooked cache, daemon) and capture scratch.
*/.ara/
*/.scratch/
*/builds/
